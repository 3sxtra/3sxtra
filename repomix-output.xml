        break;

    case 1:
        if (ewk->wu.death_timer != 0) {
            Bg_Y_Sitei(0U, 0);
            Bg_Disp_Switch(0);
            g_state.seraph_flag = 0;
            ewk->wu.disp_flag = 0;
            ewk->wu.routine_no[0] = 3;
            break;
        }

        if (g_state.execute_flag == 0 && g_state.Game_pause == 0) {
            char_move(&ewk->wu);

            if (ewk->wu.dir_old != mwk->current_char_type || ewk->wu.dir_step != mwk->char_index) {
                ewk->wu.routine_no[0] = 2;
                Bg_Y_Sitei(0, 0);
                g_state.seraph_flag = 0;
                Bg_Disp_Switch(0);
            }
        }

        push_color_trans_req(ewk->wu.cg_type + 0x62, ewk->wu.my_col_code);
        sort_push_request(&ewk->wu);
        break;

    case 2:
        ewk->wu.disp_flag = 0;
        ewk->wu.routine_no[0] = 3;
        break;

    default:
        Release_Effect(&ewk->wu);
        break;
    }
}

s32 effect_K8_init(State* wk, u8 data) {
    State_Other* ewk;
    s16 ix;

    if ((ix = Acquire_Effect(5)) == -1) {
        return -1;
    }

    ewk = (State_Other*)frw[ix];
    ewk->my_master = wk;
    ewk->wu.active_flag = 1;
    ewk->wu.id = 208;
    ewk->wu.type = data;
    ewk->wu.my_sprite_sheet = 6;
    ewk->wu.work_id = 16;
    ewk->wu.my_family = 8;
    ewk->wu.graphic_rom_type = 1;
    ewk->wu.my_col_mode = 0x4200;
    ewk->wu.my_col_code = 2;
    ewk->wu.position_x = -8;
    ewk->wu.position_y = 240 - g_state.base_y_pos;
    ewk->wu.dir_old = wk->current_char_type;
    ewk->wu.dir_step = wk->char_index;
    *ewk->wu.char_table = _plef_char_table;
    return 0;
}
