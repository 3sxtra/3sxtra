            effect_E6_init(177);
            effect_E6_init(178);
            ewk->wu.old_routine_no[5] = gill_time[9];
        }

        disp_pos_trans_entry(ewk);
        break;

    case 10:
        if (ewk->wu.old_routine_no[6] < g_state.end_w.r_no_2) {
            ewk->wu.routine_no[2] = 99;
        }

        ewk->wu.routine_no[1]++;
        ewk->wu.old_routine_no[5] = gill_time[4];
        char_move(&ewk->wu);
        disp_pos_trans_entry(ewk);
        break;

    case 11:
        if (ewk->wu.old_routine_no[6] < g_state.end_w.r_no_2) {
            ewk->wu.routine_no[2] = 99;
        }

        switch (ewk->wu.type) {
        case 177:
            ewk->wu.xyz[0].cal -= gill_range[5] / gill_time[4];
            break;

        case 178:
            ewk->wu.xyz[0].cal += gill_range[6] / gill_time[4];
            break;
        }

        if (!ewk->wu.old_routine_no[5]--) {
            ewk->wu.routine_no[1]++;
        }

        char_move(&ewk->wu);
        disp_pos_trans_entry(ewk);
        break;

    case 12:
        if (ewk->wu.old_routine_no[6] < g_state.end_w.r_no_2) {
            ewk->wu.routine_no[2] = 99;
        }

        char_move(&ewk->wu);
        disp_pos_trans_entry(ewk);
