static void effI7_pos_hosei(State_Other* ewk, State* mwk);

const s16 ex_sign_data[69][4] = {
    { 28, 70, 121, 1 },  { -44, 60, 121, 0 }, { -24, 40, 121, 1 },  { -12, 52, 121, 1 }, { -40, 68, 121, 1 },
    { -32, 64, 121, 0 }, { -32, 64, 121, 1 }, { -20, 88, 121, 0 },  { -16, 72, 121, 1 }, { 40, 60, 121, 0 },
