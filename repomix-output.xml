void effect_F9_move(State_Other* ewk) {
    switch (ewk->wu.routine_no[0]) {
    case 0:
        ewk->wu.routine_no[0]++;
        ewk->wu.my_sprite_sheet = 12;
        ewk->free = 0;

        if (g_state.mes_already) {
            get_message_conn_data((EffectMultiSprite*)ewk, 2, ewk->master_player, g_state.mes_already);
        }

        ewk->wu.old_routine_no[4] = ewk->free;

        if (ewk->wu.old_routine_no[4] == 0) {
            ewk->wu.old_routine_no[5] = 0;
        } else {
            ewk->wu.old_routine_no[5] = 1;
        }

        ewk->wu.old_routine_no[6] = 1;
        ewk->wu.disp_flag = 1;
        ewk->wu.vitality = 240;
        ewk->free = ewk->wu.old_routine_no[5];
        efff9_suicide = 0;
        break;

    case 1:
    case 2:
    case 3:
    case 4:
        ewk->wu.routine_no[0]++;
        break;

    case 5:
        if (ewk->wu.death_timer == 1) {
            ewk->wu.disp_flag = 0;
            ewk->wu.type = 0;
            ewk->wu.routine_no[0] = 6;
            break;
        }

        ewk->wu.old_routine_no[6]--;

        if (ewk->wu.old_routine_no[6] == 0) {
            ewk->wu.old_routine_no[6] = 3;

            if (ewk->wu.old_routine_no[4] == ewk->wu.old_routine_no[5]) {
                ewk->wu.old_routine_no[6] = 3;
            } else {
                ewk->wu.old_routine_no[5]++;

                if (g_state.Country != COUNTRY_JAPAN && g_state.Country != COUNTRY_KOREA &&
                    (ewk->wu.old_routine_no[5]++, ewk->wu.old_routine_no[4] < ewk->wu.old_routine_no[5])) {
                    ewk->wu.old_routine_no[5] = ewk->wu.old_routine_no[4];
                }

                ewk->free = ewk->wu.old_routine_no[5];
            }
        }

        if (ewk->wu.old_routine_no[3] == 0) {
            Rewrite();
            ewk->wu.disp_flag = 0;
            ewk->wu.routine_no[0] = 6;
        } else {
            ewk->wu.old_routine_no[3]--;

            if (efff9_suicide == 1) {
                ewk->wu.disp_flag = 0;
                ewk->wu.routine_no[0] = 6;
                ewk->wu.disp_flag = 0;
            } else {
                sort_push_request3(&ewk->wu);
            }
        }

        break;

    case 6:
        ewk->wu.routine_no[0]++;
        break;

    default:
        Release_Effect(&ewk->wu);
    }
}

void effect_F9_init(s16 END_PL_NO) {
    g_state.mes_already = 0;
    efff9_suicide = 0;
    efff9_txt_point = 0;
    keep_mes_no = 0;
    efff9_PL_NO = END_PL_NO;
}

static void efff9_wk_set(EffectMultiSprite* ewk) {
    ewk->wu.active_flag = 1;
    ewk->wu.id = 159;
    ewk->wu.work_id = 16;
    ewk->wu.facing_flag = 0;
    ewk->wu.graphic_rom_type = 1;
    ewk->wu.sync_bg_strip = 0;
    ewk->wu.my_col_mode = 0x4200;
    ewk->wu.my_col_code = 55;
    ewk->wu.my_family = 4;
    ewk->wu.my_priority = 5;
    ewk->wu.position_x = 312;
    ewk->wu.position_y = 24;
    ewk->wu.position_z = ewk->wu.my_priority = 5;
}

s32 Rewrite_End_Message(u16 mes_no) {
    State_Other* ewk;
    s16 ix;

    if ((ix = Acquire_Effect(4)) == -1) {
        return -1;
    }

    ewk = (State_Other*)frw[ix];
    keep_mes_no = mes_no;
    efff9_wk_set((EffectMultiSprite*)ewk);
    ewk->master_player = efff9_PL_NO;
    efff9_suicide = 1;
    efff9_txt_point = 2;
    efff9_txt_no_adrs = txt_no_tbl[efff9_PL_NO];
    efff9_txt_scene_adrs = efff9_txt_no_adrs[mes_no];
    efff9_message = efff9_txt_scene_adrs[0];
    ewk->wu.old_routine_no[3] = efff9_txt_scene_adrs[1];
    g_state.mes_already = efff9_message;
    return 0;
}

static s32 Rewrite() {
    State_Other* ewk;
    s16 ix;

    if ((ix = Acquire_Effect(4)) == -1) {
        return -1;
    }

    ewk = (State_Other*)frw[ix];
    efff9_wk_set((EffectMultiSprite*)ewk);
    ewk->master_player = efff9_PL_NO;
    efff9_suicide = 1;
    efff9_txt_no_adrs = txt_no_tbl[efff9_PL_NO];
    efff9_txt_scene_adrs = efff9_txt_no_adrs[keep_mes_no];
    efff9_message = efff9_txt_scene_adrs[efff9_txt_point];
    ewk->wu.old_routine_no[3] = efff9_txt_scene_adrs[efff9_txt_point + 1];
    efff9_txt_point += 2;
    g_state.mes_already = efff9_message;
    return 0;
}
