            if (ewk->wu.cg_type) {
                ewk->wu.routine_no[1]++;
                ewk->wu.disp_flag = 0;
            }
        }

        disp_pos_trans_entry_rs(ewk);
        break;

    case 2:
        ewk->wu.routine_no[1]++;
        break;

    default:
        Release_Effect(&ewk->wu);
        break;
    }
}

static void eff09_1000(State_Other* ewk) {
    if (obr_no_disp_check()) {
        return;
    }

    switch (ewk->wu.routine_no[1]) {
    case 0:
        ewk->wu.routine_no[1]++;
        ewk->wu.disp_flag = 1;
        ewk->wu.my_priority = ewk->wu.position_z = 67;
        ewk->wu.position_x = ewk->wu.xyz[0].disp.pos & 0xFFFF;
        ewk->wu.position_y = ewk->wu.xyz[1].disp.pos = 4;
        ewk->wu.old_routine_no[0] = random_16();
        ewk->wu.old_routine_no[0] &= 1;

        if (ewk->master_id) {
            ewk->wu.type = 10;
        } else {
            ewk->wu.type = 9;
        }

        if (g_state.EXE_obroll) {
            set_char_move_init(&ewk->wu, 0, 25);
            ewk->wu.old_routine_no[0] = 1;
        } else if (ewk->wu.old_routine_no[0]) {
            set_char_move_init(&ewk->wu, 0, 25);
        } else {
            set_char_move_init(&ewk->wu, 0, 65);
        }

        sort_push_request(&ewk->wu);
        break;

    case 1:
    case 3:
        if (!g_state.execute_flag && !g_state.Game_pause && !g_state.EXE_obroll) {
            char_move(&ewk->wu);

            if (ewk->wu.cg_type) {
                ewk->wu.routine_no[1]++;
            }
