/**
 * @file flash_lp.c
 * @brief Win-mark flash lamp animation.
 *
 * Drives the alternating flash on victory markers during gameplay.
 * Skipped in training modes.
 *
 * Part of the ui module.
 */

#include "sf33rd/Source/Game/ui/flash_lamp.h"
#include "game_state.h"
#include "common.h"
#include "sf33rd/Source/Game/engine/state_user.h"
#include "sf33rd/Source/Game/system/system_director.h"
#include "sf33rd/Source/Game/system/work_sys.h"
#include "sf33rd/Source/Game/ui/hud_data.h"
#include "sf33rd/Source/Game/ui/hud_subroutines.h"

#define LAMP_FLASH_COUNT 2

/* Phase 3 RmlUi bypass */
#include "port/sdl/rmlui/rmlui_phase3_toggles.h"
#include <stdbool.h>

const u8 Lamp_Flash_Data[LAMP_FLASH_COUNT][2] = { { 0x07, 0x6F }, { 0x1E, 0x03 } };

/** @brief Animate the win-mark lamps — alternate flash colors each frame. */
void Flash_Lamp() {
    u8 ix;
    u8 ix2p;
    u8 mark;
    u8 color;

    if (g_state.Mode_Type == MODE_NORMAL_TRAINING || g_state.Mode_Type == MODE_PARRY_TRAINING ||
        g_state.Mode_Type == MODE_TRIALS) {
        return;
    }

    if (omop_cockpit == 0) {
        return;
    }

    if (!g_state.Game_pause) {
        switch (g_state.Lamp_No) {
        case 0:
            g_state.Lamp_No = 1;
            g_state.Lamp_Index = 1;
            g_state.Lamp_Timer = 1;
            /* fallthrough */

        case 1:
            if (--g_state.Lamp_Timer == 0) {
                if (++g_state.Lamp_Index > 1) {
                    g_state.Lamp_Index = 0;
                }

                if (g_state.Lamp_Index < LAMP_FLASH_COUNT) {
                    g_state.Lamp_Color = Lamp_Flash_Data[g_state.Lamp_Index][0];
                    g_state.Lamp_Timer = Lamp_Flash_Data[g_state.Lamp_Index][1];
                }
            }

            break;
        }
    }

    for (ix = 0; ix <= CurrentSave()->Battle_Number[g_state.Play_Type]; ix++) {
        mark = g_state.flash_win_type[0][ix];

        if (g_state.flash_win_type[0][ix] == 0) {
            color = 7;
        } else {
            color = g_state.Lamp_Color;
        }

        if (g_state.flash_win_type[0][ix] == g_state.sync_win_type[0][ix]) {
            if (!use_rmlui || !rmlui_hud_wins)
                scfont_sqput(vmark_tbl[ix], 4, color, 0, mark * 2, 26, 2, 1, 2);
        }

        mark = g_state.flash_win_type[1][ix];
        ix2p = ix + 4;

        if (g_state.flash_win_type[1][ix] == 0) {
            color = 7;
        } else {
            color = g_state.Lamp_Color;
        }

        if (g_state.flash_win_type[1][ix] == g_state.sync_win_type[1][ix]) {
            if (!use_rmlui || !rmlui_hud_wins)
                scfont_sqput(vmark_tbl[ix2p], 4, color, 0, mark * 2, 26, 2, 1, 2);
        }
    }
}
