/** @brief Ranking table 01 dispatcher — used from demo/attract-mode sequence. */
void Ranking_Display() {
    switch (g_state.demo_phase[1]) {
    case R01_INIT_SCREEN:
        Ranking_01_1st();
        break;
    case R01_LAYOUT_ENTRIES:
        Ranking_01_2nd();
