/**
 * @file efff2.c
 * Effect: Speed / Timer Effect
 */

#include "sf33rd/Source/Game/effect/effect_f2_speed_timer.h"
#include "game_state.h"
#include "bin2obj/char_table.h"
#include "common.h"
#include "sf33rd/Source/Game/effect/effect.h"
#include "sf33rd/Source/Game/ending/end_data.h"
#include "sf33rd/Source/Game/engine/charset.h"
#include "sf33rd/Source/Game/engine/player_system_utilities.h"
#include "sf33rd/Source/Game/rendering/texture_cache.h"
#include "sf33rd/Source/Game/stage/target_subroutines.h"

const s16 efff2_data_tbl1[10][4] = { { 1, 384, 608, 80 }, { 2, 592, 496, 86 }, { 1, 640, 576, 80 }, { 2, 336, 584, 86 },
                                     { 1, 464, 584, 80 }, { 1, 544, 640, 80 }, { 2, 640, 512, 86 }, { 1, 480, 592, 80 },
                                     { 2, 416, 640, 86 }, { 1, 576, 576, 80 } };

const s32 efff2_sp_tbl1[10][2] = { { -0xC000, 0 }, { -0x1800, 0 }, { 0x2000, 0 },  { -0x2000, 0 }, { -0x2000, 0 },
                                   { 0, 0 },       { 0x3000, 0 },  { -0x8000, 0 }, { -0x6000, 0 }, { 0x6000, 0 } };

const s16 efff2_timer_tbl[16] = { 60, 0, 40, 90, 20, 10, 8, 130, 1, 34, 50, 70, 6, 80, 22, 100 };

void effect_F2_move(State_Other* ewk) {
    s16 work;

    if (ewk->wu.old_routine_no[6] < g_state.end_w.r_no_2) {
        ewk->wu.routine_no[1] = 99;
    }

    switch (ewk->wu.routine_no[1]) {
    case 0:
        ewk->wu.routine_no[1]++;
        ewk->wu.disp_flag = 1;
        set_char_move_init2(&ewk->wu, 0, ewk->wu.old_routine_no[4], ewk->wu.char_index, 0);
        work = random_16();
        work &= 0xF;
        ewk->wu.old_routine_no[5] = efff2_timer_tbl[work];
        break;

    case 1:
        ewk->wu.old_routine_no[5]--;

        if (ewk->wu.old_routine_no[5] <= 0) {
            ewk->wu.routine_no[1]++;
        }

        break;

    case 2:
        char_move(&ewk->wu);

        if (ewk->wu.cg_type == 9) {
            ewk->wu.routine_no[1]++;
            ewk->wu.cg_type = 0;
            ewk->wu.mvxy.a[0].sp = efff2_sp_tbl1[ewk->wu.type][0];
            ewk->wu.mvxy.d[0].sp = efff2_sp_tbl1[ewk->wu.type][1];
            ewk->wu.mvxy.a[1].sp = -0x18000;
            ewk->wu.mvxy.d[1].sp = -0x400;
        }

        disp_pos_trans_entry(ewk);
        break;

    case 3:
        add_x_sub(&ewk->wu);
        add_y_sub(&ewk->wu);

        if (ewk->wu.xyz[1].disp.pos < 256) {
            ewk->wu.routine_no[1] = 0;
            ewk->wu.xyz[0].disp.pos = efff2_data_tbl1[ewk->wu.type][1];
            ewk->wu.xyz[1].disp.pos = efff2_data_tbl1[ewk->wu.type][2];
            ewk->wu.old_routine_no[4] = 19;
            ewk->wu.char_index = 1;
            break;
        }

        disp_pos_trans_entry(ewk);
        break;

    default:
        Release_Effect(&ewk->wu);
        break;
    }
}

s32 effect_F2_init() {
    State_Other* ewk;
    s16 ix;
    s16 i;
    const s16* data_ptr = &efff2_data_tbl1[0][0];

    for (i = 0; i < 10; i++) {
        if ((ix = Acquire_Effect(4)) == -1) {
            return -1;
        }

        ewk = (State_Other*)frw[ix];
        ewk->wu.id = 152;
        ewk->wu.active_flag = 1;
        ewk->wu.work_id = 0x10;
        ewk->wu.graphic_rom_type = 1;
        ewk->wu.type = i;
        ewk->wu.old_routine_no[0] = g_state.end_w.r_no_2;
        ewk->wu.my_col_mode = 0x4200;
        ewk->wu.char_table[0] = (u32*)_end_char_table;
        ewk->wu.my_col_code = 0x12C;
        ewk->wu.my_family = *data_ptr++;
        ewk->wu.old_routine_no[6] = 0;
        ewk->wu.old_routine_no[6] += g_state.end_w.r_no_2;
        ewk->wu.old_routine_no[4] = 19;
        ewk->wu.xyz[0].disp.pos = *data_ptr++;
        ewk->wu.xyz[1].disp.pos = *data_ptr++;
        ewk->wu.my_priority = ewk->wu.position_z = *data_ptr++;
        ewk->wu.char_index = 1;
        ewk->wu.old_routine_no[1] = 1;
        ewk->wu.my_sprite_sheet = 8;
        ewk->wu.my_trans_mode = get_my_trans_mode(ewk->wu.my_sprite_sheet);
    }

    return 0;
}
</file>

<file path="src/sf33rd/Source/Game/effect/effect_f6_move_data_table.c">
/**
 * @file efff6.c
 * Effect: Move / Data Table Effect
 */

#include "sf33rd/Source/Game/effect/effect_f6_move_data_table.h"
#include "bin2obj/char_table.h"
#include "common.h"
#include "sf33rd/Source/Game/debug/Debug.h"
#include "sf33rd/Source/Game/effect/effect.h"
#include "sf33rd/Source/Game/engine/charset.h"
#include "sf33rd/Source/Game/opening/opening.h"
#include "sf33rd/Source/Game/rendering/color_palette.h"
#include "sf33rd/Source/Game/rendering/texture_cache.h"
#include "sf33rd/Source/Game/stage/target_subroutines.h"

// forward decls
void efff6_move_common(State_Other* ewk);
void efff6_move01(State_Other* ewk);

void effect_F6_move(State_Other* ewk) {
    switch (ewk->wu.routine_no[0]) {
    case 0:
        if (ewk->wu.old_routine_no[1] <= op_w.index) {
            ewk->wu.routine_no[0] += 1;
        } else if (ewk->wu.old_routine_no[2] <= op_w.index) {
            if (ewk->wu.type == 0x1B) {
                efff6_move01(ewk);
            } else {
                efff6_move(ewk);
            }
        }
        break;
    default:
        Release_Effect(&ewk->wu);
        break;
    }
}

void efff6_move(State_Other* ewk) {
    switch (ewk->wu.routine_no[2]) {
    case 0:
        ewk->wu.routine_no[2] += 1;
        ewk->wu.disp_flag = 1;
        set_char_move_init2(&ewk->wu, 0, ewk->wu.old_routine_no[0], ewk->wu.char_index, 0);
        if (ewk->wu.mirror_scale.size.x == 0x3F) {
            ewk->wu.mirror_flag = 0;
        } else {
            ewk->wu.mirror_flag = 1;
        }
        if (ewk->wu.type == 0x36) {
            push_color_trans_req((ewk->wu.my_col_code & 0x1FF) + 0x3C, 8);
            push_color_trans_req((ewk->wu.my_col_code & 0x1FF) + 0x3D, 9);
            push_color_trans_req((ewk->wu.my_col_code & 0x1FF) + 0x3E, 10);
            ewk->wu.my_col_code = 8;
        } else {
            push_color_trans_req(ewk->wu.my_col_code & 0x1FF, 0);
            ewk->wu.my_col_code = 0;
        }
        /* fallthrough */
    case 1:
        efff6_move_common(ewk);
        disp_pos_trans_entry5(ewk);
        break;
    }
}

void efff6_move_common(State_Other* ewk) {
    s16 work;

    switch (ewk->wu.routine_no[3]) {
    case 0:
        switch (ewk->wu.direction) {
        case 0x20:
            add_x_sub(&ewk->wu);
            if (ewk->wu.xyz[0].disp.pos <= ewk->wu.old_routine_no[3]) {
                ewk->wu.routine_no[3] += 1;
                ewk->wu.xyz[0].disp.pos = ewk->wu.old_routine_no[3];
            }
            break;
        default:
            break;
        case 0x10:
            add_x_sub(&ewk->wu);
            if (ewk->wu.xyz[0].disp.pos >= ewk->wu.old_routine_no[3]) {
                ewk->wu.routine_no[3] += 1;
                ewk->wu.xyz[0].disp.pos = ewk->wu.old_routine_no[3];
            }
            break;
        case 0x200:
            add_y_sub(&ewk->wu);
            if (ewk->wu.xyz[1].disp.pos <= ewk->wu.old_routine_no[4]) {
                ewk->wu.routine_no[3] += 1;
                ewk->wu.xyz[1].disp.pos = ewk->wu.old_routine_no[4];
            }
