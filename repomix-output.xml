<file path="assets/ui/stage_config.rcss">
/* Stage config menu stylesheet — 3SXtra RmlUi overlay */

body {
    width: 100%;
    height: 100%;
    /* No background — let mouse events pass through to the game */
}

#config-panel {
    display: block;
    position: absolute;
    top: 2%;
    left: 2%;
    width: 50%;
    max-height: 92%;
    background-color: rgba(15, 15, 20, 242);
    border-width: 1dp;
    border-color: #444;
    border-radius: 6dp;
    padding: 6dp 8dp;
    overflow-y: auto;
}

/* Drag handle */
#config-panel handle {
    display: block;
    cursor: move;
    padding: 4dp 0;
    margin-bottom: 4dp;
}

#config-panel handle:hover {
    background-color: rgba(255, 255, 255, 10);
    border-radius: 4dp 4dp 0 0;
}

/* Title */
#config-panel h1 {
    font-size: 17dp;
    color: #ff9933;
    margin-bottom: 3dp;
    text-align: center;
    white-space: nowrap;
}

/* Section headers */
h2 {
    font-size: 12dp;
    color: #b0b0b0;
    margin-top: 2dp;
    margin-bottom: 2dp;
    text-transform: uppercase;
    letter-spacing: 1dp;
    white-space: nowrap;
}

/* Dividers */
.divider {
    display: block;
    height: 1dp;
    background-color: #333;
    margin-top: 3dp;
    margin-bottom: 3dp;
}

/* Stage info */
.stage-info {
    display: block;
    color: #cccccc;
    font-size: 12dp;
    margin-bottom: 3dp;
}

/* ─── Button row ─── */

.button-row {
    display: block;
    margin-bottom: 4dp;
}

button {
    display: inline-block;
    padding: 3dp 8dp;
    background-color: #2a2a30;
    border-width: 1dp;
    border-color: #888;
    border-radius: 3dp;
    color: #ddd;
    font-size: 13dp;
    cursor: pointer;
    margin-right: 4dp;
}

button:hover {
    background-color: #3a3a44;
    border-color: #ff9933;
}

button:active {
    background-color: #222;
}

.btn-danger {
    border-color: #a33;
    color: #f88;
}

.btn-danger:hover {
    background-color: #3a2020;
    border-color: #f44;
}

/* ─── Tab bar ─── */

.tab-bar {
    display: block;
    margin-bottom: 6dp;
}

.tab {
    display: inline-block;
    padding: 3dp 8dp;
    background-color: #1a1a20;
    border-width: 1dp;
    border-color: #333;
    border-radius: 3dp 3dp 0 0;
    color: #b0b0b0;
    font-size: 12dp;
    cursor: pointer;
    margin-right: 2dp;
}

.tab:hover {
    background-color: #2a2a30;
    color: #e0e0e0;
}

.tab.active {
    background-color: #2a2a30;
    border-color: #ff9933;
    border-bottom-color: #2a2a30;
    color: #ff9933;
}

/* ─── Layer panel ─── */

.layer-panel {
    display: block;
    background-color: rgba(42, 42, 48, 128);
    border-width: 1dp;
    border-color: #333;
    border-radius: 0 4dp 4dp 4dp;
    padding: 4dp 6dp;
}

/* Control rows */
.control-row {
    display: block;
    padding: 1dp 0;
}

label {
    font-size: 13dp;
    color: #e0e0e0;
}

/* Indent for sub-options */
.indent {
    display: block;
    margin-left: 10dp;
}

/* ─── Text input ─── */

input.text {
    display: block;
    width: 100%;
    padding: 4dp 8dp;
    background-color: #1a1a20;
    border-width: 1dp;
    border-color: #888;
    border-radius: 3dp;
    color: #fff;
    font-size: 13dp;
    margin-top: 2dp;
    box-sizing: border-box;
}

input.text:focus {
    border-color: #ff9933;
}

/* ─── Select ─── */

select {
    display: inline-block;
    padding: 4dp 8dp;
    background-color: #2a2a30;
    border-width: 1dp;
    border-color: #888;
    border-radius: 3dp;
    color: #ddd;
    font-size: 13dp;
    margin-left: 4dp;
}

select:hover {
    border-color: #ff9933;
}

select selectbox {
    background-color: #1a1a20;
    border-width: 1dp;
    border-color: #888;
}

select selectbox option {
    padding: 3dp 8dp;
}

select selectbox option:hover {
    background-color: #ff993344;
}

select selectbox option:checked {
    background-color: #ff993366;
    color: #fff;
}

/* ─── Range slider value display ─── */

.value-display {
    display: inline-block;
    font-size: 12dp;
    color: #ff9933;
    margin-left: 4dp;
    min-width: 30dp;
}

/* Status text */
.status-error {
    color: #ff4444;
    font-size: 13dp;
    display: block;
    text-align: center;
    padding: 8dp;
}

.status-hint {
    color: #666;
    font-size: 12dp;
    display: block;
    margin-left: 10dp;
}

.hint {
    font-size: 11dp;
    color: #888;
    margin-top: 3dp;
    text-align: center;
}

/* Scrollbar */
#config-panel scrollbarvertical {
    width: 8dp;
}

#config-panel scrollbarvertical sliderbar {
    background-color: #888;
    border-radius: 4dp;
}

#config-panel scrollbarvertical sliderbar:hover {
    background-color: #777;
}

#config-panel scrollbarvertical slidertrack {
    background-color: #222;
}
</file>

<file path="assets/ui/stage_config.rml">
<rml>
<head>
    <title>HD Stage Config</title>
    <link type="text/rcss" href="base.rcss"/>
    <link type="text/rcss" href="stage_config.rcss"/>
</head>
<body data-model="stage_config">
    <div id="config-panel">
        <handle move_target="config-panel">
            <h1>HD STAGE CONFIG (F6)</h1>
        </handle>
        <div class="divider"></div>

        <!-- No stage loaded -->
        <div data-if="!has_stage">
            <p class="status-error">No active HD stage loaded.</p>
        </div>

        <!-- Stage loaded -->
        <div data-if="has_stage">
            <p class="stage-info">Stage {{stage_idx}}</p>

            <!-- Action buttons -->
            <div class="button-row">
                <button data-event-click="save_config">Save</button>
                <button data-event-click="load_config">Reload</button>
                <button class="btn-danger" data-event-click="reset_config">Reset Defaults</button>
            </div>

            <div class="divider"></div>

            <!-- Layer tabs -->
            <div class="tab-bar">
                <div class="tab" data-class-active="selected_layer == 0"
                     data-event-click="select_tab(0)">Layer 0</div>
                <div class="tab" data-class-active="selected_layer == 1"
                     data-event-click="select_tab(1)">Layer 1</div>
                <div class="tab" data-class-active="selected_layer == 2"
                     data-event-click="select_tab(2)">Layer 2</div>
                <div class="tab" data-class-active="selected_layer == 3"
                     data-event-click="select_tab(3)">Layer 3</div>
            </div>

            <!-- Active layer properties -->
            <div class="layer-panel">
                <div class="control-row">
                    <input type="checkbox" data-checked="layer_enabled"/>
                    <label>Enabled</label>
                </div>

                <div class="control-row">
                    <label>Filename</label>
                    <input type="text" data-value="layer_filename"/>
                </div>

                <div class="control-row">
                    <label>Scale Mode</label>
                    <select data-value="layer_scale_mode">
                        <option value="0">Fit Height</option>
                        <option value="1">Stretch</option>
                        <option value="2">Native</option>
                        <option value="3">Manual</option>
                    </select>
                </div>

                <div data-if="is_manual_scale" class="indent">
                    <div class="control-row">
                        <label>Scale X</label>
                        <input type="range" min="0.1" max="10" step="0.01" data-value="layer_scale_x"/>
                        <span class="value-display">{{layer_scale_x}}</span>
                    </div>
                    <div class="control-row">
                        <label>Scale Y</label>
                        <input type="range" min="0.1" max="10" step="0.01" data-value="layer_scale_y"/>
                        <span class="value-display">{{layer_scale_y}}</span>
                    </div>
                </div>
                <p data-if="is_fit_height" class="status-hint">Scale auto-calculated from height.</p>

                <div class="divider"></div>

                <h2>Parallax</h2>
                <div class="control-row">
                    <label>Para X</label>
                    <input type="range" min="0" max="2" step="0.01" data-value="layer_parallax_x"/>
                    <span class="value-display">{{layer_parallax_x}}</span>
                </div>
                <div class="control-row">
                    <label>Para Y</label>
                    <input type="range" min="0" max="2" step="0.01" data-value="layer_parallax_y"/>
                    <span class="value-display">{{layer_parallax_y}}</span>
                </div>

                <div class="control-row">
                    <label>Original Layer ID</label>
                    <input type="range" min="-1" max="7" step="1" data-value="layer_bg_index"/>
                    <span class="value-display">{{layer_bg_index}}</span>
                </div>

                <div class="divider"></div>

                <h2>Position</h2>
                <div class="control-row">
                    <label>Offset X</label>
                    <input type="range" min="-1000" max="1000" step="1" data-value="layer_offset_x"/>
                    <span class="value-display">{{layer_offset_x}}</span>
                </div>
                <div class="control-row">
                    <label>Offset Y</label>
                    <input type="range" min="-1000" max="1000" step="1" data-value="layer_offset_y"/>
                    <span class="value-display">{{layer_offset_y}}</span>
                </div>

                <div class="divider"></div>

                <div class="control-row">
                    <label>Z-Index</label>
                    <input type="range" min="-10" max="10" step="1" data-value="layer_z_index"/>
                    <span class="value-display">{{layer_z_index}}</span>
                </div>
            </div>
        </div>

        <div class="divider"></div>
        <p class="hint">Press F6 to close</p>
    </div>
</body>
</rml>
</file>

<file path="assets/ui/sysdir.rcss">
/* ─── System Direction / Dipswitch Menu ─────────────────────────── */
/* Game canvas: 384×224dp. Budget every pixel carefully.            */
/* Inherits: base.rcss → menu_shared.rcss → this                   */

/* Panel uses .menu-panel from menu_shared.rcss.
 * The subpage needs more width, so override when in subpage mode. */

#nav-section {
    display: block;
}

/* ── Wide panel for sub-page mode (centered, full-width) ────── */
#sysdir-panel.wide {
    width: 280dp;
    left: 52dp;
}

.wide .toggle-label {
    width: 180dp;
}

.wide .toggle-value {
    width: 60dp;
}

/* ── Inline direction number value ─────────────────────────────── */
.nav-value {
    display: inline;
    color: rgba(140, 200, 255, 230);
    font-size: 13dp;
    margin-left: 4dp;
}

/* ─── Sub-page section ──────────────────────────────────────────── */

#subpage-section {
    display: block;
}

.page-indicator {
    display: block;
    text-align: center;
    font-size: 12dp;
    color: rgba(140, 170, 220, 178);
    margin-bottom: 2dp;
    padding-bottom: 2dp;
    border-bottom-width: 1dp;
    border-bottom-color: rgba(100, 120, 180, 64);
}

/* ─── Toggle rows ───────────────────────────────────────────────── */

.toggle-row {
    display: block;
    padding: 2dp 4dp;
    color: rgba(200, 210, 240, 217);
    font-size: 14dp;
    border-left-width: 2dp;
    border-left-color: transparent;
    transition: background-color border-left-color 0.08s linear-in-out;
}

.toggle-row.focused {
    background-color: rgba(255, 220, 0, 31);
    border-left-color: rgba(255, 210, 40, 242);
    color: #fff;
}

.toggle-label {
    display: inline-block;
    width: 100dp;
    font-size: 13dp;
}

.toggle-value {
    display: inline-block;
    text-align: right;
    width: 40dp;
    color: rgba(100, 220, 160, 242);
    font-size: 14dp;
}

.toggle-row.focused .toggle-value {
    color: rgba(120, 255, 180, 255);
}

/* ─── Nav row (◀ / EXIT / ▶) ─────────────────────────────────── */

.nav-row {
    margin-top: 2dp;
    border-top-width: 1dp;
    border-top-color: rgba(100, 120, 180, 51);
    padding-top: 2dp;
    text-align: center;
}

.nav-row .toggle-label {
    display: none;
}

.nav-row .toggle-value {
    width: auto;
    text-align: center;
}

.nav-arrow {
    text-align: center;
    width: 80dp;
    color: rgba(180, 200, 255, 230);
}

.nav-row.focused .nav-arrow {
    color: rgba(255, 220, 80, 255);
}

/* ─── Description area ──────────────────────────────────────────── */

.desc-area {
    display: block;
    margin-top: 4dp;
    padding: 3dp 6dp;
    background-color: rgba(0, 0, 0, 80);
    min-height: 18dp;
}

.desc-text {
    display: block;
    font-size: 12dp;
    color: rgba(180, 190, 220, 217);
    line-height: 1.2;
}
</file>

