static void quad_infer_positions(SWQuad* quad) {
    float dx = quad->positions[3].x - quad->positions[0].x;
    float dy = quad->positions[3].y - quad->positions[0].y;
    quad->positions[1].x = quad->positions[0].x + dx;
    quad->positions[1].y = quad->positions[0].y;
    quad->positions[2].x = quad->positions[0].x;
    quad->positions[2].y = quad->positions[0].y + dy;
}

static void quad_infer_tex_coords(SWQuad* quad) {
    float ds = quad->tex_coords[3].s - quad->tex_coords[0].s;
    float dt = quad->tex_coords[3].t - quad->tex_coords[0].t;
    quad->tex_coords[1].s = quad->tex_coords[0].s + ds;
    quad->tex_coords[1].t = quad->tex_coords[0].t;
    quad->tex_coords[2].s = quad->tex_coords[0].s;
    quad->tex_coords[2].t = quad->tex_coords[0].t + dt;
}

static uint32_t float_to_sortable_u32(float f) {
    union {
        float f;
        uint32_t u;
    } u;
    u.f = f;
    if ((u.u & 0x80000000u) != 0) {
        return ~u.u;
    }
    return u.u | 0x80000000u;
}

