<file path="assets/ui/netplay.rcss">
/* Netplay overlay — HUD, diagnostics, toasts */

/* ═══ Mini-HUD ═══ */
#netplay-hud {
    display: block;
    position: absolute;
    top: 1%;
    right: 1%;
    padding: 3dp 6dp;
    background-color: rgba(0, 0, 0, 89);
    border-radius: 3dp;
}

.hud-text {
    font-size: 13dp;
    font-weight: bold;
    color: #ffffff;
}
.hud-text.ok {
    color: #ffffff;
}
.hud-text.warn {
    color: #ffe633;
}
.hud-text.error {
    color: #ff3333;
}

/* ═══ Diagnostics Panel ═══ */
#diag-panel {
    display: block;
    position: absolute;
    top: 2%;
    left: 2%;
    width: 50%;
    max-height: 90%;
    overflow-y: auto;
    padding: 6dp;
    background-color: rgba(15, 15, 20, 235);
    border-width: 1dp;
    border-color: #333;
    border-radius: 6dp;
}

#diag-panel h2 {
    font-size: 13dp;
    color: #e0e0e0;
    margin-bottom: 4dp;
    border-bottom-width: 1dp;
    border-bottom-color: #444;
    padding-bottom: 2dp;
}

.diag-section {
    display: block;
    margin-bottom: 4dp;
}

.diag-separator {
    display: block;
    height: 1dp;
    background-color: #444;
    margin-top: 4dp;
    margin-bottom: 4dp;
}

/* FPS text with color coding */
.fps-text {
    font-size: 13dp;
    font-weight: bold;
}
.fps-text.ok {
    color: #33ff66;
}
.fps-text.warn {
    color: #ffe633;
}
.fps-text.error {
    color: #ff4c4c;
}

/* Stats line (below charts) — mean, median, duration, frame count */
.diag-stats {
    display: block;
    font-size: 14dp;
    color: rgba(255, 255, 255, 128);
    margin-top: 4dp;
}

/* Stat lines (ping, rollback, delay, duration) */
.stat-line {
    display: block;
    font-size: 12dp;
    color: #dddddd;
    padding: 1dp 0dp;
}

/* Chart label */
.chart-label {
    display: block;
    font-size: 14dp;
    color: rgba(255, 255, 255, 153);
    margin-top: 6dp;
    margin-bottom: 2dp;
}

/* ═══ Line Charts (1px-wide bar strips) ═══ */
.line-chart {
    display: block;
    height: 40dp;
    white-space: nowrap;
    background-color: rgba(0, 0, 0, 76);
    border-radius: 2dp;
    padding: 2dp;
}

/* Each bar is a 3px-wide strip — creates a smooth line chart effect */
.line-bar {
    display: inline-block;
    width: 2dp;
    height: 36dp;
    vertical-align: bottom;
    position: relative;
}

.line-fill {
    display: block;
    position: absolute;
    bottom: 0dp;
    left: 0dp;
    width: 100%;
    border-radius: 1dp;
}

/* FPS line color — blue */
.fps-bar .line-fill {
    background-color: rgba(50, 180, 255, 204);
}

/* Ping line color — yellow */
.ping-bar .line-fill {
    background-color: rgba(255, 200, 50, 204);
}

/* Rollback line color — red */
.rb-bar .line-fill {
    background-color: rgba(255, 100, 100, 204);
}

/* Net section */
.net-section {
    display: block;
}

/* ═══ Toast Notifications ═══ */
#toast-container {
    display: block;
    position: absolute;
    top: 5%;
    left: 50%;
    margin-left: -20%;
    width: 40%;
}

.toast-item {
    display: block;
    text-align: center;
    padding: 4dp 8dp;
    margin-bottom: 3dp;
    background-color: rgba(0, 0, 0, 178);
    border-radius: 3dp;
    font-size: 13dp;
    color: #ffffff;
}
</file>

<file path="assets/ui/netplay.rml">
<rml>
<head>
    <title>Netplay</title>
    <link type="text/rcss" href="base.rcss"/>
    <link type="text/rcss" href="netplay.rcss"/>
</head>
<body data-model="netplay">
    <!-- ═══ Mini-HUD: top-right ping/rollback badge ═══ -->
    <div id="netplay-hud" data-if="hud_visible">
        <span data-class-ok="hud_color_class == 'ok'"
              data-class-warn="hud_color_class == 'warn'"
              data-class-error="hud_color_class == 'error'"
              class="hud-text">{{ hud_text }}</span>
    </div>

    <!-- ═══ Diagnostics panel [F10] ═══ -->
    <div id="diag-panel" data-if="diag_visible" class="panel">
        <h2>Diagnostics [F10]</h2>

        <!-- FPS Section -->
        <div class="diag-section">
            <span data-class-ok="fps_color_class == 'ok'"
                  data-class-warn="fps_color_class == 'warn'"
                  data-class-error="fps_color_class == 'error'"
                  class="fps-text">{{ fps_text }}</span>

            <!-- FPS line chart (1px-wide bars) -->
            <div class="line-chart">
                <div data-for="bar : fps_bars" class="line-bar fps-bar">
                    <div class="line-fill" data-style-height="bar.height_pct"></div>
                </div>
            </div>

            <div class="diag-stats">{{ fps_stats }}</div>
        </div>

        <!-- Netplay Section -->
        <div data-if="net_session_active" class="diag-section net-section">
            <div class="diag-separator"></div>
            <div class="stat-line">{{ net_ping }}</div>
            <div class="stat-line">{{ net_rollback }}</div>
            <div class="stat-line">{{ net_delay }}</div>
            <div class="stat-line">{{ net_duration }}</div>

            <div class="diag-separator"></div>

            <!-- Ping history line chart -->
            <div class="chart-label">Ping History</div>
            <div class="line-chart">
                <div data-for="bar : ping_bars" class="line-bar ping-bar">
                    <div class="line-fill" data-style-height="bar.height_pct"></div>
                </div>
            </div>

            <!-- Rollback history line chart -->
            <div class="chart-label">Rollback History</div>
            <div class="line-chart">
                <div data-for="bar : rb_bars" class="line-bar rb-bar">
                    <div class="line-fill" data-style-height="bar.height_pct"></div>
                </div>
            </div>
        </div>
    </div>

    <!-- ═══ Toast notifications ═══ -->
    <div id="toast-container">
        <div data-for="toast : toasts" class="toast-item">
            {{ toast.message }}
        </div>
    </div>
</body>
</rml>
</file>

<file path="assets/ui/network_replay_picker.rcss">
/* ─── Network Replay Picker ─────────────────────────────────── */
/* 384×224 game canvas — strict dp metrics                       */
/* Modeled after replay_picker.rcss — full-screen dark panel     */

#nrp-panel {
    display: block;
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 0;
    overflow: hidden;
    background-color: rgba(6, 8, 18, 220);
    border-width: 1dp;
    border-color: rgba(80, 110, 200, 80);
}

/* ── Title bar ── */
#nrp-title-bar {
    display: block;
    height: 16dp;
    padding: 3dp 8dp 1dp 8dp;
    border-top-width: 1dp;
    border-top-color: rgba(255, 255, 255, 200);
    border-bottom-width: 1dp;
    border-bottom-color: rgba(255, 255, 255, 200);
    text-align: center;
}
#nrp-title {
    display: block;
    font-size: 14dp;
    color: #fff;
    font-weight: bold;
    font-effect: shadow(1dp 1dp rgba(0, 0, 0, 120));
    background-color: transparent;
}

/* ── Loading / Error / Downloading states ── */
#nrp-loading, #nrp-error, #nrp-downloading {
    display: block;
    position: absolute;
    top: 36dp;
    left: 1dp;
    right: 1dp;
    bottom: 44dp;
    text-align: center;
    padding: 50dp 0;
    font-size: 12dp;
    color: rgba(180, 190, 220, 200);
}
#nrp-error {
    color: rgba(255, 120, 100, 200);
}
#nrp-downloading {
    color: rgba(100, 220, 180, 200);
}

/* ── Table area ── */
#nrp-table {
    display: block;
    position: absolute;
    top: 23dp;
    left: 1dp;
    right: 1dp;
    bottom: 22dp;
    padding: 2dp 2dp;
    background-color: rgba(0, 6, 28, 180);
    border-width: 1dp;
    border-color: rgba(80, 120, 220, 70);
    overflow: hidden;
}

/* ── Header row ── */
.nrp-header-row {
    display: block;
    font-size: 10dp;
    color: rgba(140, 170, 230, 200);
    padding: 2dp 0dp;
    margin-bottom: 1dp;
    border-bottom-width: 1dp;
    border-bottom-color: rgba(100, 130, 220, 80);
    white-space: nowrap;
}

/* ── Slot rows ── */
.nrp-row {
    display: block;
    color: rgba(190, 200, 225, 180);
    font-size: 11dp;
    padding: 2dp 0dp;
    margin-bottom: 1dp;
    border-left-width: 2dp;
    border-left-color: transparent;
    white-space: nowrap;
}

.nrp-row.hidden {
    display: none;
}

.nrp-row.selected {
    color: rgba(255, 255, 255, 255);
    background-color: rgba(100, 220, 120, 30);
    border-left-color: rgba(100, 220, 120, 230);
}

/* ── Column widths ── */
.nrp-col-num {
    display: inline-block;
    width: 24dp;
    text-align: center;
    color: rgba(100, 220, 120, 200);
    font-size: 11dp;
    font-weight: bold;
}

.nrp-row.selected .nrp-col-num {
    color: rgba(140, 255, 160, 255);
}

.nrp-col-p1 {
    display: inline-block;
    width: 80dp;
    text-align: right;
    padding-right: 4dp;
}

.nrp-col-vs {
    display: inline-block;
    width: 20dp;
    text-align: center;
    font-size: 9dp;
    color: rgba(140, 150, 170, 140);
}

.nrp-col-p2 {
    display: inline-block;
    width: 80dp;
    text-align: left;
    padding-left: 4dp;
}

.nrp-col-p1.winner, .nrp-col-p2.winner {
    color: rgba(255, 210, 70, 255);
    font-weight: bold;
}

.player-flag {
    display: inline;
    width: 10dp;
    height: 7dp;
    margin-right: 2dp;
    margin-left: 2dp;
    vertical-align: middle;
}

.nrp-col-char {
    display: inline-block;
    width: 70dp;
    text-align: center;
    font-size: 9dp;
    color: rgba(200, 180, 100, 180);
}

.nrp-col-date {
    display: inline-block;
    width: 100dp;
    text-align: center;
    font-size: 10dp;
    color: rgba(140, 170, 210, 160);
}

/* ── Empty state ── */
#nrp-empty {
    display: block;
    position: absolute;
    top: 36dp;
    left: 1dp;
    right: 1dp;
    bottom: 44dp;
    text-align: center;
    padding: 40dp 0;
    font-size: 11dp;
    color: rgba(140, 150, 180, 120);
}

/* ── Footer ── */
#nrp-footer {
    display: block;
    position: absolute;
    bottom: 1dp;
    left: 1dp;
    right: 1dp;
    padding: 1dp 4dp;
    background-color: rgba(0, 8, 30, 160);
    border-width: 1dp;
    border-color: rgba(80, 120, 220, 50);
}
.nrp-control-row {
    display: block;
    padding: 2dp 4dp;
    margin: 1dp 0;
    text-align: center;
    border-left-width: 2dp;
    border-left-color: transparent;
    color: rgba(140, 160, 200, 150);
    font-size: 11dp;
}
.nrp-control-row.active {
    color: rgba(255, 255, 255, 255);
    background-color: rgba(100, 220, 120, 30);
    border-left-color: rgba(100, 220, 120, 230);
}
.nrp-ctl-arrow {
    display: inline;
    font-size: 11dp;
    color: rgba(120, 140, 180, 120);
    margin: 0 6dp;
}
.nrp-control-row.active .nrp-ctl-arrow {
    color: rgba(255, 210, 70, 240);
}
.nrp-ctl-label {
    display: inline;
    font-size: 11dp;
}
</file>

<file path="assets/ui/network_replay_picker.rml">
<rml>
<head>
    <link type="text/rcss" href="base.rcss"/>
    <link type="text/rcss" href="network_replay_picker.rcss"/>
    <title>Network Replay Picker</title>
</head>
<body data-model="network_replay_picker">
<div id="nrp-panel" data-if="nrp_open">

    <!-- Title bar -->
    <div id="nrp-title-bar">
        <span id="nrp-title">ONLINE REPLAYS</span>
    </div>

    <!-- Loading state -->
    <div id="nrp-loading" data-if="nrp_loading">
        <span>Fetching replays...</span>
    </div>

    <!-- Error state -->
    <div id="nrp-error" data-if="nrp_error != ''">
        <span>{{nrp_error}}</span>
    </div>

    <!-- Download state -->
    <div id="nrp-downloading" data-if="nrp_downloading">
        <span>Downloading replay...</span>
    </div>

    <!-- Table header -->
    <div id="nrp-table" data-if="!nrp_loading && nrp_error == '' && !nrp_downloading">
        <div class="nrp-header-row">
            <span class="nrp-col-num">#</span>
            <span class="nrp-col-p1">P1</span>
            <span class="nrp-col-vs"></span>
            <span class="nrp-col-p2">P2</span>
            <span class="nrp-col-char">MATCHUP</span>
            <span class="nrp-col-date">DATE</span>
        </div>

        <!-- Slot rows -->
        <div data-for="slot : nrp_slots"
             class="nrp-row"
             data-class-hidden="!slot.is_valid"
             data-class-selected="slot.index == nrp_cursor">
            <span class="nrp-col-num">{{slot.display_num}}</span>
            <span class="nrp-col-p1" data-class-winner="slot.winner_id == slot.p1_name">
                {{slot.p1_name}}
                <img data-if="slot.p1_country != ''" data-attr-src="'../flags_icons/' + slot.p1_country + '.png'" class="player-flag"/>
            </span>
            <span class="nrp-col-vs">vs</span>
            <span class="nrp-col-p2" data-class-winner="slot.winner_id == slot.p2_name">
                <img data-if="slot.p2_country != ''" data-attr-src="'../flags_icons/' + slot.p2_country + '.png'" class="player-flag"/>
                {{slot.p2_name}}
            </span>
            <span class="nrp-col-char">{{slot.p1_char_name}} vs {{slot.p2_char_name}}</span>
            <span class="nrp-col-date">{{slot.date_str}}</span>
        </div>
    </div>

    <!-- Empty state -->
    <div id="nrp-empty" data-if="!nrp_loading &amp;&amp; nrp_error == '' &amp;&amp; nrp_slot_count == 0 &amp;&amp; !nrp_downloading">
        <span>No online replays found.</span>
    </div>

    <!-- Footer -->
    <div id="nrp-footer" data-if="!nrp_loading &amp;&amp; !nrp_downloading">
        <div class="nrp-control-row" data-class-active="nrp_zone == 1">
            <span class="nrp-ctl-arrow" data-if="nrp_has_prev">◀</span>
            <span class="nrp-ctl-label">PAGE {{nrp_page}} / {{nrp_total_pages}}</span>
            <span class="nrp-ctl-arrow" data-if="nrp_has_next">▶</span>
        </div>
    </div>

</div>
</body>
</rml>
</file>

