static void Win_09000(PlayerEntity* wk) {
    s16 work;

    g_state.bg_app_stop = 1;

    switch (wk->wu.routine_no[3]) {
    case 0:
        g_state.win_rno[0] = g_state.win_rno[1] = 0;
        wk->wu.routine_no[3]++;
        work = win_select(wk, 7);

        if (work == 7) {
            set_char_move_init(&wk->wu, 9, 32);
