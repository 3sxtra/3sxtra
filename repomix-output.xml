        disp_pos_trans_entry(ewk);
        break;

    case 3:
        if (!g_state.execute_flag && !g_state.Game_pause) {
            char_move(&ewk->wu);

            if (oya_ptr->script_register_bank[0] == 2) {
                ewk->wu.routine_no[1]++;
            }
        }

        jijii_win_tama_sub(ewk);
        disp_pos_trans_entry(ewk);
        break;

    case 4:
        if (!g_state.execute_flag && !g_state.Game_pause) {
            char_move(&ewk->wu);
        }

        ewk->wu.xyz[1].disp.pos = oya_ptr->position_y + g_state.base_y_pos;
        ewk->wu.xyz[1].disp.pos -= 42;
        jijii_win_tama_sub(ewk);
        disp_pos_trans_entry(ewk);
        break;

    default:
        Release_Effect(&ewk->wu);
        break;
    }
}

static void jijii_win_tama_sub(State_Other* ewk) {
    State* oya_ptr = (State*)ewk->my_master;

    ewk->wu.old_routine_no[0] ^= 1;

    if (ewk->wu.old_routine_no[0]) {
        ewk->wu.position_z = oya_ptr->position_z - 2;
        return;
    }

    ewk->wu.position_z = oya_ptr->position_z + 2;
}

static void eff09_27000(State_Other* ewk) {
    switch (ewk->wu.routine_no[1]) {
    case 0:
        ewk->wu.routine_no[1]++;
        ewk->wu.disp_flag = 1;
        ewk->wu.death_timer = 1;
        ewk->wu.shadow_flag = 1;
        ewk->wu.shadow_x = -8;
        ewk->wu.shadow_y = -11;
        ewk->wu.shadow_prio = 71;
        ewk->wu.shadow_char = 8;
        ewk->wu.mvxy.a[0].sp = -0x80000;
        ewk->wu.mvxy.d[0].sp = 0;
        ewk->wu.mvxy.a[1].sp = 0;
        ewk->wu.mvxy.d[1].sp = -0x6000;

        if (ewk->wu.facing_flag) {
            ewk->wu.mvxy.a[0].sp = -ewk->wu.mvxy.a[0].sp;
        }

        set_char_move_init(&ewk->wu, 0, ewk->wu.char_index);
        break;

    case 1:
        if (!g_state.execute_flag && !g_state.Game_pause) {
            add_x_sub(&ewk->wu);
            add_y_sub(&ewk->wu);

            if (ewk->wu.xyz[1].disp.pos < -8) {
                ewk->wu.routine_no[1]++;
                ewk->wu.xyz[1].cal = -0x80000;
                ewk->wu.mvxy.a[0].sp = -0x38000;
                ewk->wu.mvxy.d[0].sp = 0;

                if (ewk->wu.facing_flag) {
                    ewk->wu.mvxy.a[0].sp = -ewk->wu.mvxy.a[0].sp;
                }

                set_char_move_init2(&ewk->wu, 0, 107, 2, 0);
            }
        }

        pl_eff_trans_entry(ewk);
        break;

    case 2:
        if (!g_state.execute_flag && !g_state.Game_pause) {
            char_move(&ewk->wu);
            add_x_sub(&ewk->wu);

            if (range_x_check3(ewk, 36) == 0) {
                ewk->wu.routine_no[1]++;
                ewk->wu.disp_flag = 0;
            }
        }

        pl_eff_trans_entry(ewk);
        break;

    default:
        Release_Effect(&ewk->wu);
        break;
    }
}

s32 effect_09_init(State* wk, u8 data) {
    State_Other* ewk;
    s16 ix;
    const s16* data_ptr;

    if ((ix = Acquire_Effect(4)) == -1) {
        return -1;
    }

    ewk = (State_Other*)frw[ix];
    ewk->wu.type = data;
    data_ptr = eff09_data[ewk->wu.type];
    ewk->wu.active_flag = 1;
    ewk->wu.id = 9;
    ewk->wu.work_id = 16;
    ewk->master_id = wk->id;
    ewk->wu.my_priority = 64;
    ewk->wu.graphic_rom_type = 1;
    ewk->wu.facing_flag = 0;
    ewk->wu.my_col_mode = 0x4200;
    ewk->wu.char_table[0] = _eff09_char_table;
    ewk->wu.routine_no[0] = *data_ptr++;
    ewk->wu.my_family = *data_ptr++;
    ewk->wu.my_col_code = *data_ptr++;
    ewk->wu.xyz[0].disp.pos = *data_ptr++;
    ewk->wu.xyz[1].disp.pos = *data_ptr++;
    ewk->wu.my_priority = ewk->wu.position_z = *data_ptr++;
    ;
    ewk->wu.char_index = *data_ptr++;
    ewk->wu.hit_stop = *data_ptr++;
    ewk->wu.sync_bg_strip = *data_ptr++;
    suzi_offset_set(ewk);
    ewk->wu.my_sprite_sheet = 14;
    ewk->wu.my_trans_mode = get_my_trans_mode(ewk->wu.my_sprite_sheet);
    return 0;
}

s32 effect_09_init2(State* wk, u8 data) {
    State_Other* ewk;
    s16 ix;
    const s16* data_ptr;

    if (data == 0x1F && g_state.bg_w.stage == 0xA) {
        return 0;
    }

    if (g_state.test_flag && data >= 32 && data < 41) {
        return 0;
    }

    if ((ix = Acquire_Effect(4)) == -1) {
        return -1;
    }

    ewk = (State_Other*)frw[ix];
    ewk->wu.type = data;
    ewk->my_master = wk;
    ewk->wu.target_adrs = wk->target_adrs;
    ewk->wu.active_flag = 1;
    ewk->wu.id = 9;
    ewk->wu.work_id = 16;
    ewk->master_id = wk->id;
    ewk->wu.graphic_rom_type = 1;
    *ewk->wu.char_table = _etc_char_table;
    ewk->wu.my_col_mode = wk->my_col_mode;
    data_ptr = eff09_data2[ewk->wu.type];
    ewk->wu.routine_no[0] = *data_ptr++;
    ewk->wu.my_sprite_sheet = 14;

    switch (data) {
    case 18:
    case 19:
    case 31:
        ewk->wu.my_col_code = 0x2020;
        data_ptr++;
        break;

    case 24:
    case 25:
    case 26:
    case 27:
        ewk->wu.my_col_code = 0x3E;
        data_ptr++;
        break;

    case 32:
        ewk->wu.my_col_code = 0x4F;
        data_ptr++;
        break;

    case 33:
        ewk->wu.my_col_code = 0x50;
        data_ptr++;
        ewk->wu.my_sprite_sheet = 7;
        break;

    case 34:
        push_color_trans_req(0x51, 0xA);
        /* fallthrough */

    case 35:
    case 38:
    case 39:
    case 40:
        ewk->wu.my_col_code = 0xA;
        data_ptr++;
        ewk->wu.my_sprite_sheet = 0x10;
        break;

    case 41:
        ewk->wu.my_col_code = *data_ptr++;
        ewk->wu.my_col_code += wk->my_col_code;
        ewk->wu.mirror_flag = 1;
        ewk->wu.mirror_scale.size.x = 127;
        ewk->wu.mirror_scale.size.y = 127;
        break;

    default:
        ewk->wu.my_col_code = *data_ptr++;
        ewk->wu.my_col_code += wk->my_col_code;
        break;
    }

    ewk->wu.my_family = wk->my_family;

    if (data == 4) {
        ewk->wu.facing_flag = 0;
    } else {
        ewk->wu.facing_flag = wk->facing_flag;
    }

    ewk->wu.xyz[0].disp.pos = wk->xyz[0].disp.pos;

    if (wk->facing_flag) {
        ewk->wu.xyz[0].disp.pos -= *(s16*)data_ptr++;
    } else {
        ewk->wu.xyz[0].disp.pos += *(s16*)data_ptr++;
    }

    ewk->wu.xyz[1].disp.pos = *data_ptr++;
    ewk->wu.xyz[1].disp.pos += wk->xyz[1].disp.pos;
    ewk->wu.my_priority = wk->my_priority;
    ewk->wu.my_priority += *(s16*)data_ptr++;
    ewk->wu.position_z = ewk->wu.my_priority;
    ewk->wu.char_index = *data_ptr++;
    ewk->wu.hit_stop = *data_ptr++;
    ewk->wu.sync_bg_strip = *data_ptr++;
    suzi_offset_set(ewk);
    ewk->wu.my_trans_mode = get_my_trans_mode(ewk->wu.my_sprite_sheet);
    return 0;
}

void (*eff09_tbl[28])(State_Other*) = { eff09_0000,  eff09_1000,  eff09_2000,  eff09_3000,  eff09_4000,  eff09_5000,
