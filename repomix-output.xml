 * Effect: Debug / Visual Effect
 */

#include "sf33rd/Source/Game/effect/effect_90_debug_visual.h"
#include "game_state.h"
#include "common.h"
#include "sf33rd/Source/Game/debug/Debug.h"
#include "sf33rd/Source/Game/effect/effect.h"
#include "sf33rd/Source/Game/engine/state_user.h"
#include "sf33rd/Source/Game/rendering/sprite_utilities.h"
#include "sf33rd/Source/Game/stage/bg.h"

static s32 Check_Disp_90(EffectMultiSprite* ewk);
static s16 Check_Disp_Pos_90(EffectMultiSprite* ewk);

void effect_90_move(EffectMultiSprite* ewk) {
    Check_Pos_OBJ2((State_Other*)ewk);

    if (g_state.Menu_Suicide[ewk->master_player]) {
        Release_Effect(&ewk->wu);
        return;
    }

    if (ewk->master_priority == 0xFF) {
        ewk->wu.my_clear_level = 0;
    } else if (g_state.Menu_Cursor_Y[1] == ewk->master_priority) {
        ewk->wu.my_clear_level = 0;
    } else {
        ewk->wu.my_clear_level = 0x80;
    }

    ewk->wu.disp_flag = Check_Disp_90(ewk);
    ewk->wu.position_y = Check_Disp_Pos_90(ewk);
    sort_push_request3(&ewk->wu);
}

static s32 Check_Disp_90(EffectMultiSprite* ewk) {
    if (ewk->wu.dir_step == 2 || ewk->wu.dir_step == 6) {
        return 1;
    }

    if (ewk->master_priority < g_state.Cursor_Limit[0]) {
        return 0;
    }

    if (ewk->master_priority > g_state.Cursor_Limit[0] + 3) {
        return 0;
    }

    return 1;
}

static s16 Check_Disp_Pos_90(EffectMultiSprite* ewk) {
    s16 y;

    if (ewk->wu.dir_step == 2 || ewk->wu.dir_step == 6) {
        return ewk->wu.position_y;
    }

    y = (g_state.bg_w.bgw[ewk->wu.my_family - 1].wxy[1].disp.pos + 158) - (ewk->master_priority * 20);
    y += g_state.Cursor_Limit[0] * 20;

    return y;
}
