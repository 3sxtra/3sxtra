    }

    asstbl = _asstbl_lv_0000[pnum][kos];

    if ((lwork = asstbl[0] & 0x7FF)) {
        nrange = lwork;
    } else {
        if ((lwork = asstbl[1] & 0x7FF)) {
            nrange = lwork;
        }
    }

    return nrange;
}

/** @brief Selects the appropriate move from the command input. */
s32 move_select(PlayerEntity* wk, s16 kos, s16 sf) {
    const u16* wst;

    switch (sf) {
    case 0:
        wst = _asstbl_lv_0000[wk->player_number][kos];
        break;

    case 1:
        wst = _asstbl_lv_1000[wk->player_number][kos];
        break;

    case 2:
        wst = _asstbl_lv_2000[wk->player_number][kos];
        break;

    case 3:
        wst = _asstbl_lv_3000[wk->player_number][kos];
        break;

    case 4:
        wst = _asstbl_lv_4000[wk->player_number][kos];
        break;

    case 5:
        wst = _asstbl_lv_2000[wk->player_number][kos];
        break;

    case 6:
        wst = _asstbl_lv_3000[wk->player_number][kos];
        break;

    case 7:
        wst = _asstbl_lv_4000[wk->player_number][kos];
        break;

    case 8:
        wst = _asstbl_lv_2000[wk->player_number][kos];
        break;

    case 9:
        wst = _asstbl_lv_3000[wk->player_number][kos];
        break;

    case 10:
        wst = _asstbl_lv_4000[wk->player_number][kos];
        break;

    default:
        return 0;
    }

    if (decode_wst_data(wk, wst[0], wst[1])) {
        return 2;
    }

    if (decode_wst_data(wk, wst[1], wst[1])) {
        return 1;
    }

    return 0;
}

/** @brief Decodes move select table data into actual move parameters. */
u16 decode_wst_data(PlayerEntity* wk, u16 cmd, s16 cmd_ex) {
    u16 lever;
    u16 rnum;

    if (cmd == 0) {
        return 0;
    }

    rnum = 0;
    lever = cmd & 0xF;

    switch (cmd & 0xF000) {
    case 0x4000:
        rnum = wk->cp->input_pressed & lever;
        break;

    case 0x8000:
        rnum = (lever == (wk->cp->input_pressed & 0xF));
        break;

    case 0x3000:
        rnum = cmd_ex_check(wk->wu.xyz[1].disp.pos, cmd_ex);
        break;

    case 0x7000:
        if ((wk->cp->input_pressed & lever) && (cmd_ex_check(wk->wu.xyz[1].disp.pos, cmd_ex))) {
            rnum = 1;
        }

        break;

    case 0xB000:
        if ((lever == (wk->cp->input_pressed & 0xF)) && (cmd_ex_check(wk->wu.xyz[1].disp.pos, cmd_ex))) {
            rnum = 1;
        }

        break;

    case 0x2000:
        if ((wk->wu.mvxy.a[1].sp > 0) && (cmd_ex_check(wk->wu.xyz[1].disp.pos, cmd_ex))) {
            rnum = 1;
        }

        break;

    case 0x1000:
        if ((wk->wu.mvxy.a[1].sp <= 0) && (cmd_ex_check(wk->wu.xyz[1].disp.pos, cmd_ex))) {
            rnum = 1;
        }

        break;

    case 0xA000:
        if ((wk->wu.mvxy.a[1].sp > 0) && (lever == (wk->cp->input_pressed & 0xF)) &&
            (cmd_ex_check(wk->wu.xyz[1].disp.pos, cmd_ex))) {
            rnum = 1;
        }

        break;

    case 0x9000:
        if ((wk->wu.mvxy.a[1].sp <= 0) && (lever == (wk->cp->input_pressed & 0xF)) &&
            (cmd_ex_check(wk->wu.xyz[1].disp.pos, cmd_ex))) {
            rnum = 1;
        }

        break;

    case 0x6000:
        if ((wk->wu.mvxy.a[1].sp > 0) && (cmd_ex_check(wk->wu.xyz[1].disp.pos, cmd_ex))) {
            rnum = wk->cp->input_pressed & lever;
        }

        break;

    case 0x5000:
        if ((wk->wu.mvxy.a[1].sp <= 0) && (cmd_ex_check(wk->wu.xyz[1].disp.pos, cmd_ex))) {
            rnum = wk->cp->input_pressed & lever;
        }

        break;

    default:
        if (get_em_body_range(&wk->wu) >= cmd) {
            rnum = 1;
        }

        break;
    }

    return rnum;
}

/** @brief Returns the enemy body collision range. */
s16 get_em_body_range(State* wk) {
    State* em;
    s16* dad;
    s16 res_hs;

    if (g_state.Bonus_Game_Flag == 20 && wk->pl_operator != 0) {
        em = (State*)((State*)wk->target_adrs)->my_effadrs;
        dad = (s16*)(em->adjust_adrs + (get_sel_adjust_tbl_ix(((State_Other*)em)->master_player) + 1));
        res_hs = wk->xyz[0].disp.pos - (em->xyz[0].disp.pos + dad[0] + (dad[1] / 2));

        if (res_hs < 0) {
            res_hs = -res_hs;
        }

        res_hs -= (dad[1] / 2);

        return res_hs;
    }

    em = (State*)wk->target_adrs;
    res_hs = (wk->xyz[0].disp.pos) - (em->xyz[0].disp.pos);

    if (res_hs < 0) {
        res_hs = -res_hs;
    }

    res_hs += em->adjust_adrs[1].hos_box[0];

    return res_hs;
}

/** @brief Checks extended command input data for direction/button combos. */
s32 cmd_ex_check(s16 px, s16 cx) {
    if (cx) {
        if (cx < 0) {
            if (px + cx <= 0) {
                return 1;
            }
        } else if (px - cx >= 0) {
            return 1;
        }
    } else {
        return 1;
    }

    return 0;
}

const s16 shot_prio[6][2] = { { 256, 3 }, { 16, 0 }, { 512, 4 }, { 32, 1 }, { 1024, 5 }, { 64, 2 } };

/** @brief Converts raw button/shot data to prioritized shot number. */
s16 shot_data_convert(u16 sw) {
    s16 i;
    s16 rnum = -1;

    for (i = 0; i < 6; i++) {
        if (sw & shot_prio[i][0]) {
            rnum = shot_prio[i][1];
        }
    }

    return rnum;
}

const s16 shot_refresh[6] = { 16, 32, 64, 256, 512, 1024 };

/** @brief Refreshes the shot data after a button press. */
s16 shot_data_refresh(s16 sw) {
