static void Handicap_2nd() {
    g_state.ID2 = 0;
    Handicap_Control();
    g_state.ID2 = 1;
    Handicap_Control();
}

/** @brief Handicap phase 3 — fade BGM and return to exit phase 1 when timer expires. */
static void Handicap_3rd() {
    if (g_state.select_timer_legacy == 9) {
        SsBgmFadeOut(0x1000);
    }

    if ((g_state.select_timer_legacy -= 1) == 0) {
        g_state.Exit_No = 1;
