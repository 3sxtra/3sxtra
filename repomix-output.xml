<file path=".github/workflows/build_android.yml">
name: Build (Android)

on:
    workflow_dispatch:
    pull_request:
        branches: [ "main" ]
    workflow_call:
        inputs:
            release:
                description: "Build in Release mode and produce release artifacts"
                required: false
                type: boolean
                default: false

concurrency:
    group: build-android-arm64-${{ github.ref }}
    cancel-in-progress: true

env:
    FORCE_JAVASCRIPT_ACTIONS_TO_NODE24: true

jobs:
    build:
        runs-on: ubuntu-latest
        steps:
          - name: Checkout repository
            uses: actions/checkout@v6

          - name: Set up JDK 17
            uses: actions/setup-java@v4
            with:
                java-version: '17'
                distribution: 'temurin'
                cache: gradle

          - name: Set NDK path
            run: |
                # The GitHub Action ubuntu-latest runner comes with a default NDK.
                # We use ANDROID_NDK_LATEST_HOME to point to it.
                echo "ANDROID_NDK_ROOT=$ANDROID_NDK_LATEST_HOME" >> $GITHUB_ENV

          - name: Cache Android Dependencies
            uses: actions/cache@v4
            with:
                path: third_party_android
                key: android-deps-v1-${{ hashFiles('android/androiddeps.sh', 'android/app/src/main/cpp/CMakeLists.txt') }}
                restore-keys: android-deps-

          - name: Install System Dependencies
            run: |
                sudo apt update
                sudo apt install -y cmake ninja-build python3
            shell: bash

          - name: Build C/C++ third-party dependencies
            run: |
                cd android
                bash androiddeps.sh
            shell: bash

          - name: Build Android APK
            env:
                IS_RELEASE: ${{ inputs.release }}
            run: |
                cd android
                chmod +x ./gradlew
                if [ "$IS_RELEASE" = "true" ]; then
                  ./gradlew assembleRelease
                else
                  ./gradlew assembleDebug
                fi
            shell: bash

          - name: Upload APK
            uses: actions/upload-artifact@v4
            with:
                name: 3sx-android-apk
                path: |
                    android/app/build/outputs/apk/debug/app-debug.apk
                    android/app/build/outputs/apk/release/app-release.apk
                if-no-files-found: warn

          - name: Save build output (local act)
            if: ${{ always() && env.ACT }}
            run: |
                echo "✅ Android build done!"
</file>

<file path=".github/workflows/build_arcade_linux_arm64.yml">
name: Build Arcade (Linux ARM64)

on:
    workflow_dispatch:
    pull_request:
        branches: [ "main" ]

concurrency:
    group: build-arcade-linux-arm64-${{ github.ref }}
    cancel-in-progress: true

jobs:
    build:
        name: Build Arcade (Linux ARM64 cross-compile)
        runs-on: ubuntu-24.04

        steps:
          - name: Setup ARM64 cross-compilation
            run: |
                sudo dpkg --add-architecture arm64

                # Pin existing DEB822 sources to amd64-only (Ubuntu 24.04 format)
                for f in /etc/apt/sources.list.d/*.sources; do
                    if [ -f "$f" ] && ! grep -q 'Architectures:' "$f"; then
                        sudo sed -i '/^Types:/a Architectures: amd64' "$f"
                    fi
                done

                # Add arm64 sources from ports.ubuntu.com
                printf '%s\n' \
                    'deb [arch=arm64] http://ports.ubuntu.com/ubuntu-ports noble main restricted universe multiverse' \
                    'deb [arch=arm64] http://ports.ubuntu.com/ubuntu-ports noble-updates main restricted universe multiverse' \
                    'deb [arch=arm64] http://ports.ubuntu.com/ubuntu-ports noble-security main restricted universe multiverse' \
                    | sudo tee /etc/apt/sources.list.d/arm64-ports.list

                sudo apt-get update
                sudo apt-get install -y \
                    crossbuild-essential-arm64 clang \
                    zlib1g-dev:arm64 \
                    libasound2-dev:arm64 \
                    libdrm-dev:arm64 libgbm-dev:arm64 \
                    libgles2-mesa-dev:arm64 libegl1-mesa-dev:arm64 \
                    libudev-dev:arm64 libdbus-1-dev:arm64 \
                    libx11-dev:arm64 libxext-dev:arm64 \
                    libxrandr-dev:arm64 libxcursor-dev:arm64 \
                    libxfixes-dev:arm64 libxi-dev:arm64 \
                    libxss-dev:arm64 libxtst-dev:arm64 \
                    libxkbcommon-dev:arm64

          - name: Checkout repository
            uses: actions/checkout@v4
            with:
                submodules: true

          - name: Cache dependencies
            uses: actions/cache@v4
            with:
                path: third_party_arm64
                key: linux-arm64-deps-v1-${{ hashFiles('build-deps-arm64.sh') }}

          - name: Build dependencies (cross-compile)
            run: |
                chmod +x ./build-deps-arm64.sh
                ./build-deps-arm64.sh
            shell: bash

          - name: Build for Linux ARM64
            env:
                PKG_CONFIG_PATH: /usr/lib/aarch64-linux-gnu/pkgconfig:/usr/share/pkgconfig
                PKG_CONFIG_LIBDIR: /usr/lib/aarch64-linux-gnu/pkgconfig:/usr/share/pkgconfig
            run: |
                set -o pipefail
                cmake -B build-arm64 \
                    -DCMAKE_TOOLCHAIN_FILE=cmake/aarch64-linux-gnu.cmake \
                    -DCMAKE_BUILD_TYPE=Release \
                    -DTHIRD_PARTY_DIR=$GITHUB_WORKSPACE/third_party_arm64 \
                    -G Ninja
                cmake --build build-arm64 --parallel 2>&1 | tee build.log
            shell: bash

          - name: Verify binary architecture
            run: |
                file build-arm64/3sx
                file build-arm64/3sx | grep -q "aarch64" \
                    && echo "✅ ARM64 binary confirmed" \
                    || (echo "❌ Not an ARM64 binary!" && exit 1)

          - name: Package release
            run: |
                cd build-arm64
                cpack -G TGZ --config CPackConfig.cmake
                ls -lh *.tar.gz

          - name: Upload release artifact
            uses: actions/upload-artifact@v4
            with:
                name: 3sx-linux-arm64
                path: build-arm64/*.tar.gz

          - name: Upload build log
            if: always()
            uses: actions/upload-artifact@v4
            with:
                name: build-log-arm64
                path: build.log
</file>

