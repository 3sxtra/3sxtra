    s16 d;

    for (i = 2, a = j = 0; i >= 0; i--, b = j++) {
        g_state.Cursor_Y_Pos[0][i] = Cursor_Y_Data[j];
    }

    for (i = 2, c = j = 3; i >= 0; i--, d = j++) {
        g_state.Cursor_Y_Pos[1][i] = Cursor_Y_Data[j];
    }
}

