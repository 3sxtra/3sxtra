/** @brief Kuuchuu Nichirin-shou (air palm-strike special). */
void Att_KUUCHUUNICHIRINSHOU(PlayerEntity* wk) {
    switch (wk->wu.routine_no[3]) {
    case 0:
        wk->wu.routine_no[3]++;
        set_char_move_init(&wk->wu, 5, wk->as->char_ix);
        /* fallthrough */

    case 1:
        jumping_union_process(&wk->wu, 2);

        if (wk->wu.routine_no[3] != 2) {
            if (wk->wu.cg_type == 20) {
                add_to_mvxy_data(&wk->wu, wk->as->data_ix);
                wk->wu.cg_type = 0;
            }

            if (wk->wu.cg_type == 30) {
                add_to_mvxy_data(&wk->wu, wk->as->r_no);
                wk->wu.cg_type = 0;
                return;
            }
        }

        break;

    case 2:
        char_move(&wk->wu);
        break;
    }
}

/** @brief Kuuchuu Jinchuu-watari (air command movement). */
void Att_KUUCHUUJINNCHUUWATARI(PlayerEntity* wk) {
    switch (wk->wu.routine_no[3]) {
    case 0:
        wk->wu.routine_no[3]++;
        set_char_move_init(&wk->wu, 5, wk->as->char_ix);
        wk->wu.mvxy.index = wk->as->r_no;
        break;

    case 1:
        char_move(&wk->wu);

        if (wk->wu.cg_type == 1) {
