/**
 * @file bonus_basketball_ai_2.c
 * "Crush the Car!" Bonus Stage
 */

#include "sf33rd/Source/Game/engine/bonus_basketball_ai_2.h"
#include "game_state.h"
#include "common.h"
#include "sf33rd/Source/Game/effect/effect_16_decomposition_part_break_bunkai.h"
#include "sf33rd/Source/Game/effect/effect_c2_quake_bs2_data.h"
#include "sf33rd/Source/Game/engine/player_control.h"
#include "sf33rd/Source/Game/engine/state_user.h"
#include "sf33rd/Source/Game/rendering/texture_cache.h"

/** @brief Executes the AI for the car-crush bonus stage opponent. */
void bonus_basketball_ai_execute2(PlayerEntity* wk) {
    switch (g_state.Bonus_Stage_RNO[0]) {
    case 0:
        if (g_state.Bonus_Stage_RNO[1]) {
            if (!g_state.Allow_a_battle_f) {
                break;
            }

            g_state.Bonus_Stage_RNO[0] = 1;
            g_state.Bonus_Stage_RNO[1] = 0;
            wk->absolute_invuln_flag = true;

            break;
        }

        if (wk->wu.id) {
            Free_Texture_Cache(4);
            wk->wu.my_sprite_sheet = 3;

        } else {
            Free_Texture_Cache(3);
            wk->wu.my_sprite_sheet = 4;
        }

        Allocate_Texture_Cache(5);
        wk->wu.xyz[0].disp.pos = 468;
        wk->wu.xyz[1].disp.pos = 0;
        effect_C2_init(&wk->wu, 0);
        effect_16_init(wk, 0);
        effect_16_init(wk, 1);
        g_state.Bonus_Stage_RNO[1] = 1;

        break;

    case 1:
        if (((State*)wk->wu.my_effadrs)->routine_no[0] == 2 && ((State*)wk->wu.my_effadrs)->routine_no[1] == 9) {
            g_state.Bonus_Stage_RNO[0] = 2;
            g_state.Bonus_Stage_RNO[1] = 0;
            g_state.Allow_a_battle_f = 0;
            g_state.pcon_dp_flag = true;
        }

        wk->wu.xyz[0].disp.pos = 468;

        break;

    case 2:
        break;
    }
}
