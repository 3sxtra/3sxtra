#chat-input-bar {
    position: absolute;
    bottom: 16dp;
    left: 12dp;
    width: 50%;
    background: rgba(0, 0, 0, 0.8);
    border-width: 1dp;
    border-color: #777;
    padding: 6dp 10dp;
    font-size: 20dp;
    color: #fff;
    display: flex;
    flex-direction: row;
    align-items: center;
    border-radius: 4dp;
}

.chat-prompt {
    color: #ffd700;
    margin-right: 6dp;
}

.chat-input-text {
    color: #fff;
    flex: 1;
}

.chat-cursor {
    color: #ffd700;
    animation: blink 1s infinite;
}
