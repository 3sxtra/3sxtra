            } else if (unscaled) {
                int remaining = dst_w, src = src_x_start_fwd;
                SWCanvasPixel* d = drow;
                while (remaining > 0) {
                    int chunk = (tex_w - src > remaining) ? remaining : tex_w - src;
                    sw_blit_direct_row(d, src_row + src, q->modulate, chunk);
