    void (*const eff85_jp_tbl[3])(State_Other*) = { eff85_0000, eff85_0100, eff85_0200 };
    eff85_jp_tbl[ewk->wu.routine_no[0]](ewk);
};

void eff85_0000(State_Other* ewk) {
    ewk->wu.routine_no[0]++;
    ewk->wu.routine_no[1] = 0;
    ewk->wu.routine_no[2] = 0;
    ewk->wu.facing_flag = 0;
    ewk->wu.old_routine_no[0] = 0;
}

void eff85_0100(State_Other* ewk) {
    void (*const eff85_move_tbl[9])(State_Other*) = { eff85_1000,   eff85_common, eff85_3000, eff85_common, eff85_5000,
                                                     eff85_common, eff85_7000,   eff85_8000, eff85_9000 };

    if (!g_state.execute_flag && !g_state.Game_pause && !g_state.EXE_obroll) {
        eff85_move_tbl[ewk->wu.routine_no[1]](ewk);
    }

    disp_pos_trans_entry(ewk);
}

void eff85_1000(State_Other* ewk) {
    switch (ewk->wu.routine_no[2]) {
    case 0:
        ewk->wu.routine_no[2]++;
        ewk->wu.disp_flag = 1;

        if (ewk->wu.old_routine_no[0]) {
            set_char_move_init(&ewk->wu, 0, 44);
        } else {
            set_char_move_init(&ewk->wu, 0, 28);
        }

        ewk->wu.old_routine_no[0]++;
        ewk->wu.old_routine_no[0] &= 1;
        ewk->wu.xyz[0].cal = 0x1EB0000;
        ewk->wu.xyz[1].cal = 0x2C0000;
        break;

    case 1:
        if (!swallow_sprize_check(ewk)) {
            break;
        }

        char_move(&ewk->wu);

        if (ewk->wu.cg_type == 0xFF) {
            ewk->wu.routine_no[1]++;
            ewk->wu.routine_no[2] = 0;
        }

        break;
    }
}

void eff85_common(State_Other* ewk) {
    switch (ewk->wu.routine_no[2]) {
    case 0:
        ewk->wu.routine_no[2]++;
        set_char_move_init(&ewk->wu, 0, eff85_char_index_tbl[ewk->wu.routine_no[1]]);
        break;

    case 1:
        char_move(&ewk->wu);

        if (ewk->wu.cg_type == 0xFF) {
            ewk->wu.routine_no[1]++;
            ewk->wu.routine_no[2] = 0;
        }

        break;
    }
}

void eff85_3000(State_Other* ewk) {
    switch (ewk->wu.routine_no[2]) {
