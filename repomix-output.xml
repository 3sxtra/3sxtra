/**
 * @file effd3.c
 * Effect: Timer / Color Effect
 */

#include "sf33rd/Source/Game/effect/effect_d3_timer_color.h"
#include "game_state.h"
#include "common.h"
#include "sf33rd/Source/Game/effect/effect_20_simple_animation.h"
