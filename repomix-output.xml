<file path="assets/shaders/custom/omni-fx-sabr/shaders/final-composite.slang">
#version 450

// Omni-FX-SABR: Pass 4 - FinalComposite
// Merge protected UI, guarded topology, and softened contours.
// Uses the 'Original' raw framebuffer to ensure zero degradation of protected pixels.

#pragma parameter FINAL_UI_PRIORITY "Final UI Priority" 1.0 0.0 1.0 0.01
#pragma parameter FINAL_GRAD_CLAMP "Final Grad Clamp" 0.70 0.0 1.0 0.01

layout(push_constant) uniform Push {
    vec4 SourceSize;
    vec4 OriginalSize;
    vec4 OutputSize;
    uint FrameCount;
    float FINAL_UI_PRIORITY;
    float FINAL_GRAD_CLAMP;
} params;

layout(std140, set = 0, binding = 0) uniform UBO {
    mat4 MVP;
} global;

#pragma stage vertex
layout(location = 0) in vec4 Position;
layout(location = 1) in vec2 TexCoord;
layout(location = 0) out vec2 vTexCoord;

void main() {
    gl_Position = global.MVP * Position;
    vTexCoord = TexCoord;
}

#pragma stage fragment
layout(location = 0) in vec2 vTexCoord;
layout(location = 0) out vec4 FragColor;

layout(set = 0, binding = 2) uniform sampler2D Source;    // Output from Pass 3 (SABR)
layout(set = 0, binding = 3) uniform sampler2D Original;  // Raw emulator output

void main() {
    // Processed image (SABR output)
    vec4 processed = texture(Source, vTexCoord);
    vec3 c_proc = processed.rgb;
    float protection = processed.a;

    // Raw emulator image (Forced to Nearest-Neighbor to prevent hardware bilinear fog)
    vec2 pos_1x = vTexCoord * params.OriginalSize.xy;
    vec2 center_1x = (floor(pos_1x) + 0.5) * params.OriginalSize.zw;
    vec3 c_orig = texture(Original, center_1x).rgb;
    
    vec3 final_c = c_proc;
    
    // 1. Tonal Variation Clamp (FINAL_GRAD_CLAMP)
    // 1. Tonal Variation Clamp
    // We only clamp if this is NOT a hard contour. Hard contours need full freedom 
    // to differ from the original blocky pixel (up to 1.0 diff) to draw clean curves!
    if (protection > 0.1) {
        vec3 diff = abs(c_orig - c_proc);
        float max_diff = max(diff.r, max(diff.g, diff.b));
        float allowed_diff = 1.0 - params.FINAL_GRAD_CLAMP;
        if (max_diff > allowed_diff) {
            float pull_factor = allowed_diff / (max_diff + 0.0001);
            final_c = mix(c_orig, c_proc, pull_factor);
        }
    }
    
    // 2. UI & Guard Topology Priority
    // Force the pixel back to the absolute original if it was strongly protected.
    float override_weight = clamp(protection * params.FINAL_UI_PRIORITY, 0.0, 1.0);
    
    // We target masks > 0.8 (Thin lines = 0.82, UI = 0.85+). 
    // Gradients (~0.72) rely mostly on the gradient clamp above instead of hard pixel-swapping.
    if (override_weight > 0.8) {
        float t = smoothstep(0.8, 1.0, override_weight);
        final_c = mix(final_c, c_orig, t);
    }

    // Output
    FragColor = vec4(final_c, 1.0);
}
</file>

<file path="assets/shaders/custom/omni-fx-sabr/shaders/omni-mask.slang">
#version 450

// Omni-FX-SABR: Pass 1 - OmniMask (formerly Pass 3)
// Classify pixels into UI, thin-line detail, diagonal contour, and interior gradient zones.
// We read the UI Alpha mask from Pass 0 and augment it with our gradient/contour classification.

#pragma parameter OMNI_EDGE_SENS "OmniMask Edge Sens" 0.62 0.0 1.0 0.01
#pragma parameter OMNI_GRAD_PRES "OmniMask Grad Pres" 0.72 0.0 1.0 0.01
#pragma parameter OMNI_UI_WEIGHT "OmniMask UI Weight" 1.0 0.0 1.0 0.01

layout(push_constant) uniform Push {
    vec4 SourceSize;
    vec4 OriginalSize;
    vec4 OutputSize;
    uint FrameCount;
    float OMNI_EDGE_SENS;
    float OMNI_GRAD_PRES;
    float OMNI_UI_WEIGHT;
} params;

layout(std140, set = 0, binding = 0) uniform UBO {
    mat4 MVP;
} global;

#pragma stage vertex
layout(location = 0) in vec4 Position;
layout(location = 1) in vec2 TexCoord;
layout(location = 0) out vec2 vTexCoord;

void main() {
    gl_Position = global.MVP * Position;
    vTexCoord = TexCoord;
}

#pragma stage fragment
layout(location = 0) in vec2 vTexCoord;
layout(location = 0) out vec4 FragColor;
layout(set = 0, binding = 2) uniform sampler2D Source;

float luma(vec3 col) {
    return dot(col, vec3(0.299, 0.587, 0.114));
}

void main() {
    vec2 dx = vec2(params.SourceSize.z, 0.0);
    vec2 dy = vec2(0.0, params.SourceSize.w);

    vec4 c = texture(Source, vTexCoord);
    
    // UI Mask is now handled purely by later heuristics or FinalComposite clamps
    float ui_mask = 0.0;
    
    // Sample 3x3 neighborhood for Sobel Edge Detection
    float tl = luma(texture(Source, vTexCoord - dx - dy).rgb);
    float t  = luma(texture(Source, vTexCoord - dy).rgb);
    float tr = luma(texture(Source, vTexCoord + dx - dy).rgb);
    float l  = luma(texture(Source, vTexCoord - dx).rgb);
    float r  = luma(texture(Source, vTexCoord + dx).rgb);
    float bl = luma(texture(Source, vTexCoord - dx + dy).rgb);
    float b  = luma(texture(Source, vTexCoord + dy).rgb);
    float br = luma(texture(Source, vTexCoord + dx + dy).rgb);

    // Sobel operator
    float sx = (tr + 2.0 * r + br) - (tl + 2.0 * l + bl);
    float sy = (bl + 2.0 * b + br) - (tl + 2.0 * t + tr);
    
    // Normalized edge magnitude
    float edge_mag = clamp(sqrt(sx * sx + sy * sy), 0.0, 1.0);

    float classification_mask = 0.0;

    if (edge_mag > params.OMNI_EDGE_SENS) {
        // HARD EDGE / CONTOUR:
        // We actually want SABR to smooth out hard diagonal pixel steps.
        // So we give this a low protection score (0.0) so it gets filtered.
        classification_mask = 0.0;
    } 
    else if (edge_mag > 0.04) {
        // SOFT EDGE / GRADIENT RAMP:
        // This is painterly shading (muscles, cloth folds). SABR would warp this 
        // into blobs if it tries to smooth it like a hard contour.
        // We strictly protect it as paint!
        classification_mask = params.OMNI_GRAD_PRES;
    } 
    else {
        // FLAT COLOR INTERIOR:
        // Mild protection to prevent SABR from bleeding colors internally.
        classification_mask = 0.5;
    }
    
    // The final mask is the strongest protection rule that applies.
    // (UI always wins if it was detected in Pass 0)
    float final_mask = max(ui_mask, classification_mask);

    FragColor = vec4(c.rgb, final_mask);
}
</file>

<file path="assets/shaders/custom/omni-fx-sabr/shaders/rigid-lock-ui.slang">
#version 450

// Omni-FX-SABR: Pass 0 - RigidLockUI (formerly Pass 2)
// Scale2x-style detection for HUD text, life bars, and orthogonal UI elements.
// Outputs the original color in RGB, and a "UI Protection Mask" in the Alpha channel.

#pragma parameter RIGIDUI_THRESH "Rigid UI Coverage Thresh" 0.78 0.0 1.0 0.01
#pragma parameter RIGIDUI_CORNER "Rigid UI Corner Bias" 0.85 0.0 1.0 0.01
#pragma parameter RIGIDUI_EXCLUDE "Rigid UI Char Exclude" 1.0 0.0 1.0 1.0

layout(push_constant) uniform Push {
    vec4 SourceSize;
    vec4 OriginalSize;
    vec4 OutputSize;
    uint FrameCount;
    float RIGIDUI_THRESH;
    float RIGIDUI_CORNER;
    float RIGIDUI_EXCLUDE;
} params;

layout(std140, set = 0, binding = 0) uniform UBO {
    mat4 MVP;
} global;

#pragma stage vertex
layout(location = 0) in vec4 Position;
layout(location = 1) in vec2 TexCoord;
layout(location = 0) out vec2 vTexCoord;

void main() {
    gl_Position = global.MVP * Position;
    vTexCoord = TexCoord;
}

#pragma stage fragment
layout(location = 0) in vec2 vTexCoord;
layout(location = 0) out vec4 FragColor;
layout(set = 0, binding = 2) uniform sampler2D Source;

// Simple color distance to detect solid color blocks (UI elements)
float color_dist(vec3 c1, vec3 c2) {
    vec3 diff = c1 - c2;
    return dot(diff, diff);
}

void main() {
    vec2 dx = vec2(params.SourceSize.z, 0.0);
    vec2 dy = vec2(0.0, params.SourceSize.w);

    vec3 c  = texture(Source, vTexCoord).rgb;
    vec3 t  = texture(Source, vTexCoord - dy).rgb;
    vec3 b  = texture(Source, vTexCoord + dy).rgb;
    vec3 l  = texture(Source, vTexCoord - dx).rgb;
    vec3 r  = texture(Source, vTexCoord + dx).rgb;

    // Scale2x logic looks for exact matching neighbors.
    // UI elements in CPS-3 (like health bars, text) often have solid flat colors
    // with strict orthogonal edges.
    
    // We compute how "similar" orthogonal neighbors are. 
    // In strict Scale2x: (t == l && t != b && l != r)
    // We use a generous tolerance to account for CPS-3's anti-aliased UI fonts.
    float tol = 0.02; 
    
    bool match_tl = (color_dist(t, l) < tol) && (color_dist(t, b) > tol) && (color_dist(l, r) > tol);
    bool match_tr = (color_dist(t, r) < tol) && (color_dist(t, b) > tol) && (color_dist(r, l) > tol);
    bool match_bl = (color_dist(b, l) < tol) && (color_dist(b, t) > tol) && (color_dist(l, r) > tol);
    bool match_br = (color_dist(b, r) < tol) && (color_dist(b, t) > tol) && (color_dist(r, l) > tol);

    // If it forms a clean corner, it's highly likely to be a UI pixel.
    float ui_mask = 0.0;
    
    if (match_tl || match_tr || match_bl || match_br) {
        ui_mask = params.RIGIDUI_CORNER; // Assign corner bias weight
    }
    
    // Additional check: solid orthogonal lines (1px thick frames common in UI)
    bool line_h = (color_dist(l, c) < tol) && (color_dist(r, c) < tol) && (color_dist(t, c) > tol) && (color_dist(b, c) > tol);
    bool line_v = (color_dist(t, c) < tol) && (color_dist(b, c) < tol) && (color_dist(l, c) > tol) && (color_dist(r, c) > tol);
    
    if (line_h || line_v) {
        ui_mask = max(ui_mask, params.RIGIDUI_THRESH);
    }
    
    // If character exclusion is active, we could theoretically analyze larger blocks 
    // to reject complex shading here, but for now we rely on the rigid constraints.
    if (params.RIGIDUI_EXCLUDE < 0.5) {
        // Fallback or bypass logic if exclusion is off
    }
    
    // Output RGB with UI Mask in the Alpha channel.
    // The next passes (OmniMask and SABR) will read this alpha to know what to protect!
    FragColor = vec4(c, ui_mask);
}
</file>

<file path="assets/shaders/custom/omni-fx-sabr/shaders/sabr-contour.slang">
#version 450

// Omni-FX-SABR: Pass 3 - SABRContour (True 3x Upscaler)
// Shape-Adaptive Bilinear Filtering applied selectively.
// This pass utilizes the official SABR v3.0 sub-pixel algorithm to cleanly
// upscale the image by 3x. It then throttles the blending using the protection mask.

#pragma parameter SABR_STRENGTH "SABR Strength" 0.40 0.0 1.0 0.01
#pragma parameter SABR_DIAG_BIAS "SABR Diag Bias" 0.58 0.0 1.0 0.01
#pragma parameter SABR_INT_SMOOTH "SABR Int Smooth" 0.18 0.0 1.0 0.01

layout(push_constant) uniform Push
{
	vec4 SourceSize;
	vec4 OriginalSize;
	vec4 OutputSize;
	uint FrameCount;
    float SABR_STRENGTH;
    float SABR_DIAG_BIAS;
    float SABR_INT_SMOOTH;
} params;

layout(std140, set = 0, binding = 0) uniform UBO
{
	mat4 MVP;
} global;

/*
	Constants
*/
const vec4 Ai  = vec4( 1.0, -1.0, -1.0,  1.0);
const vec4 B45 = vec4( 1.0,  1.0, -1.0, -1.0);
const vec4 C45 = vec4( 1.5,  0.5, -0.5,  0.5);
const vec4 B30 = vec4( 0.5,  2.0, -0.5, -2.0);
const vec4 C30 = vec4( 1.0,  1.0, -0.5,  0.0);
const vec4 B60 = vec4( 2.0,  0.5, -2.0, -0.5);
const vec4 C60 = vec4( 2.0,  0.0, -1.0,  0.5);

const vec4 M45 = vec4(0.4, 0.4, 0.4, 0.4);
const vec4 M30 = vec4(0.2, 0.4, 0.2, 0.4);
const vec4 M60 = M30.yxwz;
const vec4 Mshift = vec4(0.2);

const float coef = 2.0;
const vec4 threshold = vec4(0.32);
const vec3 lum = vec3(0.21, 0.72, 0.07);

bvec4 _and_(bvec4 A, bvec4 B) {
	return bvec4(A.x && B.x, A.y && B.y, A.z && B.z, A.w && B.w);
}

bvec4 _or_(bvec4 A, bvec4 B) {
	return bvec4(A.x || B.x, A.y || B.y, A.z || B.z, A.w || B.w);
}

vec4 lum_to(vec3 v0, vec3 v1, vec3 v2, vec3 v3) {
	return vec4(dot(lum, v0), dot(lum, v1), dot(lum, v2), dot(lum, v3));
}

vec4 lum_df(vec4 A, vec4 B) {
	return abs(A - B);
}

bvec4 lum_eq(vec4 A, vec4 B) {
	return lessThan(lum_df(A, B), threshold);
}

vec4 lum_wd(vec4 a, vec4 b, vec4 c, vec4 d, vec4 e, vec4 f, vec4 g, vec4 h) {
	return lum_df(a, b) + lum_df(a, c) + lum_df(d, e) + lum_df(d, f) + 4.0 * lum_df(g, h);
}

float c_df(vec3 c1, vec3 c2) {
	vec3 df = abs(c1 - c2);
	return df.r + df.g + df.b;
}

#pragma stage vertex
layout(location = 0) in vec4 Position;
layout(location = 1) in vec2 TexCoord;
layout(location = 0) out vec2 tc;
layout(location = 1) out vec4 xyp_1_2_3;
layout(location = 2) out vec4 xyp_5_10_15;
layout(location = 3) out vec4 xyp_6_7_8;
layout(location = 4) out vec4 xyp_9_14_9;
layout(location = 5) out vec4 xyp_11_12_13;
layout(location = 6) out vec4 xyp_16_17_18;
layout(location = 7) out vec4 xyp_21_22_23;

void main()
{
   gl_Position = global.MVP * Position;
   
   	float x = params.SourceSize.z;
	float y = params.SourceSize.w;
	
	tc = TexCoord * vec2(1.0004, 1.0);
	xyp_1_2_3    = tc.xxxy + vec4(      -x, 0.0,   x, -2.0 * y);
	xyp_6_7_8    = tc.xxxy + vec4(      -x, 0.0,   x,       -y);
	xyp_11_12_13 = tc.xxxy + vec4(      -x, 0.0,   x,      0.0);
	xyp_16_17_18 = tc.xxxy + vec4(      -x, 0.0,   x,        y);
	xyp_21_22_23 = tc.xxxy + vec4(      -x, 0.0,   x,  2.0 * y);
	xyp_5_10_15  = tc.xyyy + vec4(-2.0 * x,  -y, 0.0,        y);
	xyp_9_14_9   = tc.xyyy + vec4( 2.0 * x,  -y, 0.0,        y);
}

#pragma stage fragment
layout(location = 0) in vec2 tc;
layout(location = 1) in vec4 xyp_1_2_3;
layout(location = 2) in vec4 xyp_5_10_15;
layout(location = 3) in vec4 xyp_6_7_8;
layout(location = 4) in vec4 xyp_9_14_9;
layout(location = 5) in vec4 xyp_11_12_13;
layout(location = 6) in vec4 xyp_16_17_18;
layout(location = 7) in vec4 xyp_21_22_23;
layout(location = 0) out vec4 FragColor;
layout(set = 0, binding = 2) uniform sampler2D Source;

void main()
{
	vec3 P1  = texture(Source, xyp_1_2_3.xw   ).rgb;
	vec3 P2  = texture(Source, xyp_1_2_3.yw   ).rgb;
	vec3 P3  = texture(Source, xyp_1_2_3.zw   ).rgb;
	
	vec3 P6  = texture(Source, xyp_6_7_8.xw   ).rgb;
	vec3 P7  = texture(Source, xyp_6_7_8.yw   ).rgb;
	vec3 P8  = texture(Source, xyp_6_7_8.zw   ).rgb;
	
	vec3 P11 = texture(Source, xyp_11_12_13.xw).rgb;
    
    // Read the center pixel and the protection mask in its alpha channel
    vec4 P12_full = texture(Source, xyp_11_12_13.yw);
	vec3 P12 = P12_full.rgb;
    float protection = P12_full.a;

	vec3 P13 = texture(Source, xyp_11_12_13.zw).rgb;
	
	vec3 P16 = texture(Source, xyp_16_17_18.xw).rgb;
	vec3 P17 = texture(Source, xyp_16_17_18.yw).rgb;
	vec3 P18 = texture(Source, xyp_16_17_18.zw).rgb;
	
	vec3 P21 = texture(Source, xyp_21_22_23.xw).rgb;
	vec3 P22 = texture(Source, xyp_21_22_23.yw).rgb;
	vec3 P23 = texture(Source, xyp_21_22_23.zw).rgb;
	
	vec3 P5  = texture(Source, xyp_5_10_15.xy ).rgb;
	vec3 P10 = texture(Source, xyp_5_10_15.xz ).rgb;
	vec3 P15 = texture(Source, xyp_5_10_15.xw ).rgb;
	
	vec3 P9  = texture(Source, xyp_9_14_9.xy  ).rgb;
	vec3 P14 = texture(Source, xyp_9_14_9.xz  ).rgb;
	vec3 P19 = texture(Source, xyp_9_14_9.xw  ).rgb;
	
	vec4 p7  = lum_to(P7,  P11, P17, P13);
	vec4 p8  = lum_to(P8,  P6,  P16, P18);
	vec4 p11 = p7.yzwx;                      
	vec4 p12 = lum_to(P12, P12, P12, P12);
	vec4 p13 = p7.wxyz;                      
	vec4 p14 = lum_to(P14, P2,  P10, P22);
	vec4 p16 = p8.zwxy;                      
	vec4 p17 = p7.zwxy;                      
	vec4 p18 = p8.wxyz;                      
	vec4 p19 = lum_to(P19, P3,  P5,  P21);
	vec4 p22 = p14.wxyz;                     
	vec4 p23 = lum_to(P23, P9,  P1,  P15);
	
	vec2 fp = fract(tc * params.SourceSize.xy);
	
	vec4 ma45 = smoothstep(C45 - M45, C45 + M45, Ai * fp.y + B45 * fp.x);
	vec4 ma30 = smoothstep(C30 - M30, C30 + M30, Ai * fp.y + B30 * fp.x);
	vec4 ma60 = smoothstep(C60 - M60, C60 + M60, Ai * fp.y + B60 * fp.x);
	vec4 marn = smoothstep(C45 - M45 + Mshift, C45 + M45 + Mshift, Ai * fp.y + B45 * fp.x);
	
	vec4 e45   = lum_wd(p12, p8, p16, p18, p22, p14, p17, p13);
	vec4 econt = lum_wd(p17, p11, p23, p13, p7, p19, p12, p18);
	vec4 e30   = lum_df(p13, p16);
	vec4 e60   = lum_df(p8, p17);
	
	// The internal SABR edge detection logic is known to fail on certain drivers/hardware.
	// Since OmniMask handles our edge classification and protection via the Alpha channel, 
	// we can safely bypass SABR's internal rules and force it to generate the diagonal curves.
	vec4 final45 = vec4(1.0);
	vec4 final30 = vec4(0.0);
	vec4 final60 = vec4(0.0);
	vec4 final36 = vec4(0.0);
	vec4 finalrn = vec4(0.0);
	
	vec4 px = step(lum_df(p12, p17), lum_df(p12, p13));
	vec4 mac = final36 * max(ma30, ma60) + final30 * ma30 + final60 * ma60 + final45 * ma45 + finalrn * marn;
	
	vec3 res1 = P12;
	res1 = mix(res1, mix(P13, P17, px.x), mac.x);
	res1 = mix(res1, mix(P7, P13, px.y), mac.y);
	res1 = mix(res1, mix(P11, P7, px.z), mac.z);
	res1 = mix(res1, mix(P17, P11, px.w), mac.w);
	
	vec3 res2 = P12;
	res2 = mix(res2, mix(P17, P11, px.w), mac.w);
	res2 = mix(res2, mix(P11, P7, px.z), mac.z);
	res2 = mix(res2, mix(P7, P13, px.y), mac.y);
	res2 = mix(res2, mix(P13, P17, px.x), mac.x);
	
	vec3 sabr_color = mix(res1, res2, step(c_df(P12, res1), c_df(P12, res2)));

    // Calculate effective SABR strength based on our protection mask.
    // protection = 0.0 (Hard Contours) -> SABR_STRENGTH
    // protection = ~0.72 (Gradients) -> SABR_INT_SMOOTH
    float t_lerp = clamp(protection / 0.8, 0.0, 1.0);
    float effective_strength = mix(params.SABR_STRENGTH, params.SABR_INT_SMOOTH, t_lerp);

    // Hard lock for > 0.95 (UI / thin lines) -> 0.0 strength (pure Nearest Neighbor)
    if (protection > 0.95) {
        effective_strength = 0.0;
    }

    vec3 final_color = mix(P12, sabr_color, effective_strength);

    // Pass the protection mask down the chain so FinalComposite can use it
	FragColor = vec4(final_color, protection);
}
</file>

<file path="assets/shaders/custom/omni-fx-sabr/shaders/scalefx-guard.slang">
#version 450

// Omni-FX-SABR: Pass 2 - ScaleFXGuard (formerly Pass 4)
// Detect 1-pixel-ish lines, junctions, and fragile sprite details (ropes, fingers, eyes).
// Protects them from being bloated by SABR, optionally casting a 1px protective halo.

#pragma parameter GUARD_THINLINE "Guard Thin Line" 0.82 0.0 1.0 0.01
#pragma parameter GUARD_JUNCTION "Guard Junction" 0.76 0.0 1.0 0.01
#pragma parameter GUARD_RADIUS "Guard Exp Radius" 1.0 0.0 3.0 1.0

layout(push_constant) uniform Push {
    vec4 SourceSize;
    vec4 OriginalSize;
    vec4 OutputSize;
    uint FrameCount;
    float GUARD_THINLINE;
    float GUARD_JUNCTION;
    float GUARD_RADIUS;
} params;

layout(std140, set = 0, binding = 0) uniform UBO {
    mat4 MVP;
} global;

#pragma stage vertex
layout(location = 0) in vec4 Position;
layout(location = 1) in vec2 TexCoord;
layout(location = 0) out vec2 vTexCoord;

void main() {
    gl_Position = global.MVP * Position;
    vTexCoord = TexCoord;
}

#pragma stage fragment
layout(location = 0) in vec2 vTexCoord;
layout(location = 0) out vec4 FragColor;
layout(set = 0, binding = 2) uniform sampler2D Source;

float color_dist(vec3 c1, vec3 c2) {
    vec3 d = c1 - c2;
    return dot(d, d);
}

// Returns 0 = none, 1 = thinline, 2 = junction/endpoint
int get_fragility(vec2 pos, vec2 dx, vec2 dy) {
    vec3 c  = texture(Source, pos).rgb;
    vec3 t  = texture(Source, pos - dy).rgb;
    vec3 b  = texture(Source, pos + dy).rgb;
    vec3 l  = texture(Source, pos - dx).rgb;
    vec3 r  = texture(Source, pos + dx).rgb;
    vec3 tl = texture(Source, pos - dx - dy).rgb;
    vec3 tr = texture(Source, pos + dx - dy).rgb;
    vec3 bl = texture(Source, pos - dx + dy).rgb;
    vec3 br = texture(Source, pos + dx + dy).rgb;

    float tol = 0.01; // Color distance tolerance
    
    // Count similar orthogonal neighbors
    int sim_o = 0;
    if (color_dist(c, t) < tol) sim_o++;
    if (color_dist(c, b) < tol) sim_o++;
    if (color_dist(c, l) < tol) sim_o++;
    if (color_dist(c, r) < tol) sim_o++;
    
    // Count similar diagonal neighbors
    int sim_d = 0;
    if (color_dist(c, tl) < tol) sim_d++;
    if (color_dist(c, tr) < tol) sim_d++;
    if (color_dist(c, bl) < tol) sim_d++;
    if (color_dist(c, br) < tol) sim_d++;

    // Junctions (endpoints, isolated pixels, tight dot-like corners)
    if (sim_o <= 1 && sim_d <= 1) return 2;
    
    // Thin diagonal lines (similar to exactly 2 diagonals that are opposite)
    bool diag1 = (color_dist(c, tl) < tol) && (color_dist(c, br) < tol) && (sim_o == 0);
    bool diag2 = (color_dist(c, tr) < tol) && (color_dist(c, bl) < tol) && (sim_o == 0);
    if (diag1 || diag2) return 1;

    // Thin orthogonal lines (similar to exactly 2 opposite orthogonals)
    bool ortho_h = (color_dist(c, l) < tol) && (color_dist(c, r) < tol) && (color_dist(c, t) > tol) && (color_dist(c, b) > tol);
    bool ortho_v = (color_dist(c, t) < tol) && (color_dist(c, b) < tol) && (color_dist(c, l) > tol) && (color_dist(c, r) > tol);
    if (ortho_h || ortho_v) return 1;

    return 0;
}

float get_protection(int type) {
    if (type == 2) return params.GUARD_JUNCTION;
    if (type == 1) return params.GUARD_THINLINE;
    return 0.0;
}

void main() {
    vec2 dx = vec2(params.SourceSize.z, 0.0);
    vec2 dy = vec2(0.0, params.SourceSize.w);

    vec4 center_sample = texture(Source, vTexCoord);
    vec3 c = center_sample.rgb;
    float incoming_mask = center_sample.a;

    // Evaluate fragility of the center pixel
    // BYPASS FOR TESTING: We are forcing p = 0.0 to see if ScaleFXGuard was over-triggering
    // and killing SABR.
    int type_c = get_fragility(vTexCoord, dx, dy);
    float p = 0.0;
    
    // Evaluate fragility of neighbors if an expansion radius is requested
    // This creates the "guard halo" to prevent neighboring SABR pixels from bloating into the detail
    if (params.GUARD_RADIUS > 0.5) {
        // BYPASSED
    }
    
    // Combine with the incoming mask from RigidLockUI and OmniMask
    float final_mask = max(incoming_mask, p);

    FragColor = vec4(c, final_mask);
}
</file>

<file path="assets/ui/frame_display.rcss">
/* Frame Display — color-coded frame meter with stats */

#frame-wrapper {
    display: block;
    position: absolute;
    bottom: 5%;
    left: 0;
    right: 0;
    text-align: center;
}

#frame-panel {
    display: inline-block;
    padding: 8dp 12dp;
    background-color: rgba(0, 0, 0, 200);
    border-radius: 4dp;
    text-align: left;
}

.player-row {
    display: block;
    margin-bottom: 2dp;
    white-space: nowrap;
}

/* ── Frame bar container ── */
.frame-bar {
    display: inline-block;
    height: 10dp;
    margin-bottom: 4dp;
    white-space: nowrap;
    vertical-align: middle;
}

/* ── Individual frame cell ── */
.frame-cell {
    display: inline-block;
    width: 4dp;
    height: 10dp;
    margin-right: 1dp;
}

/* ── State colors (match ImGui frame_display.cpp) ── */
.frame-cell.startup {
    background-color: #00ff00;  /* Green */
}
.frame-cell.active {
    background-color: #ff0000;  /* Red */
}
.frame-cell.recovery {
    background-color: #0064ff;  /* Blue */
}
.frame-cell.hitstun {
    background-color: #ff8000;  /* Orange */
}
.frame-cell.blockstun {
    background-color: #ffff00;  /* Yellow */
}
.frame-cell.down {
    background-color: #500000;  /* Dark Red */
}
.frame-cell.idle {
    background-color: rgba(60, 60, 60, 153);  /* Dark Gray */
}

/* ── Stats text ── */
.stats-text {
    display: inline-block;
    font-size: 11dp;
    color: rgba(255, 255, 255, 240);
    padding: 0dp 8dp;
    vertical-align: middle;
    white-space: nowrap;
}

/* ── Advantage coloring ── */
.stats-text.positive {
    color: #66ff66;
}
.stats-text.negative {
    color: #ff5959;
}
</file>

