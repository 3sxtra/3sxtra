            bgw_ptr->free = 0x10;
            bgw_ptr->l_limit++;

            if (bgw_ptr->l_limit >= 3) {
                bgw_ptr->r_no_1++;
                g_state.end_w.timer = 50;
                end_etc_flag = 1;
