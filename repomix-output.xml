const s32 swallow_speeds[16] = { 0,       0x8000,  0x10000, 0x18000, 0x20000, 0x28000, 0x30000, 0x38000,
                                 0x40000, 0x48000, 0x50000, 0x58000, 0x60000, 0x68000, 0x70000, 0x78000 };

void effect_D4_move(State_Other* ewk) {
    PlayerEntity* wk = (PlayerEntity*)ewk->wu.target_adrs;
    PlayerEntity* mwk = (PlayerEntity*)ewk->my_master;
    State* swk;
    s32 rl;
    s32 add_x;
    s32 add_y;
    s32 i;
    s32 j;

    ewk->wu.position_x = mwk->wu.position_x;
    ewk->wu.position_y = mwk->wu.position_y;
    ewk->wu.position_z = mwk->wu.position_z;

    switch (ewk->wu.routine_no[0]) {
    case 0:
        ewk->wu.routine_no[0]++;
        /* fallthrough */

    case 1:
        if (ewk->wu.death_timer == 1) {
            ewk->wu.routine_no[0]++;
            break;
        }

        if (mwk->wu.routine_no[1] != 4) {
            ewk->wu.dir_timer = 0;
            ewk->wu.routine_no[0]++;
            break;
        }

        if (g_state.execute_flag != 0 || g_state.Game_pause != 0) {
            break;
        }

        ewk->wu.dir_timer -= 1;

        if (ewk->wu.dir_timer <= 0) {
            ewk->wu.routine_no[0]++;
            break;
        }

        if (ewk->wu.xyz[0].cal < wk->wu.xyz[0].cal) {
            rl = 1;
        } else {
            rl = 0;
        }

        if ((ewk->wu.damage_calc_divider || mwk->sa_stop_flag) &&
            (!ewk->wu.damage_calc_divider || rl != ewk->wu.facing_flag || mwk->sa_stop_flag)) {
            break;
        }

        i = distance2speed(ewk, &wk->wu, 0);
        ewk->wu.mvxy.a[0].sp = swallow_speeds[i];
        ewk->wu.mvxy.d[0].sp = 0;
        i = distance2speed(ewk, &wk->wu, 1);
        ewk->wu.mvxy.a[1].sp = swallow_speeds[i];
        ewk->wu.mvxy.d[1].sp = 0;
        ewk->wu.mvxy.a[0].sp += ewk->wu.mvxy.d[0].sp;
        ewk->wu.mvxy.a[1].sp += ewk->wu.mvxy.d[1].sp;
        add_x = ewk->wu.mvxy.a[0].sp;
        add_y = -ewk->wu.mvxy.a[1].sp;

        if (ewk->wu.damage_calc_multiplier == -1) {
            add_x = -add_x;
            add_y = -add_y;
        }

        if (wk->wu.swallow_no_effect == 0) {
            if (rl) {
                wk->wu.xyz[0].cal -= add_x;
            } else {
                wk->wu.xyz[0].cal += add_x;
            }

            wk->wu.xyz[1].cal += add_y;
        }

        if (ewk->wu.damage_calc_multiplier != -1) {
            break;
        }

        for (j = 0; j < 8; j++) {
            if (wk->wu.shell_ix[j] == -1) {
                continue;
            }

            swk = (State*)frw[wk->wu.shell_ix[j]];

            if (!swk->active_flag) {
                continue;
            }

            if (ewk->wu.xyz[0].cal < swk->xyz[0].cal) {
                rl = 1;
            } else {
                rl = 0;
            }

            i = distance2speed(ewk, swk, 0);
            ewk->wu.mvxy.a[0].sp = swallow_speeds[i];
            ewk->wu.mvxy.d[0].sp = 0;
            ewk->wu.mvxy.a[0].sp += ewk->wu.mvxy.d[0].sp;
            add_x = -ewk->wu.mvxy.a[0].sp;

            if (rl) {
                swk->xyz[0].cal -= add_x;
            } else {
                swk->xyz[0].cal += add_x;
            }
        }

        break;

    case 2:
    default:
        Release_Effect(&ewk->wu);
        break;
    }
}

static s32 distance2speed(State_Other* ewk, State* wk, s32 dir) {
    s32 y = 0;
    s32 x = 0;

    if (ewk->wu.xyz[0].disp.pos < wk->xyz[0].disp.pos) {
        x = wk->xyz[0].disp.pos - ewk->wu.xyz[0].disp.pos;
    } else if (ewk->wu.xyz[0].disp.pos > wk->xyz[0].disp.pos) {
        x = ewk->wu.xyz[0].disp.pos - wk->xyz[0].disp.pos;
    }

    if (x >= 512) {
        x = 511;
    }

    x >>= 4;

    if (ewk->wu.xyz[1].disp.pos < wk->xyz[1].disp.pos) {
        y = wk->xyz[1].disp.pos - ewk->wu.xyz[1].disp.pos;
    }

    if (y >= 192) {
        y = 191;
    }

    y >>= 4;

    if (dir == 0) {
        return swallow_areas_x[y][x];
    }

    return swallow_areas_y[y][x];
}

s32 effect_D4_init(State* wk, u8 data) {
    State_Other* ewk;
    s16 ix;

    if (g_state.Bonus_Game_Flag != 0) {
        return 0;
    }

    if ((ix = Acquire_Effect(3)) == -1) {
        return -1;
    }

    ewk = (State_Other*)frw[ix];
    ewk->wu.active_flag = 1;
    ewk->wu.id = 134;
    ewk->wu.work_id = 16;
    ewk->wu.type = data;
    ewk->wu.my_family = wk->my_family;
    ewk->wu.graphic_rom_type = wk->graphic_rom_type;
    ewk->wu.my_col_mode = wk->my_col_mode;
    ewk->wu.my_col_code = wk->my_col_code;
    ewk->my_master = wk;
    ewk->master_work_id = wk->work_id;
    ewk->master_id = wk->id;
    ewk->wu.target_adrs = wk->target_adrs;
    ewk->wu.xyz[0].disp.pos = wk->position_x;
    ewk->wu.xyz[1].disp.pos = wk->position_y;
    ewk->wu.xyz[2].disp.pos = wk->position_z;
    ewk->wu.position_x = wk->position_x;
    ewk->wu.position_y = wk->position_y;
    ewk->wu.position_z = wk->position_z;
    ewk->wu.facing_flag = wk->facing_flag + sel_suikomi_tbl[data][1] & 1;
    ewk->wu.damage_calc_divider = sel_suikomi_tbl[data][2];
    ewk->wu.damage_calc_multiplier = sel_suikomi_tbl[data][3];
    ewk->wu.dir_timer = sel_suikomi_tbl[data][4];
    effect_G3_init(&ewk->wu, 0);
    effect_G3_init(&ewk->wu, 1);
    return 0;
}
