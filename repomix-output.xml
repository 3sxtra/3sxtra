local INPUT_BITS = {
   up = 0x0001, down = 0x0002, left = 0x0004, right = 0x0008,
   LP = 0x0010, MP = 0x0020, HP = 0x0040,
   LK = 0x0100, MK = 0x0200, HK = 0x0400,
   start = 0x0800, coin = 0x1000,
}

