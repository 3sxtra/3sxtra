        ewk->wu.mvxy.a[0].sp = *ptr++;
        ewk->wu.mvxy.a[1].sp = *ptr++;
        ewk->wu.mvxy.d[0].sp = *ptr++;
        ewk->wu.mvxy.d[1].sp = *ptr++;

        if (ewk->wu.facing_flag) {
            ewk->wu.mvxy.a[0].sp = -ewk->wu.mvxy.a[0].sp;
            ewk->wu.mvxy.d[0].sp = -ewk->wu.mvxy.d[0].sp;
        }

        ewk->wu.old_routine_no[0] = ewk->wu.old_routine_no[1] = ewk->wu.old_routine_no[2] = ewk->wu.old_routine_no[3] = 0;
        sync_bg_strip_position(ewk);
        sort_push_request(&ewk->wu);
        return;

    case 1:
        if (!g_state.execute_flag && !g_state.Game_pause) {
            char_move(&ewk->wu);
            add_x_sub(&ewk->wu);
            add_y_sub(&ewk->wu);

            if (ewk->wu.xyz[0].disp.pos >= 785 || ewk->wu.xyz[0].disp.pos < 240) {
                ewk->wu.routine_no[1] = 99;
                g_state.Appear_free[ewk->master_id] = 1;
                ewk->wu.disp_flag = 0;
            }

            if (ewk->master_id) {
                sw_work = p2sw_0;
                hit_pl = &g_state.plw[0];
                pl_hit_ptr = &g_state.plw[0].wu.body_hurtbox->body_dm[0][0];
            } else {
                sw_work = p1sw_0;
                hit_pl = &g_state.plw[1];
                pl_hit_ptr = &g_state.plw[1].wu.body_hurtbox->body_dm[0][0];
            }

            sean_ball_move(ewk, sw_work);

            if (hit_check_subroutine(&hit_pl->wu, &ewk->wu, pl_hit_ptr, sean_ball_hit)) {
                ewk->wu.routine_no[1]++;
                ball_bound_set(ewk);
                set_char_move_init2(&hit_pl->wu, 9, 63, 1, 0);
                g_state.Appear_free[ewk->master_id] = 2;
                effect_B4_init(ewk);
                work = random_16();
                work &= 7;
                add_super_arts_gauge(g_state.plw[ewk->master_id].sa,
                                     g_state.plw[ewk->master_id].wu.id,
                                     1,
                                     g_state.plw[ewk->master_id].metamorphose);
                break;
            }

            if (ewk->wu.xyz[1].disp.pos < 0) {
                Sound_SE((ewk->master_id * 0x300) + 0x157);
                ewk->wu.routine_no[1]++;
                ball_bound_set(ewk);
                g_state.Appear_free[ewk->master_id] = 1;
            }
        }

        sync_bg_strip_position(ewk);
        sort_push_request(&ewk->wu);
        break;

    case 2:
        if (!g_state.execute_flag && !g_state.Game_pause) {
            if ((ewk->wu.xyz[0].disp.pos >= 785 || ewk->wu.xyz[0].disp.pos < 240) || ewk->wu.xyz[1].disp.pos < -56) {
                ewk->wu.routine_no[1]++;
                ewk->wu.disp_flag = 0;
            } else {
                add_x_sub(&ewk->wu);
                add_y_sub(&ewk->wu);
            }
        }

        sync_bg_strip_position(ewk);
        sort_push_request(&ewk->wu);
        break;

    case 3:
        ewk->wu.routine_no[1]++;
        break;

    default:
        Release_Effect(&ewk->wu);
        break;
    }
}

static void sean_ball_move(State_Other* ewk, u16 sw_work) {
    if (!g_state.plw[ewk->master_id].wu.pl_operator) {
        return;
    }

    if (sw_work & 1) {
        ewk->wu.old_routine_no[0]++;

        if (ewk->wu.old_routine_no[0] < 8) {
            ewk->wu.mvxy.d[1].sp += eff09_add_tbl0[ewk->wu.dir_step][0];
        }
    }

    if (sw_work & 2) {
        ewk->wu.old_routine_no[1]++;

        if (ewk->wu.old_routine_no[1] < 8) {
            ewk->wu.mvxy.d[1].sp += eff09_add_tbl0[ewk->wu.dir_step][1];
        }
    }

    if (sw_work & 4) {
        ewk->wu.old_routine_no[2]++;

        if (ewk->wu.facing_flag) {
            if (ewk->wu.old_routine_no[2] < 4) {
                ewk->wu.mvxy.d[0].sp += eff09_add_tbl1[ewk->wu.dir_step][0];
            }
        } else if (ewk->wu.old_routine_no[2] < 8) {
            ewk->wu.mvxy.d[0].sp += eff09_add_tbl2[ewk->wu.dir_step][0];
        }
    }

    if (sw_work & 8) {
        ewk->wu.old_routine_no[3]++;

        if (ewk->wu.facing_flag) {
            if (ewk->wu.old_routine_no[3] < 8) {
                ewk->wu.mvxy.d[0].sp += eff09_add_tbl1[ewk->wu.dir_step][1];
            }
        } else if (ewk->wu.old_routine_no[3] < 4) {
            ewk->wu.mvxy.d[0].sp += eff09_add_tbl2[ewk->wu.dir_step][1];
        }
    }
}

