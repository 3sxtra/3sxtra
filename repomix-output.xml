/** @brief Makoto: attack 1 (Tanden Renki / Hayate chain). */
static void Att_PL17_AT1(PlayerEntity* wk) {
    switch (wk->wu.routine_no[3]) {
    case 0:
        wk->wu.routine_no[3]++;
        wk->wu.facing_flag = wk->wu.active_move;
        wk->scr_pos_set_flag = 0;
        reset_mvxy_data(&wk->wu);
        setup_mvxy_data(&wk->wu, wk->as->r_no);
        wk->wu.mvxy.index = wk->as->data_ix;

        if (g_state.Bonus_Game_Flag != 20 || (g_state.Bonus_Game_Flag == 20 && wk->bs2_on_car == 0)) {
            wk->wu.xyz[1].disp.pos = 0;
        }

        set_char_move_init(&wk->wu, 5, wk->as->char_ix);
        set_kabe_move_spd(&wk->wu, 28);
        wk->rl_save = 0;
        break;

    case 1:
        char_move(&wk->wu);

        if (wk->wu.cg_type == 10) {
            wk->wu.routine_no[3] = 3;
            effect_I3_init(&wk->wu, 2);
        }

        if (wk->wu.routine_no[3] != 1) {
            add_mvxy_speed(&wk->wu);
        }

        break;

    case 2:
        char_move(&wk->wu);

        if (wk->wu.cg_type == 20) {
            setup_mvxy_data(&wk->wu, wk->wu.mvxy.index);
            wk->wu.mvxy.index++;
            wk->wu.routine_no[3] = 3;
            wk->wu.cg_type = 0;
        }

        if (wk->wu.cg_type == 30) {
            setup_mvxy_data(&wk->wu, wk->wu.mvxy.index);
            wk->wu.mvxy.a[1].sp = wk->wu.mvxy.d[1].sp = wk->wu.mvxy.physics_curve_type[1] = 0;
            wk->wu.mvxy.index++;
            wk->wu.routine_no[3] = 4;
            wk->wu.cg_type = 0;
        }

        if (wk->wu.routine_no[3] != 2) {
            add_mvxy_speed(&wk->wu);
        }

        break;

    case 3:
        jumping_union_process(&wk->wu, 2);

        if (wk->wu.routine_no[3] != 2) {
            if (wk->wu.cg_type == 20) {
                setup_mvxy_data(&wk->wu, wk->wu.mvxy.index);
                wk->wu.mvxy.index++;
                wk->wu.cg_type = 0;
            }

            if (wk->wu.cg_type == 21) {
                reset_mvxy_data(&wk->wu);
                wk->wu.cg_type = 0;
                wk->wu.routine_no[3] = 2;
            }

            if (wk->wu.cg_type == 25) {
                wk->wu.cg_type = 0;
                wk->wu.routine_no[3] = 5;
            }
        }

        break;

    case 4:
        char_move(&wk->wu);
        cal_mvxy_speed(&wk->wu);
        add_mvxy_speed(&wk->wu);

        if (wk->wu.cg_type == 20) {
            setup_mvxy_data(&wk->wu, wk->wu.mvxy.index);
            wk->wu.mvxy.index++;
            wk->wu.routine_no[3] = 3;
            wk->wu.cg_type = 0;
        }

        if (wk->wu.cg_type == 21) {
            reset_mvxy_data(&wk->wu);
            wk->wu.cg_type = 0;
            wk->wu.routine_no[3] = 2;
        }

        if (wk->wu.cg_type == 30) {
            setup_mvxy_data(&wk->wu, wk->wu.mvxy.index);
            wk->wu.mvxy.a[1].sp = wk->wu.mvxy.d[1].sp = wk->wu.mvxy.physics_curve_type[1] = 0;
            wk->wu.mvxy.index++;
            wk->wu.cg_type = 0;
        }

        break;

    case 5:
        jumping_union_process(&wk->wu, 2);

        if (wk->wu.routine_no[3] != 2) {
            if (wk->wu.cg_type == 21) {
                reset_mvxy_data(&wk->wu);
                wk->wu.cg_type = 0;
                wk->wu.routine_no[3] = 2;
            }

            if (wk->wu.cg_type == 26) {
                wk->wu.cg_type = 0;
                wk->wu.routine_no[3] = 3;
            }

            if (wk->wu.cg_type == 30) {
                wk->wu.cg_type = 0;
                wk->wu.mvxy.d[0].sp = 0;
            }

            if (wk->rl_save) {
                wk->rl_save = 0;
                wk->wu.routine_no[3] = 2;
                wk->wu.xyz[0].disp.pos = get_center_position();

                if (wk->wu.facing_flag) {
                    wk->wu.xyz[0].disp.pos -= 142;
                } else {
                    wk->wu.xyz[0].disp.pos += 142;
                }
            }
        }

        if ((wk->wu.routine_no[3] == 5) && (kabe_check(&wk->wu))) {
            char_move_cmj4(&wk->wu);
            reset_mvxy_data(&wk->wu);
            wk->rl_save = 1;
        }

        break;
    }
}

/** @brief Makoto: sets wall-bounce movement speed for timed duration. */
static void set_kabe_move_spd(State* wk, s16 tm) {
    s16 tar_pos;

    tar_pos = get_center_position();

    if (wk->facing_flag) {
        tar_pos -= 192;
    } else {
        tar_pos += 192;
    }

    cal_all_speed_data(wk, tm, tar_pos, wk->xyz[1].disp.pos + 120, 2, 2);

    if (!wk->facing_flag) {
        wk->mvxy.a[0].sp = -wk->mvxy.a[0].sp;
        wk->mvxy.d[0].sp = -wk->mvxy.d[0].sp;
    }

    wk->mvxy.physics_curve_type[0] = 1;
}

/** @brief Makoto: checks if character has reached a stage wall. */
static s32 kabe_check(State* wk) {
    s16 tar_pos;

    if (wk->xyz[1].disp.pos < 85) {
        return 0;
    }

    tar_pos = get_center_position();

    if (wk->facing_flag) {
        tar_pos -= 142;

        if (!(wk->xyz[0].disp.pos > tar_pos)) {
            wk->xyz[0].disp.pos = tar_pos;
            return 1;
        }

        return 0;
    }

    tar_pos += 142;

    if (wk->xyz[0].disp.pos >= tar_pos) {
        wk->xyz[0].disp.pos = tar_pos;
        return 1;
    }

    return 0;
}

/** @brief Makoto: attack 2 (Seichusen Godanzuki). */
static void Att_PL17_AT2(PlayerEntity* wk) {
    switch (wk->wu.routine_no[3]) {
    case 0:
        wk->wu.routine_no[3]++;
        wk->wu.facing_flag = wk->wu.active_move;
        force_grounded_state(wk);
        set_char_move_init(&wk->wu, 5, wk->as->char_ix);
        break;

    case 1:
        char_move(&wk->wu);

        if (wk->wu.cg_type == 10) {
            wk->wu.cg_type = 0;
            effect_L8_init(wk);
        }

        break;
    }
}

/** @brief Makoto: special action (tokushu koudou). */
static void Att_PL17_TOKUSHUKOUDOU(PlayerEntity* wk) {
    wk->scr_pos_set_flag = 0;

    switch (wk->wu.routine_no[3]) {
    case 0:
        wk->wu.routine_no[3]++;
        wk->wu.facing_flag = wk->wu.active_move;
        force_grounded_state(wk);
        set_char_move_init(&wk->wu, 5, wk->as->char_ix);
        break;

    case 1:
        char_move(&wk->wu);

        switch (wk->wu.cg_type) {
        case 40:
            wk->wu.cg_type = 0;
            add_sp_arts_gauge_tokushu(wk);
            break;

        case 10:
            wk->wu.cg_type = 0;
            wk->strike_scaling += 10;

            if (wk->strike_scaling > 10) {
                wk->strike_scaling = 10;
            }

            grade_add_personal_action(wk->wu.id);
            break;

        case 20:
            wk->wu.cg_type = 0;
            wk->strike_scaling += 10;

            if (wk->strike_scaling > 20) {
                wk->strike_scaling = 20;
            }

            break;

        case 30:
            wk->wu.routine_no[3]++;

            if (wk->target_combo_success < 3) {
                wk->target_combo_success++;
                wk->py->recover = (wk->py->recover * 110) / 100;
            }

            break;
        }

        break;

    default:
        char_move(&wk->wu);
        break;
    }
}

void (*const pl17_exatt_table[18])(PlayerEntity*) = {
    Att_CHOUCHUURENGEKI, Att_PL17_AT1,     Att_HADOUKEN2,      Att_PL17_AT2, Att_KUUCHUUJINNCHUUWATARI,
    Att_DUMMY,           Att_DUMMY,        Att_DUMMY,          Att_DUMMY,    Att_DUMMY,
    Att_DUMMY,           Att_DUMMY,        Att_DUMMY,          Att_DUMMY,    Att_PL17_TOKUSHUKOUDOU,
    Att_DUMMY,           Att_METAMOR_WAIT, Att_METAMOR_REBIRTH
};
