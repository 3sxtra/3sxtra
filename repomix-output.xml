        <!-- ═══════ REMIX TAB ═══════ -->
        <div data-if="edit_mode == 2" class="tab-content" data-class-disabled="!in_game">
            <div class="control-row">
                <label>Target:</label>
                <input type="checkbox" data-value="remix_target_p1"/> <label>P1</label>
                <input type="checkbox" data-value="remix_target_p2"/> <label>P2</label>
                <input type="checkbox" data-value="remix_target_stage"/> <label>Stage</label>
            </div>
            <div class="control-row">
                <label>Scope:</label>
                <select data-value="remix_scope" class="remix-select">
                    <option value="0">Global (All Colors)</option>
                    <option value="1">Selected Bank Only</option>
                    <option value="2">Ramps (Smart Detect)</option>
                    <option value="3">Checked Banks</option>
                </select>
            </div>
            <div class="control-row">
                <input type="checkbox" data-value="remix_auto_preview"/>
                <label>Auto-Preview</label>
            </div>
            <div class="divider"></div>
            
            <div class="layer-checks">
               <label>Layers:</label>
               <input type="checkbox" data-value="remix_l2"/> <label>L2</label>
               <input type="checkbox" data-value="remix_l0"/> <label>L0</label>
               <input type="checkbox" data-value="remix_l1"/> <label>L1</label>
            </div>
            
            <!-- Effects Scroll Container -- uses data-event-click, not native inputs,
                 because RmlUi scroll containers block native form control events. -->
            <div class="effects-list">
               <div class="effect-row" data-event-click="toggle_fx(0)"><span class="fx-check" data-class-checked="chk_noir"></span><span class="effect-label">Noir</span><span class="fx-btn" data-event-click="fx_dec(0)">-</span><span class="fx-val">{{val_noir}}</span><span class="fx-btn" data-event-click="fx_inc(0)">+</span></div>
               <div class="effect-row" data-event-click="toggle_fx(1)"><span class="fx-check" data-class-checked="chk_miami"></span><span class="effect-label">Miami</span><span class="fx-btn" data-event-click="fx_dec(1)">-</span><span class="fx-val">{{val_miami}}</span><span class="fx-btn" data-event-click="fx_inc(1)">+</span></div>
               <div class="effect-row" data-event-click="toggle_fx(2)"><span class="fx-check" data-class-checked="chk_grindhouse"></span><span class="effect-label">Grindhouse</span><span class="fx-btn" data-event-click="fx_dec(2)">-</span><span class="fx-val">{{val_grindhouse}}</span><span class="fx-btn" data-event-click="fx_inc(2)">+</span></div>
               <div class="effect-row" data-event-click="toggle_fx(3)"><span class="fx-check" data-class-checked="chk_sunrise"></span><span class="effect-label">Sunrise</span><span class="fx-btn" data-event-click="fx_dec(3)">-</span><span class="fx-val">{{val_sunrise}}</span><span class="fx-btn" data-event-click="fx_inc(3)">+</span></div>
               <div class="effect-row" data-event-click="toggle_fx(4)"><span class="fx-check" data-class-checked="chk_noon"></span><span class="effect-label">Noon</span><span class="fx-btn" data-event-click="fx_dec(4)">-</span><span class="fx-val">{{val_noon}}</span><span class="fx-btn" data-event-click="fx_inc(4)">+</span></div>
               <div class="effect-row" data-event-click="toggle_fx(5)"><span class="fx-check" data-class-checked="chk_dusk"></span><span class="effect-label">Dusk</span><span class="fx-btn" data-event-click="fx_dec(5)">-</span><span class="fx-val">{{val_dusk}}</span><span class="fx-btn" data-event-click="fx_inc(5)">+</span></div>
               <div class="effect-row" data-event-click="toggle_fx(6)"><span class="fx-check" data-class-checked="chk_midnight"></span><span class="effect-label">Midnight</span><span class="fx-btn" data-event-click="fx_dec(6)">-</span><span class="fx-val">{{val_midnight}}</span><span class="fx-btn" data-event-click="fx_inc(6)">+</span></div>
               <div class="effect-row" data-event-click="toggle_fx(7)"><span class="fx-check" data-class-checked="chk_stormy"></span><span class="effect-label">Stormy</span><span class="fx-btn" data-event-click="fx_dec(7)">-</span><span class="fx-val">{{val_stormy}}</span><span class="fx-btn" data-event-click="fx_inc(7)">+</span></div>
               <div class="effect-row" data-event-click="toggle_fx(8)"><span class="fx-check" data-class-checked="chk_neon_night"></span><span class="effect-label">Neon-night</span><span class="fx-btn" data-event-click="fx_dec(8)">-</span><span class="fx-val">{{val_neon_night}}</span><span class="fx-btn" data-event-click="fx_inc(8)">+</span></div>
               <div class="effect-row" data-event-click="toggle_fx(9)"><span class="fx-check" data-class-checked="chk_cold_steel"></span><span class="effect-label">Cold Steel</span><span class="fx-btn" data-event-click="fx_dec(9)">-</span><span class="fx-val">{{val_cold_steel}}</span><span class="fx-btn" data-event-click="fx_inc(9)">+</span></div>
               <div class="effect-row" data-event-click="toggle_fx(10)"><span class="fx-check" data-class-checked="chk_heatwave"></span><span class="effect-label">Heatwave</span><span class="fx-btn" data-event-click="fx_dec(10)">-</span><span class="fx-val">{{val_heatwave}}</span><span class="fx-btn" data-event-click="fx_inc(10)">+</span></div>
               <div class="effect-row" data-event-click="toggle_fx(11)"><span class="fx-check" data-class-checked="chk_grad_curve"></span><span class="effect-label">Gradient Curve</span><span class="fx-btn" data-event-click="fx_dec(11)">-</span><span class="fx-val">{{val_grad_curve}}</span><span class="fx-btn" data-event-click="fx_inc(11)">+</span></div>
               <div class="effect-row" data-event-click="toggle_fx(12)"><span class="fx-check" data-class-checked="chk_posterize"></span><span class="effect-label">Posterize</span><span class="fx-btn" data-event-click="fx_dec(12)">-</span><span class="fx-val">{{val_posterize}}</span><span class="fx-btn" data-event-click="fx_inc(12)">+</span></div>
               <div class="effect-row" data-event-click="toggle_fx(13)"><span class="fx-check" data-class-checked="chk_dither"></span><span class="effect-label">Dither-Friendly</span><span class="fx-btn" data-event-click="fx_dec(13)">-</span><span class="fx-val">{{val_dither}}</span><span class="fx-btn" data-event-click="fx_inc(13)">+</span></div>
               <div class="effect-row" data-event-click="toggle_fx(14)"><span class="fx-check" data-class-checked="chk_edge"></span><span class="effect-label">Edge Accent</span><span class="fx-btn" data-event-click="fx_dec(14)">-</span><span class="fx-val">{{val_edge}}</span><span class="fx-btn" data-event-click="fx_inc(14)">+</span></div>
               <div class="effect-row" data-event-click="toggle_fx(15)"><span class="fx-check" data-class-checked="chk_neonizer"></span><span class="effect-label">Neonizer</span><span class="fx-btn" data-event-click="fx_dec(15)">-</span><span class="fx-val">{{val_neonizer}}</span><span class="fx-btn" data-event-click="fx_inc(15)">+</span></div>
               <div class="effect-row" data-event-click="toggle_fx(16)"><span class="fx-check" data-class-checked="chk_fg_pop"></span><span class="effect-label">Foreground Pop</span><span class="fx-btn" data-event-click="fx_dec(16)">-</span><span class="fx-val">{{val_fg_pop}}</span><span class="fx-btn" data-event-click="fx_inc(16)">+</span></div>
               <div class="effect-row" data-event-click="toggle_fx(17)"><span class="fx-check" data-class-checked="chk_bg_wash"></span><span class="effect-label">Background Wash</span><span class="fx-btn" data-event-click="fx_dec(17)">-</span><span class="fx-val">{{val_bg_wash}}</span><span class="fx-btn" data-event-click="fx_inc(17)">+</span></div>
               <div class="effect-row" data-event-click="toggle_fx(18)"><span class="fx-check" data-class-checked="chk_crt"></span><span class="effect-label">CRT / Arcade</span><span class="fx-btn" data-event-click="fx_dec(18)">-</span><span class="fx-val">{{val_crt}}</span><span class="fx-btn" data-event-click="fx_inc(18)">+</span></div>
               <div class="effect-row" data-event-click="toggle_fx(19)"><span class="fx-check" data-class-checked="chk_cel"></span><span class="effect-label">Comic / Cel</span><span class="fx-btn" data-event-click="fx_dec(19)">-</span><span class="fx-val">{{val_cel}}</span><span class="fx-btn" data-event-click="fx_inc(19)">+</span></div>
            </div>
            
            <div class="divider"></div>
            <div class="picker-buttons">
                <button class="btn btn-reset" data-event-click="remix_reset">RESET</button>
                <button class="btn btn-save" data-class-applied="apply_flash" data-event-click="remix_apply">{{ apply_label }}</button>
            </div>
            <div class="committed-status" data-if="committed_p1 || committed_p2 || committed_stage">
                <span class="commit-label">Locked:</span>
                <span data-if="committed_p1" class="commit-tag">P1</span>
                <span data-if="committed_p2" class="commit-tag">P2</span>
                <span data-if="committed_stage" class="commit-tag">STG</span>
            </div>
        </div>

        <!-- ═══════ COLOR PICKER ═══════ -->
        <div data-if="picker_active" class="picker-panel">
            <div class="divider"></div>
            <h2>COLOR EDITOR — Index {{ sel_index }}</h2>
            <div class="picker-compressed">
                <div class="picker-sliders">
                    <div class="control-row picker-slider">
                        <label class="channel-label r-label">R</label>
                        <input type="range" min="0" max="31" step="1" data-value="sel_r"/>
                        <span class="channel-value">{{ sel_r }}</span>
                    </div>
                    <div class="control-row picker-slider">
                        <label class="channel-label g-label">G</label>
                        <input type="range" min="0" max="31" step="1" data-value="sel_g"/>
                        <span class="channel-value">{{ sel_g }}</span>
                    </div>
                    <div class="control-row picker-slider">
                        <label class="channel-label b-label">B</label>
                        <input type="range" min="0" max="31" step="1" data-value="sel_b"/>
                        <span class="channel-value">{{ sel_b }}</span>
                    </div>
                </div>
                <!-- Previews in an adjacent column -->
                <div class="picker-previews">
                    <div class="preview-box">
                        <span class="preview-label">Original</span>
                        <div class="preview-swatch" data-style-background-color="sel_original"></div>
                    </div>
                    <div class="preview-box">
                        <span class="preview-label">Modified</span>
                        <div class="preview-swatch" data-style-background-color="sel_preview"></div>
                    </div>
                </div>
            </div>

            <div class="picker-buttons">
                <button class="btn btn-reset" data-event-click="reset_color">RESET</button>
                <button class="btn btn-close" data-event-click="close_picker">CLOSE</button>
            </div>
        </div>

        <!-- ═══════ SAVE / LOAD ═══════ -->
        <div class="save-panel" data-if="in_game && !picker_active">
            <div class="divider"></div>
            <h2>SAVE / LOAD</h2>

            <!-- Save row -->
            <div class="control-row">
                <label>Name:</label>
                <input type="text" data-value="save_name" class="name-input"
                       placeholder="my_palette"/>
                <button class="btn btn-save" data-event-click="do_save">SAVE</button>
            </div>

            <!-- Load browser -->
            <div class="control-row" data-if="saved_count > 0">
                <button class="btn btn-nav" data-event-click="prev_palette">◀</button>
                <span class="palette-name">{{ selected_name }}</span>
                <button class="btn btn-nav" data-event-click="next_palette">▶</button>
                <button class="btn btn-load" data-event-click="do_load">LOAD</button>
                <button class="btn btn-delete" data-event-click="do_delete">DEL</button>
            </div>
            <p data-if="saved_count == 0" class="status-warn">No saved palettes</p>
        </div>

        <div class="divider"></div>
        <p class="hint">Saved per character · Press F10 to close</p>
    </div>
</body>
</rml>
</file>

<file path="assets/ui/pause.rcss">
/* ============================================================ *
 *  pause.rcss  —  Pause text overlay stylesheet                *
 *  Blink cycle: 60 frames visible / 30 frames hidden           *
 *  (1.0s on / 0.5s off at 60fps)                               *
 * ============================================================ */

body {
    width: 384dp;
    height: 224dp;
    font-family: "DistrictTF-RegularItalic";
    font-size: 15dp;
}

/* ── Pause text ────────────────────────────────────────────── */
#pause-text {
    display: block;
    position: absolute;
    top: 90dp;
    left: 0dp;
    width: 384dp;
    text-align: center;
}

.pause-label {
    display: inline-block;
    font-size: 20dp;
    color: #ffffff;
    font-effect: shadow(2dp 2dp #000000);
    animation: pause-blink 1.5s steps(1) infinite;
}

@keyframes pause-blink {
      0% { visibility: visible; }
     67% { visibility: hidden; }
    100% { visibility: visible; }
}

/* ── Controller disconnect ─────────────────────────────────── */
#ctrl-disconnect {
    display: block;
    position: absolute;
    top: 82dp;
    left: 132dp;
    width: 120dp;
}

.disconnect-line {
    display: block;
    font-size: 12dp;
    color: #ffffff;
    font-effect: shadow(1dp 1dp #000000);
    line-height: 16dp;
    text-align: left;
}
</file>

<file path="assets/ui/pause.rml">
<rml>
<head>
    <title>Pause Overlay</title>
    <link type="text/rcss" href="base.rcss"/>
    <link type="text/rcss" href="pause.rcss"/>
</head>
<body data-model="pause_overlay" id="pause-root">
    <!-- Pause text blink -->
    <div id="pause-text" data-if="pause_visible">
        <div class="pause-label">{{pause_label}}</div>
    </div>

    <!-- Controller disconnected message -->
    <div id="ctrl-disconnect" data-if="ctrl_disconnected">
        <div class="disconnect-line">Please reconnect</div>
        <div class="disconnect-line">the controller to</div>
        <div class="disconnect-line">controller port {{disconnect_port}}.</div>
    </div>
</body>
</rml>
</file>

<file path="assets/ui/player_profile.rcss">
/* ─── Player Profile ────────────────────────────────────────────── */
/* 384×224 game canvas — every dp matters. No scrolling allowed.    */

#profile-panel {
    display: block;
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 0;
    overflow: hidden;
    background-color: rgba(10, 12, 22, 230);
    border-width: 1dp;
    border-color: rgba(100, 130, 220, 80);
}

/* ─── Title bar (compact) ──────────────────────────────────────── */

#profile-title-bar {
    display: block;
    height: 14dp;
    padding: 1dp 8dp 0dp 8dp;
    text-align: center;
    border-bottom-width: 1dp;
    border-bottom-color: rgba(255, 255, 255, 200);
}

#profile-title-text {
    display: block;
    font-size: 14dp;
    color: #fff;
    font-weight: bold;
    font-effect: shadow(1dp 1dp rgba(0, 0, 0, 120));
    text-align: center;
    background-color: transparent;
}

/* ─── Body grid Layout (absolute positioned, no overflow) ─────── */

#profile-body {
    display: block;
}

.profile-card {
    display: block;
    position: absolute;
    background-color: rgba(0, 6, 28, 180);
    border-width: 1dp;
    border-color: rgba(80, 120, 220, 70);
    padding: 2dp 4dp 4dp 4dp;
}

#panel-identity {
    left: 1dp;
    top: 17dp;
    width: 150dp;
    height: 66dp;
}

#panel-rank {
    left: 162dp;
    top: 17dp;
    right: 1dp;
    height: 66dp;
}

#panel-stats {
    left: 1dp;
    top: 84dp;
    width: 150dp;
    bottom: 15dp;
}

#panel-history {
    left: 162dp;
    top: 84dp;
    right: 1dp;
    bottom: 15dp;
}

/* ─── Section headers (tight) ────────────────────────────────── */

.card-header {
    display: block;
    font-size: 11dp;
    font-weight: bold;
    color: rgba(240, 250, 255, 255);
    background-color: rgba(30, 45, 90, 200);
    padding: 1dp 4dp 0dp 4dp;
    margin-bottom: 3dp;
    border-bottom-width: 1dp;
    border-bottom-color: rgba(100, 150, 255, 200);
    font-effect: shadow(1dp 1dp rgba(0, 0, 0, 150));
    letter-spacing: 1dp;
}

/* ─── Identity Panel ─────────────────────────────────────────── */

#identity-content {
    display: block;
    text-align: center;
    padding-top: 6dp;
}

#avatar-img {
    display: inline-block;
    vertical-align: middle;
    margin-right: 6dp;
    width: 32dp;
    height: 32dp;
    border-width: 1dp;
    border-color: rgba(150, 180, 255, 100);
}

#identity-info {
    display: inline-block;
    vertical-align: middle;
    text-align: center;
}

#player-name {
    display: block;
    font-size: 15dp;
    color: rgba(255, 210, 70, 255);
    font-weight: bold;
    font-effect: shadow(1dp 1dp rgba(0, 0, 0, 180));
    text-align: center;
    white-space: nowrap;
    overflow: hidden;
}

#player-title {
    display: block;
    font-size: 11dp;
    color: rgba(160, 190, 240, 200);
    margin-top: 1dp;
    text-align: center;
}

/* ─── Rows (Label + Value) ───────────────────────────────────── */

.profile-row {
    display: block;
    padding: 1dp 2dp;
    margin-bottom: 0dp;
    font-size: 11dp;
}

.lbl {
    display: inline;
    width: 75dp;
    font-size: 10dp;
    color: rgba(150, 180, 230, 180);
}

.val {
    display: inline;
    font-size: 11dp;
    color: #fff;
    margin-left: 2dp;
    font-weight: bold;
}

.val.bad {
    color: rgba(255, 80, 80, 255);
}

.val.good {
    color: rgba(90, 240, 150, 255);
}

.tier-val {
    color: rgba(255, 235, 100, 255);
}

/* ─── Match History List ─────────────────────────────────────── */

#history-list {
    display: block;
    overflow: hidden;
}

.history-item {
    display: block;
    padding: 1dp 2dp;
    color: rgba(190, 200, 225, 180);
    font-size: 11dp;
    border-left-width: 2dp;
    border-left-color: transparent;
    white-space: nowrap;
}

.history-item.hidden {
    display: none;
}

.history-item.selected {
    color: rgba(255, 255, 255, 255);
    border-left-color: rgba(255, 210, 40, 230);
    background-color: rgba(255, 220, 0, 25);
}

.hist-result {
    display: inline-block;
    width: 22dp;
    font-size: 11dp;
    font-weight: bold;
}

.hist-result.loss {
    color: rgba(255, 100, 100, 255); /* Loss */
}

.hist-result.win {
    color: rgba(90, 220, 100, 255); /* Win */
}

.hist-char {
    display: inline-block;
    width: 32dp;
    text-align: center;
    color: rgba(220, 180, 80, 180);
    font-size: 10dp;
}

.hist-vs {
    display: inline-block;
    width: 10dp;
    text-align: center;
    font-size: 10dp;
    color: rgba(120, 140, 180, 150);
}

.player-flag {
    display: inline-block;
    width: 10dp;
    height: 7dp;
    margin: 0 2dp;
    vertical-align: middle;
}

.hist-name {
    display: inline-block;
    font-size: 11dp;
    color: rgba(200, 220, 255, 230);
    width: 48dp;
    overflow: hidden;
    white-space: nowrap;
    vertical-align: middle;
}

.hist-status {
    display: inline-block;
    font-size: 10dp;
    width: 30dp;
    text-align: right;
    color: rgba(255, 210, 70, 200);
}

.history-empty {
    display: block;
    font-size: 11dp;
    color: rgba(140, 150, 180, 100);
    padding: 2dp 4dp;
}

/* ─── Status bar (pinned bottom) ─────────────────────────────── */

#status-bar {
    display: block;
    position: absolute;
    bottom: 1dp;
    left: 1dp;
    right: 1dp;
    padding: 1dp 6dp;
    background-color: rgba(0, 8, 30, 160);
    border-width: 1dp;
    border-color: rgba(80, 120, 220, 50);
}

#status-text {
    display: block;
    font-size: 11dp;
    color: rgba(255, 210, 70, 240);
}
</file>

<file path="assets/ui/player_profile.rml">
<rml>
<head>
    <link type="text/rcss" href="base.rcss"/>
    <link type="text/rcss" href="player_profile.rcss"/>
    <title>Player Profile</title>
</head>
<body data-model="player_profile">
<div id="profile-panel">

    <!-- ── Title bar ── -->
    <div id="profile-title-bar">
        <div id="profile-title-text">PLAYER PROFILE</div>
    </div>

    <!-- ── Main content grid ── -->
    <div id="profile-body">
        
        <!-- Top Left: Identity -->
        <div id="panel-identity" class="profile-card">
            <div class="card-header">IDENTITY</div>
            <div id="identity-content">
                <img id="avatar-img" data-attr-src="avatar_url" data-if="avatar_url != ''"/>
                <div id="identity-info">
                    <div id="player-name">{{player_name}}</div>
                    <div id="player-title">{{player_title}}</div>
                </div>
            </div>
        </div>

        <!-- Top Right: Rank & Rating -->
        <div id="panel-rank" class="profile-card">
            <div class="card-header">RANK &amp; RATING</div>
            <div class="profile-row">
                <span class="lbl">TIER</span>
                <span class="val tier-val">{{tier}}</span>
            </div>
            <div class="profile-row">
                <span class="lbl">RATING</span>
                <span class="val">{{rating}} RP</span>
            </div>
            <div class="profile-row">
                <span class="lbl">GLOBAL RANK</span>
                <span class="val">{{global_rank}}</span>
            </div>
        </div>

        <!-- Bottom Left: Match Stats & Network Health -->
        <div id="panel-stats" class="profile-card">
            <div class="card-header">MATCH STATS</div>
            <div class="profile-row">
                <span class="lbl">RECORD</span>
                <span class="val">{{wins}} W - {{losses}} L</span>
            </div>
            <div class="profile-row">
                <span class="lbl">WIN RATE</span>
                <span class="val">{{win_rate}}</span>
            </div>
            <div class="profile-row">
                <span class="lbl">BEST STREAK</span>
                <span class="val">{{max_streak}}</span>
            </div>
            
            <div class="card-header" style="margin-top: 6dp;">NETWORK HEALTH</div>
            <div class="profile-row">
                <span class="lbl">DISCONNECTS</span>
                <span class="val" data-class-bad="disconnects_bad">{{disconnects}}%</span>
            </div>
            <div class="profile-row">
                <span class="lbl">STATUS</span>
                <span class="val" data-class-bad="status_bad" data-class-good="status_good">{{network_status}}</span>
            </div>
        </div>

        <!-- Bottom Right: Match History / Replays -->
        <div id="panel-history" class="profile-card">
            <div class="card-header">RECENT MATCHES</div>
            <div id="history-list">
                <div data-for="m : match_history" class="history-item" data-class-hidden="!m.is_valid" data-class-selected="m.selected">
                    <span class="hist-result" data-class-win="m.is_win" data-class-loss="!m.is_win">{{m.result_str}}</span>
                    <span class="hist-char">{{m.player_char_name}}</span>
                    <span class="hist-vs">vs</span>
                    <span class="hist-char">{{m.opponent_char_name}}</span>
                    <img class="player-flag" data-if="m.opponent_country != ''" data-attr-src="'../flags_icons/' + m.opponent_country + '.png'"/>
                    <span class="hist-name">{{m.opponent_name}}</span>
                    <span class="hist-status">{{m.replay_status}}</span>
                </div>
                <div class="history-empty" data-if="match_history_count == 0">No recent matches found.</div>
            </div>
        </div>

    </div>

    <!-- ── Status bar ── -->
    <div id="status-bar" data-if="status_text != ''">
        <span id="status-text">{{status_text}}</span>
    </div>

</div>
</body>
</rml>
</file>

<file path="assets/ui/ranked_matchmaking.rcss">
/* ─── Ranked Matchmaking ────────────────────────────────────────── */
/* Derived from network_lobby.rcss — simplified for ranked focus.    */

#lobby-panel {
    display: block;
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 0;
    overflow: hidden;
    background-color: rgba(6, 8, 18, 210);
    border-width: 1dp;
    border-color: rgba(80, 110, 200, 80);
}

/* ─── Title bar (compact) ──────────────────────────────────────── */

#lobby-title-bar {
    display: block;
    height: 14dp;
    padding: 1dp 8dp 0dp 8dp;
    text-align: center;
    border-top-width: 1dp;
    border-top-color: rgba(255, 255, 255, 200);
    border-bottom-width: 1dp;
    border-bottom-color: rgba(255, 255, 255, 200);
}

#lobby-title-text {
    display: block;
    font-size: 14dp;
    color: #fff;
    font-weight: bold;
    font-effect: shadow(1dp 1dp rgba(0, 0, 0, 120));
    text-align: center;
    background-color: transparent;
}

/* ─── Two-column body ────────────────────────────────────────── */

#lobby-body {
    display: block;
}

#lobby-menu-col {
    display: block;
    position: absolute;
    left: 1dp;
    top: 17dp;
    width: 150dp;
    bottom: 15dp;
}

#lobby-peers-col {
    display: block;
    position: absolute;
    left: 152dp;
    top: 17dp;
    right: 1dp;
    bottom: 15dp;
}

/* ─── Section headers ────────────────────────────────────────── */

.section-header {
    display: block;
    font-size: 10dp;
    color: rgba(170, 200, 255, 170);
    padding: 0dp 0dp;
    margin-top: 2dp;
    margin-bottom: 1dp;
    border-bottom-width: 1dp;
    border-bottom-color: rgba(100, 130, 220, 60);
}

.net-header {
    margin-top: 3dp;
}

/* ─── Menu rows ──────────────────────────────────────────────── */

.lobby-row {
    display: block;
    padding: 0dp 3dp;
    margin-bottom: 0dp;
    color: rgba(210, 220, 255, 210);
    font-size: 12dp;
    border-left-width: 2dp;
    border-left-color: transparent;
    transition: background-color border-left-color 0.08s linear-in-out;
}

.lobby-row.focused {
    background-color: rgba(255, 220, 0, 30);
    border-left-color: rgba(255, 210, 40, 240);
    color: #fff;
}

.lobby-cell-label {
    display: inline;
    width: 95dp;
    font-size: 12dp;
}

.lobby-cell-value {
    display: inline;
    font-size: 12dp;
    color: rgba(170, 180, 210, 200);
    margin-left: 3dp;
}

.lobby-cell-value.on {
    color: rgba(90, 240, 150, 255);
}

.exit-row {
    position: absolute;
    bottom: 2dp;
    left: 0;
    right: 0;
    margin-top: 0;
    border-top-width: 1dp;
    border-top-color: rgba(100, 130, 220, 50);
    padding-top: 2dp;
}

/* ─── Peer panel cards ───────────────────────────────────────── */

.peer-panel {
    display: block;
    position: absolute;
    top: 2dp;
    bottom: 3dp;
    left: 0;
    right: 0;
    background-color: rgba(0, 6, 28, 180);
    border-width: 1dp;
    border-color: rgba(80, 120, 220, 70);
    padding: 0dp 4dp 3dp 4dp;
}

.peer-panel-header {
    display: block;
    margin-bottom: 1dp;
    border-bottom-width: 1dp;
    border-bottom-color: rgba(80, 120, 220, 50);
    padding-bottom: 1dp;
}

.peer-panel-title {
    display: inline;
    font-size: 11dp;
    color: rgba(150, 185, 245, 200);
}

.peer-panel-count {
    display: inline;
    font-size: 10dp;
    color: rgba(90, 240, 150, 230);
    margin-left: 4dp;
}

.peer-panel-count.searching {
    color: rgba(255, 210, 70, 210);
}

.peer-panel-count.idle {
    color: rgba(160, 170, 195, 100);
}

/* ─── Peer list rows ─────────────────────────────────────────── */

.peer-list {
    display: block;
}

.peer-list-item {
    display: block;
    padding: 0dp 2dp;
    color: rgba(190, 200, 225, 180);
    font-size: 11dp;
    border-left-width: 2dp;
    border-left-color: transparent;
    overflow: hidden;
    white-space: nowrap;
}

.peer-list-item.selected {
    color: rgba(255, 235, 100, 255);
    border-left-color: rgba(255, 210, 40, 230);
    background-color: rgba(255, 220, 0, 18);
}

.peer-list-name {
    display: inline;
    font-size: 11dp;
}

.peer-list-ping {
    display: inline;
    font-size: 10dp;
    margin-left: 3dp;
    color: rgba(160, 170, 195, 150);
}

.peer-list-ping.ping-good {
    color: rgba(80, 235, 130, 240);
}

.peer-list-ping.ping-ok {
    color: rgba(255, 200, 60, 230);
}

.peer-list-ping.ping-bad {
    color: rgba(255, 80, 80, 220);
}

.peer-list-flag {
    display: inline;
    width: 12dp;
    height: 8dp;
    margin-right: 2dp;
    vertical-align: baseline;
}

.peer-list-conn {
    display: inline;
    font-size: 9dp;
    color: rgba(140, 160, 190, 130);
    margin-left: 2dp;
}

.peer-list-conn.wifi {
    color: rgba(255, 170, 60, 210);
}

.peer-list-empty {
    display: block;
    font-size: 10dp;
    color: rgba(140, 150, 180, 100);
    padding: 1dp 3dp;
}

.peer-list-empty.searching {
    color: rgba(255, 210, 70, 160);
}

/* ─── Status bar (pinned bottom) ─────────────────────────────── */

#status-bar {
    display: block;
    position: absolute;
    bottom: 1dp;
    left: 1dp;
    right: 1dp;
    padding: 1dp 6dp;
    background-color: rgba(0, 8, 30, 160);
    border-width: 1dp;
    border-color: rgba(80, 120, 220, 50);
}

#status-text {
    display: block;
    font-size: 11dp;
    color: rgba(255, 210, 70, 240);
}

/* ─── Popup overlay ──────────────────────────────────────────── */

#popup-scrim {
    display: block;
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 175);
}

#popup-box {
    display: block;
    position: absolute;
    top: 40dp;
    left: 30dp;
    right: 30dp;
    padding: 6dp 10dp;
    background-color: rgba(8, 12, 26, 245);
    border-width: 2dp;
    border-color: rgba(210, 15, 15, 220);
    border-radius: 3dp;
}

.popup-title {
    display: block;
    text-align: center;
    font-size: 13dp;
    color: rgba(255, 210, 70, 255);
    margin-bottom: 3dp;
    border-bottom-width: 1dp;
    border-bottom-color: rgba(150, 30, 30, 120);
    padding-bottom: 2dp;
}

.popup-name {
    display: block;
    text-align: center;
    font-size: 13dp;
    color: #fff;
    margin-bottom: 2dp;
}

.popup-ping {
    display: block;
    text-align: center;
    font-size: 11dp;
    color: rgba(140, 210, 255, 230);
    margin-bottom: 2dp;
}

.popup-region {
    display: block;
    text-align: center;
    font-size: 11dp;
    color: rgba(170, 180, 210, 175);
    margin-bottom: 3dp;
}

.popup-ft {
    display: block;
    text-align: center;
    font-size: 11dp;
    color: rgba(255, 235, 100, 220);
    margin-bottom: 2dp;
}

.popup-actions {
    display: block;
    text-align: center;
    margin-top: 3dp;
    padding-top: 3dp;
    border-top-width: 1dp;
    border-top-color: rgba(90, 110, 155, 76);
}

.popup-accept {
    display: inline;
    font-size: 12dp;
    color: rgba(70, 230, 110, 255);
    margin-right: 16dp;
}

.popup-decline {
    display: inline;
    font-size: 12dp;
    color: rgba(255, 70, 70, 255);
}

.popup-cancel {
    display: inline;
    font-size: 12dp;
    color: rgba(255, 70, 70, 255);
}
</file>

<file path="assets/ui/ranked_matchmaking.rml">
<rml>
<head>
    <link type="text/rcss" href="base.rcss"/>
    <link type="text/rcss" href="ranked_matchmaking.rcss"/>
    <title>Ranked Matchmaking</title>
</head>
<body data-model="ranked_matchmaking">
<div id="lobby-panel">

    <!-- ── Title bar ── -->
    <div id="lobby-title-bar">
        <div id="lobby-title-text">RANKED MATCHMAKING</div>
    </div>

    <!-- ── Main content ── -->
    <div id="lobby-body">

        <!-- Left: menu column (Internet settings only) -->
        <div id="lobby-menu-col">
            <div class="section-header net-header">INTERNET SETTINGS</div>

            <div class="lobby-row" data-class-focused="cursor == 0">
                <span class="lobby-cell-label">AUTO-ACCEPT</span>
                <span class="lobby-cell-value" data-class-on="net_auto">{{net_auto ? 'ON' : 'OFF'}}</span>
            </div>
            <div class="lobby-row" data-class-focused="cursor == 1">
                <span class="lobby-cell-label">AUTO-SEARCH</span>
                <span class="lobby-cell-value" data-class-on="net_search_toggle">{{net_search_toggle ? 'ON' : 'OFF'}}</span>
            </div>
            <div class="lobby-row" data-class-focused="cursor == 2">
                <span class="lobby-cell-label">REGION LOCK</span>
                <span class="lobby-cell-value" data-class-on="region_lock">{{region_lock ? 'ON' : 'OFF'}}</span>
            </div>
            <div class="lobby-row" data-class-focused="cursor == 3">
                <span class="lobby-cell-label">MAX PING</span>
                <span class="lobby-cell-value">{{max_ping == 0 ? 'OFF' : max_ping + 'ms'}}</span>
            </div>
            <div class="lobby-row" data-class-focused="cursor == 4">
                <span class="lobby-cell-label">BLOCK WIFI</span>
                <span class="lobby-cell-value" data-class-on="block_wifi">{{block_wifi ? 'ON' : 'OFF'}}</span>
            </div>
            <div class="lobby-row" data-class-focused="cursor == 5">
                <span class="lobby-cell-label">MATCH FT</span>
                <span class="lobby-cell-value">{{ft_value == 1 ? 'UNRANKED' : 'FT' + ft_value}}</span>
            </div>
            <div class="lobby-row" data-class-focused="cursor == 6">
                <span class="lobby-cell-label">CONNECT</span>
                <span class="lobby-cell-value peer-val">{{net_peer_name}}</span>
            </div>

            <div class="lobby-row exit-row" data-class-focused="cursor == 7">
                <span class="lobby-cell-label">EXIT</span>
            </div>
        </div>

        <!-- Right: peer panels column (Online only) -->
        <div id="lobby-peers-col">

            <!-- Online Peers (Large) -->
            <div class="peer-panel">
                <div class="peer-panel-header">
                    <span class="peer-panel-title">ONLINE PLAYERS</span>
                    <span class="peer-panel-count" data-if="net_searching &amp;&amp; net_peer_count > 0">{{net_peer_count}} online</span>
                    <span class="peer-panel-count searching" data-if="net_searching &amp;&amp; net_peer_count == 0">searching...</span>
                    <span class="peer-panel-count idle" data-if="!net_searching">idle</span>
                </div>
                <div class="peer-list">
                    <div data-for="p : net_peers"
                         class="peer-list-item"
                         data-class-selected="p.selected">
                        <img class="peer-list-flag" data-attr-src="p.flag_icon" data-if="p.flag_icon != ''"/>
                        <span class="peer-list-name">{{p.name}}</span>
                        <span class="peer-list-conn" data-class-wifi="p.conn_type == 'wifi'">{{p.conn_type == 'wifi' ? 'WiFi' : ''}}</span>
                        <span class="peer-list-ping" data-class-ping-good="p.ping_class == 'ping-good'"
                              data-class-ping-ok="p.ping_class == 'ping-ok'"
                              data-class-ping-bad="p.ping_class == 'ping-bad'">{{p.ping_label}}</span>
                    </div>
                    <div class="peer-list-empty" data-if="!net_searching">
                        <span data-if="net_is_configured">enable search to find players</span>
                        <span data-if="!net_is_configured">lobby server not configured</span>
                    </div>
                    <div class="peer-list-empty searching" data-if="net_searching &amp;&amp; net_peer_count == 0">
                        looking for players...
                    </div>
                </div>
            </div>

        </div><!-- lobby-peers-col -->
    </div><!-- lobby-body -->

    <!-- ── Status bar ── -->
    <div id="status-bar" data-if="status_text != ''">
        <span id="status-text">{{status_text}}</span>
    </div>

    <!-- ── Popup overlay (reusing logic from network lobby) ── -->
    <div data-if="popup_type > 0" id="popup-scrim">
        <div id="popup-box">
            <div class="popup-title">{{popup_title}}</div>
            <div class="popup-name">{{popup_name}}</div>
            <div class="popup-ping" data-if="popup_ping != ''">PING: {{popup_ping}}</div>
            <div class="popup-region" data-if="popup_region != ''">{{popup_region}}</div>
            <div class="popup-ft" data-if="popup_ft != ''">{{popup_ft}}</div>
            <div class="popup-actions" data-if="popup_is_incoming">
                <span class="popup-accept">[LP] ACCEPT</span>
                <span class="popup-decline">[MK] DECLINE</span>
            </div>
            <div class="popup-actions" data-if="!popup_is_incoming">
                <span class="popup-cancel">[MK] CANCEL</span>
            </div>
        </div>
    </div>

</div>
</body>
</rml>
</file>

<file path="assets/ui/replay_picker.rcss">
/* ─── Replay Picker ──────────────────────────────────────────── */
/* 384×224 game canvas — strict dp metrics                        */
/* Modeled after leaderboard.rcss — full-screen dark panel        */

#rp-panel {
    display: block;
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 0;
    overflow: hidden;
    background-color: rgba(6, 8, 18, 220);
    border-width: 1dp;
    border-color: rgba(80, 110, 200, 80);
}

/* ── Title bar ── */
#rp-title-bar {
    display: block;
    height: 16dp;
    padding: 3dp 8dp 1dp 8dp;
    border-top-width: 1dp;
    border-top-color: rgba(255, 255, 255, 200);
    border-bottom-width: 1dp;
    border-bottom-color: rgba(255, 255, 255, 200);
    text-align: center;
}
#rp-title {
    display: block;
    font-size: 14dp;
    color: #fff;
    font-weight: bold;
    font-effect: shadow(1dp 1dp rgba(0, 0, 0, 120));
    background-color: transparent;
}

/* ── Tab bar ── */
#rp-tab-bar {
    display: block;
    padding: 2dp 8dp 1dp 8dp;
    border-bottom-width: 1dp;
    border-bottom-color: rgba(80, 120, 220, 70);
    text-align: center;
}
.rp-tab {
    display: inline-block;
    font-size: 11dp;
    color: rgba(120, 140, 180, 150);
    padding: 1dp 16dp;
    margin: 0 4dp;
    border-bottom-width: 2dp;
    border-bottom-color: transparent;
}
.rp-tab.active {
    color: rgba(255, 220, 80, 255);
    font-weight: bold;
    border-bottom-color: rgba(255, 210, 40, 230);
}

/* ── Table area ── */
#rp-table {
    display: block;
    position: absolute;
    top: 36dp;
    left: 4dp;
    right: 4dp;
    bottom: 44dp;
    padding: 2dp 2dp;
    background-color: rgba(0, 6, 28, 180);
    border-width: 1dp;
    border-color: rgba(80, 120, 220, 70);
    overflow: hidden;
}

/* ── Header row ── */
.rp-header-row {
    display: block;
    font-size: 10dp;
    color: rgba(140, 170, 230, 200);
    padding: 2dp 0dp;
    margin-bottom: 1dp;
    border-bottom-width: 1dp;
    border-bottom-color: rgba(100, 130, 220, 80);
    white-space: nowrap;
}

/* ── Slot rows ── */
.rp-row {
    display: block;
    color: rgba(190, 200, 225, 180);
    font-size: 11dp;
    padding: 2dp 0dp;
    margin-bottom: 1dp;
    border-left-width: 2dp;
    border-left-color: transparent;
    white-space: nowrap;
}

.rp-row.selected {
    color: rgba(255, 255, 255, 255);
    background-color: rgba(100, 220, 120, 30);
    border-left-color: rgba(100, 220, 120, 230);
}

.rp-row.empty {
    color: rgba(100, 110, 130, 120);
}

.rp-row.empty.selected {
    color: rgba(160, 170, 190, 180);
    background-color: rgba(100, 220, 120, 15);
    border-left-color: rgba(100, 220, 120, 120);
}

/* ── Column widths ── */
.rp-col-num {
    display: inline-block;
    width: 24dp;
    text-align: center;
    color: rgba(100, 220, 120, 200);
    font-size: 11dp;
    font-weight: bold;
}

.rp-row.empty .rp-col-num {
    color: rgba(80, 90, 100, 150);
}

.rp-row.selected .rp-col-num {
    color: rgba(140, 255, 160, 255);
}

.rp-col-p1 {
    display: inline-block;
    width: 60dp;
    text-align: right;
    padding-right: 4dp;
}

.rp-col-p1.winner {
    color: rgba(255, 210, 40, 255);
    font-weight: bold;
}

.rp-col-vs {
    display: inline-block;
    width: 20dp;
    text-align: center;
    font-size: 9dp;
    color: rgba(140, 150, 170, 140);
}

.rp-col-p2 {
    display: inline-block;
    width: 60dp;
    text-align: left;
    padding-left: 4dp;
}

.rp-col-p2.winner {
    color: rgba(255, 210, 40, 255);
    font-weight: bold;
}

.rp-col-char {
    display: inline-block;
    width: 90dp;
    text-align: center;
    font-size: 10dp;
    color: rgba(180, 190, 220, 180);
}

.rp-col-date {
    display: inline-block;
    width: 100dp;
    text-align: center;
    font-size: 10dp;
    color: rgba(140, 170, 210, 160);
}

.rp-col-empty {
    display: inline-block;
    width: 280dp;
    text-align: center;
    font-size: 10dp;
    color: rgba(80, 90, 110, 100);
}

.rp-row.selected .rp-col-empty {
    color: rgba(130, 150, 170, 150);
}

/* ── Empty state ── */
#rp-empty {
    display: block;
    position: absolute;
    top: 36dp;
    left: 4dp;
    right: 4dp;
    bottom: 44dp;
    text-align: center;
    padding: 40dp 0;
    font-size: 11dp;
    color: rgba(140, 150, 180, 120);
}

/* ── Footer ── */
#rp-footer {
    display: block;
    position: absolute;
    bottom: 1dp;
    left: 4dp;
    right: 4dp;
    padding: 1dp 4dp;
    background-color: rgba(0, 8, 30, 160);
    border-width: 1dp;
