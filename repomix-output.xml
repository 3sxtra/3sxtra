      LP = value, MP = value, HP = value,
      LK = value, MK = value, HK = value,
      start = value, coin = value
   }
end

local function decode_input(raw)
   local t = {}
   for name, mask in pairs(INPUT_BITS) do
      t[name] = (raw & mask) ~= 0
   end
   return t
end

