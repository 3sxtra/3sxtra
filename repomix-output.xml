/** @brief  */
s32 Check_Behind(PlayerEntity* wk, State_Other* tmw) {
    if (wk->wu.active_move == 0) {
        if (wk->wu.xyz[0].disp.pos < tmw->wu.xyz[0].disp.pos) {
            return 1;
        }
        return 0;
    } else {
        if (wk->wu.xyz[0].disp.pos > tmw->wu.xyz[0].disp.pos) {
            return 1;
        }
        return 0;
    }
}

