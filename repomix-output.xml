<file path="assets/ui/leaderboard.rcss">
/* ─── Leaderboard ─────────────────────────────────────────────── */
/* 384×224 game canvas — strict dp metrics                         */
/* Columns: # | Flag | Player | Char | W/M | WIN% | GRD | Rating | DC% */

#lb-panel {
    display: block;
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 0;
    overflow: hidden;
    background-color: rgba(6, 8, 18, 220);
    border-width: 1dp;
    border-color: rgba(80, 110, 200, 80);
}

/* ── Title bar (compact) ── */
#lb-title-bar {
    display: block;
    height: 14dp;
    padding: 2dp 8dp 1dp 8dp;
    border-top-width: 1dp;
    border-top-color: rgba(255, 255, 255, 200);
    border-bottom-width: 1dp;
    border-bottom-color: rgba(255, 255, 255, 200);
    text-align: center;
}
#lb-title {
    display: block;
    font-size: 11dp;
    color: #fff;
    font-weight: bold;
    font-effect: shadow(1dp 1dp rgba(0, 0, 0, 120));
    background-color: transparent;
}
#lb-total {
    display: block;
    position: absolute;
    right: 8dp;
    top: 5dp;
    font-size: 10dp;
    color: rgba(170, 200, 255, 170);
}

/* ── Loading ── */
#lb-loading {
    display: block;
    text-align: center;
    padding: 80dp 0;
    font-size: 10dp;
    color: rgba(255, 200, 60, 200);
}

/* ── Table ── */
#lb-table {
    display: block;
    position: absolute;
    top: 20dp;
    left: 1dp;
    right: 1dp;
    bottom: 15dp;
    padding: 1dp 2dp;
    background-color: rgba(0, 6, 28, 180);
    border-width: 1dp;
    border-color: rgba(80, 120, 220, 70);
    overflow: hidden;
}

/* ── Header row ── */
.lb-header-row {
    display: block;
    font-size: 10dp;
    color: rgba(140, 170, 230, 200);
    padding: 1dp 0dp;
    margin-bottom: 1dp;
    border-bottom-width: 1dp;
    border-bottom-color: rgba(100, 130, 220, 80);
    white-space: nowrap;
    line-height: 11dp;
    height: 11dp;
}

/* ── Data rows ── */
.lb-row {
    display: block;
    color: rgba(190, 200, 225, 180);
    font-size: 11dp;
    padding: 0dp 0dp;
    margin-bottom: 0dp;
    border-left-width: 2dp;
    border-left-color: transparent;
    white-space: nowrap;
    line-height: 12dp;
    height: 12dp;
}

.lb-row.hidden {
    display: none;
}

/* Alternating row tint (odd rows via nth-child not supported in RmlUi,
   so we rely on tier borders + highlight for visual rhythm) */

/* Tier-colored left borders */
.lb-row.bronze  { border-left-color: rgba(205, 127, 50, 160); }
.lb-row.silver  { border-left-color: rgba(170, 180, 210, 180); }
.lb-row.gold    { border-left-color: rgba(255, 215, 0, 200); }
.lb-row.plat    { border-left-color: rgba(180, 160, 255, 200); }
.lb-row.diamond { border-left-color: rgba(80, 220, 255, 220); }

/* My row highlight */
.lb-row.highlight {
    color: rgba(255, 235, 100, 255);
    background-color: rgba(255, 220, 0, 22);
    border-left-color: rgba(255, 210, 40, 230);
}

/* Top 3 — stronger golden glow + gold accent border */
.lb-row.top3 {
    background-color: rgba(255, 215, 0, 30);
}

/* ── Column widths (inline-block) ── */

.lb-col-rank {
    display: inline-block;
    width: 22dp;
    text-align: center;
    color: rgba(150, 160, 180, 200);
    font-size: 11dp;
}

/* Medal colors for top 3 */
.lb-row.top3 .lb-col-rank {
    font-weight: bold;
}

.lb-col-flag {
    display: inline-block;
    width: 16dp;
    vertical-align: baseline;
}

.lb-flag-img {
    display: inline;
    width: 12dp;
    height: 8dp;
    vertical-align: baseline;
}

.lb-col-name {
    display: inline-block;
    width: 104dp;
    padding-left: 2dp;
    overflow: hidden;
}

.lb-row.highlight .lb-col-name {
    color: #fff;
}

.lb-col-char {
    display: inline-block;
    width: 28dp;
    text-align: center;
    font-size: 10dp;
    color: rgba(160, 180, 210, 160);
}

.lb-col-wm {
    display: inline-block;
    width: 64dp;
    text-align: center;
    color: rgba(90, 240, 150, 230);
    font-size: 11dp;
}

.lb-col-pct {
    display: inline-block;
    width: 36dp;
    text-align: center;
    color: rgba(170, 180, 210, 200);
}

.lb-col-grade {
    display: inline-block;
    width: 20dp;
    text-align: center;
    font-size: 11dp;
    font-weight: bold;
    color: rgba(200, 210, 230, 200);
}

/* Grade colors by tier */
.lb-row.bronze .lb-col-grade   { color: #cd7f32; }
.lb-row.silver .lb-col-grade   { color: #a8b4d0; }
.lb-row.gold .lb-col-grade     { color: #ffd700; }
.lb-row.plat .lb-col-grade     { color: #c0a0ff; }
.lb-row.diamond .lb-col-grade  { color: #50e0ff; }

.lb-col-rating {
    display: inline-block;
    width: 54dp;
    text-align: center;
    color: rgba(140, 210, 255, 235);
}

.lb-col-dc {
    display: inline-block;
    width: 30dp;
    text-align: center;
    color: rgba(150, 160, 180, 200);
    font-size: 10dp;
}
.lb-col-dc.dc-warn {
    color: rgba(255, 80, 80, 255);
    font-weight: bold;
}

/* Tier-specific rating colors */
.lb-row.bronze .lb-col-rating   { color: #cd7f32; }
.lb-row.silver .lb-col-rating   { color: #a8b4d0; }
.lb-row.gold .lb-col-rating     { color: #ffd700; font-effect: shadow(1dp 1dp rgba(255, 215, 0, 0.3)); }
.lb-row.plat .lb-col-rating     { color: #c0a0ff; font-weight: bold; font-effect: shadow(1dp 1dp rgba(180, 140, 255, 0.4)); }
.lb-row.diamond .lb-col-rating  { color: #50e0ff; font-weight: bold; font-effect: shadow(1dp 1dp rgba(80, 220, 255, 0.5)); }

/* ── Empty state ── */
#lb-empty {
    display: block;
    position: absolute;
    top: 25dp;
    left: 1dp;
    right: 1dp;
    bottom: 20dp;
    text-align: center;
    padding: 60dp 0;
    font-size: 11dp;
    color: rgba(140, 150, 180, 120);
}

/* ── Pagination footer ── */
#lb-footer {
    display: block;
    position: absolute;
    bottom: 1dp;
    left: 1dp;
    right: 1dp;
    padding: 1dp 6dp;
    background-color: rgba(0, 8, 30, 160);
    border-width: 1dp;
    border-color: rgba(80, 120, 220, 50);
    text-align: center;
    font-size: 10dp;
}
.lb-nav {
    display: inline;
    color: rgba(255, 210, 70, 240);
    margin: 0 12dp;
}
.lb-page-info {
    display: inline;
    color: rgba(170, 200, 255, 170);
}
</file>

<file path="assets/ui/leaderboard.rml">
<rml>
<head>
    <link type="text/rcss" href="base.rcss"/>
    <link type="text/rcss" href="leaderboard.rcss"/>
    <title>Leaderboard</title>
</head>
<body data-model="leaderboard">
<div id="lb-panel">

    <!-- Title -->
    <div id="lb-title-bar">
        <span id="lb-title">LEADERBOARD</span>
        <span id="lb-total" data-if="has_data">{{total_players}} players</span>
    </div>

    <!-- Loading indicator -->
    <div id="lb-loading" data-if="loading">
        <span>LOADING...</span>
    </div>

    <!-- Table header -->
    <div id="lb-table" data-if="has_data">
        <div class="lb-header-row">
            <span class="lb-col-rank">#</span>
            <span class="lb-col-flag"></span>
            <span class="lb-col-name">PLAYER</span>
            <span class="lb-col-char">CHAR</span>
            <span class="lb-col-wm">W/M</span>
            <span class="lb-col-pct">WIN%</span>
            <span class="lb-col-grade">GRD</span>
            <span class="lb-col-rating">RATING</span>
            <span class="lb-col-dc">DC%</span>
        </div>

        <!-- Entries -->
        <div data-for="e : entries"
             class="lb-row"
             data-class-hidden="!e.is_valid"
             data-class-highlight="e.is_me"
             data-class-top3="e.is_top3"
             data-class-bronze="e.tier == 'bronze'"
             data-class-silver="e.tier == 'silver'"
             data-class-gold="e.tier == 'gold'"
             data-class-plat="e.tier == 'platinum'"
             data-class-diamond="e.tier == 'diamond'">
            <span class="lb-col-rank">{{e.rank_str}}</span>
            <span class="lb-col-flag"><img class="lb-flag-img" data-attr-src="e.flag_icon" data-if="e.flag_icon != ''"/></span>
            <span class="lb-col-name">{{e.name}}</span>
            <span class="lb-col-char">{{e.char_name}}</span>
            <span class="lb-col-wm">{{e.wins_matches}}</span>
            <span class="lb-col-pct">{{e.win_pct}}%</span>
            <span class="lb-col-grade">{{e.grade_str}}</span>
            <span class="lb-col-rating">{{e.rating_str}}</span>
            <span class="lb-col-dc" data-class-dc-warn="e.dc_pct > 10">{{e.dc_pct}}%</span>
        </div>
    </div>

    <!-- Empty state -->
    <div id="lb-empty" data-if="has_data == false &amp;&amp; loading == false">
        <span>No match results yet.</span>
    </div>

    <!-- Pagination -->
    <div id="lb-footer" data-if="has_data">
        <span class="lb-nav" data-if="has_prev">◀ PREV</span>
        <span class="lb-page-info">PAGE {{page}} / {{total_pages}}</span>
        <span class="lb-nav" data-if="has_next">NEXT ▶</span>
    </div>

</div>
</body>
</rml>
</file>

