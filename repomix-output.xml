            } else {
                svg = nonesvg;
            }
        } else {
            // We don't have a variant but we do have a default image (variant 0)
            svg = defaultsvg;
        }
    }
    return svg;
}

bool ControllerImage_HasScancodeSVG(ControllerImage_KeyboardDevice* device, SDL_Scancode scancode, int variantID) {
    const int iscancode = (int)scancode;
    if ((iscancode < SDL_SCANCODE_UNKNOWN) || (iscancode >= SDL_SCANCODE_COUNT)) {
        SDL_InvalidParamError("scancode");
        return false;
    }
    if ((variantID < 0) || (variantID >= CONTROLLERIMAGE_MAX_KEYBOARD_VARIANTS)) {
        SDL_InvalidParamError("scancode variantID");
        return false;
    }

    if (!device->keys_svg[iscancode][variantID])
        return false;
    return true;
}

bool ControllerImage_HasMouseIconSVG(ControllerImage_MouseDevice* device, int iconID, int variantID) {
    if ((iconID < CONTROLLERIMAGE_MOUSE_NONE) || (iconID >= CONTROLLERIMAGE_MOUSE_MAX)) {
        SDL_InvalidParamError("mouse icon");
        return false;
    }
    if ((variantID < 0) || (variantID >= CONTROLLERIMAGE_MAX_MOUSE_VARIANTS)) {
        SDL_InvalidParamError("mouse icon variantID");
        return false;
    }

    if (!device->icons_svg[iconID][variantID])
        return false;
    return true;
}
