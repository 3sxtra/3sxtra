        if (g_state.rw_dat[1].rwd_ptr[0] == -1) {
            g_state.rw_dat[1].rwd_ptr = g_state.rw_dat[1].brw_ptr;
            g_state.rw_dat[1].rw_cnt = *g_state.rw_dat[1].rwd_ptr++;
