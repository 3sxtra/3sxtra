        break;

    case 3:
        if (end_fade_complete()) {
            bgw_ptr->r_no_1++;
            end_no_cut = 0;
            g_state.end_w.timer = 20;
            overwrite_panel(0xFFFFFFFF, 0x17);
        }

        break;

    case 4:
        overwrite_panel(0xFFFFFFFF, 0x17);
        break;
    }
}

/** @brief Scene 3 — fade-in with vertical scroll and effects. */
static void end_300_0003() {
    switch (bgw_ptr->r_no_1) {
    case 0:
        overwrite_panel(0xFFFFFFFF, 0x17);
        bgw_ptr->r_no_1++;
        bgw_ptr->xy[0].disp.pos = end_3_pos[g_state.end_w.r_no_2][0];
        bgw_ptr->xy[1].disp.pos = end_3_pos[g_state.end_w.r_no_2][1];
        bgw_ptr->abs_x = 512;
        bgw_ptr->abs_y = bgw_ptr->xy[1].disp.pos;
        effect_E6_init(0x9D);
        effect_E6_init(0xB3);
