            if (g_state.end_w.r_no_2 == 2) {
                end_no_cut = 1;
            }

            g_state.end_w.timer = timer_4_tbl[g_state.end_w.r_no_2];
            g_state.bg_w.bgw[0].r_no_1 = 0;
            g_state.bg_w.bgw[1].r_no_1 = 0;
            g_state.bg_w.bgw[2].r_no_1 = 0;
        }

        end_400_move();
        end_401_move();
        end_402_move();
        /* fallthrough */

