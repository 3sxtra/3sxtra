        break;

    case 1:
        wk->script_register_bank[ctc->kind_of_char & 0xF] &= wk->script_register_bank[ctc->pat & 0xF];
        break;

    case 2:
        wk->script_register_bank[ctc->kind_of_char & 0xF] |= wk->script_register_bank[ctc->pat & 0xF];
        break;

    case 3:
        wk->script_register_bank[ctc->kind_of_char & 0xF] += wk->script_register_bank[ctc->pat & 0xF];
        break;

    case 4:
        wk->script_register_bank[ctc->kind_of_char & 0xF] -= wk->script_register_bank[ctc->pat & 0xF];
        break;

    case 5:
        wk->script_register_bank[ctc->kind_of_char & 0xF] *= wk->script_register_bank[ctc->pat & 0xF];
        break;

    case 6:
        wk->script_register_bank[ctc->kind_of_char & 0xF] /= wk->script_register_bank[ctc->pat & 0xF];
