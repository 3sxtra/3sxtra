/**
 * @file effi9.c
 * Effect: Visual Effect (Generic)
 */

#include "sf33rd/Source/Game/effect/effect_i9_image_buffer_manager.h"
#include "game_state.h"
#include "common.h"
#include "sf33rd/Source/Game/effect/effect.h"
#include "sf33rd/Source/Game/effect/effect_j0_image_buffer_manager.h"
#include "sf33rd/Source/Game/engine/slow_motion.h"
#include "sf33rd/Source/Game/engine/state_user.h"

static void push_image_buff(State_Other* wk, ImageBuff* image_buff);
static void init_image_buff(State_Other* wk, ImageBuff* image_buff);

void effect_I9_move(State_Other* ewk) {
    State* sub_w = (State*)ewk->wu.target_adrs;
    ImageBuff* image_buff = (ImageBuff*)sub_w + 9;
    State_Other* mwk = (State_Other*)ewk->my_master;
    s16 i;

    switch (ewk->wu.routine_no[0]) {
    case 0:
        ewk->wu.routine_no[0]++;
        init_image_buff(mwk, image_buff);
        push_image_buff(mwk, image_buff);

        for (i = ewk->wu.damage_calc_divider; i > 0; i--) {
            effect_J0_init(ewk, mwk, i * ewk->wu.damage_calc_multiplier);
        }

        break;

    case 1:
        push_image_buff(mwk, image_buff);

        if (ewk->wu.death_timer == 1) {
            ewk->wu.routine_no[0]++;
            break;
        }

        if (mwk->wu.routine_no[0] >= 2 || mwk->wu.routine_no[1] >= 2) {
            ewk->wu.routine_no[0] = 2;
            ewk->wu.disp_flag = 0;
            break;
        }

        if (!g_state.execute_flag && !g_state.Game_pause && mwk->wu.hit_stop <= 0 && --ewk->wu.dir_timer == 0) {
            ewk->wu.routine_no[0] = 2;
        }

        break;

    case 2:
        ewk->wu.routine_no[0] = 3;
        break;

    default:
        Release_Effect(&ewk->wu);
        Release_Effect(sub_w);
        break;
    }
}

static void push_image_buff(State_Other* wk, ImageBuff* image_buff) {
    s16 i;

    for (i = 16; i > 0; i--) {
        image_buff[i] = image_buff[i - 1];
    }

    image_buff->pos_x = wk->wu.position_x;
    image_buff->pos_y = wk->wu.position_y;
}

static void init_image_buff(State_Other* wk, ImageBuff* image_buff) {
    s16 i;

    for (i = 16; i >= 0; i--) {
        image_buff[i].pos_x = wk->wu.position_x;
        image_buff[i].pos_y = wk->wu.position_y;
    }
}

s32 effect_I9_init(State_Other* wk, s16 total, s16 interval, s16 life) {
    State_Other* ewk;
    s16 ix;
    s16 ix2;
    State* sub_w;

    if ((ix = Acquire_Effect(3)) == -1) {
        return -1;
    }

    ewk = (State_Other*)frw[ix];
    ewk->wu.active_flag = 1;
    ewk->wu.id = 189;
    ewk->wu.work_id = 16;
    ewk->wu.my_family = wk->wu.my_family;
    ewk->wu.graphic_rom_type = wk->wu.graphic_rom_type;
    ewk->wu.my_col_mode = wk->wu.my_col_mode;
    ewk->wu.my_col_code = wk->wu.my_col_code;
    ewk->wu.extra_col = wk->wu.current_colcd;
    ewk->wu.cg_number = wk->wu.cg_number;
    ewk->my_master = wk;
    ewk->master_work_id = wk->wu.work_id;
    ewk->master_id = wk->wu.id;
    ewk->master_player = wk->master_player;
    ewk->wu.damage_calc_divider = total;
    ewk->wu.damage_calc_multiplier = interval;
    ewk->wu.dir_timer = life;
    ewk->wu.blink_timing = ewk->master_id;

    if ((ix2 = Acquire_Effect(7)) == -1) {
        Release_Effect(&ewk->wu);
        return -1;
    }

    sub_w = (State*)frw[ix2];
    ewk->wu.target_adrs = sub_w;
    return 0;
}
