<file path="assets/ui/mods.rcss">
/* Mods menu stylesheet — 3SXtra RmlUi overlay
 * Two-column layout uses the same pattern as shaders.rcss:
 *   .columns  { display: block; white-space: nowrap; }
 *   .column   { display: inline-block; vertical-align: top; white-space: normal; }
 */

body {
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 191);
    display: flex;
    justify-content: center;
    align-items: center;
}

#mods-panel {
    display: block;
    width: 85vw;
    max-height: 88vh;
    background-color: rgba(15, 15, 20, 242);
    border-width: 1dp;
    border-color: #444;
    border-radius: 10dp;
    padding: 12dp 16dp;
    overflow-y: auto;
}

/* ── Two-Column Layout (same pattern as shaders.rcss) ─────── */

.columns {
    display: block;
    white-space: nowrap;
}

.column {
    display: inline-block;
    vertical-align: top;
    padding: 2dp;
    white-space: normal;
}

.col-left {
    width: 48%;
}

.col-right {
    width: 48%;
    border-left-width: 1dp;
    border-left-color: #333;
    padding-left: 6dp;
}

/* Title */
#mods-panel h1 {
    font-size: 22dp;
    color: #ff9933;
    margin-bottom: 6dp;
    text-align: center;
    white-space: nowrap;
}

/* Section headers */
#mods-panel h2 {
    font-size: 16dp;
    color: #b0b0b0;
    margin-top: 6dp;
    margin-bottom: 5dp;
    text-transform: uppercase;
    letter-spacing: 1dp;
    white-space: nowrap;
}

/* Sections */
.section {
    display: block;
    margin-bottom: 2dp;
}

/* Horizontal dividers */
.divider {
    display: block;
    height: 1dp;
    background-color: #333;
    margin-top: 3dp;
    margin-bottom: 3dp;
}

/* Control rows */
.control-row {
    display: block;
    padding: 3dp 6dp;
    white-space: nowrap;
}

.control-row input {
    display: inline-block;
    vertical-align: middle;
}

.control-row label {
    display: inline-block;
    vertical-align: middle;
}

.control-row:hover {
    background-color: rgba(255, 255, 255, 13);
    border-radius: 3dp;
}

/* Labels */
label {
    font-size: 17dp;
    color: #dddddd;
    cursor: pointer;
    white-space: nowrap;
}

/* Indent for sub-options */
.indent {
    display: block;
    margin-left: 12dp;
}

/* Disabled state */
.disabled {
    opacity: 0.35;
}

/* ─── Select/Dropdown ─── */

select {
    display: block;
    width: 100%;
    height: 26dp;
    background-color: #2a2a30;
    border-width: 1dp;
    border-color: #888;
    border-radius: 4dp;
    color: #ddd;
    font-size: 16dp;
}

select selectvalue {
    width: auto;
    height: 26dp;
    padding: 6dp 10dp 0 10dp;
    color: #ddd;
}

select selectarrow {
    width: 0;
    height: 0;
}

select:hover {
    border-color: #ff9933;
}

select selectbox {
    width: 100%;
    background-color: #1a1a20;
    border-width: 1dp;
    border-color: #888;
}

select selectbox option {
    padding: 6dp 8dp;
    color: #ddd;
}

select selectbox option:hover {
    background-color: #ff993344;
}

select selectbox option:checked {
    background-color: #ff993366;
    color: #fff;
}

/* Status indicator text */
.status-ok {
    color: #66ff66;
    font-size: 16dp;
}

.status-warn {
    color: #ffcc33;
    font-size: 16dp;
    display: block;
    margin-bottom: 4dp;
    white-space: nowrap;
}

/* Footer hint text */
.hint {
    font-size: 15dp;
    color: #888;
    margin-top: 8dp;
    text-align: center;
    white-space: nowrap;
}

/* Scrollbar styling */
scrollbarvertical {
    width: 6dp;
}

scrollbarvertical sliderbar {
    background-color: #888;
    border-radius: 3dp;
}

scrollbarvertical sliderbar:hover {
    background-color: #777;
}

scrollbarvertical slidertrack {
    background-color: #222;
}
</file>

<file path="assets/ui/mods.rml">
<rml>
<head>
    <title>Mods Menu</title>
    <link type="text/rcss" href="base.rcss"/>
    <link type="text/rcss" href="mods.rcss"/>
</head>
<body data-model="mods">
    <div id="mods-panel">
        <h1>MODS</h1>
        <div class="divider"></div>

        <!-- ═══ Two-Column Layout ═══ -->
        <div class="columns">
            <!-- ── Left Column: General Settings ── -->
            <div class="column col-left">
                <!-- Audio Mods -->
                <div class="section">
                    <h2>Audio Mods</h2>
                    <div class="control-row">
                        <input type="checkbox" data-checked="modded_bgm_enabled"/>
                        <label>Enable Modded BGM</label>
                        <span data-if="modded_bgm_count > 0" class="status-ok"> ({{ modded_bgm_count }} tracks)</span>
                    </div>
                    <div class="control-row">
                        <input type="checkbox" data-checked="modded_voice_enabled"/>
                        <label>Enable Modded Voice Lines</label>
                    </div>
                </div>

                <div class="divider"></div>

                <!-- HD Stage Backgrounds -->
                <div class="section">
                    <h2>HD Stage Backgrounds</h2>
                    <div class="control-row">
                        <input type="checkbox" data-checked="hd_enabled"/>
                        <label>Enable HD Backgrounds</label>
                        <span data-if="hd_active" class="status-ok"> (Active)</span>
                    </div>
                    <div class="control-row">
                        <input type="checkbox" data-checked="shader_bypass"/>
                        <label>Bypass Shaders on HD Stages</label>
                        <span data-if="shader_bypass" class="status-warn"> (No CRT/filters)</span>
                    </div>
                </div>

                <div class="divider"></div>

                <!-- Pre-Game -->
                <div class="section">
                    <h2>Pre-Game & Engine</h2>
                    <div class="control-row">
                        <input type="checkbox" data-checked="fast_pre_game"/>
                        <label>Fast Pre-Game Sequences</label>
                    </div>
                    <div class="control-row">
                        <input type="checkbox" data-checked="palmod_enabled"/>
                        <label>Enable PalMod Engine</label>
                    </div>
                </div>

                <div class="divider"></div>

                <!-- Bezels -->
                <div class="section">
                    <h2>Bezels</h2>
                    <div class="control-row">
                        <input type="checkbox" data-checked="bezel_enabled"/>
                        <label>Enable Arcade Bezels</label>
                    </div>
                </div>

                <div class="divider"></div>

                <!-- Display -->
                <div class="section">
                    <h2>Display</h2>
                    <div class="control-row">
                        <input type="checkbox" data-checked="debug_hud"/>
                        <label>Show Debug HUD (FPS)</label>
                    </div>
                    <div class="control-row">
                        <input type="checkbox" data-checked="vsync"/>
                        <label>VSync</label>
                    </div>
                </div>

                <div class="divider"></div>

                <!-- Video Broadcast -->
                <div class="section">
                    <h2>Video Broadcast</h2>
                    <div class="control-row">
                        <input type="checkbox" data-checked="broadcast_enabled"/>
                        <label>Enable Broadcast</label>
                    </div>
                    <div data-if="broadcast_enabled" class="indent">
                        <div class="control-row">
                            <label>Source:</label>
                            <select data-value="broadcast_source">
                                <option value="0">Native (384x224)</option>
                                <option value="1">Final Output (Scaled)</option>
                            </select>
                        </div>
                        <p data-if="broadcast_source == 1" class="status-warn">
                            Warning: Final Output may impact performance.
                        </p>
                    </div>
                </div>
            </div>

            <!-- ── Right Column: Rendering & Debug ── -->
            <div class="column col-right">
                <!-- Stage Rendering -->
                <div class="section">
                    <h2>Stage Rendering</h2>
                    <div class="control-row">
                        <input type="checkbox" data-checked="render_disabled"/>
                        <label>Disable All Stage Rendering</label>
                    </div>
                    <div class="control-row">
                        <input type="checkbox" data-checked="anims_disabled"/>
                        <label>Disable Stage Animations</label>
                    </div>
                    <div class="control-row">
                        <input type="checkbox" data-checked="bg_draw_off"/>
                        <label>BG Draw Off</label>
                    </div>
                    <div class="control-row">
                        <input type="checkbox" data-checked="blue_back"/>
                        <label>Blue Background</label>
                    </div>
                    <div class="control-row" data-class-disabled="!in_game">
                        <input type="checkbox" data-checked="shin_gouki_pal" data-attrif-disabled="!in_game"/>
                        <label>Shin Gouki Stage Palette</label>
                    </div>
                </div>

                <div class="divider"></div>

                <!-- Debug Options (gameplay only) -->
                <div class="section">
                    <p data-if="!in_game" class="status-warn">Debug options: in-game only</p>
                    <h2>Debug Options</h2>
                    <div class="control-row" data-class-disabled="!in_game">
                        <input type="checkbox" data-checked="hide_shadows" data-attrif-disabled="!in_game"/>
                        <label>Hide Shadows</label>
                    </div>
                    <div class="control-row" data-class-disabled="!in_game">
                        <input type="checkbox" data-checked="hide_pal_sprites" data-attrif-disabled="!in_game"/>
                        <label>Hide Palette Sprites</label>
                    </div>
                    <div class="control-row" data-class-disabled="!in_game">
                        <input type="checkbox" data-checked="hide_cps3_sprites" data-attrif-disabled="!in_game"/>
                        <label>Hide CPS3 Sprites</label>
                    </div>
                    <div class="control-row" data-class-disabled="!in_game">
                        <input type="checkbox" data-checked="hide_rgb_sprites" data-attrif-disabled="!in_game"/>
                        <label>Hide RGB Sprites</label>
                    </div>
                    <div class="control-row" data-class-disabled="!in_game">
                        <label>Sprite Type SB</label>
                        <input type="range" min="0" max="3" step="1" data-value="sprite_type_sb" data-attrif-disabled="!in_game"/>
                    </div>
                    <div class="control-row" data-class-disabled="!in_game">
                        <input type="checkbox" data-checked="freeze_effects" data-attrif-disabled="!in_game"/>
                        <label>Freeze Effects</label>
                    </div>
                    <div class="control-row" data-class-disabled="!in_game">
                        <input type="checkbox" data-checked="mute_bgm" data-attrif-disabled="!in_game"/>
                        <label>Mute BGM</label>
                    </div>
                </div>
            </div>
        </div>

        <div class="divider"></div>
        <p class="hint">Press F3 to close this menu</p>
    </div>
</body>
</rml>
</file>

