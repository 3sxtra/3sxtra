#include "sf33rd/Source/Game/stage/target_subroutines.h"
#include "sf33rd/Source/Game/system/work_sys.h"

/** @brief Main handler for Santos Harbor, Brazil stage. */
void BG090() {
    bgw_ptr = &g_state.bg_w.bgw[1];
    bg0902();
    bgw_ptr = &g_state.bg_w.bgw[0];
    bg0901();
    bgw_ptr = &g_state.bg_w.bgw[2];
    bg_fam0900();
    bgw_ptr = &g_state.bg_w.bgw[6];
    bg_fam0900();
    bgw_ptr = &g_state.bg_w.bgw[5];
    bg_fam0900();
    zoom_ud_check();
    bg_pos_adjust2();
    Bg_Family_Set();
}

/** @brief Background layer handler for Santos Harbor, Brazil. */
void bg0901() {
    void (*bg0901_jmp[3])() = { bg0901_init00, demo90_base, bg_move_common };

    if (g_state.win_sp_flag) {
        jijii_win_bg2();
        return;
    }

    if (bgw_ptr->r_no_0 >= 3)
        return;
    bg0901_jmp[bgw_ptr->r_no_0]();
}

/** @brief Initialize background layer for Santos Harbor, Brazil. */
void bg0901_init00() {
    bgw_ptr->old_pos_x = bgw_ptr->xy[0].disp.pos = bgw_ptr->pos_x_work = 0x200;
    bgw_ptr->hos_xy[0].cal = bgw_ptr->wxy[0].cal = bgw_ptr->xy[0].cal;
    bgw_ptr->zuubun = 0;
    bg090_demo_check();
}

/** @brief Background layer handler for Santos Harbor, Brazil. */
void bg0902() {
    void (*bg0902_jmp[3])() = { bg0902_init00, demo90_base, bg_base_move_common };

    if (g_state.win_sp_flag) {
        jijii_win_bg();
        return;
    }

    if (bgw_ptr->r_no_0 >= 3)
        return;
    bg0902_jmp[bgw_ptr->r_no_0]();
}

/** @brief Initialize background layer for Santos Harbor, Brazil. */
void bg0902_init00() {
    bgw_ptr->old_pos_x = bgw_ptr->xy[0].disp.pos = bgw_ptr->pos_x_work = 0x200;
    bgw_ptr->hos_xy[0].cal = bgw_ptr->wxy[0].cal = bgw_ptr->xy[0].cal;
    bgw_ptr->zuubun = 0;
    bg090_demo_check();
    effect_05_init();
    effect_06_init();
    effect_68_init();
}

/** @brief Background layer handler for Santos Harbor, Brazil. */
void bg_fam0900() {
    if (g_state.win_sp_flag) {
        jijii_win_bg2();
        sync_fam_set3(bgw_ptr->fam_no);
        return;
    }

    switch (bgw_ptr->r_no_0) {
    case 0:
        bgw_ptr->r_no_0++;
        bgw_ptr->old_pos_x = bgw_ptr->xy[0].disp.pos = bgw_ptr->pos_x_work = 0x200;
        bgw_ptr->hos_xy[0].cal = bgw_ptr->wxy[0].cal = bgw_ptr->xy[0].cal;
        bgw_ptr->xy[1].disp.pos = bgw_ptr->pos_y_work = 0;

        switch (bgw_ptr->fam_no) {
        case 2:
            bgw_ptr->speed_x = 0xC000;
            bgw_ptr->speed_y = 0x10000;
            break;

        case 6:
            bgw_ptr->speed_x = 0x9000;
            bgw_ptr->speed_y = 0x10000;
            break;

        default:
            bgw_ptr->speed_x = 0x12000;
            bgw_ptr->speed_y = 0x10000;
            break;
        }

        bgw_ptr->xy[0].disp.low = bgw_ptr->xy[1].disp.low = 0;
        bgw_ptr->y_limit = bgw_ptr->y_limit2 = 0xF0;
        bg090_demo_check();
        sync_fam_set3(bgw_ptr->fam_no);
        break;

    case 1:
        demo90_base();
        sync_fam_set3(bgw_ptr->fam_no);
        break;

    case 2:
        bg_x_move_check();
        bg_y_move_check();
        sync_fam_set3(bgw_ptr->fam_no);
        break;
    }
}

/** @brief Check and set up demo-mode for Santos Harbor, Brazil. */
void bg090_demo_check() {
    s16 pos_w;

    if ((g_state.plw->player_number != 9) && (g_state.plw[1].player_number != 9)) {
        bgw_ptr->r_no_0 = 2;
        return;
    }

    if (g_state.bg_w.area != 0) {
        bgw_ptr->r_no_0 = 2;
        return;
    }

    bgw_ptr->r_no_0 = 1;
    pos_w = 0xC0;
    bgw_ptr->xy[1].cal = bgw_ptr->wxy[1].cal = bgw_ptr->speed_y * pos_w;
}

/** @brief Background layer handler for Santos Harbor, Brazil. */
void demo90_base() {
    s16 chk_pl;

    if (g_state.execute_flag || g_state.Game_pause) {
        return;
    }

    switch (bgw_ptr->r_no_1) {
    case 0:
        chk_pl = 0;

        if (g_state.plw->player_number == 9 && g_state.plw[1].player_number == 9) {
            if (g_state.Appear_hv[0]) {
                chk_pl = 1;
            }
        } else if (g_state.plw[1].player_number == 9) {
            chk_pl = 1;
        }

        if (g_state.Appear_free[chk_pl]) {
            bgw_ptr->r_no_1++;
            break;
        }

        break;

    case 1:
        bgw_ptr->xy[1].cal -= bgw_ptr->speed_y * 0xA;
        bgw_ptr->wxy[1].cal -= bgw_ptr->speed_y * 0xA;

        if (bgw_ptr->xy[1].disp.pos <= 0) {
            bgw_ptr->r_no_1++;
            bgw_ptr->xy[1].cal = 0;
            bgw_ptr->wxy[1].cal = 0;
            break;
        }
        break;

    case 2:
        if (g_state.Appear_end == 2) {
            bgw_ptr->r_no_0++;
            bgw_ptr->r_no_1 = 0;
            bgw_ptr->xy[1].cal = 0;
            bgw_ptr->wxy[1].cal = 0;
        }
        break;
    }
}

/** @brief Win animation background handler for Santos Harbor, Brazil. */
void jijii_win_bg() {
    if ((g_state.execute_flag || g_state.Game_pause)) {
        return;
    }

    switch (bgw_ptr->r_no_1) {
    case 0:
        if (g_state.win_sp_flag == 2) {
            bgw_ptr->xy[1].cal += 0xA0000;
            bgw_ptr->wxy[1].cal += 0xA0000;
            if (bgw_ptr->xy[1].disp.pos > 0xB0) {
                bgw_ptr->r_no_1 += 1;
                g_state.win_sp_flag = 3;
            }
        }
        /* fallthrough */

    case 1:
        break;
    }
}

/** @brief Win animation background handler for Santos Harbor, Brazil. */
void jijii_win_bg2() {
    s16 zuu_work;
    s32 sp_work;

    if ((g_state.execute_flag || g_state.Game_pause)) {
        return;
    }

    switch (g_state.bg_w.bgw[1].r_no_1) {
    case 0:
        if (g_state.win_sp_flag == 2) {
            zuu_work = 0xA;
            sp_work = bgw_ptr->speed_y * zuu_work;
            bgw_ptr->xy[1].cal += sp_work;
            bgw_ptr->wxy[1].cal += sp_work;
        }
        /* fallthrough */

    case 1:
        break;
    }
}
