<file path="assets/ui/base.rcss">
/* Base stylesheet for 3SXtra RmlUi overlay menus */

/* RmlUi requires explicit block display on HTML-like elements */
div, p, h1, h2, h3, button {
    display: block;
}

body {
    width: 100%;
    height: 100%;
    font-family: "DistrictTF-RegularItalic";
    font-size: 13dp;
    color: #ffffff;
}

/* Semi-transparent dark panel backdrop */
.panel {
    background-color: rgba(15, 15, 20, 235);
    border-width: 1dp;
    border-color: #333;
    border-radius: 8dp;
    padding: 6dp;
}

/* Section headers */
h1 {
    display: block;
    font-size: 17dp;
    color: #ff9933;
    margin-bottom: 4dp;
}

h2 {
    display: block;
    font-size: 14dp;
    color: #e0e0e0;
    margin-top: 6dp;
    margin-bottom: 4dp;
    border-bottom-width: 1dp;
    border-bottom-color: #444;
    padding-bottom: 2dp;
}

/* Utility: centered text */
.center {
    text-align: center;
}

/* Status indicators */
.status-ok {
    color: #66ff66;
}

.status-warn {
    color: #ffcc33;
}

.status-error {
    color: #ff4444;
}

/* ─── Form Controls ─── */

/* Checkbox: styled as a small colored square */
input.checkbox {
    width: 13dp;
    height: 13dp;
    border-width: 1dp;
    border-color: #666;
    background-color: #333;
    border-radius: 2dp;
    margin-right: 4dp;
    vertical-align: middle;
}
input.checkbox:hover {
    border-color: #ff9933;
    background-color: #444;
}
input.checkbox:checked {
    background-color: #ff9933;
    border-color: #ff9933;
}
input.checkbox:checked:hover {
    background-color: #ffaa55;
}
input.checkbox:disabled {
    opacity: 0.3;
}

/* Range slider */
input.range {
    width: 100dp;
    height: 14dp;
    margin-left: 4dp;
    vertical-align: middle;
}
input.range slidertrack {
    background-color: #444;
    height: 4dp;
    margin-top: 7dp;
    border-radius: 2dp;
}
input.range sliderbar {
    width: 16dp;
    height: 16dp;
    background-color: #ff9933;
    border-radius: 7dp;
    margin-top: -5dp;
}
input.range sliderbar:hover {
    background-color: #ffaa55;
}
input.range sliderbar:active {
    background-color: #cc7722;
}
input.range sliderarrowdec, input.range sliderarrowinc {
    width: 0;
    height: 0;
}
input.range:disabled {
    opacity: 0.3;
}

/* ── Red Banner: "punched out" text ── */
.red-banner {
    display: block;
    position: absolute;
    left: 0;
    width: 100%;
    height: 32dp;
    text-align: center;
    padding-top: 3dp;
    padding-bottom: 1dp;
    border-top-width: 1dp;
    border-top-color: rgba(255, 255, 255, 200);
    border-bottom-width: 1dp;
    border-bottom-color: rgba(255, 255, 255, 200);
}

.red-banner-text {
    display: block;
    font-size: 28dp;
    font-weight: bold;
    letter-spacing: 4dp;
    color: rgba(15, 10, 10, 220);
    font-effect: shadow(-1dp -1dp rgba(255, 255, 255, 30));
    text-transform: uppercase;
    background-color: rgba(210, 20, 20, 220);
}
</file>

