/** @brief Checks for target-combo (meoshi) cancel opportunity. */
s32 check_target_combo_cancel(PlayerEntity* wk) {
    s16 i;
    s16 tdat;
    s16 wdat;

    wk->permitted_art_type |= 0x10;

    if (wk->wu.frame_link_hit_flag == 0) {
        return 0;
    }

    tdat = wk->wu.cg_tc_state & 0x8F;

    switch (tdat) {
    default:
        wdat = cnmc_conv_data[wk->cp->input_pressed & 0xF];
        tdat &= 0xF;

        while (1) {
            if (wk->wu.cg_tc_state & 0x80) {
                for (i = 0; i < 6; i++) {
                    if (cnmc_Z_lever_data[tdat][i] == -1) {
                        return 0;
                    }

                    if (wdat == cnmc_Z_lever_data[tdat][i]) {
                        goto case_0;
                    }
                }
            } else {
                for (i = 0; i < 8; i++) {
                    if (cnmc_z_lever_data[tdat][i] == -1) {
                        return 0;
                    }

                    if (wdat == cnmc_z_lever_data[tdat][i]) {
                        goto case_0;
                    }
                }
            }
            return 0;
        }

    case 0:
    case_0:
        if ((tdat = wk->wu.cg_tc_state & 0x770) == 0) {
            if (!(wk->wu.cg_tc_state & 0x800)) {
                return 0;
            }

            break;
        }

        wdat = wk->cp->input_pressed & 0x770;

        if (wdat & ~tdat) {
            return 0;
        }

        if (shot_data_convert(wk->cp->input_current) >= 0) {
            if ((wk->wu.cg_tc_state & 0x800)) {
                break;
            }

            goto end;
        }

        if (!(wk->wu.cg_cancel & 0x80)) {
            return 0;
        }

        wdat = wk->cp->input_released & 0x770;

        if (wdat & ~tdat) {
            return 0;
        }

        if (shot_data_convert(wk->cp->input_released) < 0) {
            return 0;
        }

        if (!(wk->wu.cg_tc_state & 0x800)) {
            return 0;
        }

        break;
    }

    if (wk->wu.cg_tc_state & 0x1000) {
        if (char_move_cmms3(wk) == 0) {
            return 0;
        }
    } else {
        char_move_cmms2(&wk->wu);
    }

    wk->wu.hf.hit_flag = 0;
    wk->wu.att_hit_ok = 0;
    wk->wu.frame_link_hit_flag = 0;
    wk->wu.cg_cancel &= 0x60;

    if ((wk->tc_1st_flag == 0) && (wk->wu.current_char_type == 4)) {
        grade_add_target_combo(wk->wu.id);
    }

    wk->tc_1st_flag = 1;
    pp_pulpara_remake_at_init2(wk);
    return 1;

end:
    if ((wk->tc_1st_flag == 0) && wk->wu.current_char_type == 4) {
        grade_add_target_combo(wk->wu.id);
    }

    check_nm_attack(wk);
    wk->tc_1st_flag = 1;
    return 1;
}

