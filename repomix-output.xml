    { 16, 32, 121, 1 },  { -8, 40, 121, 1 },  { 20, 36, 121, 1 },   { -8, 72, 121, 1 },  { 0, 40, 121, 1 },
    { 24, 80, 121, 0 },  { 8, 56, 121, 0 },   { 20, 20, 121, 0 },   { 20, 24, 121, 1 },  { 8, 48, 121, 1 },
