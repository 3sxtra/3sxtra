/**
 * @file effl7.c
 * Effect: Win Player / Data Table Effect
 */

#include "sf33rd/Source/Game/effect/effect_l7_win_player_data_table.h"
#include "game_state.h"
#include "bin2obj/char_table.h"
#include "common.h"
