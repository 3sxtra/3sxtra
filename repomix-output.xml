        /* fallthrough */

    case 1:
        if (Request_Fade(2)) {
            bgw_ptr->r_no_1++;
            end_no_cut = 1;
        }

        break;

    case 2:
        if (end_fade_complete()) {
            bgw_ptr->r_no_1++;
            end_no_cut = 0;
        }

        break;

    case 3:
        bgw_ptr->xy[1].cal -= 0x4000;

        if (bgw_ptr->xy[1].disp.pos < 449) {
            bgw_ptr->r_no_1++;
            bgw_ptr->xy[1].cal = 0x1C00000;
        }

        bgw_ptr->abs_y = bgw_ptr->xy[1].disp.pos;
