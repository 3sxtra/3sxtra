/** @brief Clear super-art frame state for both players. */
void Sa_frame_Clear() {
    u8 i;
    u8 j;

    for (j = 0; j < SA_FRAME_ROWS; j++) {
        for (i = 0; i < SA_FRAME_COLS; i++) {
            sa_frame[j][i].atr = 0;
