/**
 * @file effa2.c
 * Effect: Color Table Effect
 */

#include "sf33rd/Source/Game/effect/effect_a2_color_table.h"
#include "game_state.h"
#include "common.h"
#include "sf33rd/Source/Game/effect/effect.h"
