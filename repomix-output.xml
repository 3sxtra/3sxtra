/** @brief Unlock a texture, flushing CPU data back to system memory. */
s32 flUnlockTexture(u32 th) {
    if (th == 0 || th > FL_TEXTURE_MAX) {
        return 0;
    }

    FLTexture* lpflTexture = &flTexture[th - 1];

    if (!lpflTexture->active_flag) {
