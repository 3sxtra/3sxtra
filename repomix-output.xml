#include "sf33rd/Source/Game/engine/player_control.h"
#include "sf33rd/Source/Game/engine/state_user.h"
#include "sf33rd/Source/Game/rendering/sprite_utilities.h"

static void effe8_zanzou_process(State_Other* ewk, PlayerEntity* mwk);
static void effE8_trans(State_Other* ewk, PlayerEntity* mwk);

void effect_E8_move(State_Other* ewk) {
    PlayerEntity* mwk = (PlayerEntity*)ewk->my_master;
    State_Other* cwk = (State_Other*)ewk->wu.target_adrs;
    State* mtwk;

    switch (ewk->wu.routine_no[0]) {
    case 0:
        ewk->wu.type = ewk->wu.charset_id;
        ewk->wu.anim_hitbox_index = 0;
        ewk->wu.anim_hurtbox_index = 0;

        if (ewk->wu.type >= ewk->wu.charset_id) {
            ewk->wu.type = ewk->wu.charset_id;
            ewk->wu.routine_no[0] = 1;
        }

        effe8_zanzou_process(ewk, mwk);
        effE8_trans(ewk, mwk);
        break;

    case 1:
        if (ewk->wu.death_timer == 1) {
            ewk->wu.disp_flag = 0;
            ewk->wu.routine_no[0] = 2;
            break;
        }

        if (g_state.Game_pause == 0x81) {
            effE8_trans(ewk, mwk);
            break;
        }

        switch (ewk->wu.routine_no[1]) {
        case 0:
            if (cwk->wu.routine_no[0] != 1 || cwk->wu.routine_no[1] != 1) {
                ewk->wu.routine_no[1] = 1;
            }

            effe8_zanzou_process(ewk, mwk);
            effE8_trans(ewk, mwk);
            break;

        default:
            ewk->wu.type -= ewk->wu.active_move;

            if (ewk->wu.type <= 0) {
                ewk->wu.disp_flag = 0;
                ewk->wu.routine_no[0] = 2;
            } else {
                effe8_zanzou_process(ewk, mwk);
                effE8_trans(ewk, mwk);
            }

            break;
        }

        break;

    case 2:
        if (g_state.pcon_rno[0] != 2) {
            mtwk = (State*)mwk->wu.target_adrs;

            if (mtwk->routine_no[0] == 4 && mtwk->routine_no[1] == 1 && mtwk->routine_no[3] < 2) {
                break;
            }
        }

        ewk->wu.routine_no[0] = 3;
        break;

    default:
        Release_Effect(&ewk->wu);
        break;
    }
}

static void effe8_zanzou_process(State_Other* ewk, PlayerEntity* mwk) {
    if (ewk->wu.old_routine_no[5]) {
        if (ewk->wu.type == 0) {
            ewk->wu.position_x = mwk->wu.position_x;
            ewk->wu.position_y = mwk->wu.position_y;
        } else {
            ewk->wu.position_x = g_state.afterimage_table[ewk->master_id][ewk->wu.type - 1].pos_x;
            ewk->wu.position_y = g_state.afterimage_table[ewk->master_id][ewk->wu.type - 1].pos_y;
        }
    } else {
        ewk->wu.position_x = g_state.afterimage_table[ewk->master_id][ewk->wu.type].pos_x;
        ewk->wu.position_y = g_state.afterimage_table[ewk->master_id][ewk->wu.type].pos_y;
    }

    ewk->wu.position_z = mwk->wu.position_z;

    if (ewk->wu.old_routine_no[3] == 0) {
        ewk->wu.old_cgnum = ewk->wu.cg_number = mwk->wu.cg_number;
        ewk->wu.facing_flag = mwk->wu.facing_flag;
        ewk->wu.cg_flip = mwk->wu.cg_flip;
    } else {
        ewk->wu.cg_number = g_state.afterimage_table[ewk->master_id][ewk->wu.type].cg_num;
        ewk->wu.facing_flag = g_state.afterimage_table[ewk->master_id][ewk->wu.type].flip;
        ewk->wu.cg_flip = g_state.afterimage_table[ewk->master_id][ewk->wu.type].cg_flp;
    }

    if (ewk->wu.old_routine_no[0]) {
        ewk->wu.position_z -= ewk->wu.active_move;
    } else {
        ewk->wu.position_z += ewk->wu.active_move;
    }

    if (ewk->wu.old_routine_no[4]) {
        if (ewk->wu.olc_work_ix[2] && mwk->metamorphose) {
            ewk->wu.extra_col = after_image_color[ewk->wu.old_routine_no[4] + ewk->wu.active_move - 1][(ewk->master_id + 1) & 1];
        } else {
            ewk->wu.extra_col = after_image_color[ewk->wu.old_routine_no[4] + ewk->wu.active_move - 1][ewk->master_id];
        }
    } else {
        ewk->wu.extra_col = mwk->wu.current_colcd;
    }

    if (ewk->wu.old_routine_no[1]) {
        get_attdata_of_illusion(ewk);
    }
}

static void effE8_trans(State_Other* ewk, PlayerEntity* mwk) {
    if (ewk->wu.old_routine_no[3] == 0) {
        return;
    }

    ewk->wu.old_routine_no[6] = ewk->wu.active_move - 1;
    ewk->wu.my_bright_level = (ewk->wu.old_routine_no[6] * 3) + 1;

    if (mwk->wu.disp_flag != 0 && mwk->sa_stop_flag == 0) {
        sort_push_request(&ewk->wu);
    }
}

s32 effect_E8_init(State_Other* ek, PlayerEntity* mk, s16 data) {
    State_Other* ewk;
    s16 ix;

    if ((ix = Acquire_Effect(3)) == -1) {
        return -1;
    }

    ewk = (State_Other*)frw[ix];
    ewk->wu.active_flag = 1;
    ewk->wu.disp_flag = ek->wu.disp_flag;
    ewk->wu.id = 148;
    ewk->wu.type = 0;
    ewk->wu.charset_id = data;
    ewk->wu.active_move = data / ek->wu.damage_calc_multiplier;

    if (ek->wu.old_routine_no[1]) {
        ewk->wu.work_id = 8;
    } else {
        ewk->wu.work_id = 16;
    }

    effect_e7_e8_init_union(ewk, ek, mk);
    return 0;
}
</file>

