            effect_E6_init(0x8E);
            effect_E6_init(0x51);
            Rewrite_End_Message(4);
            break;

        case 5:
            effect_E6_init(0x52);
            effect_E6_init(0x53);
            Rewrite_End_Message(6);
            end_fade_flag = 1;
            end_fade_timer = timer_10_tbl[g_state.end_w.r_no_2] - 120;
