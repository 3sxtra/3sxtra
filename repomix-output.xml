<file path="assets/ui/control_mapping.rcss">
/* Control mapping menu stylesheet — 3SXtra RmlUi overlay */
/* 5-column layout: P1 Prompt | P1 Device | Available | P2 Device | P2 Prompt */

body {
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 235);
    display: flex;
    justify-content: center;
    align-items: center;
}

#mapping-panel {
    display: block;
    width: 96vw;
    max-height: 96vh;
    background-color: rgba(15, 15, 20, 242);
    border-width: 1dp;
    border-color: #444;
    border-radius: 12dp;
    padding: 10dp 6dp;
    overflow-y: auto;
}

h1 {
    font-size: 22dp;
    color: #ff9933;
    margin-bottom: 8dp;
    text-align: center;
    white-space: nowrap;
}

h2 {
    font-size: 17dp;
    color: #b0b0b0;
    margin-top: 6dp;
    margin-bottom: 6dp;
    text-transform: uppercase;
    letter-spacing: 1dp;
    text-align: center;
    white-space: nowrap;
}

.divider {
    display: block;
    height: 1dp;
    background-color: #333;
    margin-top: 4dp;
    margin-bottom: 4dp;
}

/* ─── 5-column layout ─── */

.columns {
    display: block;
    white-space: nowrap;
}

.column {
    display: inline-block;
    vertical-align: top;
    padding: 2dp;
    white-space: normal;
}

.col-prompt {
    width: 26%;
}

.col-device {
    width: 15%;
    border-left-width: 1dp;
    border-left-color: #333;
    padding-left: 1dp;
}

.col-center {
    width: 18%;
    border-left-width: 1dp;
    border-left-color: #333;
    border-right-width: 1dp;
    border-right-color: #333;
    padding-left: 1dp;
    padding-right: 1dp;
}

/* ─── Device info ─── */

.device-name {
    display: block;
    color: #66ccff;
    font-size: 19dp;
    margin-bottom: 4dp;
    text-align: center;
    word-break: break-word;
}

.device-icon {
    display: block;
    width: 100%;
    height: auto;
    max-width: 120dp;
    margin: 2dp auto;
}

.device-icon-small {
    display: block;
    width: 100%;
    height: auto;
    max-width: 120dp;
    margin: 2dp auto;
}

.no-device {
    display: block;
    color: #888;
    font-size: 16dp;
    text-align: center;
    padding: 8dp 0;
}

/* ─── Buttons ─── */

button {
    display: block;
    padding: 6dp 10dp;
    background-color: #2a2a30;
    border-width: 1dp;
    border-color: #888;
    border-radius: 4dp;
    color: #ddd;
    font-size: 16dp;
    cursor: pointer;
    margin-bottom: 4dp;
    text-align: center;
}

button:hover {
    background-color: #3a3a44;
    border-color: #ff9933;
}

button:active {
    background-color: #222;
}

.btn-danger {
    border-color: #a33;
    color: #f88;
}

.btn-danger:hover {
    background-color: #3a2020;
    border-color: #f44;
}

/* ─── Mapping prompt ─── */

.prompt {
    display: block;
    color: #ffcc33;
    font-size: 20dp;
    padding: 8dp 0;
    text-align: center;
}

/* ─── Available device cards ─── */

.device-card {
    display: block;
    background-color: rgba(255, 255, 255, 10);
    border-width: 1dp;
    border-color: #333;
    border-radius: 3dp;
    padding: 4dp;
    margin-bottom: 4dp;
}

.device-card-name {
    display: block;
    color: #e0e0e0;
    font-size: 16dp;
    text-align: center;
    margin-bottom: 4dp;
    word-break: break-word;
}

.assign-buttons {
    display: block;
    text-align: center;
}

.assign-buttons button {
    display: inline-block;
    width: 40%;
    margin-right: 4dp;
    font-size: 16dp;
    font-weight: bold;
    white-space: nowrap;
}

/* ─── Mapping rows ─── */

.mapping-row {
    display: block;
    padding: 1dp 2dp;
    border-radius: 2dp;
}

.mapping-row:hover {
    background-color: rgba(255, 255, 255, 10);
}

.map-action {
    display: inline-block;
    width: 40%;
    color: #cccccc;
    font-size: 17dp;
}

.map-arrow {
    display: inline-block;
    width: 8%;
    color: #888;
    font-size: 17dp;
    text-align: center;
}

.map-input-container {
    display: inline-block;
    width: 48%;
    text-align: right;
    vertical-align: middle;
}

.map-input-text {
    color: #66ff66;
    font-size: 17dp;
}

.map-input-icon {
    display: inline-block;
    height: 32dp;
    width: auto;
    vertical-align: middle;
}

/* Status text */
.status-hint {
    color: #888;
    font-size: 17dp;
    display: block;
    text-align: center;
    padding: 8dp;
}

.hint {
    font-size: 17dp;
    color: #888;
    margin-top: 8dp;
    text-align: center;
}

/* Scrollbar */
#mapping-panel scrollbarvertical {
    width: 6dp;
}

#mapping-panel scrollbarvertical sliderbar {
    background-color: #888;
    border-radius: 3dp;
}

#mapping-panel scrollbarvertical sliderbar:hover {
    background-color: #777;
}

