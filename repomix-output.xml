/**
 * @file ms_win.c
 * @brief MenuScreen registry integration for the Win and Lose screens.
 *
 * Implements the on_enter, on_tick, and on_exit callbacks for
 * MENU_SCREEN_WIN and MENU_SCREEN_LOSER.
 */

#include "port/menu_screen.h"
#include "game_state.h"

#include "sf33rd/Source/Game/effect/effect_58_sound_se_request.h"
#include "sf33rd/Source/Game/effect/effect_76_quake.h"
#include "sf33rd/Source/Game/effect/effect_b8_quake.h"
#include "sf33rd/Source/Game/effect/effect_l1_decomposition_grade_g_state_score.h"
#include "sf33rd/Source/Game/engine/state_user.h"
#include "sf33rd/Source/Game/io/rumble.h"
#include "sf33rd/Source/Game/rendering/memory_texture_control.h"
#include "sf33rd/Source/Game/rendering/texture_group.h"
#include "sf33rd/Source/Game/screen/character_select_data.h"
#include "sf33rd/Source/Game/sound/sound_effects.h"
#include "sf33rd/Source/Game/sound/sound3rd.h"
#include "sf33rd/Source/Game/stage/bg.h"
#include "sf33rd/Source/Game/stage/stage_data.h"
#include "sf33rd/Source/Game/stage/stage_subroutines.h"
#include "sf33rd/Source/Game/system/system_subroutines.h"
#include "sf33rd/Source/Game/system/system_subroutines_2.h"
#include "sf33rd/Source/Game/system/work_sys.h"
#include "sf33rd/Source/Game/debug/Debug.h"
#include "sf33rd/Source/Game/io/afs_loader.h"

#include "port/sdl/rmlui/rmlui_phase3_toggles.h"
#include "port/sdl/rmlui/rmlui_win_screen.h"

extern u8 WIN_X;
extern void Setup_Wins_OBJ(void);

static void ms_win_enter(struct _TASK* tp) {
    s16 ix;

    Switch_Screen(0);
    g_state.Play_Mode = 1;
    g_state.Replay_Status[0] = 0;
    g_state.Replay_Status[1] = 0;

    tp->free[0] = 1; /* Match g_state.message_phase[0] phases 1 to 5 */
    tp->free[1] = 0; /* Matches g_state.message_phase[1] */

    g_state.Game_pause = 0;
    BGM_Request(55);
    g_state.Cover_Timer = 23;
    All_Clear_Suicide();
    g_state.base_y_pos = 40;

    for (ix = 0; ix < 4; ix++) {
        g_state.Unsubstantial_BG[ix] = 0;
    }

    System_all_clear_Level_B();
    Purge_mmtm_area(4);
    Allocate_Texture_Cache_List(4);
    load_any_texture_patnum(0x7F30, 0xC, 0);
    Setup_BG(0, 0x200, 0);
    bg_etc_write(PL_Color_Data[g_state.My_char[g_state.Winner_id]]);
    Setup_BG(2, 0x300, 0);
    Setup_BG(1, 0x200, 0);
    Setup_BG(3, 0x2C0, 0);

    if (g_state.Play_Type == 0) {
        g_state.Last_Selected_EM[g_state.Winner_id] = 1;
    }

    pulpul_stop();
}

static void ms_win_tick(struct _TASK* tp) {
    switch (tp->free[0]) {
    case 1:
        Switch_Screen(0);
        tp->free[0] += 1;

        /* g_state.Score/win globals — always compute, even in RmlUi mode */
        g_state.WGJ_Score =
            g_state.Continue_Coin[g_state.Winner_id] + g_state.Score[g_state.Winner_id][g_state.Play_Type];
        g_state.WGJ_Win = g_state.Win_Record[g_state.Winner_id];

        if (use_rmlui && rmlui_screen_winner) {
            rmlui_win_screen_show();
        } else {
            spawn_effect_76(0x37, 1, 1);
            spawn_effect_76(0x35, 3, 1);
            spawn_effect_76(0x34, 3, 1);
            spawn_effect_76(0x2B, 3, 1);
            spawn_effect_76(0x3A, 3, 1);
            spawn_effect_76(0x2C, 3, 1);

            g_state.Order_Dir[0x2D] = 4;
            spawn_effect_76(0x2D, 1, 0x1E);

            spawn_effect_76(0x38, 6, 1);
        }

        /* Sparkle + character victory anim — always run */
        effect_L1_init(1);
        effect_L1_init(2);
        effect_L1_init(3);
        effect_L1_init(4);
        effect_L1_init(5);
        effect_L1_init(6);

        if (!use_rmlui || !rmlui_screen_winner) {
            Setup_Wins_OBJ();
        }
        effect_B8_init(g_state.WINNER, 0x3C);
        break;

    case 2:
        switch (tp->free[1]) {
        case 0:
            Switch_Screen(0);
            tp->free[1] += 1;
            Clear_Flash_No();
            Switch_Screen_Init(1);
            break;

        case 1:
            if (Switch_Screen_Revival(1) != 0) {
                tp->free[0] += 1;
                tp->timer = 90;
                g_state.Forbid_Break = -1;
                g_state.Ignore_Entry[g_state.LOSER] = 0;
                g_state.Target_BG_X[2] = g_state.bg_w.bgw[2].wxy[0].disp.pos - 384;
                g_state.Offset_BG_X[2] = 0;
                g_state.Next_Step = 0;
                g_state.bg_mvxy.a[0].sp = -0x100000;
                g_state.bg_mvxy.d[0].sp = 0x800;

                effect_58_init(0xE, 0x14, 2);

                if (Debug_w[DEBUG_MY_CHAR_PL1]) {
                    g_state.My_char[0] = Debug_w[DEBUG_MY_CHAR_PL1] - 1;
                }
                if (Debug_w[DEBUG_MY_CHAR_PL2]) {
                    g_state.My_char[1] = Debug_w[DEBUG_MY_CHAR_PL2] - 1;
                }

                if (g_state.Mode_Type == MODE_ARCADE) {
                    Push_LDREQ_Queue_Player(g_state.Winner_id, g_state.My_char[g_state.Winner_id]);
                }
            }
            break;
        }
        break;

    case 3:
        if (--tp->timer <= 0) {
            tp->free[0] += 1;
            tp->free[1] = 0;
            tp->timer = 0xAA;
            g_state.Forbid_Break = 0;
        }
        break;

    case 4:
        switch (tp->free[1]) {
        case 0:
            if (g_state.Scene_Cut) {
                tp->timer = 9;
            }

            if (tp->timer < 10) {
                tp->timer = 9;
                tp->free[1] += 1;

                if (g_state.Mode_Type == MODE_ARCADE) {
                    SsBgmFadeOut(0x1000);
                }
            }
            break;
        }

        if (--tp->timer <= 0) {
            MenuScreen_RequestFadeOut(); /* FADE_OUT -> EXIT */
        }
        break;
    }
}

