typedef struct Location {
    Uint32 offset;
    Uint32 size;
} Location;

typedef struct LocationData {
    Location nmca;
    Location dmca;
    Location btca;
    Location caca;
    Location cuca;
    Location atca;
    Location saca;
    Location exca;
    Location cbca;
    Location yuca;
    Location stxy;
    Location mvxy;
    Location sernd;
    Location ovct;
    Location ovix;
    Location rict;
    Location hiit;
    Location boda;
    Location hana;
    Location cata;
    Location caua;
    Location atta;
    Location hosa;
    Location atit;
    Location prot;
