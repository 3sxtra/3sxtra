<file path="assets/ui/casual_lobby.rml">
<rml>
<head>
    <link type="text/rcss" href="base.rcss"/>
    <link type="text/rcss" href="casual_lobby.rcss"/>
    <title>Casual Lobby</title>
</head>
<body data-model="casual_lobby">
<div id="lobby-panel">

    <!-- ── Title bar ── -->
    <div id="lobby-title-bar">
        <div id="lobby-title-text">{{room_name}}</div>
        <div id="password-badge" data-if="room_password != ''">🔒 PW: {{room_password}}</div>
        <div id="hidden-badge" data-if="room_visibility == 1">🔒 ROOM CODE: {{room_code}}</div>
    </div>

    <!-- ── Main content: Left match/queue panel + Right chat panel ── -->
    <div id="lobby-body">

        <!-- Left: Match and Queue column -->
        <div id="lobby-match-col">
            
            <!-- Active Match -->
            <div id="active-match-panel" data-class-active="match_active">
                <div class="section-header">CURRENT MATCH</div>
                <div id="match-players">
                    <div class="match-player p1" data-class-winner="match_winner == 1">
                        <span class="player-tag">1P</span>
                        <span class="player-name">{{match_p1_name}}</span>
                    </div>
                    <div id="match-vs">VS</div>
                    <div class="match-player p2" data-class-winner="match_winner == 2">
                        <span class="player-tag">2P</span>
                        <span class="player-name">{{match_p2_name}}</span>
                    </div>
                </div>

                <div id="match-idle" data-if="!match_active">CABINET OPEN — JOIN QUEUE TO PLAY</div>
            </div>

            <!-- The Queue -->
            <div id="queue-panel">
                <div class="section-header">NEXT UP (QUEUE)</div>
                <div class="queue-list">
                    <div data-for="q : queue_players">
                        <div data-if="q.index < queue_count" class="queue-item" data-class-focused="cursor_x == 0 &amp;&amp; cursor_y == q.index + 1">
                            <span class="queue-num">{{q.index + 1}}.</span>
                            <span class="queue-name" data-class-self="q.is_self">{{q.name}}</span>
                        </div>
                    </div>
                </div>
                <div id="btn-leave-queue" data-if="in_queue" data-class-focused="cursor_x == 0 && cursor_y == 9">
                    STEP DOWN
                </div>
                <div id="btn-join-queue" data-if="!in_queue" data-class-focused="cursor_x == 0 && cursor_y == 9">
                    INSERT COIN (JOIN QUEUE)
                </div>
            </div>

            <div id="btn-leave-room" data-class-focused="cursor_x == 0 && cursor_y == 10">
                LEAVE ROOM
            </div>
            <div id="qr-badge" data-if="qr_image_path != ''">
                <img data-attr-src="qr_image_path" id="qr-code-img"/>
                <div id="qr-label">SCAN TO JOIN</div>
            </div>
            
        </div>

        <!-- Right: Player List + Chat column -->
        <div id="lobby-chat-col">
            <!-- Player List -->
            <div class="section-header">PLAYERS ({{player_count}}/{{max_players}})</div>
            <div id="player-list">
                <div data-for="pl : room_players">
                    <div data-if="pl.index < player_count" class="player-row"
                         data-class-self="pl.is_self"
                         data-class-playing="pl.is_playing"
                         data-class-queued="pl.is_queued">
                        <img data-if="pl.country != ''"
                             data-attr-src="'../flags_icons/' + pl.country + '.png'"
                             class="player-flag"/>
                        <span class="player-list-name">{{pl.name}}</span>
                        <span class="player-status" data-if="pl.is_playing">[VS]</span>
                        <span class="player-status" data-if="pl.is_queued &amp;&amp; !pl.is_playing">&#x23F3;</span>
                    </div>
                </div>
            </div>

            <!-- Chat -->
            <div class="section-header">CHAT</div>
            <div id="chat-messages">
                <div data-for="msg : chat_messages">
                    <div data-if="msg.index < chat_count" class="chat-msg">
                        <span class="chat-sender">{{msg.sender}}:</span>
                        <span class="chat-text">{{msg.text}}</span>
                    </div>
                </div>
            </div>

            <div id="chat-input-box" data-class-focused="cursor_x == 1">
                <span id="chat-prompt">&gt;</span>
                <span id="chat-typing-text" data-class-active="is_typing">{{chat_input}}{{is_typing ? '_' : ''}}</span>
                <span id="chat-hint" data-if="!is_typing">PRESS [START] TO CHAT</span>
            </div>
        </div>

    </div>

    <!-- ── Match Accept Popup (inline — data-if driven) ── -->
    <div id="match-accept-panel" data-if="proposal_active">
        <div id="ma-title">MATCH FOUND!</div>
        <div id="ma-opponent-section">
            <div id="ma-opponent-label">OPPONENT</div>
            <div id="ma-opponent-name">{{proposal_opponent_name}}</div>
            <div id="ma-opponent-details">
                <span class="ma-detail-item" data-if="proposal_opponent_ping >= 0">
                    ~{{proposal_opponent_ping}}ms
                </span>
                <span class="ma-detail-item">
                    {{proposal_opponent_conn_type == 'wired' ? 'Wired' : (proposal_opponent_conn_type == 'wifi' ? 'WiFi' : '?')}}
                </span>
            </div>
        </div>
        <div id="ma-countdown-section">
            <div id="ma-countdown-bar-bg">
                <div id="ma-countdown-bar-fill" data-style-width="proposal_countdown_pct + '%'"/>
            </div>
            <div id="ma-countdown-text">{{proposal_countdown}}s</div>
        </div>
        <div id="ma-buttons">
            <div id="ma-btn-accept" data-class-focused="proposal_cursor == 0">
                ACCEPT
            </div>
            <div id="ma-btn-decline" data-class-focused="proposal_cursor == 1">
                DECLINE
            </div>
        </div>
    </div>

    <!-- ── Chat Popup (inline — data-if driven, Pi4 compatible) ── -->
    <div id="chat-popup" data-if="is_typing">
        <div id="chat-popup-title">ROOM CHAT</div>
        <div id="chat-popup-text">{{chat_input}}<span class="cursor-blink">|</span></div>
        <div class="chat-help">Type message, ENTER to send, ESC to cancel</div>
    </div>

    <!-- ── Status bar ── -->
    <div id="status-bar" data-if="status_text != ''">
        <span id="status-text">{{status_text}}</span>
    </div>

</div>
</body>
</rml>
</file>

<file path="assets/ui/char_select.rcss">
/* ── Character Select Overlay ─────────────────────────────── */
body {
    width: 384dp;
    height: 224dp;
    font-family: "DistrictTF-RegularItalic";
    font-size: 17dp;
    color: #ffffff;
}

.sel-overlay {
    display: block;
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
}

/* ── Base Name Plate ── */
.sel-name {
    display: block;
    position: absolute;
    font-weight: bold;
    color: #ffffff;
    text-transform: uppercase;
    font-effect: shadow(2dp 2dp #000000cc);
}

/* ── Single Player: one line, top-left ── */
.sel-name-solo {
    top: 10dp;
    left: 28dp;
    font-size: 24dp;
}

/* ── Two Player: P1 bottom-left, two lines ── */
.sel-name-dual-1p {
    bottom: 32dp;
    left: 18dp;
    text-align: left;
}

/* ── Two Player: P2 top-right, two lines ── */
.sel-name-dual-2p {
    top: 14dp;
    right: 18dp;
    text-align: right;
}

.sel-player-tag {
    font-size: 22dp;
}

.sel-char-name {
    font-size: 26dp;
}

/* ── Timer (shared base) ── */
.sel-timer {
    display: block;
    position: absolute;
    width: 56dp;
    height: 30dp;
    font-weight: bold;
    color: #ffffff;
    font-effect: shadow(2dp 2dp #000000aa);
    z-index: 10;
}

/* Solo mode: bottom-aligned with SELECT row, further right */
.sel-timer-solo {
    bottom: 2dp;
    right: 8dp;
}

/* Dual mode: bottom-center, aligned with solo timer */
.sel-timer-dual {
    bottom: 2dp;
    left: 50%;
}

/* "TIME" label: top-left quadrant, right-aligned */
.sel-time-label {
    display: block;
    position: absolute;
    top: 0;
    left: 0;
    width: 50%;
    text-align: right;
    font-size: 11dp;
    color: #ffffffaa;
}

/* Counter value: bottom-right quadrant, center-aligned */
.sel-timer-value {
    display: block;
    position: absolute;
    bottom: 0;
    right: 0;
    width: 50%;
    text-align: center;
    font-size: 24dp;
}

/* ── Reusable Screen-Phase Banner (PLAYER SELECT / SUPER ARTS SELECT) ── */
.sel-screen-banner {
    display: block;
    position: absolute;
    bottom: 2dp;
    right: 0;
    width: 36%;
    padding: 2dp 6dp;
    background-color: #cc0000;
}

/* Line 1: e.g. "PLAYER" or "SUPER ARTS" */
.sel-banner-line1 {
    display: block;
    font-size: 17dp;
    font-weight: bold;
    color: #ffffff;
    text-transform: uppercase;
    font-effect: shadow(2dp 2dp #000000aa);
    line-height: 1.0;
    margin-bottom: 2dp;
}

/* Line 2: always "SELECT" */
.sel-banner-line2 {
    display: block;
    font-size: 17dp;
    font-weight: bold;
    color: #ffffff;
    text-transform: uppercase;
    font-effect: shadow(2dp 2dp #000000aa);
    line-height: 1.0;
}

/* ── Super Arts Selection ── */
.sa-container {
    display: block;
    position: absolute;
    width: 130dp;
}

/* Positional base — overridden by scenario classes below */
.sa-p1 {}
.sa-p2 {}

/* ── Scenario-specific positions (from native Plate_Pos_Data_79) ── */
/* Solo 1P: P1 plate — right-of-center, raised */
.sa-pos-1p-solo {
    left: 215dp;
    top: 40dp;
}

/* Solo 2P: P2 plate — left-of-center, raised */
.sa-pos-2p-solo {
    left: 23dp;
    top: 40dp;
}

/* Two Players P1: above the 1P label */
.sa-pos-dual-p1 {
    left: 0dp;
    top: 100dp;
}

/* Two Players P2: under the 2P label */
.sa-pos-dual-p2 {
    left: 234dp;  /* 130dp container + 8dp padding = 146dp actual; 234+146=380dp right edge */
    top: 72dp;
}

.sa-plate {
    display: block;
    position: relative;
    width: 100%;
    margin-bottom: 2dp;
    padding: 2dp 8dp;
    overflow: hidden;
    white-space: nowrap; /* keep numeral + name on one line always */
    background-color: #222222cc;
    border-width: 1dp;
    border-color: #888888;
    border-radius: 12dp;
    text-align: center;
    color: #b0b0b0;
    transform: scale(0.85);
    transition: transform 0.1s, background-color 0.1s;
}

.sa-plate.active {
    background-color: #e0e0e0;
    border-width: 2dp;
    border-color: #ff0000;
    color: #000000;
    transform: scale(1.0); /* Active is full size */
    z-index: 10;
}

.sa-numeral {
    display: inline-block;
    font-family: "BoldPixels";
    font-size: 20dp;
    font-weight: bold;
    font-effect: shadow(1dp 1dp #000000);
    margin-right: 6dp;
    margin-top: -2dp;
    vertical-align: middle;
}

.sa-numeral-0 { color: #ffff00; } /* Yellow */
.sa-numeral-1 { color: #ff2020; } /* Red */
.sa-numeral-2 { color: #2080ff; } /* Blue */

.sa-name-text {
    display: inline-block;
    font-family: "DistrictTF-RegularItalic";
    font-size: 12dp;
    font-weight: bold;
    vertical-align: middle;
}

.sa-plate.active .sa-name-text {
    font-effect: shadow(1dp 1dp #ffffffaa);
}

/* ── Super Art Cursors (Blue Arrows) ── */
.sa-cursor {
    display: block;
    position: absolute;
    width: 0;
    height: 0;
    
    /* Simulate triangle borders */
    border-left-width: 8dp;
    border-left-color: transparent;
    border-right-width: 8dp;
    border-right-color: transparent;

    left: 50%;
    margin-left: -8dp;
}

.sa-cursor-up {
    top: -12dp;
    border-bottom-width: 10dp;
    border-bottom-color: #00aaff;
}

.sa-cursor-down {
    bottom: -12dp;
    border-top-width: 10dp;
    border-top-color: #00aaff;
}

/* ── Stage Select Overlay ── */
.stg-section {
    display: block;
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
}


/* Red banner: "FIRST STAGE" — vertically centered on 224dp screen */
.stg-banner {
    top: 95dp;
    z-index: 5;
}

/* Timer on stage select: same pos as solo timer in char select, but above banner */
.stg-timer {
    bottom: 6dp;
    right: 8dp;
    z-index: 10;
}

/* Opponent row: full width, vertically centered content */
.stg-opponent {
    display: block;
    position: absolute;
    left: 0;
    width: 100%;
    height: 88dp;
    box-sizing: border-box;
    padding: 0 20dp;
    z-index: 6;
}

.stg-top {
    top: 8dp;
}

.stg-bot {
    top: 124dp;
}


/* Country flag */
.stg-flag {
    display: block;
    position: absolute;
    left: 22dp;
    top: 50%;
    margin-top: -15dp;
    width: 46dp;
    height: 30dp;
}

/* Row content block: country + char name, right of the flag.
   position:absolute with left+right lets it span from flag edge to row right edge. */
.stg-row-content {
    display: block;
    position: absolute;
    left: 76dp;
    top: 0;
    right: 0;
    height: 88dp;
    overflow: hidden;
}

/* Country name — vertically centered in the row */
.stg-country {
    display: block;
    position: absolute;
    top: 50%;
    left: 0;
    margin-top: -12dp;
    font-size: 24dp;
    font-weight: bold;
    color: #ffffff;
    font-effect: shadow(2dp 2dp #000000cc);
    text-transform: uppercase;
}

/* Character name — large italic, right side, vertically centered */
.stg-charname {
    display: block;
    position: absolute;
    right: 10dp;
    top: 50%;
    margin-top: -16dp;
    font-size: 34dp;
    font-weight: bold;
    color: #ffffff;
    font-effect: shadow(3dp 3dp #000000cc);
    text-transform: uppercase;
}

/* ── Character Portraits ── */
/* height-constrained: RmlUI computes proportional width via intrinsic_ratio.
   Confirmed in CalculateSizeForReplacedElement: when auto_width=true and
   auto_height=false, content_size.x = content_size.y * intrinsic_ratio.
   Using height ensures no overflow above the screen top.
   transform-origin bottom: PAR scaleY correction (data-style-transform) anchors at bottom. */
.sel-portrait {
    display: block;
    position: absolute;
    width: auto;
    height: 224dp;
    transform-origin: 50% 100%;
}

/* Solo / P1 side: right-edge at screen center, overflows leftward off-screen */
.sel-portrait-p1 {
    right: 50%;
    bottom: 0;
}

/* P2 side: left-edge at screen center, overflows rightward off-screen */
.sel-portrait-p2 {
    left: 50%;
    bottom: 0;
}

/* ── VS Screen portrait overrides (full-body fas set) ── */
/* Confined to outer 1/3 zones — center 1/3 is the VS logo no-go zone.
 * P1: right edge at ~128dp (right:66%), extends leftward off-screen.
 * P2: left edge at ~256dp (left:66%), extends rightward off-screen.
 * Outer overflow (off screen edges) is acceptable; center is never crossed. */
.sel-portrait-p1.vs-portrait {
    height: 224dp;
    width: auto;
    right: 66%;
}

.sel-portrait-p2.vs-portrait {
    height: 224dp;
    width: auto;
    left: 66%;
}


/* ── VS Screen Name Plates ── */
.vs-section {
    display: block;
    position: absolute;
    top: 8dp;
    left: 0;
    width: 384dp;
}

.vs-name {
    display: block;
    position: absolute;
    top: 0;
    font-size: 22dp;
    font-weight: bold;
    color: #ffffff;
    text-transform: uppercase;
    font-effect: shadow(2dp 2dp #000000cc);
}

.vs-name-p1 {
    left: 16dp;
    text-align: left;
}

.vs-name-p2 {
    right: 16dp;
    text-align: right;
}
</file>

<file path="assets/ui/char_select.rml">
<rml>
<head>
    <link type="text/rcss" href="base.rcss"/>
    <link type="text/rcss" href="char_select.rcss"/>
    <title>Character Select</title>
</head>
<body data-model="char_select">
    <div id="sel-overlay" class="sel-overlay">

        <!-- ═══ PORTRAITS ═══ -->
        <img class="sel-portrait sel-portrait-p1" data-if="sel_p1_solo || sel_both_active || vs_active" data-attr-src="sel_p1_portrait" data-class-vs-portrait="vs_active"
             data-style-transform="'scaleY(' + sel_portrait_scale_y + ')'" />
        <img class="sel-portrait sel-portrait-p2" data-if="sel_p2_solo || sel_both_active || vs_active" data-attr-src="sel_p2_portrait" data-class-vs-portrait="vs_active"
             data-style-transform="'scaleY(' + sel_portrait_scale_y + ')'" />

        <!-- ═══ SINGLE PLAYER: one line at top-left ═══ -->
        <div class="sel-name sel-name-solo" data-if="sel_p1_solo">
            <span>1P {{ sel_p1_name }}</span>
        </div>
        <div class="sel-name sel-name-solo" data-if="sel_p2_solo">
            <span>2P {{ sel_p2_name }}</span>
        </div>

        <!-- ═══ TWO PLAYER: two lines each ═══ -->
        <div class="sel-name sel-name-dual-1p" data-if="sel_both_active">
            <div class="sel-player-tag">1P</div>
            <div class="sel-char-name">{{ sel_p1_name }}</div>
        </div>
        <div class="sel-name sel-name-dual-2p" data-if="sel_both_active">
            <div class="sel-char-name">{{ sel_p2_name }}</div>
            <div class="sel-player-tag">2P</div>
        </div>

        <!-- Timer: solo mode (bottom-right) -->
        <div class="sel-timer sel-timer-solo" data-if="sel_p1_solo || sel_p2_solo">
            <div class="sel-time-label">TIME</div>
            <div class="sel-timer-value">{{ sel_timer }}</div>
        </div>

        <!-- Timer: dual mode (bottom-center) -->
        <div class="sel-timer sel-timer-dual" data-if="sel_both_active">
            <div class="sel-time-label">TIME</div>
            <div class="sel-timer-value">{{ sel_timer }}</div>
        </div>

        <!-- PLAYER SELECT banner (solo mode, before character confirmed) -->
        <div class="sel-screen-banner" data-if="sel_banner_visible">
            <div class="sel-banner-line1">PLAYER</div>
            <div class="sel-banner-line2">SELECT</div>
        </div>

        <!-- SUPER ARTS SELECT banner (solo mode only — hidden in 2P) -->
        <div class="sel-screen-banner" data-if="sel_sa_banner_visible && !sel_both_active">
            <div class="sel-banner-line1">SUPER ARTS</div>
            <div class="sel-banner-line2">SELECT</div>
        </div>

        <!-- Timer: stage select / VS screen phase (hidden in dual mode — that has its own center timer) -->
        <div class="sel-timer sel-timer-solo" data-if="sel_timer_visible && !sel_both_active">
            <div class="sel-time-label">TIME</div>
            <div class="sel-timer-value">{{ sel_timer }}</div>
        </div>

        <!-- ═══ SUPER ARTS SELECTION P1 ═══ -->
        <div class="sa-container sa-p1" data-if="sel_p1_sa_visible"
             data-class-sa-pos-1p-solo="sel_p1_solo"
             data-class-sa-pos-dual-p1="sel_both_active">
            <div class="sa-plate" data-class-active="sel_p1_sa_active">
                <div class="sa-numeral" data-class-sa-numeral-0="sel_p1_sa_index == 0" data-class-sa-numeral-1="sel_p1_sa_index == 1" data-class-sa-numeral-2="sel_p1_sa_index == 2">{{ sel_p1_sa_current_numeral }}</div>
                <div class="sa-name-text">{{ sel_p1_sa_current_name }}</div>
                <div class="sa-cursor sa-cursor-up"></div>
                <div class="sa-cursor sa-cursor-down"></div>
            </div>
        </div>

        <!-- ═══ SUPER ARTS SELECTION P2 ═══ -->
        <div class="sa-container sa-p2" data-if="sel_p2_sa_visible"
             data-class-sa-pos-2p-solo="sel_p2_solo"
             data-class-sa-pos-dual-p2="sel_both_active">
            <div class="sa-plate" data-class-active="sel_p2_sa_active">
                <div class="sa-numeral" data-class-sa-numeral-0="sel_p2_sa_index == 0" data-class-sa-numeral-1="sel_p2_sa_index == 1" data-class-sa-numeral-2="sel_p2_sa_index == 2">{{ sel_p2_sa_current_numeral }}</div>
                <div class="sa-name-text">{{ sel_p2_sa_current_name }}</div>
                <div class="sa-cursor sa-cursor-up"></div>
                <div class="sa-cursor sa-cursor-down"></div>
            </div>
        </div>

        <!-- ═══ STAGE SELECT OVERLAY ═══ -->
        <div class="stg-section" data-if="stg_visible">

            <!-- Red banner: "FIRST STAGE" etc. -->
            <div class="red-banner stg-banner">
                <div class="red-banner-text">{{ stg_stage_label }}</div>
            </div>

            <!-- Timer: bottom-right, same style as char select -->
            <div class="sel-timer sel-timer-solo stg-timer">
                <div class="sel-time-label">TIME</div>
                <div class="sel-timer-value">{{ sel_timer }}</div>
            </div>

            <!-- Top opponent (EM slot 1) -->
            <div class="stg-opponent stg-top" data-class-stg-selected="stg_sel_top">
                <img class="stg-flag" data-attr-src="stg_em1_flag" />
                <div class="stg-row-content">
                    <div class="stg-country">{{ stg_em1_country }}</div>
                    <div class="stg-charname">{{ stg_em1_name }}</div>
                </div>
            </div>

            <!-- Bottom opponent (EM slot 2) -->
            <div class="stg-opponent stg-bot" data-class-stg-selected="stg_sel_bot">
                <img class="stg-flag" data-attr-src="stg_em2_flag" />
                <div class="stg-row-content">
                    <div class="stg-country">{{ stg_em2_country }}</div>
                    <div class="stg-charname">{{ stg_em2_name }}</div>
                </div>
            </div>
        </div>

        <!-- ═══ VS SCREEN NAME PLATES ═══ -->
        <div class="vs-section" data-if="vs_active">
            <div class="vs-name vs-name-p1">{{ sel_p1_name }}</div>
            <div class="vs-name vs-name-p2">{{ sel_p2_name }}</div>
        </div>
    </div>
</body>
</rml>
</file>

<file path="assets/ui/continue.rcss">
/* ── Continue Screen Stylesheet ────────────────────────────── */
body {
    width: 384dp;
    height: 224dp;
    font-family: "DistrictTF-RegularItalic";
    font-size: 17dp;
    color: #ffffffee;
}

/* Position the red banner at mid-screen */
.continue-banner {
    top: 96dp;
}

/* Panel sits below the banner, centred */
.continue-panel {
    display: block;
    position: absolute;
    top: 128dp;
    left: 50%;
    margin-left: -120dp;
    width: 240dp;
    text-align: center;
}

/* ── Countdown number ───────────────────────────────────────── */
.countdown-display {
    display: block;
    margin-bottom: 8dp;
}

.countdown-number {
    display: inline-block;
    font-size: 36dp;
    font-weight: bold;
    color: #ff4444;
    font-effect: shadow(2dp 2dp #00000088);
    animation: count-pulse 1.0s sine-in-out infinite;
}

@keyframes count-pulse {
    0% {
        font-size: 36dp;
        color: #ff4444;
    }
    50% {
        font-size: 40dp;
        color: #ffcc44;
    }
    100% {
        font-size: 36dp;
        color: #ff4444;
    }
}

/* ── Loser character name ───────────────────────────────────── */
.loser-name {
    display: block;
    font-size: 14dp;
    color: #cccccc;
    letter-spacing: 2dp;
}
</file>

<file path="assets/ui/continue.rml">
<rml>
<head>
    <link type="text/rcss" href="base.rcss"/>
    <link type="text/rcss" href="continue.rcss"/>
    <title>Continue Screen</title>
</head>
<body data-model="continue_screen">
    <!-- Red banner: "CONTINUE?" -->
    <div class="red-banner continue-banner">
        <div class="red-banner-text">CONTINUE?</div>
    </div>

    <div id="continue-panel" class="continue-panel">
        <div class="countdown-display">
            <span class="countdown-number">{{ continue_count }}</span>
        </div>

        <div class="loser-name">
            <span>{{ loser_name }}</span>
        </div>
    </div>
</body>
</rml>
