        stop_if(cg_add_xy_3sx != cg_add_xy_cps3);
    }
}

static void compare_move_work(SDL_IOStream* io) {
    MOVE_WORK move_work_cps3[2][56];
    read_move_work(io, move_work_cps3);

    for (int i = 0; i < 2; i++) {
