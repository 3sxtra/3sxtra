void effect_02_move(State_Other* ewk) {
    const HMDT* tad;
    const EXPLEM* edt;

    switch (ewk->wu.routine_no[0]) {
    case 0:
        ewk->wu.routine_no[0]++;
        ewk->wu.char_table[0] = _ef01_char_table;
        tad = &hmdt[ewk->wu.kind_of_hit_mark];

        if (ewk->wu.vital_old == 2) {
            ewk->wu.kind_of_hit_mark = tad->deff;

            if (ewk->wu.damage_vitality != 0) {
                ewk->wu.kind_of_hit_mark = tad->kezu;
            }
        }

        tad = &hmdt[ewk->wu.kind_of_hit_mark];

        if (tad->hits == 0) {
            if (tad->se) {
                urian_guard_se_check(ewk, (PlayerEntity*)ewk->wu.target_adrs, tad->se);
            } else {
                g_state.Last_Called_SE = 0;
            }

            if (tad->quake != 0) {
                g_state.bg_w.quake_y_index = gqdt[tad->quake][1];
                pp_screen_quake(g_state.bg_w.quake_y_index);
            }

            Release_Effect(&ewk->wu);
            break;
        }

        if (tad->status & 8) {
            ewk->wu.disp_flag = 2;
        } else {
            ewk->wu.disp_flag = 1;
        }

        if (tad->status & 0x40) {
            if (((PlayerEntity*)ewk->wu.target_adrs)->wu.work_id == 1) {
                ewk->wu.dir_timer = ((PlayerEntity*)ewk->wu.target_adrs)->player_number;
            } else {
                ewk->wu.dir_timer = ((State_Other*)ewk->wu.target_adrs)->master_player;
            }
        }

        if (tad->col) {
            ewk->wu.my_col_code = hcct[tad->col];
        } else if (tad->status & 0x80) {
            ewk->wu.my_col_code = ((PlayerEntity*)ewk->wu.target_adrs)->wu.my_col_code;
        }

        if (tad->se) {
            urian_guard_se_check(ewk, (PlayerEntity*)ewk->wu.target_adrs, tad->se);
        } else {
            g_state.Last_Called_SE = 0;
        }

        if (tad->status & 4) {
            ewk->wu.facing_flag = ewk->wu.damage_facing;
        }

        if (tad->status & 0x10) {
            if (tad->status & 0x20) {
                edt = &explem2[tad->emhix][ewk->wu.dir_timer];
            } else {
                edt = &explem[tad->myhix];
            }

            if (ewk->wu.facing_flag) {
                ewk->wu.xyz[0].disp.pos -= *(s16*)&edt->hx;
            } else {
                ewk->wu.xyz[0].disp.pos += *(s16*)&edt->hx;
            }

            ewk->wu.xyz[1].disp.pos += *(s16*)&edt->hy;
        } else {
            ewk->wu.xyz[0].disp.pos += ewk->wu.old_pos[0];
            ewk->wu.xyz[1].disp.pos += ewk->wu.old_pos[1];
        }

        if (ewk->wu.weight_level) {
            ewk->wu.xyz[0].disp.pos += ((PlayerEntity*)ewk->my_master)->forced_movement;
        }

        if (tad->status & 2) {
            ewk->wu.xyz[0].disp.pos += random_16() - 7;
            ewk->wu.xyz[1].disp.pos += (random_16() & 7) - 3;
        }

        ewk->wu.screen_move_x = gqdt[tad->quake][0];
        ewk->wu.screen_move_y = gqdt[tad->quake][1];
        ewk->wu.position_x = ewk->wu.xyz[0].disp.pos;
        ewk->wu.position_y = ewk->wu.xyz[1].disp.pos;
        ewk->wu.position_z = ewk->wu.xyz[2].disp.pos;

        if (tad->status & 0x10) {
            set_char_move_init(&ewk->wu, 0, edt->chix);
        } else {
            ewk->wu.dir_old = 0;

            if (tad->dir) {
                ewk->wu.dir_old = hit_mark_dir_table[ewk->wu.direction];

                if (ewk->wu.dir_old < 0) {
                    ewk->wu.facing_flag = 1;
                    ewk->wu.dir_old = -ewk->wu.dir_old;
                }
            }

            set_char_move_init(&ewk->wu, 0, tad->hits + ewk->wu.dir_old);
        }

        if (ewk->wu.char_index == 0x4B) {
            ewk->wu.mirror_flag = 1;
            ewk->wu.mirror_scale.size.x = 127;
            ewk->wu.mirror_scale.size.y = 63;
            ewk->wu.my_col_code |= (ewk->master_id == 1) * 16;
        }

        if (!g_state.Pause_Hit_Marks) {
            sort_push_request8(&ewk->wu);
        }

        break;

    case 1:
        if (ewk->wu.death_timer == 1 || g_state.Suicide[6] != 0) {
            ewk->wu.disp_flag = 0;
            ewk->wu.routine_no[0]++;
            break;
        }

        if (g_state.Pause_Hit_Marks) {
            break;
        }

        if (g_state.execute_flag == 0 && g_state.Game_pause == 0) {
            char_move(&ewk->wu);

            if (ewk->wu.cg_type == 0xFF) {
                ewk->wu.disp_flag = 0;
                ewk->wu.routine_no[0]++;
                break;
            }

            if (ewk->wu.screen_move_x && --ewk->wu.screen_move_x == 0) {
                g_state.bg_w.quake_y_index = ewk->wu.screen_move_y;
                pp_screen_quake(g_state.bg_w.quake_y_index);
            }
        }

        sort_push_request8(&ewk->wu);

        break;

    case 2:
        ewk->wu.routine_no[0] = 3;
        break;

    default:
        Release_Effect(&ewk->wu);
        break;
    }
}

static void urian_guard_se_check(State_Other* ewk, PlayerEntity* twk, u16 oto) {
    if (twk->player_number == 13 && (oto == 266 || oto == 267)) {
        Se_Dispatch(280, 280, ewk);
        g_state.Last_Called_SE = 280;
        return;
    }

    Se_Dispatch(oto, oto, ewk);
    g_state.Last_Called_SE = oto;
}

s32 effect_02_init(State* wk, s8 dmgp, s8 mkst, s8 dmrl) {
    State_Other* ewk;
    State_Other* dwk;
    s16 ix;

    if (g_state.Combo_Demo_Flag & 0x80) {
        return 0;
    }

    if ((ix = Acquire_Effect(2)) == -1) {
        return -1;
    }

    ewk = (State_Other*)frw[ix];
    ewk->wu.active_flag = 1;
    ewk->wu.id = 2;
    ewk->wu.work_id = 64;
    ewk->wu.vital_new = dmgp;
    ewk->wu.vital_old = mkst;
    ewk->wu.damage_facing = dmrl;
    ewk->wu.kind_of_hit_mark = wk->att.hit_mark;
    ewk->wu.direction = wk->dir_atthit;
    ewk->wu.damage_vitality = wk->chip_damage_power;
    ewk->wu.graphic_rom_type = 1;
    ewk->wu.my_col_mode = 0x4200;
    ewk->wu.my_family = 2;
    ewk->wu.mirror_flag = 0;
    ewk->wu.xyz[0].disp.pos = ewk->wu.position_x = wk->xyz[0].disp.pos;
    ewk->wu.xyz[1].disp.pos = ewk->wu.position_y = wk->xyz[1].disp.pos;
    ewk->wu.xyz[2].disp.pos = 26;
    ewk->wu.old_pos[0] = wk->hit_mark_x - wk->xyz[0].disp.pos;
    ewk->wu.old_pos[1] = wk->hit_mark_y - wk->xyz[1].disp.pos;
    ewk->wu.weight_level = 0;

    if (wk->work_id == 1) {
        ewk->my_master = wk;
        ewk->master_id = wk->id;
        ewk->master_work_id = wk->work_id;
        ewk->wu.target_adrs = wk->target_adrs;
        ewk->wu.my_col_code = wk->my_col_code;
        ewk->master_player = ewk->wu.dir_timer = ((PlayerEntity*)wk)->player_number;
        ewk->wu.weight_level = 1;
    } else {
        dwk = (State_Other*)wk;
        ewk->my_master = dwk->my_master;
        ewk->master_id = dwk->master_id;
        ewk->master_work_id = dwk->master_work_id;
        ewk->wu.target_adrs = ((State*)dwk->my_master)->target_adrs;
        ewk->wu.my_col_code = ((State*)dwk->my_master)->my_col_code;
        ewk->master_player = ewk->wu.dir_timer = dwk->master_player;
    }

    ewk->wu.blink_timing = ewk->master_id;
    return 0;
}
