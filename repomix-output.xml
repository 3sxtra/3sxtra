                break;
            }

            if (g_state.execute_flag) {
                break;
            }

            if (--ewk->wu.dir_timer > 0) {
                break;
            }

            if (ewk->wu.shadow_prio) {
                Se_Dispatch(167, 167, ewk);
            }

            ewk->wu.dir_timer = 3;
            ewk->num_of_conn++;

            if (ewk->num_of_conn >= ewk->wu.direction) {
                ewk->wu.routine_no[0] = 1;
                ewk->wu.routine_no[1] = 0;
            }

            break;
        }

        effB1_trans(&ewk->wu);
        break;

    case 1:
        if (ewk->wu.death_timer == 1 || g_state.Suicide[0] != 0) {
            ewk->wu.disp_flag = 0;
            ewk->wu.type = 0;
            ewk->wu.routine_no[0] = 2;
            break;
        }

        if (ewk->wu.dir_step > g_state.Bonus_Game_result) {
            ewk->wu.routine_no[1] = 1;
        }

        switch (ewk->wu.routine_no[1]) {
        case 0:
            if (g_state.Bonus_Game_result) {
                for (i = 0; i < g_state.Bonus_Game_result; i++) {
                    if (!ewk->conn[i + 20].nx) {
                        ewk->conn[i + 20].nx = 1;
                    }
                }

                effB1_mark_change(ewk);
            }

            break;

        default:
            if (ewk->wu.dir_step != g_state.Bonus_Game_result) {
                for (i = g_state.Bonus_Game_result; i < ewk->wu.dir_step; i++) {
                    if (ewk->conn[i + 20].nx != 2) {
                        ewk->conn[i + 20].nx = 2;
                        ewk->conn[i + 20].ny = 0;
                    }
                }
            }

            effB1_mark_exchange(ewk);
            break;
        }

        ewk->wu.dir_step = g_state.Bonus_Game_result;
        effB1_trans(&ewk->wu);
        break;

    case 2:
        ewk->wu.routine_no[0]++;
        break;

    default:
        Release_Effect(&ewk->wu);
        break;
    }
}

static void effB1_trans(State* ewk) {
    ewk->position_x = g_state.bg_w.bgw[2].wxy[0].disp.pos;
    ewk->position_y = g_state.bg_w.bgw[2].wxy[1].disp.pos;
    sort_push_request3(ewk);
}

static void effB1_mark_change(EffectMultiSprite* ewk) {
    s16 i;

    for (i = 0; i < g_state.Bonus_Game_result; i++) {
        switch (ewk->conn[i + 20].ny) {
        default:
            if (--ewk->conn[i + 20].col > 0) {
                break;
            }

            /* fallthrough */

        case 0:
            ewk->conn[i + 20].col = effB1_wait_table[ewk->conn[i + 20].ny];
            ewk->conn[i + 20].ny++;
            ewk->conn[i].chr++;
            break;

        case 4:
            break;
        }
    }
}

static void effB1_mark_exchange(EffectMultiSprite* ewk) {
    s16 i;

    for (i = 0; i < ewk->wu.direction; i++) {
        if (ewk->conn[i + 20].nx == 0) {
            continue;
        }

        if (ewk->conn[i + 20].nx == 1) {
            continue;
        }

        switch (ewk->conn[i + 20].ny) {
        default:
            if (--ewk->conn[i + 20].col > 0) {
                break;
            }

            /* fallthrough */

        case 0:
            ewk->conn[i + 20].col = effB1_wait_tbl_2[ewk->conn[i + 20].ny];
            ewk->conn[i + 20].ny++;
            ewk->conn[i].chr--;
            break;

        case 4:
            break;
        }
    }
}

s32 effect_B1_init(PlayerEntity* wk, s32 flag) {
    EffectMultiSprite* ewk;
    s16 ix;
    s16 i;

    if ((ix = Acquire_Effect(4)) == -1) {
        return -1;
    }

    ewk = (EffectMultiSprite*)frw[ix];
    ewk->wu.active_flag = 1;
    ewk->wu.id = 111;
    ewk->wu.work_id = 16;
    ewk->wu.my_sprite_sheet = 14;
    ewk->wu.my_family = 3;
    ewk->wu.graphic_rom_type = 1;
    ewk->wu.shadow_prio = flag;
    ewk->wu.my_col_mode = 0x4200;
    ewk->wu.my_col_code = 73;
    ewk->num_of_conn = 20;

    for (i = 0; i < 20; i++) {
        ewk->conn[i] = bbbs_blocking[i];
    }

    for (i = 0; i < 20; i++) {
        ewk->conn[i + 20] = bbbs_clear;
    }

    if (wk->wu.facing_flag) {
        for (i = 0; i < 20; i++) {
            ewk->conn[i].nx = -ewk->conn[i].nx;
        }
    }

    return 0;
}
