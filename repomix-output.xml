        g_state.wcp[cmd_id].move_state_flags[move_type[cmd_id]] =
            16 - ukemi_time_tbl[g_state.wcp[cmd_id].move_state_flags[move_type[cmd_id]]];
        move_ptr->free3 = 16;
        chk_pl->move_id = move_type[cmd_id];
