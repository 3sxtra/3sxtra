/** @brief Initialise vibration work structures for both players. */
void init_pulpul_work() {
    init_pulpul_work2(0);
    init_pulpul_work2(1);
}

/** @brief Initialise vibration work for a single player. */
void init_pulpul_work2(s16 ix) {
    rumble_work[ix].ok_dev = 0;
    rumble_work[ix].id = ix;
    rumble_work[ix].psix = 0;
    rumble_work[ix].inStop = 0;

    rumble_work[ix].p[0].ppnew = 0;

    rumble_request[ix][0] = rumble_request[ix][1] = 0;

    init_pulpul_round2(ix);
}

/** @brief Per-round vibration work reset for a single player. */
void init_pulpul_round2(s16 ix) {
    rumble_work[ix].vital = PP_INITIAL_VITALITY;
    pul[ix].ix.cal = 0;
}

/** @brief Stop all vibration effects immediately. */
void pulpul_stop() {
    pulpul_stop2(0);
    pulpul_stop2(1);
}

/** @brief Stop vibration for a single player. */
void pulpul_stop2(s16 ix) {
    if (rumble_work[ix].ok_dev) {
        vibration_param_transfer(ix, &pulpara[1]);
        rumble_work[ix].inStop = 4;
    }

    rumble_work[ix].ok_dev = 0;
    rumble_work[ix].p[0].ppnew = 0;

    waitVsyncDummy();
}

/** @brief Submit a vibration request by index for a player. */
void pulpul_request(s16 id, s16 ix) {
    RumbleRequest* adr;

    if (vib_sel[id] == 0) {
        return;
    }

    if (ix <= 0 || ix >= PULREQ_MAX) {
        return;
    }

    if (g_state.test_flag) {
        adr = &ot_pulreq[ix];
        adr->adrs = ot_pulreq_xx;
    } else {
        adr = &pulreq[ix];
    }

    rumble_request[id][adr->prio] = ix;

    pulpul_req_copy(id, adr);
}

/** @brief Copy a vibration request into a player’s work area. */
void pulpul_req_copy(s16 id, RumbleRequest* adr) {
    rumble_work[id].p[adr->prio].ppnew = rumble_work[id].ok_dev;
    rumble_work[id].p[adr->prio].rno[0] = 0;
    rumble_work[id].p[adr->prio].rno[1] = adr->rno;
    rumble_work[id].p[adr->prio].padr = adr->adrs;
}

/** @brief Turn on vibration motor for a player. */
void pp_vib_on(s16 id) {
    RumbleRequest* adr;

    adr = &pulreq[3];
    pulpul_req_copy(id, adr);
}

/** @brief Re-issue the current vibration request (after pause). */
void pulpul_request_again() {
    pulpul_request(0, rumble_request[0][0]);
    pulpul_request(1, rumble_request[1][0]);
}

/** @brief Set operator check flag for vibration permission. */
void pp_operator_check_flag(u8 fl) {
    rumble_work[0].opck = rumble_work[1].opck = fl;
}

/** @brief Process vibration work for both players every frame. */
void move_pulpul_work() {
    move_pulpul(&rumble_work[0]);
    move_pulpul(&rumble_work[1]);
}

/** @brief Check whether a vibration unit is connected on a port. */
s32 check_vibration_unit(s32 port) {
    if ((flpad_adr[0][port].kind == 0) || (flpad_adr[0][port].kind == 0x8000)) {
        return 0;
    }

    return flpad_adr[0][port].conn.vib;
}

/** @brief Tick the vibration state machine for one player. */
void move_pulpul(RumbleWorkState* wk) {
    s32 i;
    s32 index;
    s32 data;
    s32 result;

    if (wk->ok_dev) {
        if (check_vibration_unit(wk->id) == 0) {
            wk->ok_dev = 0;
            vibration_param_transfer(wk->id, &pulpara[1]);
            return;
        }

        for (i = 0; i <= 0; i++) {
            switch (wk->p[i].rno[0]) {
            case 0:
                if (wk->p[i].ppnew == 0)
                    break;

                wk->p[i].rno[0] = 1;
                wk->p[i].ppnew = 0;
                wk->p[i].exix = -1;
                /* fallthrough */
            case 1:
                wk->p[i].exix += 1;

            lbl:
                index = wk->p[i].padr[wk->p[i].exix].ix;
                data = wk->p[i].padr[wk->p[i].exix].timer;

                if (index <= 0) {
                    if (index == 0) {
                        wk->p[i].rno[0] = 0;
                        rumble_request[wk->id][i] = 0;
                        vibration_param_transfer(wk->id, &pulpara[1]);
                        break;
                    } else if (index == -1) {
                        wk->p[i].exix = data;
                        goto lbl;
                    }

                    if (index == -3) {
                        wk->p[i].rno[0] = 0;

                        if (g_state.test_flag) {
                            *ot_mot_of = data;
                            ot_make_curr_vib_data();
                        }

                        pulpul_request((s16)wk->id, data);
                        break;
                    }

                    if (index == -2) {
                        if (wk->vital >= data) {
                            wk->p[i].exix += 1;
                        } else {
                            wk->p[i].exix += 2;
                        }
                        goto lbl;
                    }

                    wk->p[i].rno[0] = 0;
                    break;
                }
                wk->p[i].rno[0] = 2;
                /* fallthrough */

            case 2:
                if (wk->p[i].padr[wk->p[i].exix].ix >= 0 && wk->p[i].padr[wk->p[i].exix].ix < PULPARA_MAX) {
                    result = pulpul_pdVibMxStart(wk, i, wk->port, &pulpara[wk->p[i].padr[wk->p[i].exix].ix]);
                } else {
                    result = 0;
                }

                if (!result) {
                    break;
                }

                wk->p[i].rno[0] = 3;

                if (i == 1) {
                    wk->p[i].life = ((wk->p[i].padr[wk->p[i].exix].timer) * (0x20 - pul[wk->id].tim_ans)) / 0x20;
                } else {
                    wk->p[i].life = wk->p[i].padr[wk->p[i].exix].timer;
                }
                /* fallthrough */

            case 3:
                if (--wk->p[i].life < 0) {
                    wk->p[i].rno[0] = 1;
                }
                break;
            }
        }
        return;
    }

    if (check_vibration_unit(wk->id) != 0) {
        wk->ok_dev = 1;
        wk->p[0].rno[0] = wk->p[1].rno[0] = 0;
        wk->p[0].ppnew = wk->p[1].ppnew = 0;
    }
}

/** @brief Start a mixed vibration effect with the given parameters. */
s32 pulpul_pdVibMxStart(RumbleWorkState* wk, s32 arg1, s32 arg2, RumbleParams* param) {
    RumbleParams adrs;

    adrs = *param;

    if ((Check_Menu_Task() == 0) && (g_state.test_flag == 0)) {
        if (CurrentSave()->Pad_Infor[wk->id].Vibration == 0) {
            return 1;
        }

        if ((wk->opck) && (g_state.plw[wk->id].wu.pl_operator == 0)) {
            return 1;
        }

        if (rumble_scene == 0) {
            return 1;
        }
    }

    return vibration_param_transfer(wk->id, &adrs);
}

/** @brief Translate vibration parameters into motor commands. */
s32 vibration_param_transfer(s32 id, RumbleParams* prm) {
    s32 vib_data_size;
    s32 rnum;
    u16 big;
    u8 vib_data[2];
    u8 profile;

    profile = ps2slot[id].vprofile & 3;
    if ((prm->power == 0) || (prm->unit == 0) || (profile == 0)) {
        switch (profile) {
        case 1:
        case 2:
            vib_data_size = 1;
            vib_data[0] = 0;
            break;

        default:
            vib_data_size = 2;
            vib_data[0] = 0;
            vib_data[1] = 0;
            break;
        }

        profile = 3;
    } else {

        big = prm->freq + pulpul_level[prm->power];

        switch (profile &= prm->unit) {
        case 1:
            vib_data_size = 1;
            vib_data[0] = 1;
            break;

        case 2:
            vib_data_size = 1;
            vib_data[0] = big;
            break;

        default:
            vib_data_size = 2;
            vib_data[0] = (((big * 2) & 0xFE) | 1);
            vib_data[1] = (big >> 7) & 1;
            break;
        }
    }

    rnum = sceVibSetActParam(ps2slot[id].socket_id, 1, &profile, vib_data_size, vib_data);

    return rnum == 1;
}

/** @brief Trigger a screen-quake effect by shake index. */
void pp_screen_quake(s16 ix) {
    ix /= 3;

    if (ix > PP_QUAKE_MAX_INDEX) {
        ix = PP_QUAKE_MAX_INDEX;
    }

    pulpul_request(0, comm_quay_pulpul[ix]);
    pulpul_request(1, comm_quay_pulpul[ix]);
}

/** @brief Convert a KO-weight value to a vibration parameter index. */
static s32 pp_convert_attack_type(u8 num) {
    s16 ix;

    if (num & 0x60) {
        if (num & 0x40) {
            ix = 0x11;
        } else {
            ix = 0x10;
        }
    } else {
        ix = num / 2 & 0xF;
    }

    if (ix < 0 || ix >= DOKIDOKI_TABLE_SIZE) {
        ix = 0;
    }

    return dokidoki_ix_change_table[ix];
}

