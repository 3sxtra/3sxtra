static bool is_enabled = false;

void ArcadeBalance_Init() {
    is_enabled = Config_GetBool(CFG_ARCADE_BALANCE);

    if (is_enabled) {
        ArcadeCharData_Init();
    }
}

bool ArcadeBalance_IsEnabled() {
