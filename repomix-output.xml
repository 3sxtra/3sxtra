/**
 * @brief Performs a single simulation tick.
 *
 * Extracted from Game_Task to reduce function length and improve readability.
 * Handles game state updates, rendering prep, and subsystem ticks.
 *
 * @param task_ptr Task system pointer passed down to handlers.
 * @param is_last_frame 1 if this is the final tick of the frame (controls rendering trans flag).
 */
static void Game_UpdateFrame(struct _TASK* task_ptr, s32 is_last_frame) {
    if (is_last_frame) {
        No_Trans = 0;
    } else {
        No_Trans = 1;
    }

    g_state.Play_Game = 0;

    if (g_state.Game_pause != 0x81) {
        g_state.system_timer += 1;
    }

    Init_Texture_Cache_Before_Process();

    seqsBeforeProcess();

    if (nowSoftReset() == 0) {
        switch (g_state.fsm[0]) {
        case MAIN_STATE_WAIT_AUTO_LOAD:
            Wait_Auto_Load(task_ptr);
            break;
        case MAIN_STATE_LOOP_DEMO:
            Loop_Demo(task_ptr);
            break;
        case MAIN_STATE_GAME:
            Game(task_ptr);
            break;
        default:
            break;
        }
    }

    seqsAfterProcess();

    texture_cash_update();

    move_pulpul_work();

    Check_LDREQ_Queue();
}

/**
 * @brief Main game task — top-level per-frame entry point.
 *
 * Dispatches to one of three modes based on g_state.fsm[0]:
 *   0 = Wait_Auto_Load (idle while loading)
 *   1 = Loop_Demo (attract-mode demo loop)
 *   2 = Game (active gameplay)
 *
 * Also handles fast-forward (sysFF) by running multiple iterations per frame.
 */
void Game_Task(struct _TASK* task_ptr) {
    s16 ix;
    s16 ff;

    HUD_Shift_Init();
    init_color_trans_req();
    ff = sysFF;

    for (ix = 0; ix < ff; ix++) {
        Game_UpdateFrame(task_ptr, (ix == ff - 1));
    }

    Check_Check_Screen();
    Check_Pos_BG();
    Disp_Sound_Code();
}

/**
 * @brief Game state dispatcher — routes to Game_Title–Game_Challenge based on g_state.fsm[1].
 *
 * Also sets g_state.Play_Game flag (1=fight, 2=ending) for subsystems that need
 * to know whether active gameplay is in progress.
 */
void Game(struct _TASK* task_ptr) {
    (void)task_ptr;

    // Safety bounds check
    if (g_state.fsm[1] >= GAME_STATE_COUNT) {
        I_Error("Game(): gs_fsm[1]=%d is out of bounds [0-%d)!", g_state.fsm[1], GAME_STATE_COUNT);
        return;
    }

    if (g_state.fsm[1] == MODE_FIGHT || g_state.fsm[1] == MODE_BONUS) {
        g_state.Play_Game = 1;
    } else if (g_state.fsm[1] == MODE_ENDING) {
        g_state.Play_Game = 2;
    }

    switch (g_state.fsm[1]) {
    case MODE_TITLE:
        Game_Title();
        break;
    case MODE_CHAR_SELECT:
        Game_CharSelect();
        break;
    case MODE_FIGHT:
        Game_Fight();
        break;
    case MODE_WIN_RESULT:
        Game_WinResult();
        break;
    case MODE_LOSE_RESULT:
        Game_LoseResult();
        break;
    case MODE_NEXT_CPU:
        Game_NextCPU();
        break;
    case MODE_GAME_OVER:
        Game_GameOver();
        break;
    case MODE_CONTINUE:
        Game_Continue();
        break;
    case MODE_ENDING:
        Game_Ending();
        break;
    case MODE_BONUS:
        Game_Bonus();
        break;
    case MODE_AFTER_BONUS:
        Game_AfterBonus();
        break;
    case MODE_NEXT_Q:
        Game_NextQ();
        break;
    case MODE_CHALLENGE:
        Game_Challenge();
        break;
    default:
        break;
    }
}

/** @brief State 0: Title screen — logo display, copyright, transition to menu. */
void Game_Title() {
    if (g_state.fsm[2] >= 3) {
        return;
    }

    switch (g_state.fsm[2]) {
    case 0:
        Game_Title_Sub0();
        break;
    case 1:
        Game_Title_Sub1();
        break;
    case 2:
        Game_Title_Sub2();
        break;
    default:
        break;
    }
    // njSetBackColor(0, 0, 0);
    BG_Draw_System();
    Basic_Sub();
    Check_Back_Demo();
}

void Game_Title_Sub0() {
    if (Title_At_a_Dash() != 0) {
        FSM_AdvanceSubState();
    }
}

void Game_Title_Sub1() {
    Disp_Copyright();
    TITLE_Move(1);

    if (g_state.Request_G_No) {
        FSM_AdvanceSubState();
    }
}

void Game_Title_Sub2() {
    switch (g_state.fsm[3]) {
    case 0:
        Disp_Copyright();
        TITLE_Move(1);
        FSM_AdvanceSubSubState();
        Switch_Screen_Init(1);
        break;

    case 1:
        if (Switch_Screen(1) != 0) {
            FSM_AdvanceSubSubState();
            g_state.Cover_Timer = 23;
            return;
        }

        TITLE_Move(1);
        Disp_Copyright();
        break;

    case 2:
        FadeOut(1, 0xFF, 8);
        FSM_AdvanceSubSubState();
        break;

    case 3:
        FadeOut(1, 0xFF, 8);
        FSM_AdvanceSubSubState();
        TexRelease(601);
        title_tex_flag = 0;
        break;

    case 4:
        FadeOut(1, 0xFF, 8);
        FSM_AdvanceSubSubState();
        Purge_mmtm_area(2);
        Allocate_Texture_Cache_List(2);
        break;

    case 5:
        FadeOut(1, 0xFF, 8);
        BGM_Request(65);
        FSM_SetMode(MODE_CHALLENGE);
        cpReadyTask(TASK_MENU, Menu_Task);
        break;
    }
}

/** @brief Check if the attract-mode demo timer has expired (1800 frames = 30 seconds). */
void Check_Back_Demo() {
    if (++g_state.fsm_timer < DEMO_TIMEOUT_FRAMES) {
        return;
    }

    if (g_state.fsm[1] == MODE_CHALLENGE || (g_state.fsm[2] == 2 && g_state.fsm[3] >= 2)) {
        return;
    }

    TexRelease(601);
    title_tex_flag = 0;

    /* Hide RmlUi title screen before switching to demo loop */
    if (use_rmlui && rmlui_screen_title) {
        rmlui_title_screen_hide();
    }
    if (use_rmlui && rmlui_screen_attract_overlay) {
        rmlui_attract_overlay_hide();
    }

    Next_Demo_Loop();
    effect_work_init();
}

