/**
 * @file ending_20_remy.c
 * Remy's Ending
 */

#include "common.h"
#include "game_state.h"
#include "port/rendering/renderer.h"
#include "sf33rd/Source/Common/ppg_file.h"
#include "sf33rd/Source/Common/ppg_work.h"
#include "sf33rd/Source/Game/effect/effect_e6_ending_scene_gill_general.h"
#include "sf33rd/Source/Game/effect/effect_f9_text_message.h"
#include "sf33rd/Source/Game/ending/end_data.h"
#include "sf33rd/Source/Game/ending/end_main.h"
#include "sf33rd/Source/Game/engine/calculate_direction.h"
#include "sf33rd/Source/Game/rendering/rendering_transform.h"
#include "sf33rd/Source/Game/sound/sound_effects.h"
#include "sf33rd/Source/Game/stage/bg.h"
#include "sf33rd/Source/Game/stage/stage_data.h"
#include "sf33rd/Source/Game/system/work_sys.h"

static void end_2000_move();
static void end_2001_move();

static void end_2000_0000();
static void end_2000_0001();
static void end_2000_0002();
static void end_2000_0003();
static void end_2000_0005();

static void end_2001_0000();
static void end_2001_0002();
static void end_2001_0003();
static void end_2001_0004();
static void end_2001_0005();

static void sea_write();
static void sea_trans(u16 num, f64 arg2);

const s16 timer_20_tbl[6] = { 360, 420, 780, 720, 240, 780 };

const s16 end_20_pos[6][2] = { { 256, 704 }, { 256, 304 }, { 256, 448 }, { 256, 816 }, { 768, 768 }, { 256, 224 } };

/** @brief Remy's ending entry point — initialize and run all ending scenes. */
void end_20000(s16 pl_num) {
    switch (g_state.end_w.r_no_1) {
    case 0:
        g_state.end_w.r_no_1++;
        g_state.end_w.r_no_2 = 0;
        common_end_init00(pl_num);
        common_end_init01();
        g_state.end_w.timer = timer_20_tbl[g_state.end_w.r_no_2];
        BGM_Request(0x31);
        break;

    case 1:
        g_state.end_w.timer--;

        if (g_state.end_w.timer < 0) {
            g_state.end_w.r_no_2++;

            if (g_state.end_w.r_no_2 >= 6) {
                g_state.end_w.r_no_1++;
                g_state.end_w.end_flag = 1;
                fadeout_to_staff_roll();
                end_scn_pos_set2();
                end_bg_pos_adjust2();
                end_fam_set2();
                break;
            }

            g_state.end_w.timer = timer_20_tbl[g_state.end_w.r_no_2];
            g_state.bg_w.bgw[0].r_no_1 = 0;
            g_state.bg_w.bgw[1].r_no_1 = 0;
            g_state.bg_w.bgw[2].r_no_1 = 0;
        }

        end_2000_move();
        end_2001_move();
        /* fallthrough */

    case 2:
        end_scn_pos_set2();
        end_bg_pos_adjust2();
        end_fam_set2();
        break;
    }
}

/** @brief Dispatch to the current scene handler for background layer 0. */
static void end_2000_move() {
    void (*end_2000_jp[6])() = { end_2000_0000, end_2000_0001, end_2000_0002,
                                 end_2000_0003, end_2000_0002, end_2000_0005 };
    bgw_ptr = &g_state.bg_w.bgw[0];
    if (g_state.end_w.r_no_2 >= 6)
        return;
    end_2000_jp[g_state.end_w.r_no_2]();
}

/** @brief Scene 0 — initial background with SEA write. */
static void end_2000_0000() {
    switch (bgw_ptr->r_no_1) {
    case 0:
        bgw_ptr->r_no_1++;
        bgw_ptr->xy[0].disp.pos = end_20_pos[g_state.end_w.r_no_2][0];
        bgw_ptr->xy[1].disp.pos = end_20_pos[g_state.end_w.r_no_2][1];
        bgw_ptr->abs_x = bgw_ptr->xy[0].disp.pos;
        effect_E6_init(0x3E);
        Rewrite_End_Message(1);
        break;

    case 1:
        bgw_ptr->xy[0].cal += 0x8000;
        bgw_ptr->abs_x = bgw_ptr->xy[0].disp.pos;
        bgw_ptr->xy[1].cal += 0x4000;
        bgw_ptr->abs_y = bgw_ptr->xy[1].disp.pos;
        break;
    }
}

/** @brief Scene 1 — horizontal pan with SEA write. */
static void end_2000_0001() {
    switch (bgw_ptr->r_no_1) {
    case 0:
        bgw_ptr->r_no_1++;
        Bg_On_W(1);
        bgw_ptr->xy[0].disp.pos = end_20_pos[g_state.end_w.r_no_2][0];
        bgw_ptr->xy[1].disp.pos = end_20_pos[g_state.end_w.r_no_2][1];
        bgw_ptr->abs_x = 512;
        bgw_ptr->abs_y = bgw_ptr->xy[1].disp.pos;
        Rewrite_End_Message(2);
        effect_E6_init(0x3F);
        effect_E6_init(0x40);
        break;

    case 1:
        bgw_ptr->xy[1].cal -= 0x4000;

        if (bgw_ptr->xy[1].disp.pos < 272) {
            bgw_ptr->r_no_1++;
            bgw_ptr->xy[1].cal = 0x1100000;
        }

        bgw_ptr->abs_y = bgw_ptr->xy[1].disp.pos;
        break;

    case 2:
        break;
    }
}

/** @brief Scene 2 — vertical scroll with parallax. */
static void end_2000_0002() {
    switch (bgw_ptr->r_no_1) {
    case 0:
        bgw_ptr->r_no_1++;
        Bg_On_W(1);

        switch (g_state.end_w.r_no_2) {
        case 2:
            Rewrite_End_Message(3);
            break;

        case 4:
            Rewrite_End_Message(5);
            effect_E6_init(0x42);
            effect_E6_init(0x43);
            break;
        }

        bgw_ptr->xy[0].disp.pos = end_20_pos[g_state.end_w.r_no_2][0];
        bgw_ptr->xy[1].disp.pos = end_20_pos[g_state.end_w.r_no_2][1];
        bgw_ptr->abs_x = 512;
        bgw_ptr->abs_y = 0;
        break;

    case 1:
        break;
    }
}

/** @brief Scene 3 — horizontal pan with message. */
static void end_2000_0003() {
    switch (bgw_ptr->r_no_1) {
    case 0:
        bgw_ptr->r_no_1++;
        Bg_Off_W(1);
        bgw_ptr->xy[0].disp.pos = end_20_pos[g_state.end_w.r_no_2][0];
        bgw_ptr->xy[1].disp.pos = end_20_pos[g_state.end_w.r_no_2][1];
        bgw_ptr->abs_x = bgw_ptr->xy[0].disp.pos;
        bgw_ptr->abs_y = bgw_ptr->xy[1].disp.pos;
        Rewrite_End_Message(4);
        effect_E6_init(0x91);
        effect_E6_init(0x92);
        effect_E6_init(0x93);
        effect_E6_init(0x94);
        effect_E6_init(0x95);
        break;

    case 1:
        bgw_ptr->xy[0].cal -= 0x4000;
        bgw_ptr->abs_x = bgw_ptr->xy[0].disp.pos;
        bgw_ptr->xy[1].cal += 0x6000;
        bgw_ptr->abs_y = bgw_ptr->xy[1].disp.pos;
        break;
    }
}

/** @brief Scene 5 — final scene with fade timer and message. */
static void end_2000_0005() {
    switch (bgw_ptr->r_no_1) {
    case 0:
        bgw_ptr->r_no_1++;
        Bg_On_W(1);
        bgw_ptr->xy[0].disp.pos = end_20_pos[g_state.end_w.r_no_2][0];
        bgw_ptr->xy[1].disp.pos = end_20_pos[g_state.end_w.r_no_2][1];
        bgw_ptr->abs_x = 512;
        bgw_ptr->abs_y = bgw_ptr->xy[1].disp.pos;
        effect_E6_init(0x44);
        effect_E6_init(0x45);
        Rewrite_End_Message(6);
        end_fade_flag = 1;
        end_fade_timer = timer_20_tbl[g_state.end_w.r_no_2] - 120;
        bgw_ptr->free = 0x5A;
        break;

    case 1:
        bgw_ptr->free--;

        if (bgw_ptr->free <= 0) {
            bgw_ptr->r_no_1++;
        }

        break;

    case 2:
        bgw_ptr->xy[1].cal += 0x10000;

        if (bgw_ptr->xy[1].disp.pos > 544) {
            bgw_ptr->r_no_1++;
            bgw_ptr->xy[1].cal = 0x2200000;
        }

        bgw_ptr->abs_y = bgw_ptr->xy[1].disp.pos;
        break;

    case 3:
        break;
    }
}

/** @brief Dispatch to the current scene handler for background layer 1. */
static void end_2001_move() {
    void (
        *end_2001_jp[6])() = { end_2001_0000, end_X_com01, end_2001_0002, end_2001_0003, end_2001_0004, end_2001_0005 };
    bgw_ptr = &g_state.bg_w.bgw[1];
    if (g_state.end_w.r_no_2 >= 6)
        return;
    end_2001_jp[g_state.end_w.r_no_2]();
}

/** @brief Layer 1 scene 0 — background enable with position set. */
static void end_2001_0000() {
    switch (bgw_ptr->r_no_1) {
    case 0:
        bgw_ptr->r_no_1++;
        Bg_On_W(2);
        bgw_ptr->xy[0].disp.pos = end_20_pos[g_state.end_w.r_no_2][0];
        bgw_ptr->xy[1].disp.pos = end_20_pos[g_state.end_w.r_no_2][1];
        effect_E6_init(0x38);
        break;

    case 1:
        break;
    }
}

/** @brief Layer 1 scene 2 — vertical scroll with parallax. */
static void end_2001_0002() {
    switch (bgw_ptr->r_no_1) {
    case 0:
        bgw_ptr->r_no_1++;
        bgw_ptr->xy[0].disp.pos = end_20_pos[g_state.end_w.r_no_2][0];
        bgw_ptr->xy[1].disp.pos = end_20_pos[g_state.end_w.r_no_2][1];
        bgw_ptr->abs_x = bgw_ptr->xy[0].disp.pos;
        effect_E6_init(0x41);
        break;

    case 1:
        break;
    }
}

/** @brief Layer 1 scene 3 — horizontal pan. */
static void end_2001_0003() {
    ppgSetupCurrentDataList(&ppgAkeList);
    ppgSetupCurrentPaletteNumber(NULL, 0);

    switch (bgw_ptr->r_no_1) {
    case 0:
        bgw_ptr->r_no_1++;
        bgw_ptr->xy[0].disp.pos = 512;
        bgw_ptr->xy[1].disp.pos = 0;
        bgw_ptr->abs_x = 512;
        bgw_ptr->abs_y = 0;
        g_state.ls_cnt1 = 0;
        bgw_ptr->xy[0].disp.pos = end_20_pos[g_state.end_w.r_no_2][0];
        bgw_ptr->xy[1].disp.pos = end_20_pos[g_state.end_w.r_no_2][1];
        /* fallthrough */

    case 1:
        sea_write();
        break;
    }
}

/** @brief Layer 1 scene 4 — static background. */
static void end_2001_0004() {
    switch (bgw_ptr->r_no_1) {
    case 0:
    case 1:
        end_X_com01();
        break;
    }
}

/** @brief Layer 1 scene 5 — static background with message. */
static void end_2001_0005() {
    switch (bgw_ptr->r_no_1) {
    case 0:
        bgw_ptr->r_no_1++;
        bgw_ptr->xy[0].disp.pos = end_20_pos[g_state.end_w.r_no_2][0];
        bgw_ptr->xy[1].disp.pos = end_20_pos[g_state.end_w.r_no_2][1];
        bgw_ptr->abs_x = 512;
        bgw_ptr->abs_y = 0;
        /* fallthrough */

    case 1:
    case 2:
        break;
    }
}

/** @brief Write sea background palette data. */
static void sea_write() {
    u16 j;
    u16 k;
    SEA_WORK work;

    e_line_step = 64;

    for (j = 0; j < 512; j++) {
        k = g_state.ls_cnt1 + (j * 4) & 0xFF;
        work.s.xx = e_line_step * rate_256_table[k][0] >> 4;

        if (No_Trans) {
            continue;
        }

        sea_trans(j, (f32)work.o.xh);
    }

    g_state.ls_cnt1 = (g_state.ls_cnt1 + 2) & 0x1FF;
}

/** @brief Apply color gradient transition for sea effect. */
static void sea_trans(u16 num, f64 arg2) {
    f32 suzi = arg2;
    RendererVertex poly[4];

    poly[0].color = poly[1].color = poly[2].color = poly[3].color = -1;
    poly[0].u = poly[1].u = 0.0f;
    poly[2].u = poly[3].u = 1.0f;
    poly[0].v = poly[2].v = num / 512.0f;
    poly[1].v = poly[3].v = (num + 1) / 512.0f;
    poly[0].x = poly[1].x = (-64.0f + suzi);
    poly[2].x = poly[3].x = (448.0f + suzi);
    poly[0].y = poly[2].y = (32.0f + num);
    poly[1].y = poly[3].y = (32.0f + (num + 1));
    poly[0].z = poly[1].z = poly[2].z = poly[3].z = PrioBase[84];

    Renderer_SetTexture(228);
    Renderer_DrawTexturedQuadVtx(poly, 4);
}
