/**
 * @file eff20.c
 * Effect: Visual Effect (Generic)
 */

#include "sf33rd/Source/Game/effect/effect_20_simple_animation.h"
#include "game_state.h"
#include "bin2obj/char_table.h"
#include "common.h"
