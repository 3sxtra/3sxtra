                                   { 344, 128 }, { 640, 224 }, { 336, 176 }, { 672, 72 } };

void effect_B0_move(State_Other* ewk) {
    s16 work;

    if (ewk->wu.old_routine_no[6] < g_state.end_w.r_no_2) {
        ewk->wu.routine_no[0] = 99;
    }

    switch (ewk->wu.routine_no[0]) {
    case 0:
        ewk->wu.old_routine_no[5]--;

        if (ewk->wu.old_routine_no[5] <= 0) {
            ewk->wu.routine_no[0]++;
            ewk->wu.disp_flag = 1;
            set_char_move_init(&ewk->wu, 0, ewk->wu.char_index);
        }

        break;

    case 1:
        char_move(&ewk->wu);

        if (ewk->wu.cg_type) {
            ewk->wu.routine_no[0] = 0;
            ewk->wu.disp_flag = 0;
            work = random_16();
            work &= 7;
            ewk->wu.old_routine_no[5] = effb0_timer_tbl[work];
            work = random_16();
            work &= 7;
            ewk->wu.xyz[0].disp.pos = effb0_data_tbl[work][0];
            work = random_16();
            work &= 7;
            ewk->wu.xyz[1].disp.pos = effb0_data_tbl[work][1];
        }

        disp_pos_trans_entry(ewk);
        break;

    default:
        Release_Effect(&ewk->wu);
        break;
    }
}

s32 effect_B0_init() {
    State_Other* ewk;
    s16 ix;
    s16 i;
    s16 work;

    for (i = 0; i < 8; i++) {
        if ((ix = Acquire_Effect(4)) == -1) {
            return -1;
        }

        ewk = (State_Other*)frw[ix];
        ewk->wu.id = 110;
        ewk->wu.active_flag = 1;
        ewk->wu.type = i;
        ewk->wu.work_id = 16;
        ewk->wu.graphic_rom_type = 1;
        ewk->wu.old_routine_no[0] = g_state.end_w.r_no_2;
        ewk->wu.my_col_mode = 0x4200;
        ewk->wu.char_table[0] = (u32*)_end_char_table;
        ewk->wu.my_col_code = 300;
        ewk->wu.my_family = 1;
        ewk->wu.old_routine_no[6] = 0;
        ewk->wu.old_routine_no[6] += g_state.end_w.r_no_2;
        ewk->wu.xyz[0].disp.pos = effb0_data_tbl[i][0];
        ewk->wu.xyz[1].disp.pos = effb0_data_tbl[i][1];
        ewk->wu.my_priority = ewk->wu.position_z = 80;
        ewk->wu.char_index = 29;
        work = random_16();
        work &= 7;
        ewk->wu.old_routine_no[5] = effb0_timer_tbl[work];
        ewk->wu.my_sprite_sheet = 8;
        ewk->wu.my_trans_mode = get_my_trans_mode(ewk->wu.my_sprite_sheet);
    }

    return 0;
}
