/** @brief Returns the nearing range (approach distance) for an attack. */
u16 get_nearing_range(s16 pnum, s16 kos) {
    const u16* asstbl;
    u16 nrange = 0;
    u16 lwork;

    if ((kos = shot_data_convert(kos)) < 0) {
