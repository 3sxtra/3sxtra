<file path="src/sf33rd/Source/Game/effect/effect_d0_counter_data_table.c">
/**
 * @file effd0.c
 * Effect: Counter / Data Table Effect
 */

#include "sf33rd/Source/Game/effect/effect_d0_counter_data_table.h"
#include "game_state.h"
#include "bin2obj/char_table.h"
#include "common.h"
