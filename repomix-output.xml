/** @brief Initialize background layers for the current stage. */
void bg_initialize() {
    const s16* ptr;
    u8 i;

    Bg_Off_R(7);
    Family_Init();
    Scrn_Pos_Init();
    Zoomf_Init();
    g_state.bg_w.bg_opaque = stage_opaque[g_state.bg_w.stage];
