<file path="assets/ui/training.rcss">
/* Training Options — F7 modded training overlay
 * CPS3-inspired two-tab layout: DUMMY | DISPLAY */

body {
    width: 100%;
    height: 100%;
}

/* ── Panel Positioning ── */
#training-panel {
    display: block;
    position: absolute;
    top: 2%;
    right: 2%;
    width: 48%;
    max-height: 92%;
    overflow-y: auto;
}

/* ── Drag Handle ── */
#training-panel handle {
    display: block;
    cursor: move;
    padding: 2dp 0;
    margin-bottom: 4dp;
}

#training-panel handle:hover {
    background-color: rgba(255, 255, 255, 10);
    border-radius: 4dp 4dp 0 0;
}

#training-panel h1 {
    font-size: 14dp;
    color: #cc0000;
    margin-bottom: 0;
    text-align: center;
    white-space: nowrap;
}

/* ── Tab Bar ── */
.tab-bar {
    display: block;
    margin-bottom: 2dp;
}

.tab {
    display: inline-block;
    padding: 2dp 8dp;
    margin-right: 2dp;
    background-color: #333;
    color: #999;
    border-width: 1dp;
    border-color: #888;
    font-size: 12dp;
    white-space: nowrap;
    cursor: pointer;
}

.tab.active {
    background-color: #cc0000;
    color: #fff;
    border-color: #ff3333;
    border-width: 1dp;
}

.tab:hover {
    background-color: #888;
    color: #fff;
}

.tab.active:hover {
    background-color: #dd2222;
}

/* ── Tab Content ── */
.tab-content {
    display: block;
    padding: 2dp 0dp;
}

/* ── Sections ── */
.section {
    display: block;
    margin-bottom: 2dp;
}

/* ── Control rows ── */
.control-row {
    display: block;
    padding: 1dp 0dp;
}

.control-row label {
    vertical-align: middle;
    color: #dddddd;
    white-space: nowrap;
}

/* List-type rows (label + value) */
.list-row {
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

.list-row .value {
    color: #ffcc00;
    font-size: 12dp;
    white-space: nowrap;
}

/* Clickable list rows — visual feedback */
.clickable {
    cursor: pointer;
}

.clickable:hover {
    background-color: #333;
}

.clickable:hover .value {
    color: #ffffff;
}

/* ── Sub-group indentation ── */
.sub-group {
    display: block;
    padding-left: 12dp;
    margin-top: 2dp;
}

/* ── Divider ── */
.divider {
    display: block;
    height: 1dp;
    background-color: #444;
    margin-top: 3dp;
    margin-bottom: 3dp;
}

/* ── Hint text ── */
.hint {
    display: block;
    font-size: 11dp;
    color: #b0b0b0;
    margin-top: 2dp;
    margin-bottom: 2dp;
    white-space: nowrap;
}
</file>

<file path="assets/ui/training.rml">
<rml>
<head>
    <title>Training Options</title>
    <link type="text/rcss" href="base.rcss"/>
    <link type="text/rcss" href="training.rcss"/>
</head>
<body data-model="training">
    <div id="training-panel" class="panel">
        <handle move_target="training-panel">
            <h1>TRAINING OPTIONS (F7)</h1>
        </handle>
        <!-- Tab Bar -->
        <div class="tab-bar">
            <button class="tab" data-class-active="active_tab == 0"
                    data-event-click="active_tab = 0">DUMMY</button>
            <button class="tab" data-class-active="active_tab == 1"
                    data-event-click="active_tab = 1">DISPLAY</button>
        </div>
        <div class="divider"></div>

        <!-- ═════════════════════════════════════════ -->
        <!-- DUMMY TAB — click row to cycle value     -->
        <!-- ═════════════════════════════════════════ -->
        <div class="tab-content" data-if="active_tab == 0">
            <div id="cycle-block" class="control-row list-row clickable">
                <label>Block</label>
                <span class="value">{{ dummy_block_label }}</span>
            </div>
            <div id="cycle-parry" class="control-row list-row clickable">
                <label>Parry</label>
                <span class="value">{{ dummy_parry_label }}</span>
            </div>
            <div id="cycle-block-dir" class="control-row list-row clickable">
                <label>Block Direction</label>
                <span class="value">{{ dummy_block_dir_label }}</span>
            </div>
            <div id="cycle-stun-mash" class="control-row list-row clickable">
                <label>Stun Mash</label>
                <span class="value">{{ dummy_stun_mash_label }}</span>
            </div>
            <div id="cycle-wakeup-mash" class="control-row list-row clickable">
                <label>Wakeup Mash</label>
                <span class="value">{{ dummy_wakeup_mash_label }}</span>
            </div>
            <div class="control-row">
                <input type="checkbox" data-checked="dummy_wakeup_reversal"/>
                <label>Wakeup Reversal</label>
            </div>
            <div class="control-row">
                <input type="checkbox" data-checked="dummy_guard_low"/>
                <label>Default Guard Low</label>
            </div>
            <div id="cycle-tech-throw" class="control-row list-row clickable">
                <label>Tech Throw</label>
                <span class="value">{{ dummy_tech_throw_label }}</span>
            </div>
            <div id="cycle-fast-wakeup" class="control-row list-row clickable">
                <label>Fast Wakeup</label>
                <span class="value">{{ dummy_fast_wakeup_label }}</span>
            </div>
            <div class="control-row">
                <input type="checkbox" data-checked="dummy_auto_reversal"/>
                <label>Auto Reversal</label>
            </div>
            <div id="cycle-playback-mode" class="control-row list-row clickable">
                <label>Playback Mode</label>
                <span class="value">{{ dummy_playback_mode_label }}</span>
            </div>
        </div>

        <!-- ═════════════════════════════════════════ -->
        <!-- DISPLAY TAB                               -->
        <!-- ═════════════════════════════════════════ -->
        <div class="tab-content" data-if="active_tab == 1">
            <div class="section">
                <div class="control-row">
                    <input type="checkbox" data-checked="hitboxes"/>
                    <label>Master Hitboxes Toggle</label>
                </div>
                <div class="sub-group" data-if="hitboxes">
                    <div class="control-row">
                        <input type="checkbox" data-checked="pushboxes"/>
                        <label>Pushboxes (Green)</label>
                    </div>
                    <div class="control-row">
                        <input type="checkbox" data-checked="hurtboxes"/>
                        <label>Hurtboxes (Blue)</label>
                    </div>
                    <div class="control-row">
                        <input type="checkbox" data-checked="attackboxes"/>
                        <label>Hitboxes (Red)</label>
                    </div>
                    <div class="control-row">
                        <input type="checkbox" data-checked="throwboxes"/>
                        <label>Throwboxes (Yellow)</label>
                    </div>
                </div>
            </div>
            <div class="divider"></div>
            <div class="section">
                <div class="control-row">
                    <input type="checkbox" data-checked="advantage"/>
                    <label>Frame Advantage</label>
                </div>
                <div class="control-row">
                    <input type="checkbox" data-checked="stun"/>
                    <label>Stun Timer</label>
                </div>
                <div class="control-row">
                    <input type="checkbox" data-checked="inputs"/>
                    <label>Input History</label>
                </div>
                <div class="control-row">
                    <input type="checkbox" data-checked="frame_meter"/>
                    <label>Frame Meter</label>
                </div>
            </div>
        </div>

        <div class="divider"></div>
        <p class="hint">Click row to cycle · F7 to close</p>
    </div>
</body>
</rml>
</file>

<file path="assets/ui/trials_hud.rcss">
/* ============================================================ *
 *  trials_hud.rcss  —  Trial mode HUD overlay                 *
 * ============================================================ */

body {
    width: 384dp;
    height: 224dp;
    font-family: "DistrictTF-RegularItalic";
    font-size: 13dp;
}

#trials-container {
    display: block;
    position: absolute;
    top: 40dp;
    left: 16dp;
    width: 280dp;
}

#trial-header {
    display: block;
    font-size: 12dp;
    color: #ffffff;
    font-effect: shadow(1dp 1dp #000000);
    margin-bottom: 4dp;
}

#trial-gauge-alert {
    display: block;
    position: absolute;
    top: 0dp;
    left: 224dp;
    font-size: 12dp;
    color: #00ffff;
    font-effect: shadow(1dp 1dp #000000);
}

#trial-step-list {
    display: block;
    margin-top: 4dp;
}

.step-item {
    display: block;
    font-size: 11dp;
    font-effect: shadow(1dp 1dp #000000);
    margin-bottom: 2dp;
}

.step-item.pending {
    color: #e0e0e0;
}

.step-item.active {
    color: #ffff00;
}

.step-item.completed {
    color: #00ff00;
}

.step-item.failed {
    color: #ff0000;
}

#trial-complete {
    display: block;
    position: absolute;
    top: 110dp;
    left: 134dp;
    font-size: 17dp;
    text-align: center;
    font-effect: shadow(2dp 2dp #000000);
}

.complete-flash {
    animation: trial-flash 0.27s steps(1) infinite;
}

@keyframes trial-flash {
      0% { color: #00ff00; }
     50% { color: #ffffff; }
    100% { color: #00ff00; }
}
</file>

