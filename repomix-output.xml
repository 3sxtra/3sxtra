}

/** @brief Scene 0 — initial background setup with effect and message. */
static void end_1000_0000() {
    switch (bgw_ptr->r_no_1) {
    case 0:
        bgw_ptr->r_no_1++;
        Bg_On_W(1);
        effect_E6_init(0x4C);
        bgw_ptr->xy[0].disp.pos = end_10_pos[g_state.end_w.r_no_2][0];
        bgw_ptr->xy[1].disp.pos = end_10_pos[g_state.end_w.r_no_2][1];
        bgw_ptr->free = 4;
        bgw_ptr->l_limit = 0;
        Rewrite_End_Message(1);
        break;

    case 1:
        bgw_ptr->free--;

        if (bgw_ptr->free <= 0) {
            bgw_ptr->free = 4;
            bgw_ptr->l_limit++;

            if (bgw_ptr->l_limit >= 6) {
                bgw_ptr->l_limit = 0;
            }
        }

        break;
    }
}

/** @brief Scene 1 — timed horizontal pan with message. */
static void end_1000_1000() {
    switch (bgw_ptr->r_no_1) {
