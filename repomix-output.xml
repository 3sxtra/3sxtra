<file path="assets/ui/game_hud.rcss">
/* ============================================================ *
 *  game_hud.rcss  —  In-game fight HUD stylesheet              *
 *  Positions matched to CPS3 sprite coords (384×224, 1dp=1px)  *
 * ============================================================ */

/* ── Root body ─────────────────────────────────────────────── */
body {
    width: 384dp;
    height: 100%;
    font-family: "DistrictTF-RegularItalic";
    font-size: 15dp;
}

/* ── Outer container ────────────────────────────────────────── */
.hud-wrap {
    display: block;
    position: absolute;
    top: 0dp;
    left: 0dp;
    width: 384dp;
    height: 100%;
}
.hud-hidden {
    display: none;
}
/* Elements hidden until cockpit appears (synced with round banner) */
.hud-pre-cockpit {
    opacity: 0;
}

/* ── Section containers (passthrough — span full area) ────── */
#hud-top, #hud-gauges, #hud-combos, #hud-training-stun {
    display: block;
    position: absolute;
    top: 0dp;
    left: 0dp;
    width: 384dp;
    height: 100%;
}
.player-side {
    display: block;
    position: absolute;
    top: 0dp;
    left: 0dp;
    width: 384dp;
    height: 100%;
}

/* ── Player names ───────────────────────────────────────────── */
/* CPS3: P1 tile(6,3)=48px,24px  P2 tile(37,3)=296px,24px      */
.player-name {
    display: block;
    position: absolute;
    top: 24dp;
    width: 80dp;
    height: 10dp;
    font-size: 13dp;
    color: #ffffff;
    font-effect: outline(1dp #000000);
}
.p1-name { left: 48dp; text-align: left; }
.p2-name { left: 296dp; text-align: left; }

/* ── HP bar container ───────────────────────────────────────── */
/* CPS3: P1 x=8..168  P2 x=216..376  bottom=24dp, height trimmed from top */
.hp-bar-wrap {
    display: block;
    position: absolute;
    top: 18dp;
    width: 160dp;
    height: 5dp;
    background-color: rgba(0, 0, 0, 180);
}
.p1-hp { left: 8dp; }
.p2-hp { left: 216dp; }

/* Drain (red trail) — P1 right-to-left, P2 left-to-right */
.hp-drain {
    display: block;
    position: absolute;
    top: 0dp;
    height: 5dp;
    background-color: #800000;
    transition: width 0.16s linear-in-out;
    max-width: 100%;
}
.p1-hp .hp-drain { right: 0dp; }
.p2-hp .hp-drain { left: 0dp; }

/* HP fill — colors by state class */
.hp-fill {
    display: block;
    position: absolute;
    top: 0dp;
    height: 5dp;
    transition: width 0.08s linear-in-out;
    max-width: 100%;
}
.p1-hp .hp-fill { right: 0dp; }
.p2-hp .hp-fill { left: 0dp; }

.hp-col-1 { background-color: #40c840; }   /* Green — full */
.hp-col-2 { background-color: #e8c000; }   /* Yellow — mid */
.hp-col-3 { background-color: #e00000; }   /* Red — low */

/* ── Center timer ───────────────────────────────────────────── */
/* CPS3: digits at tile(22,0)=176px (2×16=32px wide) y=0        */
#timer-block {
    display: block;
    position: absolute;
    top: 0dp;
    left: 0dp;
    width: 384dp;
    height: 40dp;
}

.timer-digits {
    display: block;
    position: absolute;
    left: 168dp;
    top: 0dp;
    width: 48dp;
    font-size: 32dp;
    color: #ffd700;
    font-effect: shadow(2dp 2dp #000000);
    text-align: center;
    line-height: 32dp;
}
.timer-digits.timer-flash {
    animation: timer-pulse 0.4s sine-in-out infinite;
}

/* ── Round result bubbles ───────────────────────────────────── */
/* Two groups: each below its stun bar, aligned in toward center */
.win-row {
    display: block;
    position: absolute;
    top: 24dp;
    left: 0dp;
    width: 384dp;
    margin: 0dp;
    padding: 0dp;
}
.win-pips {
    display: block;
    position: absolute;
    top: 0;
    margin: 0dp;
    padding: 0dp;
}
/* P1: right-aligned, ending where P1 stun bar ends (right: 216dp → x≈168dp) */
.p1-wins { right: 216dp; text-align: right; }
/* P2: left-aligned, starting where P2 stun bar starts */
.p2-wins { left: 216dp; text-align: left; }
.round-bubble {
    display: inline-block;
    width: 8dp;
    height: 8dp;
    border-radius: 4dp;
    background-color: #333333;
    margin: 0dp 1dp;
    font-size: 9dp;
    text-align: center;
    line-height: 8dp;
    color: #000000;
}
/* Result type colors */
.rt-1  { background-color: #ffd700; color: #222222; } /* V — Normal victory (gold) */
.rt-3  { background-color: #00e5ff; color: #003333; } /* P — Perfect (cyan) */
.rt-4  { background-color: #ff8c00; color: #331a00; } /* C — Chip/special (orange) */
.rt-5  { background-color: #b0b0b0; color: #222222; } /* D — Draw (gray) */
.rt-6  { background-color: #b388ff; color: #1a0033; } /* J — Judgement (purple) */
.rt-7  { background-color: #ff4444; color: #330000; } /* S — SA finish (red) */
.rt-0  { width: 4dp; height: 4dp; background-color: #ffffff; border-width: 0; vertical-align: bottom; margin-bottom: 0dp; } /* Empty — small white dot */
.win-sep {
    display: none;
}

/* ── Stun gauge ─────────────────────────────────────────────── */
/* CPS3: P1 anchors left 8dp, P2 anchors right 8dp. Width is dynamic per char. */
/* bottom=30dp, height trimmed from top */
.stun-wrap {
    display: block;
    position: absolute;
    top: 27dp;
    height: 2dp;
    background-color: rgba(0, 0, 0, 144);
}
.p1-stun { right: 216dp; }
.p2-stun { left: 216dp; }

.stun-fill {
    display: block;
    position: absolute;
    top: 0dp;
    height: 2dp;
    background-color: #c81010;
    max-width: 100%;
    transition: width 0.05s linear-in-out;
}
.p1-stun .stun-fill { right: 0dp; }
.p2-stun .stun-fill { left: 0dp; }

.stun-fill.stun-active {
    animation: stun-blink 0.11s sine-in-out infinite;
}

/* ── SA gauge ───────────────────────────────────────────────── */
/* CPS3: bottom=217dp, height trimmed from top. P1 anchors left 48, P2 anchors right 48. */
.sa-wrap {
    display: block;
    position: absolute;
    bottom: 7dp;
    height: 4dp;
    background-color: rgba(0, 0, 0, 200);
}
.p1-sa { left: 48dp; }
.p2-sa { right: 48dp; }

.sa-fill {
    display: block;
    position: absolute;
    top: 0dp;
    height: 4dp;
    background-color: #4080ff;
    max-width: 100%;
    transition: width 0.08s linear-in-out;
}
.p1-sa .sa-fill { right: 0dp; }
.p2-sa .sa-fill { left: 0dp; }

.sa-fill.sa-active {
    background-color: #e040e0;
    animation: sa-active-pulse 0.2s sine-in-out infinite;
}
.sa-fill.sa-ready {
    animation: sa-stock-flicker 0.3s sine-in-out infinite;
}
.sa-fill.sa-max {
    animation: sa-stock-flicker 0.2s sine-in-out infinite;
}

.sa-label {
    display: inline-block;
    position: absolute;
    top: -4dp;
    left: 0dp;
    width: 100%;
    font-family: "BoldPixels";
    font-size: 15dp;
    color: #ffd700;
    text-align: center;
    font-effect: outline(1dp #CC6600);
}

.sa-stock {
    display: inline-block;
    position: absolute;
    top: -4dp;
    font-family: "BoldPixels";
    font-size: 15dp;
    color: #ffffff;
    font-effect: shadow(1dp 1dp #000000);
}
.p1-sa .sa-stock { right: 102%; margin-right: 2dp; text-align: right; }
.p2-sa .sa-stock { left: 102%; margin-left: 2dp; text-align: left; }

.gauge-center-spacer {
    display: none;
}

/* SA type numeral (I / II / III) outside gauge — BoldPixels, color-coded by SA index */
.sa-type {
    display: inline-block;
    position: absolute;
    top: -4dp;            /* centers 12dp glyph in the 4dp bar: (4/2) - (12/2) = -4dp */
    font-family: "BoldPixels";
    font-size: 15dp;
    font-effect: outline(1dp #000000);
}
.p1-sa .sa-type { left: 102%; margin-left: 2dp; }
.p2-sa .sa-type { right: 102%; margin-right: 2dp; }

.sa-type-0 { color: #ffff00; } /* SA I  — Yellow */
.sa-type-1 { color: #ff2020; } /* SA II — Red    */
.sa-type-2 { color: #2080ff; } /* SA III — Blue  */

/* ── Combo popups ───────────────────────────────────────────── */
/* CPS3: row 7 = y=56  P1 on RIGHT side, P2 on LEFT side       */
.combo-popup {
    display: block;
    position: absolute;
    top: 56dp;
    visibility: hidden;
    padding: 2dp 6dp;
    opacity: 0;
}
.combo-popup.combo-visible {
    visibility: visible;
    animation: combo-enter 0.6s sine-in-out;
}
.combo-popup.combo-visible.combo-sa {
    animation: combo-enter 1.0s sine-in-out;
}
.p1-combo { right: 8dp; }
.p2-combo { left: 8dp; }

.combo-hits {
    display: inline-block;
    font-size: 22dp;
    color: #ffffff;
    font-effect: shadow(2dp 2dp #000000);
}
.combo-label {
    display: inline-block;
    font-size: 13dp;
    color: #ffffff;
    letter-spacing: 1dp;
    font-effect: shadow(2dp 2dp #000000);
}

/* Kind-specific label colors */
.combo-lbl-hit   { color: #ffffff; }
.combo-lbl-arts  { color: #e0c060; }
.combo-lbl-sa    { color: #e040e0; }
.combo-lbl-1st   { color: #ffd700; }
.combo-lbl-rev   { color: #ff6040; }
.combo-lbl-parry { color: #40c0ff; }
.parry-red { color: #ff4040; }

/* Combo points below label */
.combo-pts {
    display: block;
    font-size: 11dp;
    color: #ffd700;
    font-effect: shadow(1dp 1dp #000000);
}
.p1-combo .combo-pts { text-align: right; }
.p2-combo .combo-pts { text-align: left; }

/* ── Score display ──────────────────────────────────────────── */
#hud-scores {
    display: block;
    position: absolute;
    top: 0dp;
    left: 0dp;
    width: 384dp;
    height: 100%;
}
.score {
    display: block;
    position: absolute;
    top: 0dp;
    font-size: 20dp;
    color: #00edd0;
    font-effect: outline(1dp #000000);
}
/* Score: native right-aligns at tile 17 (P1) / tile 37 (P2) = 136dp / 296dp */
.p1-score { left: 0dp; width: 136dp; text-align: right; }
.p2-score { left: 0dp; width: 296dp; text-align: right; }

/* "PRESS NP START" text for CPU-controlled sides */
.press-start {
    display: block;
    position: absolute;
    top: 0dp;
    margin: 0dp;
    padding: 0dp;
    font-family: "BoldPixels";
    font-size: 15dp;
    line-height: 12dp;
    color: #a8ecff;
    font-effect: outline(1dp #1A2866);
    animation: press-start-blink 1.3s sine-in-out infinite;
}
/* Native: P1 at tile 5 (40dp), P2 at tile 30 (240dp), y=0 */
.p1-press-start { left: 40dp; }
.p2-press-start { left: 240dp; }

/* ── Training stun counter ──────────────────────────────────── */
#hud-training-stun {
    display: block;
    position: absolute;
    top: 60dp;
    left: 0dp;
    width: 384dp;
    height: 14dp;
}

.stun-counter {
    display: block;
    position: absolute;
    font-size: 13dp;
    color: #40c0ff;
    font-effect: shadow(1dp 1dp #000000);
}
.p1-stun-counter { left: 10dp; }
.p2-stun-counter { left: 250dp; }

/* ── Animations ─────────────────────────────────────────────── */
@keyframes timer-pulse {
      0% { color: #ffd700; }
     50% { color: #ff4040; }
    100% { color: #ffd700; }
}

@keyframes stun-blink {
      0% { background-color: #c81010; }
     50% { background-color: #ff8080; }
    100% { background-color: #c81010; }
}

@keyframes sa-active-pulse {
      0% { background-color: #e040e0; }
     50% { background-color: #ffffff; }
    100% { background-color: #e040e0; }
}

@keyframes sa-stock-flicker {
      0% { background-color: #80c0ff; }
     50% { background-color: #ffffff; }
    100% { background-color: #80c0ff; }
}

@keyframes combo-enter {
      0% { opacity: 0; }
     15% { opacity: 1; }
     85% { opacity: 1; }
    100% { opacity: 0; }
}

@keyframes press-start-blink {
      0% { opacity: 1; }
     62% { opacity: 1; }
     63% { opacity: 0; }
    100% { opacity: 0; }
}
</file>

<file path="assets/ui/game_hud.rml">
<rml>
<head>
    <title>Fight HUD</title>
    <link type="text/rcss" href="base.rcss"/>
    <link type="text/rcss" href="game_hud.rcss"/>
</head>
<body data-model="game_hud" id="game-hud-root">
    <!-- HUD is visible during active fights -->
    <div id="hud-container" class="hud-wrap" data-class-hud-hidden="!is_fight_active">

        <!-- ═══ TOP BAR: Portraits + HP bars + Timer ═══ -->
        <div id="hud-top" data-class-hud-pre-cockpit="!cockpit_visible">

            <!-- P1 Side -->
            <div class="player-side p1-side">
                <div class="player-name p1-name">{{p1_name}}</div>
                <div class="hp-bar-wrap p1-hp">
                    <!-- Drain bar (red, trails behind) -->
                    <div class="hp-drain" data-style-width="(p1_drain * 100 / (health_max > 0 ? health_max : 1)) + '%'"></div>
                    <!-- Current HP fill -->
                    <div data-attr-class="'hp-fill hp-col-' + p1_hp_color"
                         data-style-width="(p1_health * 100 / (health_max > 0 ? health_max : 1)) + '%'"></div>
                </div>
            </div>

            <!-- Center Timer -->
            <div id="timer-block">
                <div class="timer-digits" data-class-timer-flash="timer_flash">
                    <span data-if="!timer_infinite">{{round_timer}}</span>
                    <span data-if="timer_infinite">--</span>
                </div>
            </div>

            <!-- Round result bubbles (dynamic count + V/J/C/S/P/D) -->
            <div class="win-row">
                <div class="win-pips p1-wins">
                    <span data-if="rounds_to_win >= 1" data-attr-class="'round-bubble rt-' + p1_r0">{{p1_r0_lbl}}</span>
                    <span data-if="rounds_to_win >= 2" data-attr-class="'round-bubble rt-' + p1_r1">{{p1_r1_lbl}}</span>
                    <span data-if="rounds_to_win >= 3" data-attr-class="'round-bubble rt-' + p1_r2">{{p1_r2_lbl}}</span>
                    <span data-if="rounds_to_win >= 4" data-attr-class="'round-bubble rt-' + p1_r3">{{p1_r3_lbl}}</span>
                </div>
                <div class="win-sep">VS</div>
                <div class="win-pips p2-wins">
                    <span data-if="rounds_to_win >= 1" data-attr-class="'round-bubble rt-' + p2_r0">{{p2_r0_lbl}}</span>
                    <span data-if="rounds_to_win >= 2" data-attr-class="'round-bubble rt-' + p2_r1">{{p2_r1_lbl}}</span>
                    <span data-if="rounds_to_win >= 3" data-attr-class="'round-bubble rt-' + p2_r2">{{p2_r2_lbl}}</span>
                    <span data-if="rounds_to_win >= 4" data-attr-class="'round-bubble rt-' + p2_r3">{{p2_r3_lbl}}</span>
                </div>
            </div>

            <!-- P2 Side (mirrored) -->
            <div class="player-side p2-side">
                <div class="hp-bar-wrap p2-hp">
                    <div class="hp-drain" data-style-width="(p2_drain * 100 / (health_max > 0 ? health_max : 1)) + '%'"></div>
                    <div data-attr-class="'hp-fill hp-col-' + p2_hp_color"
                         data-style-width="(p2_health * 100 / (health_max > 0 ? health_max : 1)) + '%'"></div>
                </div>
                <div class="player-name p2-name">{{p2_name}}</div>
            </div>

        </div><!-- hud-top -->

        <!-- ═══ SECOND ROW: Stun + SA gauges ═══ -->
        <div id="hud-gauges" data-class-hud-pre-cockpit="!cockpit_visible">

            <!-- P1 Stun -->
            <div class="stun-wrap p1-stun" data-style-width="p1_stun_width">
                <div class="stun-fill" data-class-stun-active="p1_stun_active"
                     data-style-width="(p1_stun * 100 / (p1_stun_max > 0 ? p1_stun_max : 1)) + '%'"></div>
            </div>

            <!-- P1 SA Gauge -->
            <div class="sa-wrap p1-sa" data-style-width="p1_sa_width">
                <div class="sa-fill" data-class-sa-active="p1_sa_active" data-class-sa-max="p1_sa_max"
                     data-class-sa-ready="p1_sa_stocks >= 1"
                     data-style-width="p1_sa_pct + '%'"></div>
                <div class="sa-label" data-if="p1_sa_max">MAX</div>
                <div class="sa-type" data-class-sa-type-0="p1_sa_index == 0" data-class-sa-type-1="p1_sa_index == 1" data-class-sa-type-2="p1_sa_index == 2">{{p1_sa_type}}</div>
                <div class="sa-stock" data-if="p1_sa_stocks_max > 0">{{p1_sa_stocks}}/{{p1_sa_stocks_max}}</div>
            </div>

            <!-- Spacer -->
            <div class="gauge-center-spacer"></div>

            <!-- P2 SA Gauge (right side) -->
            <div class="sa-wrap p2-sa" data-style-width="p2_sa_width">
                <div class="sa-fill" data-class-sa-active="p2_sa_active" data-class-sa-max="p2_sa_max"
                     data-class-sa-ready="p2_sa_stocks >= 1"
                     data-style-width="p2_sa_pct + '%'"></div>
                <div class="sa-label" data-if="p2_sa_max">MAX</div>
                <div class="sa-type" data-class-sa-type-0="p2_sa_index == 0" data-class-sa-type-1="p2_sa_index == 1" data-class-sa-type-2="p2_sa_index == 2">{{p2_sa_type}}</div>
                <div class="sa-stock" data-if="p2_sa_stocks_max > 0">{{p2_sa_stocks}}/{{p2_sa_stocks_max}}</div>
            </div>

            <!-- P2 Stun -->
            <div class="stun-wrap p2-stun" data-style-width="p2_stun_width">
                <div class="stun-fill" data-class-stun-active="p2_stun_active"
                     data-style-width="(p2_stun * 100 / (p2_stun_max > 0 ? p2_stun_max : 1)) + '%'"></div>
            </div>

        </div><!-- hud-gauges -->

        <!-- ═══ COMBO POPUPS (kind-aware: 0=HIT, 1=ARTS, 2/3=SA FINISH, 4=1ST ATK, 5=REVERSAL, 6=PARRY) ═══ -->
        <div id="hud-combos">
            <!-- P1 Combo -->
            <div class="combo-popup p1-combo" data-class-combo-visible="p1_combo_active"
                 data-class-combo-sa="p1_combo_kind == 2 || p1_combo_kind == 3">
                <!-- Hit count (only for kinds that show it: 0=combo, 1=arts, 2=SA w/ combo) -->
                <span class="combo-hits" data-if="p1_combo_kind <= 2">{{p1_combo_count}}</span>
                <!-- Kind-specific label -->
                <span class="combo-label combo-lbl-hit" data-if="p1_combo_kind == 0"> HIT</span>
                <span class="combo-label combo-lbl-arts" data-if="p1_combo_kind == 1"> ARTS COMBO</span>
                <span class="combo-label combo-lbl-sa" data-if="p1_combo_kind == 2 || p1_combo_kind == 3">S.A. FINISH</span>
                <span class="combo-label combo-lbl-1st" data-if="p1_combo_kind == 4">1ST ATTACK</span>
                <span class="combo-label combo-lbl-rev" data-if="p1_combo_kind == 5">REVERSAL</span>
                <span class="combo-label combo-lbl-parry" data-if="p1_combo_kind == 6" data-class-parry-red="p1_parry_red">PARRY ×{{p1_parry_count}}</span>
                <!-- Points (shown when pts_flag is set) -->
                <div class="combo-pts" data-if="p1_combo_pts_flag">{{p1_combo_pts}}</div>
            </div>

            <!-- P2 Combo (mirrored) -->
            <div class="combo-popup p2-combo" data-class-combo-visible="p2_combo_active"
                 data-class-combo-sa="p2_combo_kind == 2 || p2_combo_kind == 3">
                <span class="combo-hits" data-if="p2_combo_kind <= 2">{{p2_combo_count}}</span>
                <span class="combo-label combo-lbl-hit" data-if="p2_combo_kind == 0"> HIT</span>
                <span class="combo-label combo-lbl-arts" data-if="p2_combo_kind == 1"> ARTS COMBO</span>
                <span class="combo-label combo-lbl-sa" data-if="p2_combo_kind == 2 || p2_combo_kind == 3">S.A. FINISH</span>
                <span class="combo-label combo-lbl-1st" data-if="p2_combo_kind == 4">1ST ATTACK</span>
                <span class="combo-label combo-lbl-rev" data-if="p2_combo_kind == 5">REVERSAL</span>
                <span class="combo-label combo-lbl-parry" data-if="p2_combo_kind == 6" data-class-parry-red="p2_parry_red">PARRY ×{{p2_parry_count}}</span>
                <div class="combo-pts" data-if="p2_combo_pts_flag">{{p2_combo_pts}}</div>
            </div>
        </div>

        <!-- ═══ SCORE / PRESS START DISPLAY ═══ -->
        <div id="hud-scores" data-if="!training_stun_active" data-class-hud-pre-cockpit="!cockpit_visible">
            <!-- P1: show score if human, "PRESS 1P START" if CPU -->
            <div class="score p1-score" data-if="p1_is_human">{{p1_score}}</div>
            <div class="press-start p1-press-start" data-if="!p1_is_human">PRESS 1P START</div>
            <!-- P2: show score if human, "PRESS 2P START" if CPU -->
            <div class="score p2-score" data-if="p2_is_human">{{p2_score}}</div>
            <div class="press-start p2-press-start" data-if="!p2_is_human">PRESS 2P START</div>
        </div>

        <!-- ═══ TRAINING STUN COUNTER ═══ -->
        <div id="hud-training-stun" data-if="training_stun_active">
            <div class="stun-counter p1-stun-counter">STUN: {{p1_combo_stun}}</div>
            <div class="stun-counter p2-stun-counter">STUN: {{p2_combo_stun}}</div>
        </div>

    </div><!-- hud-container -->
</body>
</rml>
</file>

