/** @brief  */
void Check_Jump_Distance_Level(PlayerEntity* wk) {
    g_state.PL_Distance[wk->wu.id] = ((State*)wk->wu.target_adrs)->xyz[0].disp.pos - wk->wu.xyz[0].disp.pos;

    if (g_state.PL_Distance[wk->wu.id] > 0) {
        g_state.Lever_Pool[wk->wu.id] = 9;
    } else {
