        break;

    case 2:
        char_move(&wk->wu);

        g_state.appear_work[wk->wu.id]--;

        if (g_state.appear_work[wk->wu.id] <= 0) {
            wk->wu.routine_no[APPEAR_RNO_PHASE]++;
