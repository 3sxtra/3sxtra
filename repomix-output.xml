/**
 * @file effect.c
 * Main Effect Functions
 */

#include "sf33rd/Source/Game/effect/effect.h"
#include "game_state.h"
#include "common.h"
#include "sf33rd/AcrSDK/ps2/flps2debug.h"
#include "sf33rd/Source/Game/debug/Debug.h"
#include "sf33rd/Source/Game/effect/effect_xx_move_and_init_jumptables.h"
#include "sf33rd/Source/Game/engine/player_control.h"
#include "sf33rd/Source/Game/engine/state_user.h"
#include "sf33rd/Source/Game/system/country_region.h"
#include "sf33rd/Source/Game/io/rumble.h"
#include "sf33rd/Source/Game/stage/bg.h"

#include "port/I_System.h"

s16 frwctr;
s16 frwctr_min;
s16 head_ix[8];
s16 tail_ix[8];
s16 exec_tm[8];
uintptr_t frw[EFFECT_MAX][448];
s16 frwque[EFFECT_MAX];

void move_effect_work(s16 index) {
    State* c_addr;
    s16 curr_ix;
    s16 next_ix;

    if (Debug_w[DEBUG_EFF_NOT_MOVE]) {
        return;
    }

    exec_tm[index] += 1;

    for (curr_ix = head_ix[index]; curr_ix != -1; curr_ix = next_ix) {
        c_addr = (State*)frw[curr_ix];
        next_ix = c_addr->behind;

        if (c_addr->timing != exec_tm[index]) {
            c_addr->timing = exec_tm[index];
            effmovejptbl[c_addr->id](c_addr);
        }
    }
}

void disp_effect_work() {
    State* c_addr;
    s16 index;
    s16 curr_ix;
    s16 next_ix;
    s32 px;
    s32 py;

    if (Debug_w[DEBUG_EFF_NUM_DISP] == 0) {
        return;
    }

    if (Debug_w[DEBUG_EFF_NUM_DISP] == 2) {
        /* Mode 2: draw effect g_state.ID at each visual effect's screen position
         * with a drop-shadow for readability against game graphics. */
        for (index = 0; index <= 7; index += 1) {
            for (curr_ix = head_ix[index]; curr_ix != -1; curr_ix = next_ix) {
                c_addr = (State*)frw[curr_ix];
                next_ix = c_addr->behind;

                /* Skip non-visual effects */
                if (c_addr->disp_flag == 0) {
                    continue;
                }

                /* position_x/y are screen-relative (set by disp_pos_trans_entry).
                 * Convert pixel coords to flPrintL's 8x8 character grid. */
                px = (s32)(u16)c_addr->position_x / 8;
                py = (s32)(u16)c_addr->position_y / 8;

                /* Clamp to visible screen area (48x28 char grid for 384x224) */
                if (px < 1 || px > 45 || py < 1 || py > 26) {
                    continue;
                }

                /* Bright green for visibility */
                flPrintColor(0xFF00FF00);
                flPrintL(px, py, "%c%d", "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ"[(c_addr->id / 10)], c_addr -> id % 10);
            }
        }
        /* Reset color to default white */
        flPrintColor(0xFFFFFFFF);
        return;
    }

    /* Mode 1: original grid layout */
    px = 7;
    py = 15;

    for (index = 0; index <= 7; index += 1) {
        curr_ix = head_ix[index];
        px += 5;
        py = 14;

        for (; curr_ix != -1; curr_ix = next_ix) {
            if (py > 49) {
                py = 14;
                px += 3;
            }

            c_addr = (State*)frw[curr_ix];
            next_ix = c_addr->behind;

            flPrintColor(0xFF00FFFF);
            flPrintL(px, py, "%c%d", "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ"[(c_addr->id / 10)], c_addr -> id % 10);

            py += 2;
        }
    }

    /* Reset color to default white */
    flPrintColor(0xFFFFFFFF);
}

void effect_work_init() {
    State* c_addr;
    s16 i;

    I_ZeroArray(frw);

    for (i = 0; i < EFFECT_MAX; i++) {
        frwctr = (EFFECT_MAX - 1) - i;
        c_addr = (State*)frw[frwctr];
        frwque[i] = c_addr->myself = frwctr;
        c_addr->before = c_addr->behind = -1;
    }

    frwctr = EFFECT_MAX;
    frwctr_min = frwctr;

    for (i = 0; i < 8; i++) {
        head_ix[i] = tail_ix[i] = -1;
        exec_tm[i] = 0;
    }
}

void effect_work_quick_init() {
    s16 i;

    for (i = 0; i < 8; i += 1) {
        effect_work_list_init(i, -1);
    }
}

void effect_work_list_init(s16 lix, s16 iid) {
    State* c_addr;
    s16 curr_ix;
    s16 next_ix;

    curr_ix = head_ix[lix];

    if (iid == -1) {
        while (curr_ix != -1) {
            c_addr = (State*)frw[curr_ix];
            next_ix = c_addr->behind;
            Release_Effect(c_addr);
            curr_ix = next_ix;
        }

        exec_tm[lix] = 0;
    } else {
        while (curr_ix != -1) {
            c_addr = (State*)frw[curr_ix];
            next_ix = c_addr->behind;

            if (c_addr->id == iid) {
                Release_Effect(c_addr);
            }

            curr_ix = next_ix;
        }
    }
}

s16 Acquire_Effect(s16 index) {
    s16 qix;
    State* tadr;
    State* wrk;

    if (frwctr < 1) {
        return -1;
    }

    qix = frwque[(frwctr -= 1)];
    tadr = (State*)frw[qix];

    if (head_ix[index] == -1) {
        tail_ix[index] = qix;
        head_ix[index] = qix;
    } else {
        wrk = (State*)frw[tail_ix[index]];
        wrk->behind = qix;
        tadr->before = tail_ix[index];
        tail_ix[index] = qix;
    }

    tadr->timing = exec_tm[index];
    tadr->listix = index;

    if (frwctr_min > frwctr) {
        frwctr_min = frwctr;
    }

    return qix;
}

/// @brief Searches for an effect.
/// @param index Index of the list to perform search in.
/// @param flag Set to `true` to search from the tail, `false` to search from the head.
/// @param tid g_state.ID to search for.
/// @return Index of the effect, or `-1` if it couldn't be found.
s16 search_effect_index(s16 index, s16 flag, s16 tid) {
    State* c_addr;
    s16 aix;

    if (flag) {
        aix = tail_ix[index];

        while (aix != -1) {
            c_addr = (State*)frw[aix];

            if (c_addr->id != tid) {
                aix = c_addr->before;
            } else {
                break;
            }
        }
    } else {
        aix = head_ix[index];

        while (aix != -1) {
            c_addr = (State*)frw[aix];

            if (c_addr->id != tid) {
                aix = c_addr->behind;
            } else {
                break;
            }
        }
    }

    return aix;
}

void Release_Effect(State* wkhd) {
    State* c_addr;
    State* c_addr2;
    s16 qix;
    s16 lix;

    lix = wkhd->listix;
    qix = wkhd->myself;
    c_addr = (State*)frw[qix];

    if (qix < 0 || qix >= 128) {
        fatal_error("qix is out of range");
    }

    switch ((qix == head_ix[lix]) + (qix == tail_ix[lix]) * 2) {
    case 0:
        c_addr2 = (State*)frw[c_addr->before];
        c_addr2->behind = c_addr->behind;
        c_addr2 = (State*)frw[c_addr->behind];
        c_addr2->before = c_addr->before;
        break;

    case 1:
        head_ix[lix] = c_addr->behind;
        c_addr2 = (State*)frw[c_addr->behind];
        c_addr2->before = -1;
        break;

    case 2:
        c_addr2 = (State*)frw[c_addr->before];
        c_addr2->behind = -1;
        tail_ix[lix] = c_addr->before;
        break;

    default:
        head_ix[lix] = tail_ix[lix] = -1;
        break;
    }

    I_ZeroArray(frw[qix]);

    c_addr->before = c_addr->behind = -1;
    frwque[frwctr++] = qix;
    c_addr->myself = qix;
}

void effect_work_kill(s16 index, s16 kill_id) {
    State* c_addr;
    s16 aix = head_ix[index];

    if (kill_id == -1) {
        while (aix != -1) {
            c_addr = (State*)frw[aix];
            c_addr->death_timer = 1;
            aix = c_addr->behind;
        }

        return;
    }

    while (aix != -1) {
        c_addr = (State*)frw[aix];

        if (c_addr->id == kill_id) {
            c_addr->death_timer = 1;
        }

        aix = c_addr->behind;
    }
}

void write_my_shell_ix(State* wk, s16 ix) {
    s32 i;

    for (i = 7; i > 0; i -= 1) {
        wk->shell_ix[i] = wk->shell_ix[i - 1];
    }

    wk->shell_ix[0] = ix;
}

s32 erase_my_shell_ix(State* wk, s16 ix) {
    s32 i;
    s32 j;

    for (i = 0; i < 8; i++) {
        if (wk->shell_ix[i] == ix) {
            goto can_activate;
        }
    }

    return 0;

can_activate:
    for (j = i; j < 7; j++) {
        wk->shell_ix[j] = wk->shell_ix[j + 1];
    }

    wk->shell_ix[7] = -1;
    return 1;
}

s32 get_my_shell_ix(State* wk, s16 ix, State** tmw) {
    if (wk->shell_ix[ix] == -1) {
        return 0;
    }

    *tmw = (State*)frw[wk->shell_ix[ix]];

    if ((*tmw)->active_flag) {
        return 1;
    }

    return 0;
}

s32 get_vs_shell_adrs(State* wk, s16 id, s16 ix, State_Other** tmw) {
    if (wk->shell_ix[ix] == -1) {
        return 0;
    }

    *tmw = (State_Other*)frw[wk->shell_ix[ix]];

    if ((*tmw)->master_id == id) {
        return 1;
    }

    return 0;
}

void clear_my_shell_ix(State* wk) {
    s32 i;

    for (i = 0; i < 8; i += 1) {
        wk->shell_ix[i] = -1;
    }
}

void setup_shell_hit_stop(State* wk, s16 tm, s16 fl) {
    State* tmw;
    s32 i;

    for (i = 0; i < 8; i++) {
        if (get_my_shell_ix(wk, i, &tmw) != 0) {
            if (fl == 0 || tmw->id != 0x29) {
                tmw->hit_stop = tm;
            }
        }
    }
}

s32 shell_live_check(PlayerEntity* wk, s16 wix) {
    State_Other* tmw;
    s16 i;

    if (wk->player_number != 0xE) {
        for (i = 0; i < 8; i++) {
            if (wk->wu.shell_ix[i] == -1) {
                break;
            }

            tmw = (State_Other*)frw[wk->wu.shell_ix[i]];

            if ((!tmw->refrected) && (tmw->wu.original_vitality == wix)) {
                return 1;
            }
        }

        return 0;
    }

    for (i = 0; i < 8; i++) {
        if (wk->wu.shell_ix[i] == -1) {
            break;
        }

        tmw = (State_Other*)frw[wk->wu.shell_ix[i]];

        if (tmw->refrected) {
            continue;
        }

        if ((tmw->wu.original_vitality == 31) || (tmw->wu.original_vitality == 33) ||
            (tmw->wu.original_vitality == 46)) {
            return 1;
        }
    }

    return 0;
}

s32 clear_caution_flag(PlayerEntity* wk, u8 /* unused */) {
    wk->caution_flag = 0;
    return 0;
}

s32 set_caution_flag(PlayerEntity* wk, u8 /* unused */) {
    wk->caution_flag = 1;
    return 0;
}

s32 setup_status_flag(State* wk, u8 data) {
    wk->pat_status = data;
    return 0;
}

s32 reset_extra_bg_flag(State* wk, u8 /* unused */) {
    g_state.another_bg[wk->id] = 0;
    return 0;
}

s32 flip_my_facing_flag(State* wk, u8 /* unused */) {
    wk->facing_flag = wk->facing_flag + 1U & 1;
    return 0;
}

s32 setup_tc_hit_flag(State* wk, u8 data) {
    wk->frame_link_hit_flag = data;
    return 0;
}

s32 exec_char_asxy(State* wk, u8 data) {
    s16* from_rom2;
    s32 st;
    s16 ix = data;

    ix *= 2;
    from_rom2 = &wk->step_xy_table[ix];
    st = *from_rom2++;
    st *= 256;

    if (wk->facing_flag) {
        wk->xyz[0].cal += st;
    } else {
        wk->xyz[0].cal -= st;
    }

    st = *from_rom2;
    st *= 256;
    wk->xyz[1].cal += st;
    return 0;
}

s32 setup_my_clear_level(State* wk, u8 data) {
    wk->my_clear_level = data;
    return 0;
}

s32 setup_my_bright_level(State* wk, u8 data) {
    wk->my_bright_level = data;
    return 0;
}

s32 setup_free_program(s32 /* unused */, s32 /* unused */) {
    return 0;
}

s32 setup_bg_quake_x(s32 /* unused */, u8 data) {
    g_state.bg_w.quake_x_index = data;
    return 0;
}

s32 setup_bg_quake_y(s32 /* unused */, u8 data) {
    g_state.bg_w.quake_y_index = data;
    pp_screen_quake(g_state.bg_w.quake_y_index);
    return 0;
}

s32 setup_exdamage_index(PlayerEntity* wk, u8 data) {
    wk->exdamage_index = data;
    return 0;
}

s32 setup_dmv_use_flag(PlayerEntity* wk, u8 data) {
    wk->dm_vital_use = data;
    return 0;
}

s32 setup_disp_flag(State* wk, u8 data) {
    wk->disp_flag = data;
    return 0;
}

s32 setup_command_number(PlayerEntity* wk, u8 data) {
    wk->cmd_request = data;
    return 0;
}

u8 old_my_char_check(u8 num, u8 flag) {
    switch (flag) {
    case 0:
        if ((g_state.Country == COUNTRY_JAPAN) || (g_state.Country == COUNTRY_KOREA)) {
            if (num > 14) {
                num += 1;
            }
        } else if (num > 13) {
            num += 1;
        }

        break;

    case 1:
        if (num > 14) {
            num += 1;
        }

        break;
    }

    return num;
}

void effect_work_kill_mod_plcol() {
    effect_work_kill(6, -1);
}

void setup_shadow_of_the_Effy(State* wk) {
    wk->shadow_flag = 1;
    wk->shadow_x = 0;
    wk->shadow_y = -0xA;
    wk->shadow_prio = 0x47;
    wk->shadow_char = 0xC;
}

void set_init_A4_flag() {
    g_state.plw[0].init_effect_e3_flag = 1;
    g_state.plw[1].init_effect_e3_flag = 1;
    g_state.plw[0].init_effect_e4_flag = 1;
    g_state.plw[1].init_effect_e4_flag = 1;
}
