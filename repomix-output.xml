/** @brief Core combo counter update — increments hit tracking arrays. */
static void add_combo_work_impl(PlayerEntity* as, PlayerEntity* ds) {
    s16* move_type;
    s16* cal;

    ds->stun_state = ds->combo_type.new_dm = as->wu.attack_type;
    move_type = &ds->combo_type.kind_of[0][0][0];
    cal = &g_state.calc_hit[ds->wu.id][0];
    move_type[as->wu.attack_type]++;
    cal[(as->wu.attack_type & 120) / 8]++;
    ds->combo_type.total++;
    move_type = &ds->remake_power.kind_of[0][0][0];
    move_type[as->wu.attack_type]++;
    ds->remake_power.total++;
}

/** @brief Adds a hit to the combo counter and updates combo display work. */
void add_combo_work(PlayerEntity* as, PlayerEntity* ds) {
    if (ds->chip_death_flag) {
        return;
    }

    add_combo_work_impl(as, ds);
}

/** @brief Adds fake combo hits (for multi-hit moves that don't combo normally). */
void nise_combo_work(PlayerEntity* as, PlayerEntity* ds, s16 num) {
    s16 i;

    for (i = 0; i < num; i++) {
        add_combo_work_impl(as, ds);
    }
}

/** @brief Calculates combo damage scaling (waribiki) for the current combo length. */
void cal_combo_waribiki(PlayerEntity* as, PlayerEntity* ds) {
    POWER* power;
    KOATT* koatt;
    s16 i;
    s16 j;
    s16 k;
    TBL tbl;

    if (ds->wu.damage_vitality == 0) {
        return;
    }

    if (ds->remake_power.total == 0) {
        return;
    }

    koatt = (KOATT*)_exchange_koa[(as->wu.attack_type) >> 1];
    tbl.ixl = 0;

    for (i = 0; i < 9; i++) {
        for (j = 0; j < 4; j++) {
            k = ds->remake_power.kind_of[i][j][0];
            k += ds->remake_power.kind_of[i][j][1];

            if (k) {
                tbl.ixl += k * koatt->step[i][j] * 256;
            }
        }
    }

    if (tbl.ixs.l) {
        tbl.ixs.h++;
    }

    power = (POWER*)_exchange_pow[as->wu.attack_type >> 1];

    if ((as->player_number == 3 || as->player_number == 10) && (as->sa->kind_of_arts == 2 && as->sa->can_activate == -1)) {
        power = (POWER*)_exchange_pow_pl03_sa3[as->wu.attack_type >> 1];
    }

    if (tbl.ixs.h > 31) {
        tbl.ixs.h = 31;
    }

    ds->wu.damage_vitality *= power[0].data[tbl.ixs.h];
    ds->wu.damage_vitality >>= 5;

    if (ds->wu.damage_vitality <= 0) {
        ds->wu.damage_vitality = 1;
    }
}

/** @brief Calculates combo damage scaling variant 2 (for specific multi-hit patterns). */
void cal_combo_waribiki2(PlayerEntity* ds) {
    s16 num;

    if (ds->wu.damage_stun_value == 0) {
        return;
    }

    if (ds->combo_type.total == 0) {
        return;
    }

    num = 32 - (ds->combo_type.total * 2);

    if (num <= 0) {
        num = 1;
    }

    if (num > 32) {
        num = 32;
    }

    ds->wu.damage_stun_value = (ds->wu.damage_stun_value * num) / 32;

    if (ds->wu.damage_stun_value == 0) {
        ds->wu.damage_stun_value = 1;
    }
}

/** @brief Main catch (throw) hit-check loop — tests all active catch boxes. */
void catch_hit_check() {
    State* mad;
    State* sad;
    s16* mh;
    s16* sh;
    s16 mi;
    s16 si;

    for (mi = 0; mi < hpq_in; mi++) {
        if (hs[mi].flag.results & 0x1000) {
            continue;
        }

        mad = q_hit_push[mi];

        if (mad->work_id != 1) {
            continue;
        }

        if (mad->att_hit_ok == 0) {
            continue;
        }

        mh = &mad->catch_box->cat_box[0];

        if (mh[1] == 0) {
            continue;
        }

        for (si = 0; si < hpq_in; si++) {
            if (si == mi) {
                continue;
            }

            if (hs[si].flag.results & 0x100) {
                continue;
            }

            sad = q_hit_push[si];

            if (sad->work_id != 1) {
                continue;
            }

            sh = &sad->caught_box->cau_box[0];

            if (sh[1] == 0) {
                continue;
            }

            if (!(mad->att.guard & 0x18)) {
                if (!((PlayerEntity*)sad)->throw_invuln_flag) {
                    if (!(mad->att.dipsw & 0x60)) {
                        if ((sad->routine_no[1] == 1) && (sad->routine_no[3] != 0)) {
                            if (sad->routine_no[2] != 0x19) {
                                continue;
                            }
                        }
                    } else if ((sad->routine_no[1] == 1) && (sad->routine_no[3] != 0) && (sad->cg_type != 10)) {
                        if (!dm_oiuchi_catch[sad->routine_no[2]]) {
                            continue;
                        }
                    }
                } else {
                    continue;
                }
            }

            if (hit_check_subroutine(mad, sad, mh, sh)) {
                hs[mi].flag.results |= 0x1000;
                hs[mi].my_hit = (u16)si;
                hs[si].flag.results |= 0x100;
                hs[si].dm_me = (u16)mi;
                mad->att_hit_ok = 0;
                hs[mi].ah = mh;
                hs[si].dh = sh;
                mad->att_hit_ok = 0;
            } else {
                continue;
            }

            break;
        }
    }
}

/** @brief Main attack hit-check loop — tests all active attack vs. hurt boxes. */
void attack_hit_check() {
    State* mad;
    State* sad;
    s16* mh;
    s16* sh;
    s16 mi;
    s16 si;
    s16 lp;
    s16 lp2;
    s16 mw;

    s16* assign1;
    s16* assign2;

    for (si = 0; si < hpq_in; si++) {
        if (hs[si].flag.results & 0x1101) {
            continue;
        }

        sad = q_hit_push[si];
        sh = sad->body_hurtbox->body_dm[0];
        mh = sad->hand_hurtbox->hand_dm[0];

        for (lp = 0; lp < 4; lp++, sh += 4, assign1 = mh += 4) {
            dmdat_adrs[lp] = sh;
            dmdat_adrs[lp + 4] = mh;
        }

        dmdat_adrs[8] = &sad->attack_hitbox->att_box[2][0];
        dmdat_adrs[9] = &sad->attack_hitbox->att_box[3][0];
        dmdat_adrs[10] = &sad->pushbox->hos_box[0];

        for (mi = 0; mi < hpq_in; mi++) {
            if (mi == si) {
                continue;
            }
            if (hs[mi].flag.results & 0x1110) {
                continue;
            }

            mad = q_hit_push[mi];
            if (mad->cg_ja.attack_box_index == 0) {
                continue;
            }
            if (mad->att_hit_ok == 0) {
                continue;
            }

            if (!(mad->att.dipsw & 2) ||
                (!(sad->att.dipsw & 2) && (sad->work_id == 1 || !(((State_Other*)sad)->refrected)))) {
                if ((mad->work_id != 1 && mad->work_id != 8) || !(sad->att.dipsw & 2)) {
                    if (!(mad->vs_id & sad->work_id)) {
                        continue;
                    }
                }
            }

            if (mad->work_id != 1) {
                if (sad->work_id == 1) {
                    if (((State_Other*)mad)->master_id == sad->id) {
                        continue;
                    }
                } else if (((State_Other*)mad)->master_id == ((State_Other*)sad)->master_id) {
                    continue;
                }
            } else if ((sad->work_id != 1 && ((State_Other*)sad)->refrected == 0) &&
                       (mad->id == ((State_Other*)sad)->master_id)) {
                continue;
            }

            mh = &mad->attack_hitbox->att_box[0][0];

            for (lp = 0; lp < 4; lp++, assign2 = mh += 4) {
                if (mh[1] == 0) {
                    continue;
                }

                for (lp2 = 0; lp2 < 11; lp2++) {
                    if (lp2 > 3 && mad->att_hit_ok == 0) {
                        goto end;
                    }

                    if (dmdat_adrs[lp2][1] == 0) {
                        continue;
                    }

                    if ((lp == 2 || lp == 3) && (lp2 == 8 || lp2 == 9)) {
                        continue;
                    }

                    if ((lp2 > 3) && (lp2 < 0xA)) {
                        if (!(((mad->facing_flag) + (sad->facing_flag)) & 1)) {
                            // turbo
                            // What: Convert unpredictable direction checks into branchless arithmetic.
                            // Target: CPU Branch Prediction
                            int diff = mad->xyz[0].disp.pos - sad->xyz[0].disp.pos;
                            int dir_mask = (mad->facing_flag << 1) - 1;
                            if ((diff * dir_mask) > 0) {
                                continue;
                            }
                        }
                        if (mad->att.dipsw & 4 && (lp2 >= 8 || sad->cg_ja.behind_hurtbox_index == 0)) {
                            continue;
                        }
                    }

                    if (lp2 == 10) {
                        if (!(mad->att.dipsw & 64) || sad->attack_type & 0x60 || g_state.pcon_dp_flag ||
                            sad->pat_status == 0x26) {
                            continue;
                        }
                    }

                    mw = hit_check_subroutine(mad, sad, mh, dmdat_adrs[lp2]);

                    if (mw > mkm_wk[si]) {
                        hs[mi].flag.results |= 0x10;
                        hs[mi].my_hit = si;
                        hs[mi].my_att = lp;
                        hs[si].flag.results |= 1;
                        hs[si].dm_me = mi;
                        hs[si].dm_body = lp2;
                        mad->att_hit_ok = 0;
                        mkm_wk[si] = mw;
                        hs[mi].ah = mh;
                        hs[si].dh = dmdat_adrs[lp2];
                    }
                }
            }
        }

    end:
        continue;
    }
}

/** @brief Low-level hitbox overlap test (AABB intersection check). */
s16 hit_check_subroutine(State* wk1, State* wk2, const s16* hd1, const s16* hd2) {
    s16 d0;
    s16 d1;
    s16 d2;
    s16 d3;
    s16 m1, m2;

    d0 = *hd1++;
    d1 = *hd1++;

    // turbo
    // What: Convert AABB bounding box coordinate calculations into branchless logic.
    // Target: CPU Branch Prediction (eliminates branching in hot hit-check paths).
    m1 = -(s16)wk1->facing_flag;
    d0 = (d0 ^ m1) - m1;
    d0 -= (d1 & m1);

    d0 += wk1->xyz[0].disp.pos;
    d2 = *hd2++;
    d3 = *hd2++;

    // turbo
    // What: Convert AABB bounding box coordinate calculations into branchless logic.
    // Target: CPU Branch Prediction (eliminates branching in hot hit-check paths).
    m2 = -(s16)wk2->facing_flag;
    d2 = (d2 ^ m2) - m2;
    d2 -= (d3 & m2);

    d2 += wk2->xyz[0].disp.pos;
    d2 += d3 - d0;
    d3 += d1;

    if ((u32)d2 >= d3) {
        return 0;
    }

    d0 = (wk1->xyz[1].disp.pos + *hd1++) - (wk2->xyz[1].disp.pos + *hd2++);
    d0 += d1 = *hd1;
    d1 += *hd2;

    if ((u32)d0 >= d1) {
        return 0;
    }

    if (d2 > (d3 - d2)) {
        d2 = d3 - d2;
    }

    return d2;
}

/** @brief Hitbox overlap test on X-axis only (for push/proximity checks). */
s32 hit_check_x_only(State* wk1, State* wk2, s16* hd1, s16* hd2) {
    s16 d0;
    s16 d1;
    s16 d2;
    s16 d3;
    s16 m1, m2;

    d0 = *hd1++;
    d1 = *hd1++;

    // turbo
    // What: Convert AABB bounding box coordinate calculations into branchless logic.
    // Target: CPU Branch Prediction (eliminates branching in hot hit-check paths).
    m1 = -(s16)wk1->facing_flag;
    d0 = (d0 ^ m1) - m1;
    d0 -= (d1 & m1);

    d0 += wk1->xyz[0].disp.pos;
    d2 = *hd2++;
    d3 = *hd2++;

    // turbo
    // What: Convert AABB bounding box coordinate calculations into branchless logic.
    // Target: CPU Branch Prediction (eliminates branching in hot hit-check paths).
    m2 = -(s16)wk2->facing_flag;
    d2 = (d2 ^ m2) - m2;
    d2 -= (d3 & m2);

    d2 += wk2->xyz[0].disp.pos;
    d2 += d3 - d0;
    d3 += d1;

    if ((u32)d2 >= d3) {
        return 0;
    }

    return 1;
}

/** @brief Calculates the hit-mark spark position from two overlapping hitbox rects. */
void cal_hit_mark_position(State* wk1, State* wk2, s16* hd1, s16* hd2) {
    s16 d0 = *hd1++;
    s16 d1 = *hd1++;
    s16 d2;
    s16 d3;
    s16 m1, m2;

    // turbo
    // What: Convert AABB bounding box coordinate calculations into branchless logic.
    // Target: CPU Branch Prediction (eliminates branching in hot hit-check paths).
    m1 = -(s16)wk1->facing_flag;
    d0 = (d0 ^ m1) - m1;
    d0 -= (d1 & m1);

    d0 += wk1->xyz[0].disp.pos;
    d1 += d0;
    d2 = *hd2++;
    d3 = *hd2++;

    // turbo
    // What: Convert AABB bounding box coordinate calculations into branchless logic.
    // Target: CPU Branch Prediction (eliminates branching in hot hit-check paths).
    m2 = -(s16)wk2->facing_flag;
    d2 = (d2 ^ m2) - m2;
    d2 -= (d3 & m2);

    d2 += wk2->xyz[0].disp.pos;
    d3 += d2;

    if (d0 < d2) {
        d0 = d2;
    }

    if (d1 > d3) {
        d1 = d3;
    }

    wk2->hit_mark_x = (d0 + d1) >> 1;

    d0 = wk1->xyz[1].disp.pos + *hd1++;
    d1 = *hd1 + d0;
    d2 = wk2->xyz[1].disp.pos + *hd2++;
    d3 = *hd2 + d2;

    if (d0 < d2) {
        d0 = d2;
    }

    if (d1 > d3) {
        d1 = d3;
    }

    wk2->hit_mark_y = (d0 + d1) >> 1;
}

/** @brief Gets the target attack position for aim/tracking purposes. */
void get_target_att_position(State* wk, s16* tx, s16* ty) {
    s16 i;
    s16(*ta)[4];

    *tx = wk->xyz[0].disp.pos;
    *ty = wk->xyz[1].disp.pos;
    ta = &wk->attack_hitbox->att_box[0];

    for (i = 0; i < 3; ta++, i++) {
        if (!ta[0][0]) {
            continue;
        }

        if (wk->facing_flag) {
            *tx -= ta[0][0] + (ta[0][1] / 2);
        } else {
            *tx += ta[0][0] + (ta[0][1] / 2);
        }

        *ty += ta[0][2] + (ta[0][3] / 2);
        break;
    }
}

/** @brief Gets the head position for a work item's attack hitbox. */
s16 get_att_head_position(State* wk) {
    s16* ta;
    s16 kx;
    s16 tx;
    s16 i;

    tx = wk->xyz[0].disp.pos;

    if (wk->cg_ja.attack_box_index == 0) {
        return tx;
    }

    ta = &wk->attack_hitbox->att_box[0][0];

    for (i = 0; i < 3; i++) {
        if (*ta) {
            if (wk->facing_flag) {
                kx = tx - *ta;

                if (tx < kx) {
                    tx = kx;
                }

                break;
            } else {
                kx = tx + *ta;

                if (tx > kx) {
                    tx = kx;
                }

                break;
            }
        } else {
            ta += 4;
        }
    }
    return tx;
}

/** @brief Enqueues a work item into the hit-push processing queue. */
void hit_push_request(State* hpr_wk) {
    if (hpq_in < 31 && hpr_wk->anim_hurtbox_index != 0) {
        q_hit_push[hpq_in++] = hpr_wk;
    }
}

/** @brief Clears the hit-push queue and processes all pending hit pushes. */
void clear_hit_queue() {
    hpq_in = 0;

    // ⚡ Bolt: bulk memset replaces per-element zeroing loops (called every frame)
    memset(mkm_wk, 0, sizeof(mkm_wk));
    memset(q_hit_push, 0, sizeof(q_hit_push));

    I_ZeroArray(hs);
}

/** @brief Converts a raw damage attribute to a character-specific variant. */
s16 change_damage_attribute(PlayerEntity* as, u16 atr, u16 ix) {
    switch (atr) {
    case 1:
        if (as->wu.work_id == 1 && as->player_number == 0 && as->wu.facing_flag) {
            ix = attr_freeze_tbl[ix - 32];
            as->wu.attack_attribute = 3;
        } else {
            ix = attr_flame_tbl[ix - 32];
        }
        break;

    case 2:
        ix = attr_thunder_tbl[ix - 32];
        break;

    case 3:
        if (as->wu.work_id == 1 && as->player_number == 0 && as->wu.facing_flag) {
            ix = attr_flame_tbl[ix - 32];
            as->wu.attack_attribute = 1;
        } else {
            ix = attr_freeze_tbl[ix - 32];
        }
        break;
    }

    return ix;
}

