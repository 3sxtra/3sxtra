/**
 * @file eff77.c
 * Effect: Collision / Slow Effect
 */

#include "sf33rd/Source/Game/effect/effect_77_collision_slow.h"
#include "game_state.h"
#include "common.h"
#include "sf33rd/Source/Game/effect/effect.h"
#include "sf33rd/Source/Game/engine/player_control.h"
#include "sf33rd/Source/Game/engine/slow_motion.h"
#include "sf33rd/Source/Game/engine/state_user.h"
#include "sf33rd/Source/Game/rendering/sprite_utilities.h"
#include "sf33rd/Source/Game/stage/bg.h"
#include "sf33rd/Source/Game/stage/stage_data.h"
#include "sf33rd/Source/Game/ui/hud_subroutines.h"

s16 chk77_flag;

const s16 eff77_data_tbl[7][2] = { { 64, 0 }, { 2, 0 }, { 1, 1 }, { 32, 1 }, { 22, 1 }, { 1, 0 }, { 1, 0 } };

const u32 eff77_col_tbl[2] = { 0xFFFFFFFF, 0xFF000000 };

void effect_77_move(State_Other* ewk) {
    s16 i;
    u16 bg;
    u16 mask;

    u16 assign1;
    u16 assign2;
    u16 assign3;

    g_state.another_bg[0] = g_state.another_bg[1] = 0;
    g_state.Flash_MT[0] = g_state.Flash_MT[1] = 0;

    if (g_state.akebono_flag) {
        ewk->wu.routine_no[0] = 99;
    }

    for (i = 0; i < 3; i++) {
        scr_calc(i);
    }

    switch (ewk->wu.routine_no[0]) {
    case 0:
        if (g_state.Game_pause || g_state.execute_flag) {
            break;
        }

        ewk->wu.routine_no[0]++;
        g_state.plw[0].wu.disp_flag = 0;
        g_state.plw[1].wu.disp_flag = 0;

        if (ewk->wu.type == 0) {
            g_state.Extra_Break = 1;
        }

        /* fallthrough */

    case 1:
        if (g_state.Game_pause || g_state.execute_flag) {
            break;
        }

        ewk->wu.routine_no[0]++;
        g_state.sa_pa_flag = 1;
        bg = ake_bg_off[g_state.bg_w.stage];
        mask = 1;

        for (i = 0; i < 4; i++, assign1 = mask *= 2) {
            if (bg & mask) {
                Bg_Off_R(1 << i);
            }
        }

        ewk->wu.old_routine_no[0] = eff77_data_tbl[ewk->wu.type][0];
        ewk->wu.old_routine_no[1] = eff77_data_tbl[ewk->wu.type][1];
        overwrite_panel(eff77_col_tbl[ewk->wu.old_routine_no[1]], 0x46);
        break;

    case 2:
        if (g_state.Game_pause || g_state.execute_flag) {
            overwrite_panel(eff77_col_tbl[ewk->wu.old_routine_no[1]], 0x46);
            break;
        }

        ewk->wu.routine_no[0]++;
        bg = ake_bg_off[g_state.bg_w.stage];
        mask = 1;

        for (i = 0; i < 4; i++, assign2 = mask *= 2) {
            if (bg & mask) {
                Bg_Off_R(1 << i);
            }
        }

        g_state.sa_pa_flag = 1;
        /* fallthrough */

    case 3:
        if (g_state.Suicide[6]) {
            ewk->wu.old_routine_no[0] = 0;
        }

        if (!g_state.Game_pause && !g_state.execute_flag) {
            ewk->wu.old_routine_no[0]--;

            if (ewk->wu.old_routine_no[0] <= 0) {
                g_state.sa_pa_flag = 0;
                ewk->wu.routine_no[0]++;
                g_state.plw[0].wu.disp_flag = 1;
                g_state.plw[1].wu.disp_flag = 1;
                overwrite_panel(eff77_col_tbl[ewk->wu.old_routine_no[1]], 0x46);
                bg = ake_bg_off[g_state.bg_w.stage];
                mask = 1;

                for (i = 0; i < 4; i++, assign3 = mask *= 2) {
                    if (bg & mask) {
                        bg_enable_render(1 << i);
                    }
                }

                break;
            }

            g_state.sa_pa_flag = 1;
        }

        overwrite_panel(eff77_col_tbl[ewk->wu.old_routine_no[1]], 0x46);
        break;

    case 4:
        if (g_state.Game_pause || g_state.execute_flag) {
            break;
        }

        ewk->wu.routine_no[0]++;

        if (ewk->wu.type == 0) {
            g_state.Extra_Break = 0;
        }

        break;

    default:
        if (!g_state.Game_pause && !g_state.execute_flag) {
            g_state.sa_pa_flag = 0;
            all_cgps_put_back(&ewk->wu);
            Release_Effect(&ewk->wu);
        }

        break;
    }
}

s32 effect_77_init(u8 /* unused */, u8 data) {
    State_Other* ewk;
    s16 ix;

    chk77_flag = 0;

    if ((ix = Acquire_Effect(4)) == -1) {
        return -1;
    }

    ewk = (State_Other*)frw[ix];
    ewk->wu.active_flag = 1;
    ewk->wu.id = 77;
    ewk->wu.type = data;
    g_state.another_bg[0] = g_state.another_bg[1] = 0;
    g_state.Flash_MT[0] = g_state.Flash_MT[1] = 0;
    g_state.sa_pa_flag = 1;
    return 0;
}
</file>

