    SDLApp_BeginFrame(); // skips SDLGameRenderer_BeginFrame (no FBO clear)
    SDLApp_EndFrame();   // skips SDLGameRenderer_RenderFrame + audio, re-blits existing canvas
    present_only_mode = false;
