#define TO_UV_256(val) ((val) / 256.0f)
#define TO_UV_128(val) ((val) / 128.0f)

#define SA_FRAME_ROWS 3
#define SA_FRAME_COLS 48
#define SA_FRAME_Y_OFFSET 25
