        break;

    case 2:
        if (g_state.judge_flag == 1 && bgnm == 1) {
            vtxColor = 0xFFA0A0A0;
        } else {
            vtxColor = 0xFFFFFFFF;
        }

        for (y = yy[0]; y < yy[1]; y += 128) {
            for (x = xx[0]; x < xx[1]; x += 128) {
                global_index_real = global_index + (((y >> 7) << 3) + (x >> 7));

                if (bgnm == 1) {
