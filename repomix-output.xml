            ewk->wu.routine_no[1] = 4;
            ewk->wu.xyz[0].disp.pos = 16;
            ewk->wu.xyz[1].disp.pos = 120;
            break;
        case 1:
            ewk->wu.routine_no[1] = 0;
            ewk->wu.xyz[0].disp.pos = -1;
            ewk->wu.xyz[1].disp.pos = 104;
