        g_state.bg_w.bgw[(i)].xy[1].disp.pos = g_state.bg_w.bgw[(i)].wxy[1].disp.pos = g_state.bg_w.bgw[(i)].pos_y_work;
        g_state.bg_w.bgw[(i)].xy[0].disp.low = g_state.bg_w.bgw[(i)].wxy[0].disp.low = 0;
