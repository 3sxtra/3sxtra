/**
 * @file effa7.c
 * Effect: Quake & Hit Spark Effect
 */

#include "sf33rd/Source/Game/effect/effect_a7_quake_hit_spark.h"
#include "game_state.h"
#include "bin2obj/char_table.h"
#include "common.h"
#include "sf33rd/Source/Game/effect/effect_02_hit_marks_sparks.h"
#include "sf33rd/Source/Game/effect/effect.h"
#include "sf33rd/Source/Game/engine/charset.h"
#include "sf33rd/Source/Game/engine/player_system_utilities.h"
#include "sf33rd/Source/Game/engine/slow_motion.h"
#include "sf33rd/Source/Game/engine/state_user.h"
#include "sf33rd/Source/Game/io/rumble.h"
#include "sf33rd/Source/Game/rendering/sprite_utilities.h"
#include "sf33rd/Source/Game/sound/sound_effect_data.h"
#include "sf33rd/Source/Game/stage/bg.h"

void effect_A7_move(State_Other* ewk) {
    const HMDT* tad;
    const EXPLEM* edt;

    switch (ewk->wu.routine_no[0]) {
    case 0:
        ewk->wu.routine_no[0]++;
        *ewk->wu.char_table = _ef01_char_table;
        tad = &hmdt[ewk->wu.kind_of_hit_mark];

        if (tad->hits == 0) {
            if (tad->se) {
                Se_Dispatch(tad->se, tad->se, ewk);
                g_state.Last_Called_SE = tad->se;
            } else {
                g_state.Last_Called_SE = 0;
            }

            if (tad->quake != 0) {
                g_state.bg_w.quake_y_index = gqdt[tad->quake][1];
                pp_screen_quake(g_state.bg_w.quake_y_index);
            }

            Release_Effect(&ewk->wu);
            break;
        }

        if (tad->status & 8) {
            ewk->wu.disp_flag = 2;
        } else {
            ewk->wu.disp_flag = 1;
        }

        if (tad->status & 0x40) {
            if (((State*)ewk->wu.target_adrs)->work_id == 1) {
                ewk->wu.dir_timer = ((PlayerEntity*)ewk->wu.target_adrs)->player_number;
            } else {
                ewk->wu.dir_timer = ((State_Other*)ewk->wu.target_adrs)->master_player;
            }
        }

        if (tad->col) {
            ewk->wu.my_col_code = hcct[tad->col];
        } else if (tad->status & 0x80) {
            ewk->wu.my_col_code = ((State*)ewk->wu.target_adrs)->my_col_code + 1;
        }

        if (tad->se) {
            Se_Dispatch(tad->se, tad->se, ewk);
            g_state.Last_Called_SE = tad->se;
        } else {
            g_state.Last_Called_SE = 0;
        }

        if (tad->status & 0x10) {
            if (tad->status & 0x20) {
                edt = &explem2[tad->emhix][ewk->wu.dir_timer];
            } else {
                edt = &explem[tad->myhix];
            }

            if (ewk->wu.facing_flag) {
                ewk->wu.xyz[0].disp.pos -= *(s16*)&edt->hx;
            } else {
                ewk->wu.xyz[0].disp.pos += *(s16*)&edt->hx;
            }

            ewk->wu.xyz[1].disp.pos += *(s16*)&edt->hy;
        }

        if (tad->status & 2) {
            ewk->wu.xyz[0].disp.pos += random_16() - 7;
            ewk->wu.xyz[1].disp.pos += (random_16() & 7) - 3;
        }

        ewk->wu.screen_move_x = gqdt[tad->quake][0];
        ewk->wu.screen_move_y = gqdt[tad->quake][1];
        ewk->wu.position_x = ewk->wu.xyz[0].disp.pos;
        ewk->wu.position_y = ewk->wu.xyz[1].disp.pos;
        ewk->wu.position_z = ewk->wu.xyz[2].disp.pos;

        if (tad->status & 0x10) {
            set_char_move_init(&ewk->wu, 0, edt->chix);
        } else {
            ewk->wu.dir_old = 0;

            if (tad->dir) {
                ewk->wu.dir_old = hit_mark_dir_table[ewk->wu.direction];

                if (ewk->wu.dir_old < 0) {
                    ewk->wu.facing_flag = 1;
                    ewk->wu.dir_old = -ewk->wu.dir_old;
                }
            }

            set_char_move_init(&ewk->wu, 0, tad->hits + ewk->wu.dir_old);
        }

        if (ewk->wu.char_index == 75) {
            ewk->wu.mirror_flag = 1;
            ewk->wu.mirror_scale.size.x = 127;
            ewk->wu.mirror_scale.size.y = 63;
            ewk->wu.my_col_code |= (ewk->master_id == 1) * 16;
        }

        if (!g_state.Pause_Hit_Marks) {
            sort_push_request8(&ewk->wu);
        }

        break;

    case 1:
        if (ewk->wu.death_timer == 1 || g_state.Suicide[6] != 0) {
            ewk->wu.disp_flag = 0;
            ewk->wu.routine_no[0]++;
            break;
        }

        if (g_state.Pause_Hit_Marks) {
            break;
        }

        if (g_state.execute_flag == 0 && g_state.Game_pause == 0) {
            char_move(&ewk->wu);

            if (ewk->wu.cg_type == 0xFF) {
                ewk->wu.disp_flag = 0;
                ewk->wu.routine_no[0]++;
                break;
            }

            if (ewk->wu.screen_move_x && --ewk->wu.screen_move_x == 0) {
                g_state.bg_w.quake_y_index = ewk->wu.screen_move_y;
                pp_screen_quake(g_state.bg_w.quake_y_index);
            }
        }

        sort_push_request8(&ewk->wu);
        break;

    case 2:
        ewk->wu.routine_no[0] = 3;
        break;

    default:
        Release_Effect(&ewk->wu);
        break;
    }
}

s32 effect_A7_init(PlayerEntity* wk) {
    State_Other* ewk;
    PlayerEntity* twk;
    s16 ix;

    if (wk->wu.work_id != 1) {
        return -1;
    }

    if ((ix = Acquire_Effect(2)) == -1) {
        return -1;
    }

    ewk = (State_Other*)frw[ix];
    twk = (PlayerEntity*)wk->wu.target_adrs;
    ewk->wu.active_flag = 1;
    ewk->wu.id = 107;
    ewk->wu.work_id = 64;
    ewk->wu.facing_flag = wk->wu.facing_flag;
    ewk->wu.kind_of_hit_mark = wk->wu.hitmark_damage_side;
    ewk->wu.graphic_rom_type = 1;
    ewk->wu.my_col_mode = 0x4200;
    ewk->wu.my_family = 2;
    ewk->wu.mirror_flag = 0;
    ewk->wu.xyz[0].disp.pos = ewk->wu.position_x = wk->wu.xyz[0].disp.pos;
    ewk->wu.xyz[1].disp.pos = ewk->wu.position_y = wk->wu.xyz[1].disp.pos;
    ewk->wu.xyz[2].disp.pos = 26;
    ewk->my_master = wk->wu.target_adrs;
    ewk->master_id = twk->wu.id;
    ewk->master_work_id = twk->wu.work_id;
    ewk->wu.target_adrs = wk;
    ewk->wu.my_col_code = twk->wu.my_col_code + 1;
    ewk->master_player = ewk->wu.dir_timer = twk->player_number;
