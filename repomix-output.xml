#if CPS3
    if (DAT_02016b6c == -1) {
        wk->cp->input_held = processed_lvbt(FUN_06092294(wk->wu.id));
    } else {
        if (wk->wu.pl_operator) {
            wk->cp->input_held = lv_data;
