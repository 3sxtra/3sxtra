                uint32_t u_cur = u_scaled_fwd;
                int remaining = dst_w;
                SWCanvasPixel* d = drow;
                while (remaining > 0) {
                    int chunk = (du_fx == 0) ? remaining : (int)((u_mask_fx - u_cur) / du_fx) + 1;
