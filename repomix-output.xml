void effect_04_move(State_Other* ewk) {
    if (g_state.Menu_Suicide[ewk->master_player]) {
        Release_Effect(&ewk->wu);
        return;
    }

    switch (ewk->wu.routine_no[0]) {
    case 0:
        if (--ewk->wu.dir_timer) {
            break;
        }

        ewk->wu.routine_no[0]++;
        /* fallthrough */

