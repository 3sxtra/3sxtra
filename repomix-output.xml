}

#ma-countdown-bar-fill {
    display: block;
    height: 100%;
    background-color: rgba(100, 255, 100, 200);
}

#ma-countdown-text {
    display: block;
    text-align: center;
    font-size: 11dp;
    color: rgba(200, 200, 200, 180);
    margin-top: 1dp;
}

#ma-buttons {
    display: block;
    text-align: center;
}

#ma-btn-accept, #ma-btn-decline {
    display: inline-block;
    width: 76dp;
    height: 16dp;
    line-height: 16dp;
    text-align: center;
    font-size: 12dp;
