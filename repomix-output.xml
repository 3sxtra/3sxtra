static void animal_init(State_Other* ewk);
static void animal_control(State_Other* ewk);
static void animal_0000(State_Other* ewk);
static void animal_0001(State_Other* ewk);
static void animal_0002(State_Other* ewk);
static void animal_0004(State_Other* ewk);
static void animal_0005(State_Other* ewk);
static void mouse_run_set(State_Other* ewk);
static void mouse_stand_set(State_Other* ewk);
static void cat_run_set(State_Other* ewk);
static void don_run_set(State_Other* ewk);

const s16 animal_0005_tbl[16] = { 40, 50, 160, 70, 80, 100, 30, 200, 340, 10, 110, 18, 40, 60, 30, 150 };

void effect_M0_move(State_Other* ewk) {
    switch (ewk->wu.routine_no[0]) {
    case 0:
        ewk->wu.routine_no[0]++;
        animal_init(ewk);
        break;

    case 1:
        if (!g_state.execute_flag && !g_state.Game_pause) {
            animal_control(ewk);
        }

        disp_pos_trans_entry(ewk);
        break;

    case 99:
        ewk->wu.routine_no[0]++;
        break;

    default:
        all_cgps_put_back(&ewk->wu);
        Release_Effect(&ewk->wu);
        break;
    }
}

static void animal_init(State_Other* ewk) {
    s16 work_l = g_state.bg_w.bgw[1].wxy[0].disp.pos - g_state.bg_w.pos_offset;
    s16 work_r = g_state.bg_w.bgw[1].wxy[0].disp.pos + g_state.bg_w.pos_offset;

    switch (ewk->wu.type) {
    case 0:
        ewk->wu.shadow_flag = 1;
        ewk->wu.shadow_x = -4;
        ewk->wu.shadow_y = 33;
        ewk->wu.shadow_prio = 71;
        ewk->wu.shadow_char = 3;

        if (ewk->wu.facing_flag) {
            ewk->wu.xyz[0].disp.pos = work_l;
            break;
        }

        ewk->wu.xyz[0].disp.pos = work_r;
        break;

    case 2:
        ewk->wu.shadow_flag = 1;
        ewk->wu.shadow_x = -4;
        ewk->wu.shadow_y = 33;
        ewk->wu.shadow_prio = 71;
        ewk->wu.shadow_char = 3;
        ewk->wu.facing_flag ^= 1;
        break;

    case 6:
        if (g_state.plw->player_number == 7) {
            ewk->wu.my_col_code = g_state.plw->wu.my_col_code;
        } else {
            ewk->wu.my_col_code = g_state.plw[1].wu.my_col_code;
        }

        ewk->wu.shadow_flag = 1;
        ewk->wu.shadow_x = -2;
        ewk->wu.shadow_y = 24;
        ewk->wu.shadow_prio = 71;
        ewk->wu.shadow_char = 8;

        if (ewk->wu.facing_flag) {
            ewk->wu.xyz[0].disp.pos = work_l;
            break;
        }

        ewk->wu.xyz[0].disp.pos = work_r;
        break;

    default:
        if (ewk->wu.facing_flag) {
            ewk->wu.xyz[0].disp.pos = work_r;
        } else {
            ewk->wu.xyz[0].disp.pos = work_l;
        }

        ewk->wu.shadow_flag = 1;
        ewk->wu.shadow_x = 0;
        ewk->wu.shadow_y = 33;
        ewk->wu.shadow_prio = 71;
        ewk->wu.shadow_char = 0;
        ewk->wu.facing_flag ^= 1;
        break;
    }
}

static void animal_control(State_Other* ewk) {
    void (*animal_jp[7])(State_Other* ewk) = { animal_0000, animal_0001, animal_0002, animal_0001,
                                              animal_0004, animal_0005, animal_0000 };
    animal_jp[ewk->wu.type](ewk);
}

static void animal_0000(State_Other* ewk) {
    switch (ewk->wu.routine_no[1]) {
    case 0:
        ewk->wu.routine_no[1]++;
        ewk->wu.disp_flag = 1;

        if (ewk->wu.type == 6) {
            ewk->wu.old_routine_no[0] = 10;
            don_run_set(ewk);
            ewk->wu.xyz[1].disp.pos = 24;
        } else {
            ewk->wu.old_routine_no[0] = 60;
            cat_run_set(ewk);
            ewk->wu.xyz[1].disp.pos = 32;
        }

        ewk->wu.my_priority = ewk->wu.position_z = 27;
        break;

    case 1:
        ewk->wu.old_routine_no[0]--;

        if (ewk->wu.old_routine_no[0] <= 0) {
            ewk->wu.routine_no[1]++;
        }

        break;

    case 2:
        add_x_sub(&ewk->wu);
        char_move(&ewk->wu);

        if (!range_x_check3(ewk, 48)) {
            ewk->wu.routine_no[1]++;
        }

        break;

    case 3:
        add_x_sub(&ewk->wu);
        char_move(&ewk->wu);
        ewk->wu.routine_no[0] = 99;
        ewk->wu.routine_no[1]++;
        break;
    }
}

static void animal_0001(State_Other* ewk) {
    switch (ewk->wu.routine_no[1]) {
    case 0:
        ewk->wu.routine_no[1]++;
        ewk->wu.old_routine_no[0] = 30;
        ewk->wu.disp_flag = 1;
        mouse_run_set(ewk);
        ewk->wu.xyz[1].disp.pos = 32;
        ewk->wu.my_priority = ewk->wu.position_z = 27;
        break;

    case 1:
        ewk->wu.old_routine_no[0]--;

        if (ewk->wu.old_routine_no[0] <= 0) {
            ewk->wu.routine_no[1]++;
        }

        break;

    case 2:
        add_x_sub(&ewk->wu);
        char_move(&ewk->wu);

        if (!range_x_check3(ewk, 32)) {
            ewk->wu.routine_no[0] = 99;
            ewk->wu.routine_no[1]++;
        }

        break;
    }
}

static void animal_0002(State_Other* ewk) {
    switch (ewk->wu.routine_no[1]) {
    case 0:
        ewk->wu.routine_no[1]++;
        ewk->wu.disp_flag = 1;
        set_char_move_init(&ewk->wu, 0, 47);
        ewk->wu.xyz[0].disp.pos = g_state.bg_w.bgw[1].wxy[0].disp.pos;
        ewk->wu.xyz[1].disp.pos = 32;
        ewk->wu.my_priority = ewk->wu.position_z = 27;
        break;

    case 1:
        char_move(&ewk->wu);

        if (ewk->wu.cg_type == 0xFF) {
            ewk->wu.routine_no[1]++;
            ewk->wu.facing_flag ^= 1;
            cat_run_set(ewk);
        }

        break;

    case 2:
        add_x_sub(&ewk->wu);
        char_move(&ewk->wu);

        if (!range_x_check3(ewk, 32)) {
