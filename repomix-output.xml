<file path="assets/ui/dev_overlay.rcss">
/* Dev overlay stylesheet — 3SXtra RmlUi developer tool */

body {
    width: 100%;
    height: 100%;
    /* No background — let mouse events pass through to the game */
}

#dev-panel {
    display: block;
    position: absolute;
    width: 50%;
    max-height: 95%;
    top: 1%;
    left: auto;
    right: 1%;
    background-color: rgba(12, 12, 18, 245);
    border-width: 1dp;
    border-color: #2a6af0;
    border-radius: 6dp;
    padding: 6dp 8dp;
    overflow-y: auto;
}

/* Drag handle */
#dev-panel handle {
    display: block;
    cursor: move;
    padding: 4dp 0;
    border-bottom-width: 1dp;
    border-bottom-color: #222240;
    margin-bottom: 4dp;
}

#dev-panel handle:hover {
    background-color: #1a1a30;
    border-radius: 4dp 4dp 0 0;
}

/* Title */
#dev-panel h1 {
    font-size: 15dp;
    color: #4a9eff;
    margin-bottom: 2dp;
    text-align: center;
    white-space: nowrap;
}

/* Section headers */
h2 {
    font-size: 12dp;
    color: #6a6a80;
    margin-top: 2dp;
    margin-bottom: 2dp;
    text-transform: uppercase;
    letter-spacing: 1dp;
}

h3 {
    font-size: 11dp;
    color: #4a9eff;
    margin-top: 2dp;
    margin-bottom: 1dp;
    text-transform: uppercase;
    letter-spacing: 0.5dp;
}

/* Dividers */
.divider {
    display: block;
    height: 1dp;
    background-color: #222240;
    margin-top: 4dp;
    margin-bottom: 4dp;
}

/* Section */
.section {
    display: block;
    margin-bottom: 2dp;
}

.section-header {
    display: block;
}

.section-header h2 {
    display: inline-block;
}

.section-header .btn-sm {
    display: inline-block;
    float: right;
    padding: 2dp 8dp;
    font-size: 14dp;
    background-color: #1a1a2a;
    border-width: 1dp;
    border-color: #444;
    border-radius: 3dp;
    color: #cccccc;
    cursor: pointer;
}

.section-header .btn-sm:hover {
    border-color: #4a9eff;
    color: #4a9eff;
}

/* ─── Document list ─── */

.doc-list {
    display: block;
    max-height: 80dp;
    overflow-y: auto;
}

.doc-item {
    display: block;
    padding: 2dp 6dp;
    font-size: 12dp;
    color: #bbb;
    cursor: pointer;
    border-radius: 3dp;
}

.doc-item:hover {
    background-color: #1a1a30;
}

.doc-item.doc-selected {
    background-color: #1a2a50;
    color: #4a9eff;
    border-width: 0 0 0 2dp;
    border-color: #4a9eff;
}

.doc-item.doc-hidden {
    color: #888;
}

.doc-ctx {
    display: inline-block;
    font-size: 13dp;
    color: #666;
    min-width: 50dp;
}

.doc-name {
    display: inline-block;
}

.doc-vis {
    display: inline-block;
    font-size: 13dp;
    color: #44cc44;
    margin-left: 6dp;
}

.doc-vis-off {
    display: inline-block;
    font-size: 13dp;
    color: #444;
    margin-left: 6dp;
}

/* ─── Element list ─── */

.elem-list {
    display: block;
    max-height: 120dp;
    overflow-y: auto;
}

.elem-item {
    display: block;
    padding: 1dp 4dp;
    font-size: 12dp;
    color: #999;
    cursor: pointer;
    border-radius: 2dp;
}

.elem-item:hover {
    background-color: #181830;
    color: #e0e0e0;
}

.elem-item.elem-selected {
    background-color: #1a2a50;
    color: #4af0ff;
}

/* ─── Inspector ─── */

.elem-breadcrumb {
    font-size: 14dp;
    color: #4af0ff;
    margin-bottom: 4dp;
    display: block;
}

/* Control rows */
.control-row {
    display: block;
    padding: 2dp 0;
}

label {
    display: inline-block;
    font-size: 12dp;
    color: #999;
    min-width: 40dp;
}

input.text {
    display: inline-block;
    width: 80dp;
    padding: 1dp 4dp;
    background-color: #0f0f1a;
    border-width: 1dp;
    border-color: #333;
    border-radius: 2dp;
    color: #ddd;
    font-size: 12dp;
    margin-left: 2dp;
}

input.text:focus {
    border-color: #4a9eff;
}

/* Range slider value display */
.value-display {
    display: inline-block;
    font-size: 13dp;
    color: #4a9eff;
    margin-left: 4dp;
    min-width: 30dp;
}

/* ─── Range slider ─── */

input.range {
    display: inline-block;
    width: 90dp;
    height: 12dp;
    margin-left: 2dp;
    vertical-align: middle;
}

input.range slidertrack {
    height: 4dp;
    margin-top: 6dp;
    background-color: #1a1a2a;
    border-radius: 2dp;
}

input.range sliderbar {
    width: 10dp;
    height: 14dp;
    margin-top: 1dp;
    background-color: #4a6aaa;
    border-radius: 3dp;
}

input.range sliderbar:hover {
    background-color: #4a9eff;
}

input.range sliderbar:active {
    background-color: #6ab0ff;
}

input.range sliderarrowdec,
input.range sliderarrowinc {
    width: 0;
    height: 0;
}

/* ─── Checkbox ─── */

input.checkbox {
    display: inline-block;
    width: 14dp;
    height: 14dp;
    background-color: #1a1a2a;
    border-width: 1dp;
    border-color: #444;
    border-radius: 3dp;
    margin-right: 4dp;
    vertical-align: middle;
}

input.checkbox:hover {
    border-color: #4a9eff;
}

input.checkbox:checked {
    background-color: #2a4a80;
    border-color: #4a9eff;
    /* RmlUi renders a checkmark decorator when :checked */
}

/* ─── Info panel (read-only) ─── */

.info-row {
    display: block;
    padding: 1dp 0;
}

.info-label {
    display: inline-block;
    font-size: 13dp;
    color: #666;
    min-width: 55dp;
}

.info-value {
    display: inline-block;
    font-size: 14dp;
    color: #cccccc;
}

.info-accent {
    color: #4af0ff;
}
/* ─── Buttons ─── */

.button-row {
    display: block;
    margin-top: 4dp;
}

button {
    display: inline-block;
    padding: 3dp 8dp;
    background-color: #1a1a2a;
    border-width: 1dp;
    border-color: #444;
    border-radius: 3dp;
    color: #e0e0e0;
    font-size: 12dp;
    cursor: pointer;
    margin-right: 6dp;
}

button:hover {
    background-color: #252540;
    border-color: #4a9eff;
}

button:active {
    background-color: #111;
}

.btn-accent {
    border-color: #4a9eff;
    color: #4a9eff;
}

.btn-accent:hover {
    background-color: #1a2a50;
}

.no-selection {
    display: block;
    padding: 20dp;
    text-align: center;
}

/* Status/hint text */
.status-hint {
    color: #444;
    font-size: 14dp;
    display: block;
    text-align: center;
    padding: 8dp;
}

.hint {
    font-size: 13dp;
    color: #333;
    margin-top: 4dp;
    text-align: center;
}

/* Scrollbar */
#dev-panel scrollbarvertical {
    width: 6dp;
}

#dev-panel scrollbarvertical sliderbar {
    background-color: #333;
    border-radius: 3dp;
}

#dev-panel scrollbarvertical sliderbar:hover {
    background-color: #4a9eff;
}

#dev-panel scrollbarvertical slidertrack {
    background-color: #111;
}

.doc-list scrollbarvertical,
.elem-list scrollbarvertical {
    width: 4dp;
}

.doc-list scrollbarvertical sliderbar,
.elem-list scrollbarvertical sliderbar {
    background-color: #2a2a40;
    border-radius: 2dp;
}
</file>

<file path="assets/ui/dev_overlay.rml">
<rml>
<head>
    <title>Dev Overlay</title>
    <link type="text/rcss" href="base.rcss"/>
    <link type="text/rcss" href="dev_overlay.rcss"/>
</head>
<body data-model="dev_overlay">
    <div id="dev-panel">
        <handle move_target="dev-panel">
            <h1>🔧 DEV OVERLAY (F9)</h1>
        </handle>
        <div class="divider"></div>

        <!-- Document list -->
        <div class="section">
            <div class="section-header">
                <h2>DOCUMENTS</h2>
                <button class="btn-sm" data-event-click="refresh_docs">Refresh</button>
            </div>
            <div class="doc-list" data-if="doc_count > 0">
                <div data-for="doc : doc_list"
                     class="doc-item"
                     data-class-doc-selected="selected_doc == doc.index"
                     data-class-doc-hidden="!doc.visible"
                     data-event-click="select_doc(doc.index)">
                    <span class="doc-ctx">{{doc.context_label}}</span>
                    <span class="doc-name">{{doc.name}}</span>
                    <span class="doc-vis" data-if="doc.visible">[ON]</span>
                    <span class="doc-vis-off" data-if="!doc.visible">[--]</span>
                </div>
            </div>
            <p class="status-hint" data-if="doc_count == 0">No documents loaded. Click Refresh.</p>
        </div>

        <div class="divider"></div>

        <!-- Element tree -->
        <div class="section">
            <h2>ELEMENT TREE</h2>
            <div class="elem-list" data-if="elem_count > 0">
                <div data-for="el : elem_list"
                     data-if="el.index < elem_count"
                     class="elem-item"
                     data-class-elem-selected="selected_elem == el.index"
                     data-event-click="select_elem(el.index)"
                     data-style-padding-left="(el.depth * 12) + 'dp'">
                    {{el.label}}
                </div>
            </div>
            <p class="status-hint" data-if="elem_count == 0">Select a document above.</p>
        </div>

        <div class="divider"></div>

        <!-- Property inspector -->
        <div class="section" data-if="has_selection">
            <h2>INSPECTOR</h2>
            <p class="elem-breadcrumb">{{sel_path}}</p>

            <!-- Visibility toggle -->
            <div class="control-row">
                <input type="checkbox" data-checked="sel_visible"/>
                <label>Visible</label>
            </div>

            <div class="divider"></div>

            <!-- Display & Position -->
            <h3>Layout</h3>
            <div class="control-row">
                <label>Display</label>
                <input type="text" data-value="sel_display"/>
            </div>
            <div class="control-row">
                <label>Position</label>
                <input type="text" data-value="sel_position"/>
            </div>
            <div class="control-row">
                <label>Top</label>
                <input type="text" data-value="sel_top"/>
            </div>
            <div class="control-row">
                <label>Right</label>
                <input type="text" data-value="sel_right"/>
            </div>
            <div class="control-row">
                <label>Bottom</label>
                <input type="text" data-value="sel_bottom"/>
            </div>
            <div class="control-row">
                <label>Left</label>
                <input type="text" data-value="sel_left"/>
            </div>

            <div class="divider"></div>

            <!-- Margins -->
            <h3>Margin</h3>
            <div class="control-row">
                <label>Top</label>
                <input type="range" min="-200" max="200" step="1" data-value="sel_margin_top"/>
                <span class="value-display">{{sel_margin_top}}</span>
            </div>
            <div class="control-row">
                <label>Right</label>
                <input type="range" min="-200" max="200" step="1" data-value="sel_margin_right"/>
                <span class="value-display">{{sel_margin_right}}</span>
            </div>
            <div class="control-row">
                <label>Bottom</label>
                <input type="range" min="-200" max="200" step="1" data-value="sel_margin_bottom"/>
                <span class="value-display">{{sel_margin_bottom}}</span>
            </div>
            <div class="control-row">
                <label>Left</label>
                <input type="range" min="-200" max="200" step="1" data-value="sel_margin_left"/>
                <span class="value-display">{{sel_margin_left}}</span>
            </div>

            <div class="divider"></div>

            <!-- Padding -->
            <h3>Padding</h3>
            <div class="control-row">
                <label>Top</label>
                <input type="range" min="0" max="100" step="1" data-value="sel_padding_top"/>
                <span class="value-display">{{sel_padding_top}}</span>
            </div>
            <div class="control-row">
                <label>Right</label>
                <input type="range" min="0" max="100" step="1" data-value="sel_padding_right"/>
                <span class="value-display">{{sel_padding_right}}</span>
            </div>
            <div class="control-row">
                <label>Bottom</label>
                <input type="range" min="0" max="100" step="1" data-value="sel_padding_bottom"/>
                <span class="value-display">{{sel_padding_bottom}}</span>
            </div>
            <div class="control-row">
                <label>Left</label>
                <input type="range" min="0" max="100" step="1" data-value="sel_padding_left"/>
                <span class="value-display">{{sel_padding_left}}</span>
            </div>

            <div class="divider"></div>

            <!-- Size -->
            <h3>Size</h3>
            <div class="control-row">
                <label>Width</label>
                <input type="text" data-value="sel_width"/>
            </div>
            <div class="control-row">
                <label>Height</label>
                <input type="text" data-value="sel_height"/>
            </div>

            <div class="divider"></div>

            <!-- Border -->
            <h3>Border</h3>
            <div class="control-row">
                <label>Width</label>
                <input type="range" min="0" max="10" step="1" data-value="sel_border_width"/>
                <span class="value-display">{{sel_border_width}}</span>
            </div>
            <div class="control-row">
                <label>Color</label>
                <input type="text" data-value="sel_border_color"/>
            </div>
            <div class="control-row">
                <label>Radius</label>
                <input type="range" min="0" max="50" step="1" data-value="sel_border_radius"/>
                <span class="value-display">{{sel_border_radius}}</span>
            </div>

            <div class="divider"></div>

            <!-- Background -->
            <h3>Background</h3>
            <div class="control-row">
                <label>Color</label>
                <input type="text" data-value="sel_bg_color"/>
            </div>

            <div class="divider"></div>

            <!-- Typography -->
            <h3>Typography</h3>
            <div class="control-row">
                <label>Font Size</label>
                <input type="range" min="6" max="80" step="1" data-value="sel_font_size"/>
                <span class="value-display">{{sel_font_size}}</span>
            </div>
            <div class="control-row">
                <label>Color</label>
                <input type="text" data-value="sel_color"/>
            </div>
            <div class="control-row">
                <label>Opacity</label>
                <input type="range" min="0" max="1" step="0.05" data-value="sel_opacity"/>
                <span class="value-display">{{sel_opacity}}</span>
            </div>

            <div class="divider"></div>

            <!-- Text -->
            <h3>Text</h3>
            <div class="control-row">
                <label>Align</label>
                <input type="text" data-value="sel_text_align"/>
            </div>
            <div class="control-row">
                <label>Line Ht</label>
                <input type="range" min="8" max="60" step="1" data-value="sel_line_height"/>
                <span class="value-display">{{sel_line_height}}</span>
            </div>
            <div class="control-row">
                <label>Spacing</label>
                <input type="range" min="-5" max="20" step="1" data-value="sel_letter_spacing"/>
                <span class="value-display">{{sel_letter_spacing}}</span>
            </div>

            <div class="divider"></div>

            <!-- Flex -->
            <h3>Flex</h3>
            <div class="control-row">
                <label>Direction</label>
                <input type="text" data-value="sel_flex_direction"/>
            </div>
            <div class="control-row">
                <label>Justify</label>
                <input type="text" data-value="sel_justify_content"/>
            </div>
            <div class="control-row">
                <label>Align</label>
                <input type="text" data-value="sel_align_items"/>
            </div>
            <div class="control-row">
                <label>Gap</label>
                <input type="range" min="0" max="50" step="1" data-value="sel_gap"/>
                <span class="value-display">{{sel_gap}}</span>
            </div>

            <div class="divider"></div>

            <!-- Overflow -->
            <h3>Overflow</h3>
            <div class="control-row">
                <label>Mode</label>
                <input type="text" data-value="sel_overflow"/>
            </div>

            <div class="divider"></div>

            <!-- Computed Info (read-only) -->
            <h3>Info</h3>
            <div class="info-row">
                <span class="info-label">Tag</span>
                <span class="info-value">{{info_tag}}</span>
            </div>
            <div class="info-row" data-if="info_id != ''">
                <span class="info-label">ID</span>
                <span class="info-value info-accent">{{info_id}}</span>
            </div>
            <div class="info-row" data-if="info_classes != ''">
                <span class="info-label">Classes</span>
                <span class="info-value">{{info_classes}}</span>
            </div>
            <div class="info-row">
                <span class="info-label">Box</span>
                <span class="info-value">{{info_box}}</span>
            </div>
            <div class="info-row">
                <span class="info-label">Children</span>
                <span class="info-value">{{info_children}}</span>
            </div>
            <div class="info-row" data-if="info_source != ''">
                <span class="info-label">Source</span>
                <span class="info-value">{{info_source}}</span>
            </div>

            <div class="divider"></div>

            <!-- Actions -->
            <div class="button-row">
                <button data-event-click="reset_elem">Reset</button>
                <button class="btn-accent" data-event-click="copy_rcss">📋 Copy RCSS</button>
            </div>
        </div>

        <div data-if="!has_selection" class="no-selection">
            <p class="status-hint">Select an element to inspect.</p>
        </div>

        <div class="divider"></div>
        <p class="hint">Drag header to move • Press F9 to close</p>
    </div>
</body>
</rml>
</file>

