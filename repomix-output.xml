}

/* ─── Section headers ────────────────────────────────────────── */

.section-header {
    display: block;
    font-size: 9dp;
    color: rgba(170, 200, 255, 170);
    padding: 0dp 0dp;
    margin-top: 2dp;
    margin-bottom: 2dp;
