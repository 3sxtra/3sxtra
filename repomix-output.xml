--- Build an empty FBNeo-format input table
local function make_fbneo_input()
   local input = {}
   for _, btn in ipairs(FBNEO_BUTTONS) do
      input["P1 " .. btn] = false
      input["P2 " .. btn] = false
   end
   return input
