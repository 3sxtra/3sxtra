/**
 * @file efff8.c
 * Effect: Paring Mark B Effect
 */

#include "sf33rd/Source/Game/effect/effect_f8_paring_mark_b.h"
#include "game_state.h"
#include "bin2obj/char_table.h"
#include "common.h"
#include "sf33rd/Source/Game/effect/effect.h"
#include "sf33rd/Source/Game/engine/charset.h"
#include "sf33rd/Source/Game/engine/slow_motion.h"
#include "sf33rd/Source/Game/engine/state_user.h"
#include "sf33rd/Source/Game/rendering/sprite_utilities.h"

// forward declaration

const s16 paring_b_mark_data[3][20][2];

void effect_F8_move(State_Other* ewk) {
    State* mwk = (State*)ewk->my_master;

    switch (ewk->wu.routine_no[0]) {
    case 0:
        ewk->wu.routine_no[0] += 1;
        ewk->wu.disp_flag = 1;
        ewk->wu.xyz[2].disp.pos = 26;
        ewk->wu.next_z = mwk->position_z;
        if (mwk->facing_flag) {
            ewk->wu.position_x = mwk->position_x + paring_b_mark_data[ewk->wu.direction][ewk->master_player][0];
        } else {
            ewk->wu.position_x = mwk->position_x - paring_b_mark_data[ewk->wu.direction][ewk->master_player][0];
        }

        ewk->wu.position_y = mwk->position_y + paring_b_mark_data[ewk->wu.direction][ewk->master_player][1];
        if (ewk->wu.position_z == ewk->wu.xyz[2].disp.pos) {
            ewk->wu.position_z = ewk->wu.next_z;
        } else {
            ewk->wu.position_z = ewk->wu.xyz[2].disp.pos;
        }

        set_char_move_init(&ewk->wu, 0, 3);
        sort_push_request(&ewk->wu);
        return;

    case 1:
        if ((ewk->wu.death_timer == 1) || (g_state.Suicide[0] != 0)) {
            ewk->wu.disp_flag = 0;
            ewk->wu.routine_no[0] += 1;
            return;
        }

        if ((g_state.execute_flag == 0) && (g_state.Game_pause == 0)) {
            char_move(&ewk->wu);
            if (ewk->wu.cg_type == 0xFF) {
                ewk->wu.disp_flag = 0;
                ewk->wu.routine_no[0] += 1;
                return;
            }
        }

        sort_push_request(&ewk->wu);
        return;

    case 2:
        ewk->wu.routine_no[0] = 3;
        return;

    default:
        Release_Effect(&ewk->wu);
        return;
    }
}

s32 effect_F8_init(PlayerEntity* wk, u8 data) {
    State_Other* ewk;
    s16 ix;

    if ((ix = Acquire_Effect(2)) == -1) {
        return -1;
    }

    ewk = (State_Other*)frw[ix];
    ewk->wu.active_flag = 1;
    ewk->wu.id = 158;
    ewk->wu.work_id = 64;
    ewk->wu.facing_flag = wk->wu.facing_flag;
    ewk->wu.direction = data;
    ewk->wu.my_sprite_sheet = 14;
    ewk->wu.my_col_mode = 0x4200;
    ewk->wu.my_col_code = 0x2020;
    ewk->wu.my_family = wk->wu.my_family;
    ewk->my_master = wk;
    ewk->master_id = wk->wu.id;
    ewk->master_work_id = wk->wu.work_id;
    ewk->master_player = wk->player_number;
    ewk->wu.char_table[0] = _ef01_char_table;
    return 0;
}

