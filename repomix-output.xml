    s16 i;

    for (i = 0; i < 0x18; i++) {
        if (pto_list[ix][i]) {
            Free_Texture_Cache(i);
        }
    }
}

/** @brief Create texture cache entries according to the MTO list. */
void Allocate_Texture_Cache_List(s16 ix) {
    s16 i;

    for (i = 0; i < 0x18; i++) {
        if (mto_list[ix][i]) {
            Allocate_Texture_Cache(TM_num[i]);
        }
    }
}
