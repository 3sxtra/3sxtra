<file path="src/sf33rd/Source/Game/sound/sound_effect_data.h">
/**
 * @file sound_effect_data.h
 * @brief Sound effect dispatch table types and API.
 *
 * Declares the SeHandlerType enum-tag lookup table that maps each SE code
 * (0–1023) to its handler type (Shock, Myself, Let, etc.), and the
 * Se_Dispatch() function that provides a single typed entry point for
 * all sound effect requests.
 *
 * Part of the sound module.
 * Originally from the PS2 game module.
 */

#ifndef SOUND_EFFECT_DATA_H
#define SOUND_EFFECT_DATA_H

#include "structs.h"
#include "types.h"

/**
 * @brief Handler type tags for sound effect dispatch.
 *
 * Each SE code in the range [0, 1023] maps to one of these handler types.
 * The Se_Dispatch() function uses this tag to call the correct handler.
 */
typedef enum SeHandlerType {
    SOUND_EFFECTS_HANDLER_CALL_SE = 0,    /**< Generic SE — plays at caller's screen position */
    SOUND_EFFECTS_HANDLER_SHOCK = 1,      /**< Hit/shock SE — switches to KO variant if dead  */
    SOUND_EFFECTS_HANDLER_MYSELF = 2,     /**< Play SE on caller's own player channel          */
    SOUND_EFFECTS_HANDLER_MYSELF_DIE = 3, /**< Like MYSELF but only if character is alive      */
    SOUND_EFFECTS_HANDLER_LET = 4,        /**< Play SE on the target's channel (hit reaction)  */
    SOUND_EFFECTS_HANDLER_LET_SP = 5,     /**< Like LET with KO hit override codes             */
    SOUND_EFFECTS_HANDLER_TERM = 6,       /**< Termination SE — airborne + alive gate          */
    SOUND_EFFECTS_HANDLER_DUMMY = 7       /**< Dummy — stores code for debug, plays nothing    */
} SeHandlerType;

#define SE_DISPATCH_TABLE_SIZE 1024

/** @brief The handler-type lookup table (indexed by SE code). */
extern const SeHandlerType se_handler_type[SE_DISPATCH_TABLE_SIZE];

/**
 * @brief Dispatch a sound effect request to the correct handler.
 *
 * Replaces the legacy pattern:
 *   sound_effect_request[index](ewk, code);
 * with:
 *   Se_Dispatch(index, code, ewk);
 *
 * @param index Handler-type table index (0–1023). Selects which handler
 *              (Se_Shock, Se_Myself, Se_Let, etc.) to call.
 * @param code  Sound code passed through to the handler. Often equals
 *              index, but may differ (e.g. metamorphosis offset, or
 *              filtered SE code from check_xcopy_filter_se_req()).
 * @param ewk   Pointer to the requesting entity's work struct.
 */
void Se_Dispatch(u16 index, u16 code, State_Other* ewk);

#endif
</file>

<file path="src/sf33rd/Source/Game/sound/sound_effects.c">
/**
 * @file sound_effects.c
 * @brief Sound effect and BGM request handlers.
 *
 * Provides the per-character SE dispatch (Se_Shock, Se_Myself, Se_Let, etc.),
 * stage BGM selection, position-based stereo panning, and the debug sound code
 * overlay. All SE functions ultimately call SsRequestPan() in sound3rd.c.
 *
 * Part of the sound module.
 * Originally from the PS2 game module.
 */

#include "sf33rd/Source/Game/sound/sound_effects.h"
#include "game_state.h"
#include "common.h"
#include "port/I_System.h"
#include "sf33rd/AcrSDK/ps2/flps2debug.h"
#include "sf33rd/Source/Game/animation/appear.h"
#include "sf33rd/Source/Game/debug/Debug.h"
#include "sf33rd/Source/Game/engine/player_control.h"
#include "sf33rd/Source/Game/engine/state_user.h"
#include "sf33rd/Source/Game/sound/sound_effect_data.h"
#include "sf33rd/Source/Game/sound/sound3rd.h"
#include "sf33rd/Source/Game/stage/stage_subroutines.h"
#include "sf33rd/Source/Game/system/work_sys.h"
#include "structs.h"
#include "port/sound/modded_bgm.h"

#define SDEB_SIZE 8
#define BGM_STAGE_DATA_SIZE 22
#define SE_PLAYER_OFFSET 0x300 /* Per-player SE code stride (P1 base, P1 + 0x300 = P2) */

u8 gSeqStatus[1];
SoundPatch sdeb[SDEB_SIZE];

s16 bgm_selector_arranged[8] = { 0, 1, 2, 1, 2, 1, 2, 1 };
s16 bgm_selector_arcade[8] = { 0, 1, 0, 1, 0, 1, 0, 1 };
s16* bgm_selector[2] = { bgm_selector_arranged, bgm_selector_arcade };

const u16 BGM_Stage_Data[22] = { 46, 1, 13, 34, 31, 4, 7, 16, 25, 28, 34, 1, 28, 43, 22, 10, 19, 40, 4, 37, 61, 62 };
const s16 SE_Shock_Data[7] = { 285, 286, 287, 288, 289, 305, 306 };
const s16 Finish_SE_Data[2][7] = { { 305, 306, 285, 286, 287, 288, 272 }, { 292, 293, 290, 291, 287, 288, 272 } };

/** @brief Select and play BGM for the given stage and round. */
void Stage_BGM(u16 Stage_Number, u16 Round_Number) {
    u16 code;

    if (Stage_Number >= BGM_STAGE_DATA_SIZE) {
        return;
    }

    if (g_state.Mode_Type == MODE_ARCADE && g_state.Play_Type == 0 && g_state.My_char[g_state.COM_id] == 17 &&
        g_state.Bonus_Game_Flag == 0) {
        code = BGM_Stage_Data[17] + bgm_selector[sys_w.bgm_type][Round_Number & 7];
    } else {
        code = BGM_Stage_Data[Stage_Number] + bgm_selector[sys_w.bgm_type][Round_Number & 7];
    }

    *gSeqStatus = 0;

    if (code == 0x2E && gill_appear_check() == 0) {
        Go_BGM();
        return;
    }

    I_Log("[%s] Stage_BGM: stage=%u round=%u bgm_type=%d → code=%u",
          ModdedBGM_GetGameStateString(),
          Stage_Number,
          Round_Number,
          sys_w.bgm_type,
          code);
    SsRequest(code);
}

/** @brief Play a sound effect by code (no panning). */
void Sound_SE(s16 Code) {
    SsRequest(Code);
}

/** @brief Request BGM playback by code (no panning). */
void BGM_Request(s16 Code) {
    SsRequest(Code);
}

/** @brief Request BGM playback with current-code collision check. */
void BGM_Request_Code_Check(u16 Code) {
    SsRequest_CC(Code);
}

/** @brief Stop background music. */
void BGM_Stop() {
    SsBgmOff();
}

/** @brief Kill all active sound effects. */
void SE_All_Off() {
    spu_all_off();
}

/** @brief Dummy SE handler — stores code for debug display but plays nothing. */
void Se_Dummy(State_Other* ewk, u16 Code) {
    SoundRequestData rmc;

    rmc.ptix = 0;
    rmc.bank = 0;
    rmc.port = 0;
    rmc.code = 0;

    Store_Sound_Code(Code, &rmc);
}

/** @brief Shock/hit SE — switches to KO variant if target is dead. */
void Se_Shock(State_Other* ewk, u16 Code) {
    PlayerEntity* em;
    s16 xx;
    s16 zz;
    s16 uid;

    s16 assign1;

    if (ewk->wu.work_id == 1) {
        em = (PlayerEntity*)ewk->wu.target_adrs;
        uid = ewk->wu.id;
    } else {
        em = (PlayerEntity*)((PlayerEntity*)ewk->my_master)->wu.target_adrs;
        uid = ewk->master_id;
    }

    if (em->wu.work_id == 1 && em->wu.vital_new < 0) {
        for (xx = 0, assign1 = zz = 0x27; xx < 7; xx++) {
            if (Code == SE_Shock_Data[xx]) {
                zz = 0;
                break;
            }
        }
        Code += zz;
    }

    if (Code) {
        Code += uid * SE_PLAYER_OFFSET;
    }

    xx = Get_Position((PlayerEntity*)ewk);
    SsRequestPan(Code, xx, xx, 0, 2);
}

/** @brief Play SE from the caller's own player channel. */
void Se_Myself(State_Other* ewk, u16 Code) {
    s16 xx;
    s16 uid = ewk->wu.id;

    if ((ewk->wu.work_id == 1) || (uid = (ewk->master_id), uid < 2)) {
        if (Code) {
            Code += uid * SE_PLAYER_OFFSET;
        }

        xx = Get_Position((PlayerEntity*)ewk);
        SsRequestPan(Code, xx, xx, 0, 2);
    }
}

/** @brief Like Se_Myself but only plays when the character is alive. */
void Se_Myself_Die(State_Other* ewk, u16 Code) {
    s16 xx;

    if ((ewk->wu.work_id == 1) && (ewk->wu.vital_new >= 0)) {
        if (Code) {
            Code += ewk->wu.id * SE_PLAYER_OFFSET;
        }
        xx = Get_Position((PlayerEntity*)ewk);
        SsRequestPan(Code, xx, xx, 0, 2);
    }
}

/** @brief Play SE on the target's channel (hit reaction). */
void Se_Let(State_Other* ewk, u16 Code) {
    s16 xx;
    s16 uid;

    if (ewk->wu.work_id == 1) {
        uid = ewk->wu.id;
    } else {
        uid = ewk->master_id;
    }

    if (Code) {
        Code += uid * SE_PLAYER_OFFSET;
    }

    xx = Get_Position((PlayerEntity*)ewk);
    SsRequestPan(Code, xx, xx, 0, 2);
}

/** @brief Like Se_Let with special override codes for KO hits. */
void Se_Let_SP(State_Other* ewk, u16 Code) {
    PlayerEntity* em;
    s16 xx;
    s16 uid;

    if (ewk->wu.work_id == 1) {
        uid = ewk->wu.id;
    } else {
        uid = ewk->master_id;
    }

    em = (PlayerEntity*)ewk->wu.target_adrs;

    if ((em->wu.work_id == 1) && (em->wu.vital_new < 0)) {
        if (Code == 0x14B) {
            Code = 0x158;
        }
        if (Code == 0x13A) {
            Code = 0x15A;
        }
    }

    if (Code) {
        Code += uid * SE_PLAYER_OFFSET;
    }

    xx = Get_Position((PlayerEntity*)ewk);
    SsRequestPan(Code, xx, xx, 0, 2);
}

/** @brief Generic SE call — plays at the caller's screen position. */
void Call_Se(State_Other* ewk, u16 Code) {
    s16 xx;

    xx = Get_Position((PlayerEntity*)ewk);
    SsRequestPan(Code, xx, xx, 0, 2);
}

/** @brief Termination SE — only plays if character is airborne and alive. */
void Se_Term(State_Other* ewk, u16 Code) {
    s16 xx;

    if (ewk->wu.work_id != 1) {
        return;
    }

    if ((ewk->wu.mvxy.a[1].sp < 0) && (ewk->wu.xyz[1].disp.pos <= 64)) {
        return;
    }

    if (Code) {
        Code += ewk->wu.id * SE_PLAYER_OFFSET;
    }

    xx = Get_Position((PlayerEntity*)ewk);
    SsRequestPan(Code, xx, xx, 0, 2);
}

/** @brief Play the round-finish sound effect based on the last hit. */
void Finish_SE() {
    PlayerEntity* wk;
    s16 xx;
    s16 Code;

    Code = Check_Finish_SE();

    if (Code == -1) {
        return;
    }

    wk = &g_state.plw[g_state.Winner_id];

    if (Code) {
        Code += (wk->wu.id * SE_PLAYER_OFFSET);
    }

    xx = Get_Position(wk);
    SsRequestPan(Code, xx, xx, 0, 2);
}

/** @brief Look up the finish SE code from the last-called SE. Returns -1 if none. */
s32 Check_Finish_SE() {
    s16 xx;

    for (xx = 0; xx < 7; xx++) {
        if (g_state.Last_Called_SE == Finish_SE_Data[0][xx]) {
            return Finish_SE_Data[1][xx];
        }
    }

    return -1;
}

/** @brief Calculate stereo pan position (0x10–0x70) for a player on screen. */
u16 Get_Position(PlayerEntity* wk) {
    u16 xx;
    u16 yy;

    xx = get_center_position();
    xx -= 0xC0;
    xx = wk->wu.position_x - xx;
    xx /= 4;
    xx += 16;

    if (xx < 0x70) {
        return xx;
    }

    yy = get_center_position();

    if (yy > wk->wu.position_x) {
        return 0x10;
    }

    return 0x70;
}

/** @brief Push a sound code into the 8-deep debug ring buffer. */
void Store_Sound_Code(u16 code, SoundRequestData* rmc) {
    s16 i;

    for (i = 7; i > 0; i--) {
        sdeb[i] = sdeb[i - 1];
    }

    sdeb->cp3code = code;
    sdeb->rmc = *rmc;
}

/** @brief Render the debug sound code overlay (enabled by Debug_w[DEBUG_SOUND_CODE_DISP]). */
void Disp_Sound_Code() {
    s16 i;

    if (Debug_w[DEBUG_SOUND_CODE_DISP] == 0) {
        return;
    }

    flPrintColor(0xFFFFFFFF);

    for (i = 0; i < SDEB_SIZE; i++) {
        flPrintL(2, i * 2 + 11, "%3X", sdeb[i].cp3code);
        flPrintL(50, i * 2 + 11, "%2X", sdeb[i].rmc.ptix);
        flPrintL(53, i * 2 + 11, "%2X", sdeb[i].rmc.bank);
        flPrintL(56, i * 2 + 11, "%2X", sdeb[i].rmc.port);
        flPrintL(59, i * 2 + 11, "%3X", sdeb[i].rmc.code);
    }

    flPrintColor(0xFFFFFF8F);
    flPrintL(2, 9, "CODE  KDCM PORT BKCD PRIO VOL  POS  PICH NEXT   PX BK PO CODE");
}
</file>

