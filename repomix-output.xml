            out_room->players[0].display_name, Identity_GetDisplayName(), sizeof(out_room->players[0].display_name));
    }
    SDL_Log("[LobbyServer] Tournament room created: %s (format=%d, max=%d)",
            out_room ? out_room->id : "?",
            (int)format,
            max_players);
    return true;
}

