void Setup_Command_01(PlayerEntity* wk) {
    switch (g_state.Lever_Pool[wk->wu.id]) {
    case 2:
        g_state.Timer_00[wk->wu.id] = g_state.Lever_Store[wk->wu.id][0];
        break;
    default:
        g_state.Timer_00[wk->wu.id] = g_state.Lever_Store[wk->wu.id][2];
        break;
