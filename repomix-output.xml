typedef struct NSVGrasterizer NSVGrasterizer;

/* Example Usage:
        // Load SVG
        NSVGimage* image;
        image = nsvgParseFromFile("test.svg", "px", 96);

        // Create rasterizer (can be used to render multiple images).
        struct NSVGrasterizer* rast = nsvgCreateRasterizer();
