    render_sa_gauge_frame(1, 1);
    sa_gauge_trans(0);
    sa_gauge_trans(1);
    sa_moji_trans(0, 0, 1);
    sa_moji_trans(1, 0, 1);
    g_state.Old_Stop_SG = 0;
    g_state.Exec_Wipe_F = 0;
    g_state.time_clear[0] = 0;
