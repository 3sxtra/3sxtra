void effect_H2_move(State_Other* ewk) {
    State* mwk = (State*)ewk->my_master;

    switch (ewk->wu.routine_no[0]) {
    case 0:
        ewk->wu.routine_no[0]++;
        ewk->wu.disp_flag = 0;
        ewk->wu.my_col_mode = 0x4200;
        ewk->wu.my_col_code = 0x22;
        set_char_move_init2(&ewk->wu, 0, 0, ewk->wu.type + 21, 0);
        ewk->wu.disp_flag = 0;
        ewk->wu.direction = 7;
        ewk->wu.dir_old = 7;
        ewk->wu.dir_timer = 0;
        ewk->wu.dir_step = 0;
        break;

    case 1:
        if (ewk->wu.death_timer == 1) {
            ewk->wu.disp_flag = 0;
            ewk->wu.routine_no[0] = 2;
            break;
        }

        if (mwk->disp_flag == 1) {
            ewk->wu.disp_flag = 1;
        }

        ewk->wu.dir_timer = ewk->wu.dir_timer + 1 & ewk->wu.dir_old;

        if (ewk->wu.dir_timer == 0) {
            ewk->wu.dir_step = ewk->wu.dir_step + 1 & ewk->wu.direction;
        }

        ewk->wu.position_x = mwk->position_x + panel_guide[ewk->wu.dir_step][0];
        ewk->wu.position_y = mwk->position_y + panel_guide[ewk->wu.dir_step][1] + 17;
        sort_push_request(&ewk->wu);
        break;

    case 2:
        ewk->wu.routine_no[0] = 3;
        break;

    default:
        Release_Effect(&ewk->wu);
        break;
    }
}

