/**
 * @file rumble.h
 * @brief Public API for controller vibration (rumble) effects.
 *
 * Part of the io module.
 */

#ifndef RUMBLE_H
#define RUMBLE_H

#include "structs.h"
#include "types.h"

#define PULREQ_MAX 51
