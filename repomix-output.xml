/**
 * @file eff48.c
 * Effect: Numeric / Counter Effect
 */

#include "sf33rd/Source/Game/effect/effect_48_numeric_counter.h"
#include "bin2obj/char_table.h"
#include "common.h"
#include "sf33rd/Source/Game/debug/Debug.h"
#include "sf33rd/Source/Game/effect/effect_36_data_table_debug.h"
#include "sf33rd/Source/Game/effect/effect.h"
#include "sf33rd/Source/Game/engine/calculate_direction.h"
#include "sf33rd/Source/Game/engine/charset.h"
#include "sf33rd/Source/Game/opening/opening_subroutines.h"
#include "sf33rd/Source/Game/opening/opening.h"
#include "sf33rd/Source/Game/rendering/texture_cache.h"
#include "sf33rd/Source/Game/stage/target_subroutines.h"
#include "structs.h"

typedef const s16* ConstShortArray;
extern ConstShortArray eff48_adrs_tbl[];
extern const s16 eff48_num_tbl[22];

static void eff48_0000(State_Other*);
static void eff48_1000(State_Other*);

void effect_48_move(State_Other* ewk) {
    void (*eff48_jp[3])(State_Other*) = { eff48_0000, eff48_1000, eff48_0000 };
    eff48_jp[ewk->wu.routine_no[0]](ewk);
}

static void eff48_0000(State_Other* ewk) {
    if (ewk->wu.old_routine_no[1] <= op_obj_disp) {
        ewk->wu.routine_no[1] = 0x63;
    }

    switch (ewk->wu.routine_no[1]) {
    case 0:
        ewk->wu.routine_no[1] += 1;
        ewk->wu.disp_flag = 1;
        set_char_move_init2(&ewk->wu, 0, ewk->wu.old_routine_no[0], ewk->wu.char_index, 0);
        /* fallthrough */

    case 1:
        if (op_obj_disp) {
            ewk->wu.routine_no[1] += 1;
            return;
        }

        disp_pos_trans_entry(ewk);
        break;

    default:
        Release_Effect(&ewk->wu);
        break;
    }
}

static void eff48_1000(State_Other* ewk) {
    if (ewk->wu.old_routine_no[1] <= op_obj_disp) {
        ewk->wu.routine_no[1] = 0x63;
    }

    switch (ewk->wu.routine_no[1]) {
    case 0:
        ewk->wu.routine_no[1] += 1;
        op_scrn_end = 0;
        ewk->wu.disp_flag = 1;
        set_char_move_init2(&ewk->wu, 0, ewk->wu.old_routine_no[0], ewk->wu.char_index, 0);
        ewk->wu.old_routine_no[3] = 10;
        cal_all_speed_data(&ewk->wu, ewk->wu.old_routine_no[3], ewk->wu.xyz[0].disp.pos, ewk->wu.old_routine_no[2], 2, 2);
        /* fallthrough */

    case 1:
        ewk->wu.old_routine_no[3] -= 1;

        if (ewk->wu.old_routine_no[3] < 0) {
            ewk->wu.routine_no[1] += 1;
            ewk->wu.xyz[1].disp.pos = ewk->wu.old_routine_no[2];
            op_scrn_end = 1;

            if (!ewk->wu.old_routine_no[4]) {
                switch (ewk->wu.type) {
                case 16:
                    effect_36_init(0x18);
                    break;

                case 17:
                    effect_36_init(0x19);
                    break;

                case 20:
                    effect_36_init(0x1A);
                    break;

                case 21:
                    effect_36_init(0x1B);
                    break;
                }
            }
        } else {
            add_y_sub(ewk);
        }

        /* fallthrough */

    case 2:
        disp_pos_trans_entry(ewk);
        break;

    default:
        Release_Effect(&ewk->wu);
        break;
    }
}

s32 effect_48_init(s16 type) {
    State_Other* ewk;
    s16 ix;
    s16 i;
    const s16* data_ptr;

    if (Debug_w[DEBUG_OPENING_TEST] & 8) {
        return 0;
    }

    data_ptr = eff48_adrs_tbl[type];

    for (i = 0; i < eff48_num_tbl[type]; i++) {
        if ((ix = Acquire_Effect(4)) == -1) {
            return -1;
        }

        ewk = (State_Other*)frw[ix];
        ewk->wu.active_flag = 1;
        ewk->wu.id = 0x30;
        ewk->wu.work_id = 0x10;
        ewk->wu.type = type;
        ewk->wu.my_col_mode = 0x4200;
        ewk->wu.my_col_code = 0x12C;
        ewk->wu.my_family = 3;
        ewk->wu.my_sprite_sheet = 9;
        ewk->wu.my_trans_mode = get_my_trans_mode(ewk->wu.my_sprite_sheet);
        ewk->wu.old_routine_no[4] = i;
        ewk->wu.char_table[0] = _op_char_table;
        ewk->wu.routine_no[0] = *data_ptr++;
        ewk->wu.old_routine_no[2] = *data_ptr++;

        if (ewk->wu.routine_no[0] == 2) {
            ewk->wu.my_col_code += ewk->wu.old_routine_no[2];
        }

        ewk->wu.xyz[0].disp.pos = *data_ptr++;
        ewk->wu.xyz[1].disp.pos = *data_ptr++;
        ewk->wu.my_priority = ewk->wu.position_z = *data_ptr++;
        ewk->wu.old_routine_no[0] = *data_ptr++;
        ewk->wu.char_index = *data_ptr++;
        ewk->wu.old_routine_no[1] = *data_ptr++;

        if (ewk->wu.old_routine_no[0] == 2) {
            COLOR_COPYn(0x10, ((ewk->wu.my_col_code & 0x1FF) + 0x38) * 4, 4);
            ewk->wu.my_col_code = 4;
        } else {
            COLOR_COPYn(0x30, ((ewk->wu.my_col_code & 0x1FF) + 8) * 4, 4);
            ewk->wu.my_col_code = 12;
        }
    }

    return 0;
}

