/** @brief Script command: ASXY — add speed XY. */
static s32 comm_asxy(State* wk, CommandState* ctc) {
    s16* from_rom2 = &wk->step_xy_table[ctc->kind_of_char];
    s32 st = *from_rom2++;

    st <<= 8;

    if (wk->facing_flag) {
        wk->xyz[0].cal += st;
    } else {
        wk->xyz[0].cal -= st;
    }

    st = *from_rom2;
    st <<= 8;
    wk->xyz[1].cal += st;
    return 1;
}

