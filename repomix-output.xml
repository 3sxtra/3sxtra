/** @brief Top-level catch/grab state dispatcher. */
void Player_catch(PlayerEntity* wk) {
    wk->wu.next_z = wk->wu.my_priority;
    wk->running_flag = 0;
    wk->py->flag = 0;
    wk->guard_flag = 3;
    wk->guard_active = 0;
    wk->is_throwing = true;
    wk->is_being_thrown = false;
    wk->scr_pos_set_flag = 1;
    wk->damage_pushbox_flag = 0;
    wk->recovery_roll_success = 0;
    wk->slide_timer = 0;
    wk->slide_index_counter = 0;
    wk->sa_stop_flag = 0;
    wk->parry_flag = 0;
    wk->caution_flag = 0;
    wk->sa->super_effect_can_activate = 0;
    wk->sa->super_effect_meter = 0;
    wk->recovery_roll_success = 0;
    wk->recovery_roll_ok_timer = 0;
    wk->ukemi_cooldown_ok = 0;
    wk->cancel_timer = 0;
    wk->inescapable_flag = 0;
    wk->catch_break_reserve = 0;
    wk->high_jump_ok = 0;
    wk->high_jump_flag = 0;
    wk->wu.swallow_no_effect = 0;
    check_em_tk_power_off(wk, (PlayerEntity*)wk->wu.target_adrs);

    if (wk->wu.routine_no[3] == 0) {
        pp_pulpara_catch(&wk->wu);
    }

    if (wk->wu.routine_no[2] < PLPCA_DISPATCH_COUNT)
        plpca_lv_00[wk->wu.routine_no[2]](wk);
    Check_Throw_Escape(wk, (PlayerEntity*)wk->wu.hit_adrs);

    if (((State*)wk->wu.target_adrs)->routine_no[2] == 3) {
        return;
    }

    if (!wk->wu.cg_prio) {
        return;
    }

    wk->wu.next_z = ((State*)wk->wu.target_adrs)->my_priority;

    if (wk->wu.cg_prio == 1) {
        wk->wu.next_z++;
        return;
    }

    wk->wu.next_z -= 3;
}

/** @brief Checks for throw-break (throw_escape) from the grabbed opponent. */
static void Check_Throw_Escape(PlayerEntity* wk, PlayerEntity* tk) {
    if (tk->wu.work_id != 1) {
        return;
    }

    if (!tk->catch_break_reserve && tk->inescapable_flag) {
        return;
    }

    if (!wk->catch_break_ok_timer) {
        return;
    }

    if (wk->wu.routine_no[1] != 2) {
        return;
    }

    if (!Check_Throw_Escape_Command(tk)) {
        return;
    }

    if (wk->wu.xyz[1].disp.pos > 8) {
        wk->wu.routine_no[2] = 50;
    } else {
        wk->wu.routine_no[2] = 48;
    }

    wk->wu.routine_no[1] = 0;
    wk->wu.routine_no[3] = 0;
    wk->wu.hit_stop = 0;
    wk->wu.damage_hit_stop = 0;

    if (tk->wu.xyz[1].disp.pos > 8) {
        tk->wu.routine_no[2] = 49;
    } else {
        tk->wu.routine_no[2] = 47;
    }

    tk->wu.routine_no[1] = 0;
    tk->wu.routine_no[3] = 0;
    tk->wu.hit_stop = 1;
    tk->wu.damage_hit_stop = 0;
}

/** @brief Catch state 00 — no-op placeholder. */
static void Catch_00000(PlayerEntity* /* unused */) {}

/** @brief Catch state 01 — grab startup animation. */
static void Catch_01000(PlayerEntity* wk) {
    switch (wk->wu.routine_no[3]) {
    case 0:
        wk->wu.routine_no[3]++;
        set_char_move_init_ca(wk, 2, wk->wu.char_index);
        break;

    case 1:
        char_move(&wk->wu);
        catch_cg_type_check(wk);
        break;
    }
}

/** @brief Catch state 02 — grab whiff animation. */
static void Catch_02000(PlayerEntity* wk) {
    switch (wk->wu.routine_no[3]) {
    case 0:
        wk->wu.routine_no[3]++;
        set_char_move_init_ca(wk, 2, wk->wu.char_index + ((State*)wk->wu.hit_adrs)->weight_level);
        break;

    case 1:
        char_move(&wk->wu);
        catch_cg_type_check(wk);
        break;
    }
}

/** @brief Catch state 03 — catch success, pull-in phase. */
static void Catch_03000(PlayerEntity* wk) {
    switch (wk->wu.routine_no[3]) {
    case 0:
        wk->wu.routine_no[3]++;
        set_char_move_init_ca(wk, 2, wk->wu.char_index);
        break;

    case 1:
        char_move(&wk->wu);

        if (wk->wu.cg_type == 7) {
            setup_mvxy_data(&wk->wu, wk->as->data_ix);
        }

        catch_cg_type_check(wk);
        break;
    }
}

/** @brief Catch state 04 — throw execute phase. */
static void Catch_04000(PlayerEntity* wk) {
    switch (wk->wu.routine_no[3]) {
    case 0:
        wk->wu.routine_no[3]++;
        set_char_move_init_ca(wk, 2, wk->wu.char_index);
        reset_mvxy_data(&wk->wu);
        wk->wu.mvxy.index = wk->as->data_ix;
        break;

    case 1:
        char_move(&wk->wu);

        if (wk->wu.cg_type == 20) {
            setup_mvxy_data(&wk->wu, wk->wu.mvxy.index);
            wk->wu.mvxy.index++;
            wk->wu.routine_no[3] = 2;
            wk->wu.cg_type = 0;
        }

        catch_cg_type_check(wk);
        break;

    case 2:
        jumping_union_process(&wk->wu, 1);

        if (wk->wu.cg_type == 30) {
            setup_mvxy_data(&wk->wu, wk->wu.mvxy.index);
            wk->wu.routine_no[3] = 3;
            wk->wu.cg_type = 0;
        }

        catch_cg_type_check(wk);
        break;

    case 3:
        jumping_union_process(&wk->wu, 4);
        catch_cg_type_check(wk);
        break;

    case 4:
        char_move(&wk->wu);
        catch_cg_type_check(wk);
        break;
    }
}

/** @brief Catch state 05 — throw followup / release. */
static void Catch_05000(PlayerEntity* wk) {
    switch (wk->wu.routine_no[3]) {
    case 0:
        wk->wu.routine_no[3]++;
        set_char_move_init_ca(wk, 2, wk->wu.char_index);
        break;

    case 1:
        char_move(&wk->wu);
        switch (wk->wu.cg_type) {
        case 1:
            wk->wu.routine_no[3] = 2;
            wk->wu.cg_type = 0;
            break;

        case 20:
            add_to_mvxy_data(&wk->wu, wk->wu.mvxy.index);
            wk->wu.mvxy.index++;
            wk->wu.cg_type = 0;
            break;

        case 22:
            setup_mvxy_data(&wk->wu, wk->wu.mvxy.index);
            wk->wu.mvxy.index++;
            wk->wu.cg_type = 0;
            break;
        }

        catch_cg_type_check(wk);
        break;

    case 2:
        jumping_union_process(&wk->wu, 1);

        switch (wk->wu.cg_type) {
        case 1:
            wk->wu.routine_no[3] = 1;
            wk->wu.cg_type = 0;
            break;

        case 20:
            add_to_mvxy_data(&wk->wu, wk->wu.mvxy.index);
            wk->wu.mvxy.index++;
            wk->wu.cg_type = 0;
            break;
        }

        catch_cg_type_check(wk);
        break;

    case 3:
        char_move(&wk->wu);
        catch_cg_type_check(wk);
        break;
    }
}

/** @brief Catch state 06 — air-throw execution. */
static void Catch_06000(PlayerEntity* wk) {
    switch (wk->wu.routine_no[3]) {
    case 0:
        wk->wu.routine_no[3]++;
        wk->wu.dir_timer = 10;
        set_char_move_init_ca(wk, 2, wk->wu.char_index);
        break;

    case 1:
        if (wk->wu.dir_timer > 0 && (--wk->wu.dir_timer == 0)) {
            pp_pulpara_shungokusatsu(&wk->wu);
        }

        char_move(&wk->wu);

        if (wk->wu.cg_type == 20) {
            nise_combo_work(wk, (PlayerEntity*)wk->wu.target_adrs, 14);
            wk->wu.cg_type = 0;
        }

        catch_cg_type_check(wk);
        break;
    }
}

/** @brief Catch state 07 — running grab / command throw. */
static void Catch_07000(PlayerEntity* wk) {
    switch (wk->wu.routine_no[3]) {
    case 0:
        wk->wu.routine_no[3]++;
        set_char_move_init_ca(wk, 2, wk->wu.char_index);
        reset_mvxy_data(&wk->wu);
        wk->wu.mvxy.index = wk->as->data_ix;
        wk->wu.dir_timer = 10;
        break;

    case 1:
        char_move(&wk->wu);

        if (wk->wu.cg_type == 30) {
            setup_mvxy_data(&wk->wu, wk->wu.mvxy.index);
            wk->wu.mvxy.index++;
            wk->wu.routine_no[3] = 2;
            wk->wu.cg_type = 0;
            cat07_running_check(&wk->wu);
        }

        catch_cg_type_check(wk);
        break;

    case 2:
        add_mvxy_speed(&wk->wu);
        cal_mvxy_speed(&wk->wu);
        char_move(&wk->wu);

        if (cat07_running_check(&wk->wu) == 0) {
            catch_cg_type_check(wk);
        }

        break;

    case 3:
        jumping_union_process(&wk->wu, 6);

        if (--wk->wu.dir_timer <= 0) {
            wk->wu.routine_no[3] = 4;
        }

        break;

    case 4:
        jumping_union_process(&wk->wu, 6);

        if (((PlayerEntity*)wk->wu.target_adrs)->close_proximity_flag) {
            char_move_z(&wk->wu);
            wk->wu.routine_no[3] = 5;
        }

        catch_cg_type_check(wk);
        break;

    case 5:
        jumping_union_process(&wk->wu, 6);
        break;

    case 6:
        char_move(&wk->wu);
        break;
    }
}

/** @brief Checks if the running-catch can continue based on distance. */
static s32 cat07_running_check(State* wk) {
    if (wk->xyz[0].disp.pos < (g_state.bg_w.bgw[1].l_limit2 - 64) ||
        wk->xyz[0].disp.pos > (g_state.bg_w.bgw[1].r_limit2 + 64)) {
        char_move_cmja(wk);
        setup_mvxy_data(wk, wk->mvxy.index);
        wk->mvxy.index++;
        wk->routine_no[3] = 3;
        return 1;
    }

    return 0;
}

/** @brief Catch state 08 — special catch / multi-hit throw. */
static void Catch_08000(PlayerEntity* wk) {
    switch (wk->wu.routine_no[3]) {
    case 0:
        wk->wu.routine_no[3]++;
        set_char_move_init_ca(wk, 2, wk->wu.char_index);
        break;

    case 1:
        char_move(&wk->wu);
        catch_cg_type_check(wk);

        if (wk->wu.cg_type == 50) {
            wk->wu.routine_no[1] = 4;
            wk->wu.routine_no[2] = 23;
            wk->wu.routine_no[3] = 1;
        }

        break;
    }
}

/** @brief Subtracts grab-damage from the caught opponent's vitality. */
void subtract_cu_vital(PlayerEntity* wk) {
    if (wk->wu.damage_vitality != 0) {
        if (wk->death_timerlag == 0) {
            if (wk->wu.damage_vitality) {
                additional_score_damage((State_Other*)wk->wu.dmg_adrs, wk->wu.damage_chain_index);
                add_sp_arts_gauge_hit_dm(wk);
            }

            if (omop_vital_ix[wk->wu.id] == 5) {
                wk->wu.damage_vitality = 0;
            }

            wk->wu.vital_new -= wk->wu.damage_vitality;

            if (wk->wu.damage_no_death_attack && wk->wu.vital_new < 0) {
                wk->wu.vital_new = 0;
            }

            if (wk->wu.vital_new < 0) {
                wk->wu.vital_new = -1;
                wk->death_timerlag = 1;
                g_state.dead_voice_flag = true;

                if (!g_state.round_slow_flag) {
                    set_round_end_slowmo();
                    g_state.round_slow_flag = true;
                }
            } else if (wk->py->flag == 0) {
                wk->py->now.quantity.h += wk->wu.damage_stun_value;

                if (wk->py->now.quantity.h >= wk->py->stun_threshold) {
                    wk->py->now.timer = 0;
                    wk->py->flag = 1;
                }
            }
        }

        pp_pulpara_remake_dm_all(&wk->wu);
    }

    if (g_state.Mode_Type == MODE_NORMAL_TRAINING && (g_state.Training_ID != wk->wu.id)) {
        Training_Damage_Set(wk->wu.damage_vitality, wk->wu.damage_stun_value, wk->wu.is_taking_chip_damage);
    }

    wk->wu.damage_vitality = 0;
    wk->wu.damage_stun_value = 0;
}

/** @brief Processes cg_type transitions during the catch state. */
static void catch_cg_type_check(PlayerEntity* wk) {
    PlayerEntity* emwk = (PlayerEntity*)wk->wu.hit_adrs;

    switch (wk->wu.cg_type) {
    case 2:
        wk->wu.cg_type = 0;
        setup_catch_atthit(&wk->wu, &emwk->wu);
        add_combo_work(wk, emwk);
        grade_add_clean_hits((State_Other*)wk);
        break;

    case 3:
        wk->wu.cg_type = 4;
        subtract_cu_vital(emwk);
        set_catch_hit_mark_pos(&wk->wu, &emwk->wu);
        effect_02_init(&wk->wu, 0, 1, wk->wu.facing_flag);
        pp_pulpara_remake_at_hit(wk);
        pp_pulpara_hit(&wk->wu);
        pp_pulpara_remake_dm_all(&emwk->wu);

        if (emwk->backup_ok_timer) {
            emwk->ukemi_cooldown_ok = 1;
            emwk->recovery_roll_ok_timer = emwk->backup_ok_timer;
        } else {
            emwk->ukemi_cooldown_ok = 0;
            emwk->recovery_roll_ok_timer = 0;
        }

        emwk->recovery_roll_success = 0;
        break;

    case 5:
        subtract_cu_vital(emwk);
        wk->wu.cg_type = 0;
        emwk->recovery_roll_ok_timer = 0;
        emwk->ukemi_cooldown_ok = 0;
        emwk->recovery_roll_success = 0;
        break;

    case 6:
        wk->wu.cg_type = 0;
        wk->wu.facing_flag ^= 1;
        break;

    case 7:
        wk->wu.cg_type = 0;
        wk->wu.routine_no[1] = wk->wu.cmd_move_data.kind_of_char;
        wk->wu.routine_no[2] = wk->wu.cmd_move_data.ix;
        wk->wu.routine_no[3] = wk->wu.cmd_move_data.pat;
        break;

    case 8:
        wk->wu.cg_type = 0;
        emwk->wu.routine_no[1] = wk->wu.cmd_y_axis_data.kind_of_char;
        emwk->wu.routine_no[2] = wk->wu.cmd_y_axis_data.ix;
        emwk->wu.routine_no[3] = wk->wu.cmd_y_axis_data.pat;

    case 9:
        Grade_Add_Normal_Throw(&wk->wu);
        wk->wu.cg_type = 0;
    }
}

/** @brief Sets up character move init with catch-specific facing logic. */
static void set_char_move_init_ca(PlayerEntity* wk, s16 kind_of_char, s16 index) {
    set_char_move_init(&wk->wu, kind_of_char, index);
    wk->catch_break_ok_timer = wk->wu.cmd_y_axis_data.kind_of_char >> 8;
    wk->wu.cmd_y_axis_data.kind_of_char &= 0xFF;
}

void (*const plpca_lv_00[9])(PlayerEntity*) = { Catch_00000, Catch_01000, Catch_02000, Catch_03000, Catch_04000,
                                       Catch_05000, Catch_06000, Catch_07000, Catch_08000 };
