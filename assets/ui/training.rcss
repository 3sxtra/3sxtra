/* Training Options — F7 modded training overlay
 * CPS3-inspired two-tab layout: DUMMY | DISPLAY */

body {
    width: 100%;
    height: 100%;
}

/* ── Panel Positioning ── */
#training-panel {
    display: block;
    position: absolute;
    top: 2%;
    right: 2%;
    width: 48%;
    max-height: 92%;
    overflow-y: auto;
}

/* ── Drag Handle ── */
#training-panel handle {
    display: block;
    cursor: move;
    padding: 2dp 0;
    margin-bottom: 4dp;
}

#training-panel handle:hover {
    background-color: rgba(255, 255, 255, 10);
    border-radius: 4dp 4dp 0 0;
}

#training-panel h1 {
    font-size: 14dp;
    color: #cc0000;
    margin-bottom: 0;
    text-align: center;
    white-space: nowrap;
}

/* ── Tab Bar ── */
.tab-bar {
    display: block;
    margin-bottom: 2dp;
}

.tab {
    display: inline-block;
    padding: 2dp 8dp;
    margin-right: 2dp;
    background-color: #333;
    color: #999;
    border-width: 1dp;
    border-color: #888;
    font-size: 12dp;
    white-space: nowrap;
    cursor: pointer;
}

.tab.active {
    background-color: #cc0000;
    color: #fff;
    border-color: #ff3333;
    border-width: 1dp;
}

.tab:hover {
    background-color: #888;
    color: #fff;
}

.tab.active:hover {
    background-color: #dd2222;
}

/* ── Tab Content ── */
.tab-content {
    display: block;
    padding: 2dp 0dp;
}

/* ── Sections ── */
.section {
    display: block;
    margin-bottom: 2dp;
}

/* ── Control rows ── */
.control-row {
    display: block;
    padding: 1dp 0dp;
}

.control-row label {
    vertical-align: middle;
    color: #dddddd;
    white-space: nowrap;
}

/* List-type rows (label + value) */
.list-row {
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

.list-row .value {
    color: #ffcc00;
    font-size: 12dp;
    white-space: nowrap;
}

/* Clickable list rows — visual feedback */
.clickable {
    cursor: pointer;
}

.clickable:hover {
    background-color: #333;
}

.clickable:hover .value {
    color: #ffffff;
}

/* ── Sub-group indentation ── */
.sub-group {
    display: block;
    padding-left: 12dp;
    margin-top: 2dp;
}

/* ── Divider ── */
.divider {
    display: block;
    height: 1dp;
    background-color: #444;
    margin-top: 3dp;
    margin-bottom: 3dp;
}

/* ── Hint text ── */
.hint {
    display: block;
    font-size: 11dp;
    color: #b0b0b0;
    margin-top: 2dp;
    margin-bottom: 2dp;
    white-space: nowrap;
}


