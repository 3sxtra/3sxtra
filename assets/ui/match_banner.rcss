/* ============================================================ *
 *  match_banner.rcss  —  Fightcade-style Match Banner          *
 * ============================================================ */
body {
    width: 384dp;
    height: 100%;
    font-family: "DistrictTF-RegularItalic";
    font-size: 15dp;
}

.hud-hidden {
    display: none;
}

/* ── Match Banner (Fightcade style) ─────────────────────────────── */
#match-banner {
    display: block;
    position: absolute;
    top: 0dp;
    left: 42dp;
    width: 300dp;
    height: 14dp;
    background-color: rgba(0, 0, 0, 160);
    border-bottom-left-radius: 4dp;
    border-bottom-right-radius: 4dp;
    z-index: 100;
}
.banner-p1 {
    display: block;
    position: absolute;
    left: 4dp;
    top: 0dp;
    width: 120dp;
    height: 14dp;
    line-height: 14dp;
    text-align: right;
}
.banner-center {
    display: block;
    position: absolute;
    left: 126dp;
    top: 0dp;
    width: 48dp;
    height: 14dp;
    line-height: 15dp;
    text-align: center;
}
.banner-p2 {
    display: block;
    position: absolute;
    left: 176dp;
    top: 0dp;
    width: 120dp;
    height: 14dp;
    line-height: 14dp;
    text-align: left;
}
.banner-name {
    display: inline-block;
    font-size: 12dp;
    color: #ffffff;
    font-effect: shadow(1dp 1dp #000000);
    vertical-align: middle;
    margin-top: -1dp;
}
.banner-flag {
    display: inline;
    width: 10dp;
    height: 7dp;
    margin-left: 3dp;
    margin-right: 3dp;
    vertical-align: middle;
}
.banner-wins {
    display: inline-block;
    font-size: 13dp;
    color: #ffd700;
    font-effect: shadow(1dp 1dp #000000);
    vertical-align: middle;
    width: 14dp;
    height: 12dp;
    line-height: 12dp;
    text-align: center;
    background-color: rgba(255, 255, 255, 30);
    border-radius: 2dp;
    margin-top: -1dp;
}
.p1-banner-wins { margin-left: 6dp; }
.p2-banner-wins { margin-right: 6dp; }

.banner-ft {
    display: inline-block;
    font-size: 11dp;
    color: #00ff00;
    font-effect: shadow(1dp 1dp #000000);
    background-color: rgba(0, 255, 0, 30);
    padding: 1dp 3dp;
    border-radius: 2dp;
    vertical-align: middle;
    margin-top: -2dp;
}

/* ── Spectator badge (Fightcade-style) ─────────────────────── */
#spectator-badge {
    display: block;
    position: absolute;
    top: 34dp;
    left: 179dp;
    width: 26dp;
    text-align: center;
    background-color: rgba(0, 0, 0, 140);
    border-radius: 3dp;
    padding: 1dp 2dp;
}
.spec-eye {
    display: inline;
    font-size: 10dp;
    color: #e0e0e0;
    vertical-align: middle;
}
.spec-count {
    display: inline;
    font-size: 11dp;
    color: #e0e0e0;
    margin-left: 2dp;
    font-effect: shadow(1dp 1dp #000000);
}


