<rml>
<head>
    <link type="text/rcss" href="base.rcss"/>
    <link type="text/rcss" href="replay_picker.rcss"/>
    <title>Replay Picker</title>
</head>
<body data-model="replay_picker">
<div id="rp-panel" data-if="rp_open">

    <!-- Title bar -->
    <div id="rp-title-bar">
        <span id="rp-title" data-if="rp_mode == 0">LOAD REPLAY</span>
        <span id="rp-title" data-if="rp_mode == 1">SAVE REPLAY</span>
    </div>

    <!-- Tab bar -->
    <div id="rp-tab-bar">
        <span class="rp-tab" data-class-active="rp_tab == 0">LOCAL</span>
        <span class="rp-tab" data-class-active="rp_tab == 1">NETPLAY</span>
    </div>

    <!-- Table header -->
    <div id="rp-table">
        <div class="rp-header-row">
            <span class="rp-col-num">#</span>
            <span class="rp-col-p1">P1</span>
            <span class="rp-col-vs"></span>
            <span class="rp-col-p2">P2</span>
            <span class="rp-col-date">DATE</span>
        </div>

        <!-- Slot rows -->
        <div data-for="slot : rp_slots"
             class="rp-row"
             data-class-selected="slot.page_idx == rp_cursor && rp_zone == 0"
             data-class-empty="!slot.exists">
            <span class="rp-col-num">{{slot.display_num}}</span>
            <span class="rp-col-p1" data-if="slot.exists">{{slot.p1_name}}</span>
            <span class="rp-col-vs" data-if="slot.exists">vs</span>
            <span class="rp-col-p2" data-if="slot.exists">{{slot.p2_name}}</span>
            <span class="rp-col-date" data-if="slot.exists">{{slot.date_str}}</span>
            <span class="rp-col-empty" data-if="!slot.exists">--- empty ---</span>
        </div>
    </div>

    <!-- Empty state -->
    <div id="rp-empty" data-if="rp_slot_count == 0">
        <span>No replays found.</span>
    </div>

    <!-- Footer with navigable control rows -->
    <div id="rp-footer">
        <!-- Page control row -->
        <div class="rp-control-row" data-class-active="rp_zone == 1">
            <span class="rp-ctl-arrow" data-if="rp_has_prev">◀</span>
            <span class="rp-ctl-label">PAGE {{rp_page}} / {{rp_total_pages}}</span>
            <span class="rp-ctl-arrow" data-if="rp_has_next">▶</span>
        </div>
        <!-- Tab control row -->
        <div class="rp-control-row" data-class-active="rp_zone == 2">
            <span class="rp-ctl-arrow">◀</span>
            <span class="rp-ctl-label" data-if="rp_tab == 0">LOCAL</span>
            <span class="rp-ctl-label" data-if="rp_tab == 1">NETPLAY</span>
            <span class="rp-ctl-arrow">▶</span>
        </div>
    </div>

</div>
</body>
</rml>
