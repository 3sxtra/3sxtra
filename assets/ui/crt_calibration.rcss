body#crt-calibration-root {
    width: 100%;
    height: 100%;
    margin: 0;
    padding: 0;
    position: absolute;
    top: 0;
    left: 0;
    z-index: 1000;
    background-color: rgb(16,16,16); /* Default TV Black */
}

.pattern-container {
    width: 100%;
    height: 100%;
    position: absolute;
    top: 0;
    left: 0;
}

/* 0: SMPTE */
.smpte-container { width: 100%; height: 100%; display: block; }
.smpte-top { width: 100%; height: 66.6666%; position: relative; }
.smpte-middle { width: 100%; height: 8.3333%; position: relative; }
.smpte-bottom { width: 100%; height: 25%; position: relative; }

.bar {
    position: absolute; top: 0;
    width: 14.2857%; height: 100%;
}
.bar-white   { background-color: rgb(191,191,191); }
.bar-yellow  { background-color: rgb(191,191,0); }
.bar-cyan    { background-color: rgb(0,191,191); }
.bar-green   { background-color: rgb(0,191,0); }
.bar-magenta { background-color: rgb(191,0,191); }
.bar-red     { background-color: rgb(191,0,0); }
.bar-blue    { background-color: rgb(0,0,191); }
.bar-black   { background-color: rgb(16,16,16); } 
.bar-gray    { background-color: rgb(38,38,38); } 
.bar-i       { background-color: rgb(0,68,114); } 
.bar-q       { background-color: rgb(64,0,110); } 
.smpte-bottom .bar-white { background-color: rgb(255,255,255); } 

.pluge-container {
    position: absolute; top: 0; height: 100%;
    background-color: rgb(0,0,0);
}
.pluge-bar {
    position: absolute; top: 0;
    width: 20%; height: 100%;
}
.pluge-container .bar-black { background-color: rgb(16,16,16); }
.pluge-superblack { background-color: rgb(0,0,0); }
.pluge-light { background-color: rgb(32,32,32); }

/* 1: Geometry Grid */
.geometry-grid {
    position: absolute; top: 0; left: 0; width: 100%; height: 100%;
    box-sizing: border-box; border-width: 1dp; border-color: rgba(255, 255, 255, 255);
}
.grid-line-h {
    position: absolute; left: 0; width: 100%; height: 1dp;
    background-color: rgba(255, 255, 255, 128);
}
.grid-line-v {
    position: absolute; top: 0; width: 1dp; height: 100%;
    background-color: rgba(255, 255, 255, 128);
}
.grid-center-circle {
    position: absolute; top: 25%; left: 33.333%; width: 33.333%; height: 50%;
    border-width: 1dp; border-color: rgba(255, 255, 255, 150);
    border-radius: 1000dp;
}
.overscan-border {
    position: absolute;
    box-sizing: border-box;
    border-width: 2dp;
}
.overscan-outer {
    top: 2%; left: 2%; width: 96%; height: 96%;
    border-color: rgb(255, 0, 0);
}
.overscan-safe {
    top: 5%; left: 5%; width: 90%; height: 90%;
    border-color: rgb(0, 255, 0);
}

/* 2: Sharpness */
.sharpness-image {
    position: absolute; top: 0; left: 0; width: 100%; height: 100%;
    decorator: image("sharpness.png");
}

/* 3: Monoscope */
.monoscope-image {
    position: absolute; top: 0; left: 0; width: 100%; height: 100%;
    decorator: image("monoscope.png");
}

/* 3: PLUGE */
.pluge-fullscreen {
    background-color: rgb(16,16,16);
}
.pluge-full-bar {
    position: absolute; top: 25%; height: 50%; width: 5%;
}

/* 4: Solid Colors */
.solid-colors { width: 100%; height: 100%; }
.solid-quadrant {
    position: absolute; width: 50%; height: 50%;
}
.solid-white { background-color: rgb(255, 255, 255); }
.solid-red   { background-color: rgb(255, 0, 0); }
.solid-green { background-color: rgb(0, 255, 0); }
.solid-blue  { background-color: rgb(0, 0, 255); }
