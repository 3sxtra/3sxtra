/* Frame Display — color-coded frame meter with stats */

#frame-wrapper {
    display: block;
    position: absolute;
    bottom: 5%;
    left: 0;
    right: 0;
    text-align: center;
}

#frame-panel {
    display: inline-block;
    padding: 8dp 12dp;
    background-color: rgba(0, 0, 0, 200);
    border-radius: 4dp;
    text-align: left;
}

.player-row {
    display: block;
    margin-bottom: 2dp;
    white-space: nowrap;
}

/* ── Frame bar container ── */
.frame-bar {
    display: inline-block;
    height: 10dp;
    margin-bottom: 4dp;
    white-space: nowrap;
    vertical-align: middle;
}

/* ── Individual frame cell ── */
.frame-cell {
    display: inline-block;
    width: 4dp;
    height: 10dp;
    margin-right: 1dp;
}

/* ── State colors (match ImGui frame_display.cpp) ── */
.frame-cell.startup {
    background-color: #00ff00;  /* Green */
}
.frame-cell.active {
    background-color: #ff0000;  /* Red */
}
.frame-cell.recovery {
    background-color: #0064ff;  /* Blue */
}
.frame-cell.hitstun {
    background-color: #ff8000;  /* Orange */
}
.frame-cell.blockstun {
    background-color: #ffff00;  /* Yellow */
}
.frame-cell.down {
    background-color: #500000;  /* Dark Red */
}
.frame-cell.idle {
    background-color: rgba(60, 60, 60, 153);  /* Dark Gray */
}

/* ── Stats text ── */
.stats-text {
    display: inline-block;
    font-size: 11dp;
    color: rgba(255, 255, 255, 240);
    padding: 0dp 8dp;
    vertical-align: middle;
    white-space: nowrap;
}

/* ── Advantage coloring ── */
.stats-text.positive {
    color: #66ff66;
}
.stats-text.negative {
    color: #ff5959;
}


