/* ── VS Result Screen Stylesheet ──────────────────────────── */
body {
    width: 384dp;
    height: 224dp;
    font-family: "DistrictTF-RegularItalic";
    font-size: 17dp;
    color: #ffffffee;
}

.vs-result-panel {
    display: block;
    position: absolute;
    top: 20%;
    left: 50%;
    margin-left: -180dp;
    width: 360dp;
    text-align: center;
    animation: panel-fade-in 0.5s quadratic-out;
}

@keyframes panel-fade-in {
    0% {
        opacity: 0;
        margin-top: 15dp;
    }
    100% {
        opacity: 1;
        margin-top: 0dp;
    }
}

/* ── Header ─────────────────────────────────────────────────── */
.result-header {
    display: block;
    font-size: 28dp;
    font-weight: bold;
    color: #ffd700;
    letter-spacing: 4dp;
    margin-bottom: 16dp;
    font-effect: shadow(2dp 2dp #00000088);
}

/* ── Body: split layout ─────────────────────────────────────── */
.result-body {
    display: block;
    padding: 12dp;
    background-color: #00000066;
    border-width: 1dp;
    border-color: #ffd70033;
}

.player-side {
    display: inline-block;
    width: 130dp;
    vertical-align: top;
    text-align: center;
    padding: 8dp;
}

.p1-side {
    border-right-width: 0dp;
}

.p2-side {
    border-left-width: 0dp;
}

.vs-divider {
    display: inline-block;
    width: 50dp;
    vertical-align: top;
    text-align: center;
    padding-top: 40dp;
    font-size: 22dp;
    font-weight: bold;
    color: #b0b0b0;
}

/* ── Player elements ────────────────────────────────────────── */
.player-label {
    display: block;
    font-size: 15dp;
    color: #b0b0b0;
    letter-spacing: 2dp;
    margin-bottom: 4dp;
}

.player-char {
    display: block;
    font-size: 20dp;
    font-weight: bold;
    color: #ffffff;
    margin-bottom: 8dp;
}

.player-wins {
    display: block;
    font-size: 32dp;
    font-weight: bold;
    color: #ffd700;
    margin-bottom: 4dp;
    font-effect: shadow(1dp 1dp #00000066);
}

.player-pct-label {
    display: block;
    font-size: 13dp;
    color: #666666;
    letter-spacing: 1dp;
    margin-bottom: 2dp;
}

.player-pct {
    display: block;
    font-size: 22dp;
    font-weight: bold;
    color: #e0e0e0;
}


