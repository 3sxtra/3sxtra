/* ─── Leaderboard ─────────────────────────────────────────────── */
/* 384×224 game canvas — strict dp metrics                         */
/* Columns: # | Flag | Player | Char | W/M | WIN% | GRD | Rating | DC% */

#lb-panel {
    display: block;
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 0;
    overflow: hidden;
    background-color: rgba(6, 8, 18, 220);
    border-width: 1dp;
    border-color: rgba(80, 110, 200, 80);
}

/* ── Title bar (compact) ── */
#lb-title-bar {
    display: block;
    height: 14dp;
    padding: 2dp 8dp 1dp 8dp;
    border-top-width: 1dp;
    border-top-color: rgba(255, 255, 255, 200);
    border-bottom-width: 1dp;
    border-bottom-color: rgba(255, 255, 255, 200);
    text-align: center;
}
#lb-title {
    display: block;
    font-size: 11dp;
    color: #fff;
    font-weight: bold;
    font-effect: shadow(1dp 1dp rgba(0, 0, 0, 120));
    background-color: transparent;
}
#lb-total {
    display: block;
    position: absolute;
    right: 8dp;
    top: 5dp;
    font-size: 7dp;
    color: rgba(170, 200, 255, 170);
}

/* ── Loading ── */
#lb-loading {
    display: block;
    text-align: center;
    padding: 80dp 0;
    font-size: 10dp;
    color: rgba(255, 200, 60, 200);
}

/* ── Table ── */
#lb-table {
    display: block;
    position: absolute;
    top: 20dp;
    left: 1dp;
    right: 1dp;
    bottom: 15dp;
    padding: 1dp 2dp;
    background-color: rgba(0, 6, 28, 180);
    border-width: 1dp;
    border-color: rgba(80, 120, 220, 70);
    overflow: hidden;
}

/* ── Header row ── */
.lb-header-row {
    display: block;
    font-size: 7dp;
    color: rgba(140, 170, 230, 200);
    padding: 1dp 0dp;
    margin-bottom: 1dp;
    border-bottom-width: 1dp;
    border-bottom-color: rgba(100, 130, 220, 80);
    white-space: nowrap;
}

/* ── Data rows ── */
.lb-row {
    display: block;
    color: rgba(190, 200, 225, 180);
    font-size: 8dp;
    padding: 0dp 0dp;
    margin-bottom: 0dp;
    border-left-width: 2dp;
    border-left-color: transparent;
    white-space: nowrap;
}

.lb-row.hidden {
    display: none;
}

/* Alternating row tint (odd rows via nth-child not supported in RmlUi,
   so we rely on tier borders + highlight for visual rhythm) */

/* Tier-colored left borders */
.lb-row.bronze  { border-left-color: rgba(205, 127, 50, 160); }
.lb-row.silver  { border-left-color: rgba(170, 180, 210, 180); }
.lb-row.gold    { border-left-color: rgba(255, 215, 0, 200); }
.lb-row.plat    { border-left-color: rgba(180, 160, 255, 200); }
.lb-row.diamond { border-left-color: rgba(80, 220, 255, 220); }

/* My row highlight */
.lb-row.highlight {
    color: rgba(255, 235, 100, 255);
    background-color: rgba(255, 220, 0, 22);
    border-left-color: rgba(255, 210, 40, 230);
}

/* Top 3 — stronger golden glow + gold accent border */
.lb-row.top3 {
    background-color: rgba(255, 215, 0, 30);
}

/* ── Column widths (inline-block) ── */

.lb-col-rank {
    display: inline-block;
    width: 22dp;
    text-align: center;
    color: rgba(150, 160, 180, 200);
    font-size: 8dp;
}

/* Medal colors for top 3 */
.lb-row.top3 .lb-col-rank {
    font-weight: bold;
}

.lb-col-flag {
    display: inline-block;
    width: 16dp;
    vertical-align: baseline;
}

.lb-flag-img {
    display: inline;
    width: 12dp;
    height: 8dp;
    vertical-align: baseline;
}

.lb-col-name {
    display: inline-block;
    width: 120dp;
    padding-left: 2dp;
    overflow: hidden;
}

.lb-row.highlight .lb-col-name {
    color: #fff;
}

.lb-col-char {
    display: inline-block;
    width: 28dp;
    text-align: center;
    font-size: 7dp;
    color: rgba(160, 180, 210, 160);
}

.lb-col-wm {
    display: inline-block;
    width: 48dp;
    text-align: center;
    color: rgba(90, 240, 150, 230);
    font-size: 8dp;
}

.lb-col-pct {
    display: inline-block;
    width: 36dp;
    text-align: center;
    color: rgba(170, 180, 210, 200);
}

.lb-col-grade {
    display: inline-block;
    width: 20dp;
    text-align: center;
    font-size: 8dp;
    font-weight: bold;
    color: rgba(200, 210, 230, 200);
}

/* Grade colors by tier */
.lb-row.bronze .lb-col-grade   { color: #cd7f32; }
.lb-row.silver .lb-col-grade   { color: #a8b4d0; }
.lb-row.gold .lb-col-grade     { color: #ffd700; }
.lb-row.plat .lb-col-grade     { color: #c0a0ff; }
.lb-row.diamond .lb-col-grade  { color: #50e0ff; }

.lb-col-rating {
    display: inline-block;
    width: 54dp;
    text-align: center;
    color: rgba(140, 210, 255, 235);
}

.lb-col-dc {
    display: inline-block;
    width: 30dp;
    text-align: center;
    color: rgba(150, 160, 180, 200);
    font-size: 7dp;
}
.lb-col-dc.dc-warn {
    color: rgba(255, 80, 80, 255);
    font-weight: bold;
}

/* Tier-specific rating colors */
.lb-row.bronze .lb-col-rating   { color: #cd7f32; }
.lb-row.silver .lb-col-rating   { color: #a8b4d0; }
.lb-row.gold .lb-col-rating     { color: #ffd700; font-effect: shadow(1dp 1dp rgba(255, 215, 0, 0.3)); }
.lb-row.plat .lb-col-rating     { color: #c0a0ff; font-weight: bold; font-effect: shadow(1dp 1dp rgba(180, 140, 255, 0.4)); }
.lb-row.diamond .lb-col-rating  { color: #50e0ff; font-weight: bold; font-effect: shadow(1dp 1dp rgba(80, 220, 255, 0.5)); }

/* ── Empty state ── */
#lb-empty {
    display: block;
    position: absolute;
    top: 25dp;
    left: 1dp;
    right: 1dp;
    bottom: 20dp;
    text-align: center;
    padding: 60dp 0;
    font-size: 8dp;
    color: rgba(140, 150, 180, 120);
}

/* ── Pagination footer ── */
#lb-footer {
    display: block;
    position: absolute;
    bottom: 1dp;
    left: 1dp;
    right: 1dp;
    padding: 1dp 6dp;
    background-color: rgba(0, 8, 30, 160);
    border-width: 1dp;
    border-color: rgba(80, 120, 220, 50);
    text-align: center;
    font-size: 7dp;
}
.lb-nav {
    display: inline;
    color: rgba(255, 210, 70, 240);
    margin: 0 12dp;
}
.lb-page-info {
    display: inline;
    color: rgba(170, 200, 255, 170);
}
