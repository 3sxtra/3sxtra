/* ============================================================ *
 *  trials_hud.rcss  —  Trial mode HUD overlay                 *
 * ============================================================ */

body {
    width: 384dp;
    height: 224dp;
    font-family: "DistrictTF-RegularItalic";
    font-size: 13dp;
}

#trials-container {
    display: block;
    position: absolute;
    top: 40dp;
    left: 16dp;
    width: 280dp;
}

#trial-header {
    display: block;
    font-size: 12dp;
    color: #ffffff;
    font-effect: shadow(1dp 1dp #000000);
    margin-bottom: 4dp;
}

#trial-gauge-alert {
    display: block;
    position: absolute;
    top: 0dp;
    left: 224dp;
    font-size: 12dp;
    color: #00ffff;
    font-effect: shadow(1dp 1dp #000000);
}

#trial-step-list {
    display: block;
    margin-top: 4dp;
}

.step-item {
    display: block;
    font-size: 11dp;
    font-effect: shadow(1dp 1dp #000000);
    margin-bottom: 2dp;
}

.step-item.pending {
    color: #e0e0e0;
}

.step-item.active {
    color: #ffff00;
}

.step-item.completed {
    color: #00ff00;
}

.step-item.failed {
    color: #ff0000;
}

#trial-complete {
    display: block;
    position: absolute;
    top: 110dp;
    left: 134dp;
    font-size: 17dp;
    text-align: center;
    font-effect: shadow(2dp 2dp #000000);
}

.complete-flash {
    animation: trial-flash 0.27s steps(1) infinite;
}

@keyframes trial-flash {
      0% { color: #00ff00; }
     50% { color: #ffffff; }
    100% { color: #00ff00; }
}


