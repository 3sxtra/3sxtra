                </div>
            </div>
        </div>

        <!-- ═══════ STAGE TAB ═══════ -->
        <div data-if="edit_mode == 1" class="tab-content">
            <div class="section" data-class-disabled="!in_game">
                <h2>Stage Palette Row</h2>
                <div class="control-row">
                    <label>Row:</label>
                    <input type="range" min="32" data-attr-max="stage_row_max"
                           step="1" data-value="stage_row"
                           data-attrif-disabled="!in_game"/>
                    <span class="color-label">{{ stage_row }}</span>
                </div>
                <!-- Stage color grid: 4 consecutive rows × 16 colors -->
                <div data-if="in_game" class="stage-multi-grid">
                    <div class="stage-row-block">
                        <span class="stage-row-num">{{ stage_row_label_0 }}</span>
                        <div class="color-grid stage-compact">
                            <div class="swatch" data-style-background-color="sw_s0_0"  data-event-click="pick_stage_color(0)"></div>
                            <div class="swatch" data-style-background-color="sw_s0_1"  data-event-click="pick_stage_color(1)"></div>
                            <div class="swatch" data-style-background-color="sw_s0_2"  data-event-click="pick_stage_color(2)"></div>
                            <div class="swatch" data-style-background-color="sw_s0_3"  data-event-click="pick_stage_color(3)"></div>
                            <div class="swatch" data-style-background-color="sw_s0_4"  data-event-click="pick_stage_color(4)"></div>
                            <div class="swatch" data-style-background-color="sw_s0_5"  data-event-click="pick_stage_color(5)"></div>
                            <div class="swatch" data-style-background-color="sw_s0_6"  data-event-click="pick_stage_color(6)"></div>
                            <div class="swatch" data-style-background-color="sw_s0_7"  data-event-click="pick_stage_color(7)"></div>
                            <div class="swatch" data-style-background-color="sw_s0_8"  data-event-click="pick_stage_color(8)"></div>
                            <div class="swatch" data-style-background-color="sw_s0_9"  data-event-click="pick_stage_color(9)"></div>
                            <div class="swatch" data-style-background-color="sw_s0_10" data-event-click="pick_stage_color(10)"></div>
                            <div class="swatch" data-style-background-color="sw_s0_11" data-event-click="pick_stage_color(11)"></div>
                            <div class="swatch" data-style-background-color="sw_s0_12" data-event-click="pick_stage_color(12)"></div>
                            <div class="swatch" data-style-background-color="sw_s0_13" data-event-click="pick_stage_color(13)"></div>
                            <div class="swatch" data-style-background-color="sw_s0_14" data-event-click="pick_stage_color(14)"></div>
                            <div class="swatch" data-style-background-color="sw_s0_15" data-event-click="pick_stage_color(15)"></div>
                        </div>
                    </div>
                    <div class="stage-row-block">
                        <span class="stage-row-num">{{ stage_row_label_1 }}</span>
                        <div class="color-grid stage-compact">
                            <div class="swatch" data-style-background-color="sw_s1_0"></div>
                            <div class="swatch" data-style-background-color="sw_s1_1"></div>
                            <div class="swatch" data-style-background-color="sw_s1_2"></div>
                            <div class="swatch" data-style-background-color="sw_s1_3"></div>
                            <div class="swatch" data-style-background-color="sw_s1_4"></div>
                            <div class="swatch" data-style-background-color="sw_s1_5"></div>
                            <div class="swatch" data-style-background-color="sw_s1_6"></div>
                            <div class="swatch" data-style-background-color="sw_s1_7"></div>
                            <div class="swatch" data-style-background-color="sw_s1_8"></div>
                            <div class="swatch" data-style-background-color="sw_s1_9"></div>
                            <div class="swatch" data-style-background-color="sw_s1_10"></div>
                            <div class="swatch" data-style-background-color="sw_s1_11"></div>
                            <div class="swatch" data-style-background-color="sw_s1_12"></div>
                            <div class="swatch" data-style-background-color="sw_s1_13"></div>
                            <div class="swatch" data-style-background-color="sw_s1_14"></div>
                            <div class="swatch" data-style-background-color="sw_s1_15"></div>
                        </div>
                    </div>
                    <div class="stage-row-block">
                        <span class="stage-row-num">{{ stage_row_label_2 }}</span>
                        <div class="color-grid stage-compact">
                            <div class="swatch" data-style-background-color="sw_s2_0"></div>
                            <div class="swatch" data-style-background-color="sw_s2_1"></div>
                            <div class="swatch" data-style-background-color="sw_s2_2"></div>
                            <div class="swatch" data-style-background-color="sw_s2_3"></div>
                            <div class="swatch" data-style-background-color="sw_s2_4"></div>
                            <div class="swatch" data-style-background-color="sw_s2_5"></div>
                            <div class="swatch" data-style-background-color="sw_s2_6"></div>
                            <div class="swatch" data-style-background-color="sw_s2_7"></div>
                            <div class="swatch" data-style-background-color="sw_s2_8"></div>
                            <div class="swatch" data-style-background-color="sw_s2_9"></div>
                            <div class="swatch" data-style-background-color="sw_s2_10"></div>
                            <div class="swatch" data-style-background-color="sw_s2_11"></div>
                            <div class="swatch" data-style-background-color="sw_s2_12"></div>
                            <div class="swatch" data-style-background-color="sw_s2_13"></div>
                            <div class="swatch" data-style-background-color="sw_s2_14"></div>
                            <div class="swatch" data-style-background-color="sw_s2_15"></div>
                        </div>
                    </div>
                    <div class="stage-row-block">
                        <span class="stage-row-num">{{ stage_row_label_3 }}</span>
                        <div class="color-grid stage-compact">
                            <div class="swatch" data-style-background-color="sw_s3_0"></div>
                            <div class="swatch" data-style-background-color="sw_s3_1"></div>
                            <div class="swatch" data-style-background-color="sw_s3_2"></div>
                            <div class="swatch" data-style-background-color="sw_s3_3"></div>
                            <div class="swatch" data-style-background-color="sw_s3_4"></div>
                            <div class="swatch" data-style-background-color="sw_s3_5"></div>
                            <div class="swatch" data-style-background-color="sw_s3_6"></div>
                            <div class="swatch" data-style-background-color="sw_s3_7"></div>
                            <div class="swatch" data-style-background-color="sw_s3_8"></div>
                            <div class="swatch" data-style-background-color="sw_s3_9"></div>
                            <div class="swatch" data-style-background-color="sw_s3_10"></div>
                            <div class="swatch" data-style-background-color="sw_s3_11"></div>
                            <div class="swatch" data-style-background-color="sw_s3_12"></div>
                            <div class="swatch" data-style-background-color="sw_s3_13"></div>
                            <div class="swatch" data-style-background-color="sw_s3_14"></div>
                            <div class="swatch" data-style-background-color="sw_s3_15"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- ═══════ REMIX TAB ═══════ -->
        <div data-if="edit_mode == 2" class="tab-content" data-class-disabled="!in_game">
            <div class="control-row">
                <label>Target:</label>
                <input type="checkbox" data-value="remix_target_p1"/> <label>P1</label>
                <input type="checkbox" data-value="remix_target_p2"/> <label>P2</label>
                <input type="checkbox" data-value="remix_target_stage"/> <label>Stage</label>
            </div>
            <div class="control-row">
                <label>Scope:</label>
                <select data-value="remix_scope" class="remix-select">
                    <option value="0">Global (All Colors)</option>
                    <option value="1">Selected Bank Only</option>
                    <option value="2">Ramps (Smart Detect)</option>
                    <option value="3">Checked Banks</option>
                </select>
            </div>
            <div class="control-row">
                <input type="checkbox" data-value="remix_auto_preview"/>
                <label>Auto-Preview</label>
            </div>
            <div class="divider"></div>
            
            <div class="layer-checks">
               <label>Layers:</label>
               <input type="checkbox" data-value="remix_l2"/> <label>L2</label>
               <input type="checkbox" data-value="remix_l0"/> <label>L0</label>
               <input type="checkbox" data-value="remix_l1"/> <label>L1</label>
            </div>
            
            <!-- Effects Scroll Container -- uses data-event-click, not native inputs,
                 because RmlUi scroll containers block native form control events. -->
            <div class="effects-list">
               <div class="effect-row" data-event-click="toggle_fx(0)"><span class="fx-check" data-class-checked="chk_noir"></span><span class="effect-label">Noir</span><span class="fx-btn" data-event-click="fx_dec(0)">-</span><span class="fx-val">{{val_noir}}</span><span class="fx-btn" data-event-click="fx_inc(0)">+</span></div>
               <div class="effect-row" data-event-click="toggle_fx(1)"><span class="fx-check" data-class-checked="chk_miami"></span><span class="effect-label">Miami</span><span class="fx-btn" data-event-click="fx_dec(1)">-</span><span class="fx-val">{{val_miami}}</span><span class="fx-btn" data-event-click="fx_inc(1)">+</span></div>
               <div class="effect-row" data-event-click="toggle_fx(2)"><span class="fx-check" data-class-checked="chk_grindhouse"></span><span class="effect-label">Grindhouse</span><span class="fx-btn" data-event-click="fx_dec(2)">-</span><span class="fx-val">{{val_grindhouse}}</span><span class="fx-btn" data-event-click="fx_inc(2)">+</span></div>
               <div class="effect-row" data-event-click="toggle_fx(3)"><span class="fx-check" data-class-checked="chk_sunrise"></span><span class="effect-label">Sunrise</span><span class="fx-btn" data-event-click="fx_dec(3)">-</span><span class="fx-val">{{val_sunrise}}</span><span class="fx-btn" data-event-click="fx_inc(3)">+</span></div>
               <div class="effect-row" data-event-click="toggle_fx(4)"><span class="fx-check" data-class-checked="chk_noon"></span><span class="effect-label">Noon</span><span class="fx-btn" data-event-click="fx_dec(4)">-</span><span class="fx-val">{{val_noon}}</span><span class="fx-btn" data-event-click="fx_inc(4)">+</span></div>
               <div class="effect-row" data-event-click="toggle_fx(5)"><span class="fx-check" data-class-checked="chk_dusk"></span><span class="effect-label">Dusk</span><span class="fx-btn" data-event-click="fx_dec(5)">-</span><span class="fx-val">{{val_dusk}}</span><span class="fx-btn" data-event-click="fx_inc(5)">+</span></div>
               <div class="effect-row" data-event-click="toggle_fx(6)"><span class="fx-check" data-class-checked="chk_midnight"></span><span class="effect-label">Midnight</span><span class="fx-btn" data-event-click="fx_dec(6)">-</span><span class="fx-val">{{val_midnight}}</span><span class="fx-btn" data-event-click="fx_inc(6)">+</span></div>
               <div class="effect-row" data-event-click="toggle_fx(7)"><span class="fx-check" data-class-checked="chk_stormy"></span><span class="effect-label">Stormy</span><span class="fx-btn" data-event-click="fx_dec(7)">-</span><span class="fx-val">{{val_stormy}}</span><span class="fx-btn" data-event-click="fx_inc(7)">+</span></div>
               <div class="effect-row" data-event-click="toggle_fx(8)"><span class="fx-check" data-class-checked="chk_neon_night"></span><span class="effect-label">Neon-night</span><span class="fx-btn" data-event-click="fx_dec(8)">-</span><span class="fx-val">{{val_neon_night}}</span><span class="fx-btn" data-event-click="fx_inc(8)">+</span></div>
               <div class="effect-row" data-event-click="toggle_fx(9)"><span class="fx-check" data-class-checked="chk_cold_steel"></span><span class="effect-label">Cold Steel</span><span class="fx-btn" data-event-click="fx_dec(9)">-</span><span class="fx-val">{{val_cold_steel}}</span><span class="fx-btn" data-event-click="fx_inc(9)">+</span></div>
               <div class="effect-row" data-event-click="toggle_fx(10)"><span class="fx-check" data-class-checked="chk_heatwave"></span><span class="effect-label">Heatwave</span><span class="fx-btn" data-event-click="fx_dec(10)">-</span><span class="fx-val">{{val_heatwave}}</span><span class="fx-btn" data-event-click="fx_inc(10)">+</span></div>
               <div class="effect-row" data-event-click="toggle_fx(11)"><span class="fx-check" data-class-checked="chk_grad_curve"></span><span class="effect-label">Gradient Curve</span><span class="fx-btn" data-event-click="fx_dec(11)">-</span><span class="fx-val">{{val_grad_curve}}</span><span class="fx-btn" data-event-click="fx_inc(11)">+</span></div>
               <div class="effect-row" data-event-click="toggle_fx(12)"><span class="fx-check" data-class-checked="chk_posterize"></span><span class="effect-label">Posterize</span><span class="fx-btn" data-event-click="fx_dec(12)">-</span><span class="fx-val">{{val_posterize}}</span><span class="fx-btn" data-event-click="fx_inc(12)">+</span></div>
               <div class="effect-row" data-event-click="toggle_fx(13)"><span class="fx-check" data-class-checked="chk_dither"></span><span class="effect-label">Dither-Friendly</span><span class="fx-btn" data-event-click="fx_dec(13)">-</span><span class="fx-val">{{val_dither}}</span><span class="fx-btn" data-event-click="fx_inc(13)">+</span></div>
               <div class="effect-row" data-event-click="toggle_fx(14)"><span class="fx-check" data-class-checked="chk_edge"></span><span class="effect-label">Edge Accent</span><span class="fx-btn" data-event-click="fx_dec(14)">-</span><span class="fx-val">{{val_edge}}</span><span class="fx-btn" data-event-click="fx_inc(14)">+</span></div>
               <div class="effect-row" data-event-click="toggle_fx(15)"><span class="fx-check" data-class-checked="chk_neonizer"></span><span class="effect-label">Neonizer</span><span class="fx-btn" data-event-click="fx_dec(15)">-</span><span class="fx-val">{{val_neonizer}}</span><span class="fx-btn" data-event-click="fx_inc(15)">+</span></div>
               <div class="effect-row" data-event-click="toggle_fx(16)"><span class="fx-check" data-class-checked="chk_fg_pop"></span><span class="effect-label">Foreground Pop</span><span class="fx-btn" data-event-click="fx_dec(16)">-</span><span class="fx-val">{{val_fg_pop}}</span><span class="fx-btn" data-event-click="fx_inc(16)">+</span></div>
               <div class="effect-row" data-event-click="toggle_fx(17)"><span class="fx-check" data-class-checked="chk_bg_wash"></span><span class="effect-label">Background Wash</span><span class="fx-btn" data-event-click="fx_dec(17)">-</span><span class="fx-val">{{val_bg_wash}}</span><span class="fx-btn" data-event-click="fx_inc(17)">+</span></div>
               <div class="effect-row" data-event-click="toggle_fx(18)"><span class="fx-check" data-class-checked="chk_crt"></span><span class="effect-label">CRT / Arcade</span><span class="fx-btn" data-event-click="fx_dec(18)">-</span><span class="fx-val">{{val_crt}}</span><span class="fx-btn" data-event-click="fx_inc(18)">+</span></div>
               <div class="effect-row" data-event-click="toggle_fx(19)"><span class="fx-check" data-class-checked="chk_cel"></span><span class="effect-label">Comic / Cel</span><span class="fx-btn" data-event-click="fx_dec(19)">-</span><span class="fx-val">{{val_cel}}</span><span class="fx-btn" data-event-click="fx_inc(19)">+</span></div>
            </div>
            
            <div class="divider"></div>
            <div class="picker-buttons">
                <button class="btn btn-reset" data-event-click="remix_reset">RESET</button>
                <button class="btn btn-save" data-class-applied="apply_flash" data-event-click="remix_apply">{{ apply_label }}</button>
            </div>
            <div class="committed-status" data-if="committed_p1 || committed_p2 || committed_stage">
                <span class="commit-label">Locked:</span>
                <span data-if="committed_p1" class="commit-tag">P1</span>
                <span data-if="committed_p2" class="commit-tag">P2</span>
                <span data-if="committed_stage" class="commit-tag">STG</span>
            </div>
        </div>

        <!-- ═══════ COLOR PICKER ═══════ -->
        <div data-if="picker_active" class="picker-panel">
            <div class="divider"></div>
            <h2>COLOR EDITOR — Index {{ sel_index }}</h2>
            <div class="picker-previews">
                <div class="preview-box">
                    <span class="preview-label">Original</span>
                    <div class="preview-swatch" data-style-background-color="sel_original"></div>
                </div>
                <div class="preview-box">
                    <span class="preview-label">Modified</span>
                    <div class="preview-swatch" data-style-background-color="sel_preview"></div>
                </div>
            </div>

            <div class="control-row picker-slider">
                <label class="channel-label r-label">R</label>
                <input type="range" min="0" max="31" step="1" data-value="sel_r"/>
                <span class="channel-value">{{ sel_r }}</span>
            </div>
            <div class="control-row picker-slider">
                <label class="channel-label g-label">G</label>
                <input type="range" min="0" max="31" step="1" data-value="sel_g"/>
                <span class="channel-value">{{ sel_g }}</span>
            </div>
            <div class="control-row picker-slider">
                <label class="channel-label b-label">B</label>
                <input type="range" min="0" max="31" step="1" data-value="sel_b"/>
                <span class="channel-value">{{ sel_b }}</span>
            </div>

            <div class="picker-buttons">
                <button class="btn btn-reset" data-event-click="reset_color">RESET</button>
                <button class="btn btn-close" data-event-click="close_picker">CLOSE</button>
            </div>
        </div>

        <!-- ═══════ SAVE / LOAD ═══════ -->
        <div class="save-panel" data-if="in_game">
            <div class="divider"></div>
            <h2>SAVE / LOAD</h2>

            <!-- Save row -->
            <div class="control-row">
                <label>Name:</label>
                <input type="text" data-value="save_name" class="name-input"
                       placeholder="my_palette"/>
                <button class="btn btn-save" data-event-click="do_save">SAVE</button>
            </div>

            <!-- Load browser -->
            <div class="control-row" data-if="saved_count > 0">
                <button class="btn btn-nav" data-event-click="prev_palette">◀</button>
                <span class="palette-name">{{ selected_name }}</span>
                <button class="btn btn-nav" data-event-click="next_palette">▶</button>
                <button class="btn btn-load" data-event-click="do_load">LOAD</button>
                <button class="btn btn-delete" data-event-click="do_delete">DEL</button>
            </div>
            <p data-if="saved_count == 0" class="status-warn">No saved palettes</p>
        </div>

        <div class="divider"></div>
        <p class="hint">Saved per character · Press F10 to close</p>
    </div>
</body>
</rml>
