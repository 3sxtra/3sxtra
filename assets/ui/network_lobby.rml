<rml>
  <head>
    <link type="text/rcss" href="base.rcss" />
    <link type="text/rcss" href="network_lobby.rcss" />
    <title>Network Lobby</title>
  </head>
  <body data-model="network_lobby">
    <div id="lobby-panel">
      <!-- ── Title bar ── -->
      <div id="lobby-title-bar">
        <div id="lobby-title-text">NETWORK LOBBY</div>
      </div>

      <!-- ── Main content: left menu + right peer panels ── -->
      <div id="lobby-body">
        <!-- Left: menu column -->
        <div id="lobby-menu-col">

          <div class="lobby-row" data-class-focused="cursor == 0">
            <span class="lobby-cell-label">ROOM TYPE</span>
            <span class="lobby-cell-value">{{ create_room_type_label }}</span>
          </div>
          <div class="lobby-row" data-class-focused="cursor == 1">
            <span class="lobby-cell-label">VISIBILITY</span>
            <span class="lobby-cell-value">{{
              create_room_visibility_label
            }}</span>
          </div>
          <div class="lobby-row" data-class-focused="cursor == 2">
            <span class="lobby-cell-label">PASSWORD</span>
            <span class="lobby-cell-value">{{ create_password_label }}</span>
          </div>
          <div
            class="lobby-row"
            data-class-focused="cursor == 3"
            data-if="create_room_type == 2"
          >
            <span class="lobby-cell-label">FORMAT</span>
            <span class="lobby-cell-value">{{
              create_tournament_format_label
            }}</span>
          </div>
          <div class="lobby-row" data-class-focused="cursor == 4">
            <span class="lobby-cell-label">REGION LOCK</span>
            <span class="lobby-cell-value" data-class-on="region_lock">{{
              region_lock ? 'ON' : 'OFF'
            }}</span>
          </div>
          <div class="lobby-row" data-class-focused="cursor == 5">
            <span class="lobby-cell-label">MAX PING</span>
            <span class="lobby-cell-value">{{
              max_ping == 0 ? 'OFF' : max_ping + 'ms'
            }}</span>
          </div>
          <div class="lobby-row" data-class-focused="cursor == 6">
            <span class="lobby-cell-label">BLOCK WIFI</span>
            <span class="lobby-cell-value" data-class-on="block_wifi">{{
              block_wifi ? 'ON' : 'OFF'
            }}</span>
          </div>
          <div class="lobby-row" data-class-focused="cursor == 7">
            <span class="lobby-cell-label">MATCH FT</span>
            <span class="lobby-cell-value">{{
              ft_value == 1 ? 'UNRANKED' : 'FT' + ft_value
            }}</span>
          </div>
          <div class="lobby-row" data-class-focused="cursor == 8">
            <span class="lobby-cell-label">CREATE ROOM</span>
            <span class="lobby-cell-value" data-if="room_status != ''">{{
              room_status
            }}</span>
          </div>
          <div class="lobby-row" data-class-focused="cursor == 9">
            <span class="lobby-cell-label">JOIN ROOM</span>
            <span class="lobby-cell-value" data-if="join_room_code != ''">{{
              join_room_code
            }}</span>
          </div>
          <div class="lobby-row" data-class-focused="cursor == 10">
            <span class="lobby-cell-label">JOIN BY CODE</span>
          </div>

          <div class="lobby-row exit-row" data-class-focused="cursor == 11">
            <span class="lobby-cell-label">EXIT</span>
          </div>
        </div>

        <!-- Right: peer panels column -->
        <div id="lobby-peers-col">
          <!-- Active Rooms -->
          <div class="peer-panel">
            <div class="peer-panel-header">
              <span class="peer-panel-title">ROOMS</span>
              <span class="peer-panel-count" data-if="room_count > 0"
                >{{ room_count }} active</span
              >
              <span class="peer-panel-count empty" data-if="room_count == 0"
                >none</span
              >
            </div>
            <div class="peer-list">
              <div
                data-for="r : room_list"
                class="peer-list-item"
                data-class-selected="r.selected"
              >
                <span class="room-badge" data-if="r.is_tournament">🏆</span>
                <span class="room-badge" data-if="r.is_private">🔒</span>
                <span class="peer-list-name">{{ r.name }}</span>
                <span class="room-list-count"
                  >{{ r.player_count }}/{{ r.max_players }}</span
                >
              </div>
              <div class="peer-list-empty" data-if="room_count == 0">
                no active rooms
              </div>
            </div>
          </div>
        </div>
        <!-- lobby-peers-col -->
      </div>
      <!-- lobby-body -->

      <!-- ── Status bar ── -->
      <div id="status-bar" data-if="status_text != ''">
        <span id="status-text">{{ status_text }}</span>
      </div>

      <!-- ── Popup overlay ── -->
      <div data-if="popup_type > 0" id="popup-scrim">
        <div id="popup-box">
          <div class="popup-title">{{ popup_title }}</div>
          <div class="popup-name">{{ popup_name }}</div>
          <div class="popup-ping" data-if="popup_ping != ''">
            PING: {{ popup_ping }}
          </div>
          <div class="popup-region" data-if="popup_region != ''">
            {{ popup_region }}
          </div>
          <div class="popup-ft" data-if="popup_ft != ''">{{ popup_ft }}</div>
          <div class="popup-actions" data-if="popup_is_incoming">
            <span class="popup-accept">[LP] ACCEPT</span>
            <span class="popup-decline">[MK] DECLINE</span>
          </div>
          <div class="popup-actions" data-if="!popup_is_incoming">
            <span class="popup-cancel">[MK] CANCEL</span>
          </div>
        </div>
      </div>

      <!-- ── Password prompt popup ── -->
      <div data-if="password_popup_visible" id="popup-scrim">
        <div id="popup-box">
          <div class="popup-title">
            {{
              password_popup_mode == 2
                ? 'ENTER ROOM CODE'
                : password_popup_mode == 1
                  ? 'SET PASSWORD'
                  : 'ENTER PASSWORD'
            }}
          </div>
          <div class="popup-name">{{ password_input_display }}</div>
          <div class="popup-region">↑↓ CYCLE ← DELETE → NEXT</div>
          <div class="popup-actions">
            <span class="popup-accept">[LP] CONFIRM</span>
            <span class="popup-decline">[MK] CANCEL</span>
          </div>
        </div>
      </div>
    </div>
  </body>
</rml>
