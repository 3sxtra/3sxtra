struct V2F {
    float4 position : POSITION;
    float2 texcoord : TEXCOORD0;
    float4 color : COLOR;
};

// C-02 Audit Fix: Explicit row_major for matrix bound from C array.
// C-03 Audit Fix: CELL_GCM_VERTEX_UB passes 0-255, must be normalized in shader
// or it will cause huge color values resulting in a blown out / invisible image.
V2F main(float4 position : ATTR0, 
         float2 texcoord : ATTR1, 
         float4 color : ATTR2,
         uniform row_major float4x4 mvp) 
{
    V2F OUT;
    OUT.position = mul(mvp, position);
    OUT.texcoord = texcoord;
    // CELL_GCM_VERTEX_UB256 normalizes 0-255 → 0.0-1.0 in hardware; no shader divide needed
    OUT.color = color;
    return OUT;
}
